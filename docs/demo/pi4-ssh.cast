[13.211703, "o", "\r\r\n  0x1000 - 0x80000  rw-  stack\r\r\n  0x80000 - 0xc7000  r-x  kernel code\r\r\n  0xc7000 - 0xca000  r--  kernel constants\r\r\n  0xca000 - 0x210000  rw-  kernel data\r\r\n  0x210000 - 0x220000  rw- device  a card's memory\r\r\n  0x220000 - 0x3c000000  rw-  kernel data and heap\r\r\n  0xfc000000 - 0x100000000  rw- device  peripherals\r\r\n> "]
