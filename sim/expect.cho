edition 5;

// expect.cho -- what `arm pose` and four `arm check` requests must print for the simulated servos, computed on this machine from the same
// calibration and kinematics the kernel carries. Not part of the kernel. test.sh's caller compares the two: the
// kernel's arithmetic, with no system under it, against the same code under a system.
import std.io;
import calibration;
import kinematics;
import safety;

fn span_min(joint: int) -> [] int {
    if joint == 0 {
        return 884;
    }
    if joint == 1 {
        return 1056;
    }
    if joint == 2 {
        return 885;
    }
    if joint == 3 {
        return 2060;
    }
    return 0;
}

fn span_max(joint: int) -> [] int {
    if joint == 0 {
        return 3460;
    }
    if joint == 1 {
        return 3116;
    }
    if joint == 2 {
        return 3057;
    }
    if joint == 3 {
        return 3773;
    }
    return 4095;
}

fn say[&i, &t](io: &!i Io, text: &t [byte]) -> [io_write] int {
    return io.write_all(io, text);
}

// What `arm check a1 .. a5` prints, from the pose `current`.
fn check[&i, &c](out: &!i Io, current: &c [float], a1: int, a2: int, a3: int, a4: int, a5: int) -> [io_write] int {
    region r {
        let request = alloc_slice[r](5, 0.0);
        request[0] = float_of(a1);
        request[1] = float_of(a2);
        request[2] = float_of(a3);
        request[3] = float_of(a4);
        request[4] = float_of(a5);
        let limits = alloc_slice[r](10, 0.0);
        var j = 0;
        while j < 5 {
            limits[j * 2] = calibration.degrees(span_min(j), span_min(j), span_max(j));
            limits[j * 2 + 1] = calibration.degrees(span_max(j), span_min(j), span_max(j));
            j = j + 1;
        }
        let goals = alloc_slice[r](5, 0.0);
        let scale = alloc_slice[r](1, 0.0);
        let joint = alloc_slice[r](1, 0);
        let other = alloc_slice[r](0, 0.0);
        let mount = safety.Mount { x: -0.135, y: 0.133, z: 0.76, yaw_deg: 0.0 };
        var rule = 0;
        borrow mount as &m in {
            rule = safety.approve(request, current, limits, m, other, 0, 10, goals, scale, joint);
        }
        if rule == safety.rule_ok() {
            say(out, "approved");
            if scale[0] < 1.0 {
                say(out, ", slowed to ");
                io.print_int(out, truncate(scale[0] * 1000.0));
                say(out, " per mille of the step");
            }
            say(out, "\ngoals:");
            j = 0;
            while j < 5 {
                say(out, " ");
                io.print_int(out, truncate(goals[j] * 1000.0));
                j = j + 1;
            }
            say(out, " mdeg\n");
        } else {
            say(out, "refused: ");
            say(out, safety.rule_name(rule));
            if joint[0] >= 0 {
                say(out, " (joint ");
                io.print_int(out, joint[0] + 1);
                say(out, ")");
            }
            say(out, "\n");
        }
    }
    return say(out, "nothing was sent\n");
}

fn run[&i](out: &!i Io) -> [io_write] int {
    region r {
        let degrees = alloc_slice[r](5, 0.0);
        let pose = alloc_slice[r](16, 0.0);
        var joint = 0;
        while joint < 5 {
            // sim/servos.cho: servo `id` is at 2048 + 100 * id
            degrees[joint] = calibration.degrees(2048 + 100 * (joint + 1), span_min(joint), span_max(joint));
            say(out, "joint ");
            io.print_int(out, joint + 1);
            say(out, ": ");
            io.print_int(out, truncate(degrees[joint] * 1000.0));
            say(out, " mdeg\n");
            joint = joint + 1;
        }
        kinematics.forward(degrees, pose);
        say(out, "gripper at x ");
        io.print_int(out, truncate(pose[3] * 1000000.0));
        say(out, " y ");
        io.print_int(out, truncate(pose[7] * 1000000.0));
        say(out, " z ");
        io.print_int(out, truncate(pose[11] * 1000000.0));
        say(out, " um\n");
        // the four requests test.sh's caller sends, in the same order
        check(out, degrees, -2, 14, 33, -41, 44);
        check(out, degrees, 5, 14, 33, -41, 44);
        check(out, degrees, -2, 14, 33, -41, 400);
        check(out, degrees, 60, 14, 33, -41, 44);
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    var status = 0;
    borrow mut io as &!i in {
        status = run(i);
    }
    release(io);
    return status;
}
