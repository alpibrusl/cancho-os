edition 5;

// servos.cho -- six simulated Feetech STS servos on a bus, for testing in QEMU. Not part of the kernel: an
// ordinary cancho program for the machine the emulator runs on. It reads instruction packets on its standard
// input and writes status packets on its standard output; test.sh connects those to the emulated board's
// second serial port.
//
//     instruction:  FF FF  id  length  instruction  parameters...  checksum
//     status:       FF FF  id  length  error        parameters...  checksum
//
// Servos 1 to 6 exist, as on an SO-101 arm; any other id is silence, which is what a real bus does. A packet
// with a wrong checksum is dropped without an answer. PING, READ and SYNC READ are answered; nothing else is,
// so this simulator cannot be told to move.
//
// It is a model written from the protocol, not a recording of a servo: it can share a misreading with the
// driver. What ties it to reality is that its answers must decode with `feetech.decode`, which cancho-robot
// holds to scservo_sdk and has run against the real bus.
import feetech;

// The register a servo answers a read with. 3-4: model number (777, an STS3215). 5: its id.
// 56-57: present position, little-endian; here 2048 (the middle of the range) plus 100 for each id.
fn register(id: int, address: int) -> [] int {
    let position = 2048 + 100 * id;
    if address == 3 {
        return 777 % 256;
    }
    if address == 4 {
        return 777 / 256;
    }
    if address == 5 {
        return id;
    }
    if address == 56 {
        return position % 256;
    }
    if address == 57 {
        return position / 256;
    }
    return 0;
}

// The status packet of servo `id` carrying `count` registers from `address` (none for a PING).
fn answer[&i](io: &!i Io, id: int, address: int, count: int) -> [io_write] int {
    var sum = id + count + 2;
    putchar(io, 255);
    putchar(io, 255);
    putchar(io, id);
    putchar(io, count + 2);
    putchar(io, 0);
    var k = 0;
    while k < count {
        let v = register(id, address + k);
        putchar(io, v);
        sum = sum + v;
        k = k + 1;
    }
    return putchar(io, 255 - sum % 256);
}

fn exists(id: int) -> [] bool {
    return id >= 1 && id <= 6;
}

// One whole instruction packet, `p[0..n]`, checksum already verified.
fn serve[&i, &p](io: &!i Io, p: &p [byte], n: int) -> [io_write] int {
    let id = int_of(p[2]);
    let instr = int_of(p[4]);
    if instr == feetech.inst_ping() && exists(id) {
        answer(io, id, 0, 0);
    } else if instr == feetech.inst_read() && exists(id) && n == 8 {
        answer(io, id, int_of(p[5]), int_of(p[6]));
    } else if instr == feetech.inst_sync_read() && id == feetech.broadcast_id() && n >= 9 {
        var k = 7;
        while k < n - 1 {
            if exists(int_of(p[k])) {
                answer(io, int_of(p[k]), int_of(p[5]), int_of(p[6]));
            }
            k = k + 1;
        }
    }
    // The answer must leave now: the other end is waiting for it.
    match flush_out(io) {
        Done::Ok(n) => {
            return 0;
        }
        Done::Failed(e) => {
            return e;
        }
    }
}

fn run[&i](io: &!i Io) -> [io_read, io_write] int {
    region r {
        let p = alloc_slice[r](256, byte_of(0));
        var n = 0;
        var c = getchar(io);
        while c >= 0 {
            // Resynchronise on FF FF: a byte that cannot be where it is restarts the packet.
            if n < 2 && c != 255 {
                n = 0;
            } else {
                p[n] = byte_of(c);
                n = n + 1;
            }
            if n >= 4 && n == int_of(p[3]) + 4 {
                if int_of(p[n - 1]) == feetech.checksum(p, 2, n - 1) {
                    serve(io, p, n);
                }
                n = 0;
            }
            if n == 256 {
                n = 0;
            }
            c = getchar(io);
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    var status = 0;
    borrow mut io as &!i in {
        status = run(i);
    }
    release(io);
    return status;
}
