import std.test;
import inet;

// TCP in `inet`, and the two things the kernel says first, with no machine under them. As in inet_test.cho,
// no segment here is this file's own arithmetic: each was built by a second implementation in another
// language (Python's `struct`, with its own checksum) and pasted as hex. The other end is 10.0.0.1, port
// 40000; both first sequence numbers are a few short of 2^32, so every conversation here wraps.

fn digit(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    return c - 'a' + 10;
}

fn set[&b, &s](buf: &!b [byte], hex: &s [byte]) -> [] int {
    var i = 0;
    while i * 2 + 1 < len(hex) {
        buf[i] = byte_of(digit(int_of(hex[i * 2])) * 16 + digit(int_of(hex[i * 2 + 1])));
        i = i + 1;
    }
    return i;
}

fn same[&a, &b](x: &a [byte], y: &b [byte], n: int) -> [] bool {
    var i = 0;
    while i < n {
        if int_of(x[i]) != int_of(y[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ours() -> [] int {
    return 10 * 16777216 + 2;
}

fn peer() -> [] int {
    return 10 * 16777216 + 1;
}

fn mac() -> [] int {
    return 90520731923542;
}

// the first sequence number the tests give a new connection: 0xfffffffd
fn iss() -> [] int {
    return 4294967293;
}

// At time `now`, `request` arrives and `reply` is what is sent back, byte for byte. An empty `reply`: the
// segment is taken and nothing is sent.
fn says[&t, &b, &i, &q, &r](tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte], port: int, now: int, request: &q [byte], reply: &r [byte]) -> [] int {
    region a {
        let pkt = alloc_slice[a](1100, byte_of(0));
        let want = alloc_slice[a](1100, byte_of(0));
        let out = alloc_slice[a](1100, byte_of(0));
        let n = set(pkt, request);
        let m = set(want, reply);
        test.assert_eq(inet.serve(pkt, n, ours(), tcp, bufs, inbox, port, now, iss(), out), m);
        test.assert(same(out, want, m));
    }
    return 0;
}

// At time `now`, connection `c` sends `again` (empty: it sends nothing).
fn ticks[&t, &b, &r](tcp: &!t [int], bufs: &!b [byte], c: int, now: int, again: &r [byte]) -> [] int {
    region a {
        let want = alloc_slice[a](1100, byte_of(0));
        let out = alloc_slice[a](1100, byte_of(0));
        let m = set(want, again);
        test.assert_eq(inet.tcp_tick(tcp, bufs, c, now, ours(), out, 0), m);
        test.assert(same(out, want, m));
    }
    return 0;
}

// A connection opened: the SYN, our SYN and acknowledgement, the acknowledgement of ours.
fn open[&t, &b, &i](tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte]) -> [] int {
    says(tcp, bufs, inbox, 0, 100, "4500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307", "4500002c00000000400666ca0a0000020a00000100079c40fffffffdfffffffb601203c6e5fa0000020403c6");
    return says(tcp, bufs, inbox, 0, 101, "4500002811110000400655bd0a0000010a0000029c400007fffffffbfffffffe5010faf0049f0000", "");
}

// ── a whole conversation ──

fn test_a_connection_opens_echoes_and_closes() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        test.assert_eq(inet.tcp_count(tcp, bufs, inbox), 4);
        // the SYN carries an option we know (the most it takes, 1460) and one we do not
        says(tcp, bufs, inbox, 0, 100, "4500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307", "4500002c00000000400666ca0a0000020a00000100079c40fffffffdfffffffb601203c6e5fa0000020403c6");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
        says(tcp, bufs, inbox, 0, 101, "4500002811110000400655bd0a0000010a0000029c400007fffffffbfffffffe5010faf0049f0000", "");
        // "hello\n" comes back; the window is the room left while those six bytes are out
        says(tcp, bufs, inbox, 0, 102, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // acknowledged: the window is whole again
        says(tcp, bufs, inbox, 0, 103, "4500002811110000400655bd0a0000010a0000029c40000700000001000000045010faf004950000", "4500002800000000400666ce0a0000020a00000100079c400000000400000001501003c6fbbf0000");
        // the other end finishes, so we do
        says(tcp, bufs, inbox, 0, 104, "4500002811110000400655bd0a0000010a0000029c40000700000001000000045011faf004940000", "4500002800000000400666ce0a0000020a00000100079c40000000040000000250110000ff830000");
        says(tcp, bufs, inbox, 0, 105, "4500002811110000400655bd0a0000010a0000029c40000700000002000000055010faf004930000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_data_and_fin_in_one_segment_get_one_segment_back() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        says(tcp, bufs, inbox, 0, 102, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5019faf0c0b3000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe0000000250190000bb9e000068656c6c6f0a");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
    }
    return 0;
}

// ── what is not the next byte ──

fn test_a_segment_from_further_on_is_told_what_is_expected() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        says(tcp, bufs, inbox, 0, 102, "4500002e11110000400655b70a0000010a0000029c4000070000005ffffffffe5018faf0c051000068656c6c6f0a", "4500002800000000400666ce0a0000020a00000100079c40fffffffefffffffb501003c6fbc90000");
        // and it was not taken: the segment that does come next still is
        says(tcp, bufs, inbox, 0, 103, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // but what such a segment acknowledges counts: the echo is no longer out
        says(tcp, bufs, inbox, 0, 104, "4500002e11110000400655b70a0000010a0000029c4000070000005f000000045018faf0c04c000068656c6c6f0a", "4500002800000000400666ce0a0000020a00000100079c400000000400000001501003c6fbbf0000");
        ticks(tcp, bufs, 0, 99999, "");
    }
    return 0;
}

fn test_data_arriving_while_ours_is_out_is_echoed_after_it() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        says(tcp, bufs, inbox, 0, 102, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // "more" does not acknowledge the echo; there is room for it, and only it is sent
        says(tcp, bufs, inbox, 0, 103, "4500002c11110000400655b90a0000010a0000029c40000700000001fffffffe5018faf024b900006d6f7265", "4500002c00000000400666ca0a0000020a00000100079c400000000400000005501803bc1be500006d6f7265");
        // the first echo is acknowledged and the second is not: the window widens by six
        says(tcp, bufs, inbox, 0, 104, "4500002811110000400655bd0a0000010a0000029c40000700000005000000045010faf004910000", "4500002800000000400666ce0a0000020a00000100079c400000000800000005501003c2fbbb0000");
        // and what is sent again is only what is still out
        ticks(tcp, bufs, 0, 1103, "");
        ticks(tcp, bufs, 0, 1104, "4500002c00000000400666ca0a0000020a00000100079c400000000400000005501803c21bdf00006d6f7265");
    }
    return 0;
}

fn test_when_the_buffer_is_full_the_window_is_zero_and_nothing_more_is_taken() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        // 966 bytes, all the room there is
        says(tcp, bufs, inbox, 0, 102, "", "");
        says(tcp, bufs, inbox, 0, 103, "4500002911110000400655bc0a0000010a0000029c400007000003c1fffffffe5018faf0dfd0000021", "4500002800000000400666ce0a0000020a00000100079c40000003c4000003c150100000f8050000");
    }
    return 0;
}

fn test_a_damaged_segment_is_dropped() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let pkt = alloc_slice[a](100, byte_of(0));
        let out = alloc_slice[a](100, byte_of(0));
        open(tcp, bufs, inbox);
        let n = set(pkt, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0b");
        test.assert_eq(inet.serve(pkt, n, ours(), tcp, bufs, inbox, 0, 102, iss(), out), inet.drop_bad_checksum());
        says(tcp, bufs, inbox, 0, 103, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
    }
    return 0;
}

fn test_a_segment_seen_before_is_not_taken_twice_but_its_acknowledgement_counts() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        says(tcp, bufs, inbox, 0, 102, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // the other end finishes before our echo has reached it: our FIN goes out after the echo
        says(tcp, bufs, inbox, 0, 103, "4500002811110000400655bd0a0000010a0000029c40000700000001fffffffe5011faf004990000", "4500002800000000400666ce0a0000020a00000100079c40000000040000000250110000ff830000");
        // its FIN again, this time acknowledging the echo: only our FIN is out now
        says(tcp, bufs, inbox, 0, 104, "4500002811110000400655bd0a0000010a0000029c40000700000001000000045011faf004940000", "4500002800000000400666ce0a0000020a00000100079c40000000050000000250100000ff830000");
        ticks(tcp, bufs, 0, 1104, "4500002800000000400666ce0a0000020a00000100079c40000000040000000250110000ff830000");
        says(tcp, bufs, inbox, 0, 1105, "4500002811110000400655bd0a0000010a0000029c40000700000002000000055010faf004930000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_data_seen_before_is_not_echoed_twice() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        says(tcp, bufs, inbox, 0, 102, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // the same six bytes again, acknowledging the echo: they are not echoed again, and the window opens
        says(tcp, bufs, inbox, 0, 103, "4500002e11110000400655b70a0000010a0000029c400007fffffffb000000045018faf0c0af000068656c6c6f0a", "4500002800000000400666ce0a0000020a00000100079c400000000400000001501003c6fbbf0000");
    }
    return 0;
}

// ── resets ──

fn test_a_reset_for_the_next_byte_closes_the_connection() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        says(tcp, bufs, inbox, 0, 102, "4500002811110000400655bd0a0000010a0000029c4000070000002c000000005004faf0047a0000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
        says(tcp, bufs, inbox, 0, 103, "4500002811110000400655bd0a0000010a0000029c400007fffffffb000000005004faf004aa0000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_a_port_nothing_listens_on_answers_with_a_reset() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        says(tcp, bufs, inbox, 0, 100, "4500002811110000400655bd0a0000010a0000029c400009fffffffa000000005002faf004ab0000", "4500002800000000400666ce0a0000020a00000100099c4000000000fffffffb50140000ff880000");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_a_segment_of_no_connection_answers_with_a_reset() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        says(tcp, bufs, inbox, 0, 100, "4500002811110000400655bd0a0000010a0000029c4000070000004d000010925010faf0f3ba0000", "4500002800000000400666ce0a0000020a00000100079c40000010920000000050040000ef040000");
        // and a reset is never answered
        says(tcp, bufs, inbox, 0, 101, "4500002811110000400655bd0a0000010a0000029c400007fffffffb000000005004faf004aa0000", "");
    }
    return 0;
}

// ── options, and room ──

fn test_a_syn_that_names_no_size_is_given_536() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        says(tcp, bufs, inbox, 0, 100, "4500002811110000400655bd0a0000010a0000029c410007fffffffa000000005002faf004ac0000", "4500002c00000000400666ca0a0000020a00000100079c41fffffffdfffffffb60120218e7a70000020403c6");
    }
    return 0;
}

fn test_a_fifth_connection_is_refused_until_one_has_been_silent_a_minute() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        says(tcp, bufs, inbox, 0, 100, "4500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307", "4500002c00000000400666ca0a0000020a00000100079c40fffffffdfffffffb601203c6e5fa0000020403c6");
        says(tcp, bufs, inbox, 0, 200, "4500002c11110000400655b90a0000010a0000029c420007fffffffa000000006002faf0ecee0000020405b4", "4500002c00000000400666ca0a0000020a00000100079c42fffffffdfffffffb601203c6e5f80000020403c6");
        says(tcp, bufs, inbox, 0, 300, "4500002c11110000400655b90a0000010a0000029c430007fffffffa000000006002faf0eced0000020405b4", "4500002c00000000400666ca0a0000020a00000100079c43fffffffdfffffffb601203c6e5f70000020403c6");
        says(tcp, bufs, inbox, 0, 400, "4500002c11110000400655b90a0000010a0000029c440007fffffffa000000006002faf0ecec0000020405b4", "4500002c00000000400666ca0a0000020a00000100079c44fffffffdfffffffb601203c6e5f60000020403c6");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 4);
        says(tcp, bufs, inbox, 0, 60099, "4500002c11110000400655b90a0000010a0000029c450007fffffffa000000006002faf0eceb0000020405b4", "4500002800000000400666ce0a0000020a00000100079c4500000000fffffffb50140000ff850000");
        // the first has now been silent 60 s: its place is taken
        says(tcp, bufs, inbox, 0, 60100, "4500002c11110000400655b90a0000010a0000029c450007fffffffa000000006002faf0eceb0000020405b4", "4500002c00000000400666ca0a0000020a00000100079c45fffffffdfffffffb601203c6e5f50000020403c6");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 4);
    }
    return 0;
}

// ── time ──

fn test_an_unacknowledged_segment_is_sent_again_then_given_up() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        open(tcp, bufs, inbox);
        ticks(tcp, bufs, 0, 5000, "");
        says(tcp, bufs, inbox, 0, 10000, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a", "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // 1 s, then 2, 4, 8 and 16 after the time before
        ticks(tcp, bufs, 0, 10999, "");
        ticks(tcp, bufs, 0, 11000, "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        ticks(tcp, bufs, 0, 12999, "");
        ticks(tcp, bufs, 0, 13000, "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        ticks(tcp, bufs, 0, 17000, "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        ticks(tcp, bufs, 0, 25000, "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        ticks(tcp, bufs, 0, 40999, "");
        ticks(tcp, bufs, 0, 41000, "4500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        // 32 s more and nothing: the connection is dropped
        ticks(tcp, bufs, 0, 72999, "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
        ticks(tcp, bufs, 0, 73000, "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_a_syn_never_acknowledged_is_sent_again() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        says(tcp, bufs, inbox, 0, 100, "4500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307", "4500002c00000000400666ca0a0000020a00000100079c40fffffffdfffffffb601203c6e5fa0000020403c6");
        ticks(tcp, bufs, 0, 1100, "4500002c00000000400666ca0a0000020a00000100079c40fffffffdfffffffb601203c6e5fa0000020403c6");
        // a connection that is not there has nothing to send
        ticks(tcp, bufs, 1, 99999, "");
        ticks(tcp, bufs, 9, 99999, "");
    }
    return 0;
}

// ── the caller's port ──
// Port 23 here, from the other end's port 41000. What arrives is not echoed: it waits to be read.

// At time `now`, connection `c` has `what` to send that it has not sent (empty: nothing).
fn flushes[&t, &b, &r](tcp: &!t [int], bufs: &!b [byte], c: int, now: int, what: &r [byte]) -> [] int {
    region a {
        let want = alloc_slice[a](1100, byte_of(0));
        let out = alloc_slice[a](1100, byte_of(0));
        let m = set(want, what);
        test.assert_eq(inet.tcp_flush(tcp, bufs, c, now, ours(), out, 0), m);
        test.assert(same(out, want, m));
    }
    return 0;
}

fn test_a_line_is_read_and_an_answer_written() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        test.assert_eq(inet.tcp_port(tcp, 0), 23);
        test.assert_eq(inet.tcp_state(tcp, 0), 2);
        // "about\r\n" is acknowledged, not echoed; the window is the room left in the inbox
        says(tcp, bufs, inbox, 23, 102, "4500002f11110000400655b60a0000010a000002a0280017fffffffbfffffffe5018faf0b1b2000061626f75740d0a", "4500002800000000400666ce0a0000020a0000010017a028fffffffe00000002501000f9fa980000");
        flushes(tcp, bufs, 0, 103, "");
        // read three bytes, then the rest
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 3), 3);
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got[3..300], 100), 4);
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 100), 0);
        let n = set(want, "61626f75740d0a");
        test.assert(same(got, want, n));
        // the answer: written, and nothing is sent until the flush
        let m = set(want, "6f6b0d0a3e20");
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), m);
        ticks(tcp, bufs, 0, 5000, "");
        flushes(tcp, bufs, 0, 5000, "4500002e00000000400666c80a0000020a0000010017a028fffffffe00000002501801003fee00006f6b0d0a3e20");
        flushes(tcp, bufs, 0, 5001, "");
        // not acknowledged for a second: sent again
        ticks(tcp, bufs, 0, 5999, "");
        ticks(tcp, bufs, 0, 6000, "4500002e00000000400666c80a0000020a0000010017a028fffffffe00000002501801003fee00006f6b0d0a3e20");
        // acknowledged: nothing to say to that
        says(tcp, bufs, inbox, 23, 6001, "4500002811110000400655bd0a0000010a000002a028001700000002000000045010faf0009c0000", "");
        ticks(tcp, bufs, 0, 99999, "");
    }
    return 0;
}

fn test_the_port_is_closed_unless_the_caller_names_it() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 0, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002800000000400666ce0a0000020a0000010017a02800000000fffffffb50140000fb920000");
        says(tcp, bufs, inbox, 22, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002800000000400666ce0a0000020a0000010017a02800000000fffffffb50140000fb920000");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
        // and a connection on port 7 is not the caller's to read or write
        open(tcp, bufs, inbox);
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 100), 0);
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, 4), 0);
        test.assert_eq(inet.tcp_close(tcp, 0), 0);
        flushes(tcp, bufs, 0, 200, "");
        test.assert_eq(inet.tcp_read(tcp, inbox, 3, got, 100), 0);
        test.assert_eq(inet.tcp_read(tcp, inbox, 4, got, 100), 0);
        test.assert_eq(inet.tcp_write(tcp, bufs, -1, want, 0, 4), 0);
    }
    return 0;
}

fn test_a_full_inbox_closes_the_window_and_reading_opens_it() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        // 256 bytes: all the room
        says(tcp, bufs, inbox, 23, 102, "", "4500002800000000400666ce0a0000020a0000010017a028fffffffe000000fb50100000fa980000");
        // one more is not taken
        says(tcp, bufs, inbox, 23, 103, "4500002911110000400655bc0a0000010a000002a0280017000000fbfffffffe5018faf0de9e000021", "4500002800000000400666ce0a0000020a0000010017a028fffffffe000000fb50100000fa980000");
        flushes(tcp, bufs, 0, 104, "");
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 300), 256);
        let n = set(want, "");
        test.assert(same(got, want, n));
        // the window was said to be zero: now that there is room it is said again, once
        flushes(tcp, bufs, 0, 105, "4500002800000000400666ce0a0000020a0000010017a028fffffffe000000fb50100100f9980000");
        flushes(tcp, bufs, 0, 106, "");
    }
    return 0;
}

fn test_the_other_end_may_finish_first_and_still_be_answered() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        // a line and a FIN in one segment, as `printf ... | nc` sends them
        says(tcp, bufs, inbox, 23, 102, "4500002f11110000400655b60a0000010a000002a0280017fffffffbfffffffe5019faf0b1b1000061626f75740d0a", "4500002800000000400666ce0a0000020a0000010017a028fffffffe0000000350100000fb900000");
        test.assert_eq(inet.tcp_state(tcp, 0), 3);
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 100), 7);
        let m = set(want, "6f6b0d0a3e20");
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), m);
        flushes(tcp, bufs, 0, 103, "4500002e00000000400666c80a0000020a0000010017a028fffffffe000000035018000040ed00006f6b0d0a3e20");
        // we finish too: our FIN goes after the answer, and no more can be written
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        test.assert_eq(inet.tcp_close(tcp, 0), 0);
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), 0);
        flushes(tcp, bufs, 0, 104, "4500002800000000400666ce0a0000020a0000010017a028000000040000000350110000fb8a0000");
        flushes(tcp, bufs, 0, 105, "");
        // the answer is acknowledged and the FIN is not yet: the connection is still there
        says(tcp, bufs, inbox, 23, 106, "4500002811110000400655bd0a0000010a000002a028001700000003000000045010faf0009b0000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
        ticks(tcp, bufs, 0, 1106, "4500002800000000400666ce0a0000020a0000010017a028000000040000000350110000fb8a0000");
        says(tcp, bufs, inbox, 23, 1107, "4500002811110000400655bd0a0000010a000002a028001700000003000000055010faf0009a0000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_an_answer_and_a_fin_not_yet_sent_go_in_one_segment() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        says(tcp, bufs, inbox, 23, 102, "4500002f11110000400655b60a0000010a000002a0280017fffffffbfffffffe5019faf0b1b1000061626f75740d0a", "4500002800000000400666ce0a0000020a0000010017a028fffffffe0000000350100000fb900000");
        let m = set(want, "6f6b0d0a3e20");
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), m);
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        // an acknowledgement before anything was sent ends nothing
        says(tcp, bufs, inbox, 23, 103, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "4500002800000000400666ce0a0000020a0000010017a028fffffffe0000000350100000fb900000");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
        flushes(tcp, bufs, 0, 104, "4500002e00000000400666c80a0000020a0000010017a028fffffffe000000035019000040ec00006f6b0d0a3e20");
        ticks(tcp, bufs, 0, 1104, "4500002e00000000400666c80a0000020a0000010017a028fffffffe000000035019000040ec00006f6b0d0a3e20");
        says(tcp, bufs, inbox, 23, 1105, "4500002811110000400655bd0a0000010a000002a028001700000003000000055010faf0009a0000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

// ── hanging up first ──

fn test_we_may_finish_first_and_wait_for_the_other_end() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        test.assert_eq(inet.tcp_state(tcp, 0), 5);
        flushes(tcp, bufs, 0, 102, "4500002800000000400666ce0a0000020a0000010017a028fffffffefffffffb50110000fb960000");
        says(tcp, bufs, inbox, 23, 103, "4500002811110000400655bd0a0000010a000002a0280017fffffffbffffffff5010faf000a60000", "");
        test.assert_eq(inet.tcp_state(tcp, 0), 5);
        // what it still sends is acknowledged, and not kept
        says(tcp, bufs, inbox, 23, 104, "4500002f11110000400655b60a0000010a000002a0280017fffffffbffffffff5018faf0b1b1000061626f75740d0a", "4500002800000000400666ce0a0000020a0000010017a028ffffffff0000000250100000fb900000");
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 100), 0);
        // its FIN: acknowledged, and the connection is over
        says(tcp, bufs, inbox, 23, 105, "4500002811110000400655bd0a0000010a000002a028001700000002ffffffff5011faf0009f0000", "4500002800000000400666ce0a0000020a0000010017a028ffffffff0000000350100000fb8f0000");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_what_was_written_goes_out_with_our_fin() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        let m = set(want, "6279650d0a");
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), m);
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), 0);
        flushes(tcp, bufs, 0, 102, "4500002d00000000400666c90a0000020a0000010017a028fffffffefffffffb501900002a0300006279650d0a");
    }
    return 0;
}

fn test_both_ends_may_finish_at_once() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        flushes(tcp, bufs, 0, 102, "4500002800000000400666ce0a0000020a0000010017a028fffffffefffffffb50110000fb960000");
        // its FIN left before ours arrived: acknowledged, and ours is still out
        says(tcp, bufs, inbox, 23, 103, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5011faf000a60000", "4500002800000000400666ce0a0000020a0000010017a028fffffffffffffffc50100000fb950000");
        test.assert_eq(inet.tcp_state(tcp, 0), 4);
        says(tcp, bufs, inbox, 23, 104, "4500002811110000400655bd0a0000010a000002a0280017fffffffcffffffff5010faf000a50000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_an_end_that_never_finishes_is_dropped_after_a_minute() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        says(tcp, bufs, inbox, 23, 100, "4500002c11110000400655b90a0000010a000002a0280017fffffffa000000006002faf0e8f80000020405b4", "4500002c00000000400666ca0a0000020a0000010017a028fffffffdfffffffb60120100e4c80000020403c6");
        says(tcp, bufs, inbox, 23, 101, "4500002811110000400655bd0a0000010a000002a0280017fffffffbfffffffe5010faf000a70000", "");
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        flushes(tcp, bufs, 0, 102, "4500002800000000400666ce0a0000020a0000010017a028fffffffefffffffb50110000fb960000");
        says(tcp, bufs, inbox, 23, 103, "4500002811110000400655bd0a0000010a000002a0280017fffffffbffffffff5010faf000a60000", "");
        test.assert_eq(inet.tcp_quiet(tcp, 0, 5103), 5000);
        ticks(tcp, bufs, 0, 60103, "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 1);
        ticks(tcp, bufs, 0, 60104, "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

// ── opening a connection ──
// To port 8000 of the other machine, from our port 50000.

fn dial[&t, &b, &i](tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte]) -> [] int {
    return inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 50000, 100, iss(), 0);
}

fn test_a_connection_is_opened_asked_and_answered() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        test.assert_eq(dial(tcp, bufs, inbox), 0);
        test.assert_eq(inet.tcp_state(tcp, 0), 6);
        flushes(tcp, bufs, 0, 100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        flushes(tcp, bufs, 0, 101, "");
        // nothing can be written before it is open
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, 4), 0);
        // no answer for a second: the SYN again
        ticks(tcp, bufs, 0, 1100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        says(tcp, bufs, inbox, 0, 1101, "4500002c33330000400633970a0000010a0000021f40c350fffffffafffffffe6012faf0a6980000020405b4", "4500002800000000400666ce0a0000020a000001c3501f40fffffffefffffffb50100100b8460000");
        test.assert_eq(inet.tcp_state(tcp, 0), 2);
        let m = set(want, "474554202f20485454502f312e300d0a0d0a");
        test.assert_eq(inet.tcp_write(tcp, bufs, 0, want, 0, m), m);
        flushes(tcp, bufs, 0, 1102, "4500003a00000000400666bc0a0000020a000001c3501f40fffffffefffffffb50180100d98c0000474554202f20485454502f312e300d0a0d0a");
        // the page, and the other end's FIN with it
        says(tcp, bufs, inbox, 0, 1103, "4500003e33330000400633850a0000010a0000021f40c350fffffffb000000105019faf08ae10000485454502f312e3020323030204f4b0d0a0d0a68690a", "4500002800000000400666ce0a0000020a000001c3501f40000000100000001250100000b91f0000");
        test.assert_eq(inet.tcp_state(tcp, 0), 3);
        let n = set(want, "485454502f312e3020323030204f4b0d0a0d0a68690a");
        test.assert_eq(inet.tcp_read(tcp, inbox, 0, got, 300), n);
        test.assert(same(got, want, n));
        test.assert_eq(inet.tcp_close(tcp, 0), 1);
        flushes(tcp, bufs, 0, 1104, "4500002800000000400666ce0a0000020a000001c3501f40000000100000001250110000b91e0000");
        says(tcp, bufs, inbox, 0, 1105, "45000028333300004006339b0a0000010a0000021f40c35000000012000000115010faf0be2d0000", "");
        test.assert_eq(inet.tcp_open(tcp, bufs, inbox), 0);
    }
    return 0;
}

fn test_a_reset_that_answers_our_syn_means_refused() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        test.assert_eq(dial(tcp, bufs, inbox), 0);
        // before the SYN has gone nothing can answer it
        says(tcp, bufs, inbox, 0, 100, "45000028333300004006339b0a0000010a0000021f40c35000000000fffffffe5014faf0be4d0000", "");
        test.assert_eq(inet.tcp_state(tcp, 0), 6);
        flushes(tcp, bufs, 0, 100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        // a reset for another number is not believed
        says(tcp, bufs, inbox, 0, 101, "45000028333300004006339b0a0000010a0000021f40c35000000000000000065014faf0be460000", "");
        test.assert_eq(inet.tcp_state(tcp, 0), 6);
        says(tcp, bufs, inbox, 0, 102, "45000028333300004006339b0a0000010a0000021f40c35000000000fffffffe5014faf0be4d0000", "");
        test.assert_eq(inet.tcp_state(tcp, 0), 0);
    }
    return 0;
}

fn test_an_answer_to_another_syn_is_reset_and_a_syn_alone_ignored() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        test.assert_eq(dial(tcp, bufs, inbox), 0);
        flushes(tcp, bufs, 0, 100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        says(tcp, bufs, inbox, 0, 101, "4500002c33330000400633970a0000010a0000021f40c350fffffffa000000066012faf0a6910000020405b4", "4500002800000000400666ce0a0000020a000001c3501f40000000060000000050040000b9470000");
        says(tcp, bufs, inbox, 0, 102, "4500002c33330000400633970a0000010a0000021f40c350fffffffa000000006002faf0a6a70000020405b4", "");
        test.assert_eq(inet.tcp_state(tcp, 0), 6);
        // and it is given up after five more tries: 1, 2, 4, 8, 16 s, then 32 more
        ticks(tcp, bufs, 0, 1100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        ticks(tcp, bufs, 0, 3100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        ticks(tcp, bufs, 0, 7100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        ticks(tcp, bufs, 0, 15100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        ticks(tcp, bufs, 0, 31100, "4500002c00000000400666ca0a0000020a000001c3501f40fffffffd0000000060020100a2830000020403c6");
        ticks(tcp, bufs, 0, 63100, "");
        test.assert_eq(inet.tcp_state(tcp, 0), 0);
    }
    return 0;
}

fn test_a_connection_is_not_opened_from_port_7_or_without_room() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let got = alloc_slice[a](300, byte_of(0));
        let want = alloc_slice[a](300, byte_of(0));
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 7, 100, iss(), 0), -1);
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 0, 50000, 100, iss(), 0), -1);
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 50000, 100, iss(), 0), 0);
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 50001, 100, iss(), 0), 1);
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 50002, 100, iss(), 0), 2);
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 50003, 100, iss(), 0), 3);
        test.assert_eq(inet.tcp_dial(tcp, bufs, inbox, peer(), 8000, 50004, 100, iss(), 0), -1);
    }
    return 0;
}

// ── in frames ──

fn test_a_connection_over_ethernet() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let frame = alloc_slice[a](128, byte_of(0));
        let want = alloc_slice[a](128, byte_of(0));
        let out = alloc_slice[a](128, byte_of(0));
        var n = set(frame, "5254001234565255c0a8000108004500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307");
        var m = set(want, "5255c0a8000152540012345608004500002c00000000400666ca0a0000020a00000100079c40fffffffdfffffffb601203c6e5fa0000020403c60000");
        // 58 bytes, padded to the 60 a frame must be
        test.assert_eq(m, 60);
        test.assert_eq(inet.eth_serve(frame, n, mac(), ours(), tcp, bufs, inbox, 0, 100, iss(), out), m);
        test.assert(same(out, want, m));
        n = set(frame, "5254001234565255c0a8000108004500002811110000400655bd0a0000010a0000029c400007fffffffbfffffffe5010faf0049f0000000000000000");
        test.assert_eq(inet.eth_serve(frame, n, mac(), ours(), tcp, bufs, inbox, 0, 101, iss(), out), 0);
        n = set(frame, "5254001234565255c0a8000108004500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a");
        m = set(want, "5255c0a8000152540012345608004500002e00000000400666c80a0000020a00000100079c40fffffffe00000001501803c0b7e0000068656c6c6f0a");
        test.assert_eq(inet.eth_serve(frame, n, mac(), ours(), tcp, bufs, inbox, 0, 102, iss(), out), m);
        test.assert(same(out, want, m));
        // sent again, it goes to the card the connection came from
        test.assert_eq(inet.eth_tick(tcp, bufs, 0, 1102, mac(), ours(), out), m);
        test.assert(same(out, want, m));
        test.assert_eq(inet.eth_tick(tcp, bufs, 0, 1103, mac(), ours(), out), 0);
    }
    return 0;
}

// ── speaking first ──

fn test_our_echo_request_is_the_one_a_second_implementation_builds() -> [] int {
    region a {
        let want = alloc_slice[a](128, byte_of(0));
        let out = alloc_slice[a](128, byte_of(0));
        let m = set(want, "4500003c00000000400166bf0a0000020a000001080039ecca0c0003303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f");
        test.assert_eq(inet.echo_request(out, 0, ours(), peer(), 51724, 3, 32), m);
        test.assert(same(out, want, m));
        test.assert_eq(inet.echo_request(out, 0, ours(), peer(), 51724, 3, 101), -1);
        let n = set(want, "5255c0a8000152540012345608004500003c00000000400166bf0a0000020a000001080039ecca0c0003303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f");
        test.assert_eq(inet.echo_request(out, 14, ours(), peer(), 51724, 3, 32), m);
        test.assert_eq(inet.eth_frame(out, m, 90528257933313, mac()), n);
        test.assert(same(out, want, n));
    }
    return 0;
}

fn test_only_the_reply_to_our_request_is_the_reply() -> [] int {
    region a {
        let pkt = alloc_slice[a](128, byte_of(0));
        var n = set(pkt, "4500003c222200004001449d0a0000010a000002000041ecca0c0003303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f");
        test.assert(inet.is_echo_reply(pkt, 0, n, ours(), peer(), 51724, 3));
        test.assert(!inet.is_echo_reply(pkt, 0, n, ours(), peer(), 51724, 4));
        test.assert(!inet.is_echo_reply(pkt, 0, n, ours(), peer(), 51725, 3));
        test.assert(!inet.is_echo_reply(pkt, 0, n, ours(), peer() + 1, 51724, 3));
        test.assert(!inet.is_echo_reply(pkt, 0, n - 1, ours(), peer(), 51724, 3));
        pkt[40] = byte_of(0);
        test.assert(!inet.is_echo_reply(pkt, 0, n, ours(), peer(), 51724, 3));
        n = set(pkt, "4500003c222200004001449d0a0000010a000002000041ebca0c0004303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f");
        test.assert(!inet.is_echo_reply(pkt, 0, n, ours(), peer(), 51724, 3));
        // our own request is not a reply to it
        n = set(pkt, "4500003c00000000400166bf0a0000020a000001080039ecca0c0003303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f");
        test.assert(!inet.is_echo_reply(pkt, 0, n, ours(), peer(), 51724, 3));
    }
    return 0;
}

fn test_who_has_is_asked_of_every_card_and_the_answer_is_read() -> [] int {
    region a {
        let want = alloc_slice[a](64, byte_of(0));
        let out = alloc_slice[a](64, byte_of(0));
        let m = set(want, "ffffffffffff525400123456080600010800060400015254001234560a0000020000000000000a000001000000000000000000000000000000000000");
        test.assert_eq(inet.arp_request(out, mac(), ours(), peer()), m);
        test.assert(same(out, want, m));
        let n = set(want, "5254001234565255c0a80001080600010800060400025255c0a800010a0000015254001234560a000002000000000000000000000000000000000000");
        test.assert_eq(inet.arp_answer_from(want, n, mac(), ours(), peer()), 90528257933313);
        // not the machine that was asked about; not an answer at all
        test.assert_eq(inet.arp_answer_from(want, n, mac(), ours(), peer() + 1), -1);
        test.assert_eq(inet.arp_answer_from(out, m, mac(), ours(), peer()), -1);
        test.assert_eq(inet.arp_answer_from(want, 41, mac(), ours(), peer()), -1);
    }
    return 0;
}

// ── nothing traps ──

// Every one-byte change of a data segment, cut at five lengths, given to a connection that is open: each is
// answered, taken in silence or dropped, and none traps. The connection is opened again each time, since a
// damaged segment may be a reset.
fn test_no_damage_to_a_segment_makes_serve_trap() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let syn = alloc_slice[a](64, byte_of(0));
        let pkt = alloc_slice[a](64, byte_of(0));
        let out = alloc_slice[a](1100, byte_of(0));
        let s = set(syn, "4500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307");
        let n = set(pkt, "4500002e11110000400655b70a0000010a0000029c400007fffffffbfffffffe5018faf0c0b4000068656c6c6f0a");
        var at = 0;
        var tried = 0;
        while at < n {
            let kept = pkt[at];
            var v = 0;
            while v < 256 {
                pkt[at] = byte_of(v);
                var cut = 6;
                while cut <= n {
                    var z = 0;
                    while z < 20 {
                        tcp[z] = 0;
                        z = z + 1;
                    }
                    inet.serve(syn, s, ours(), tcp, bufs, inbox, 0, 100, iss(), out);
                    tcp[0] = 2;
                    tcp[4] = tcp[5];
                    tcp[8] = 0;
                    let r = inet.serve(pkt, cut, ours(), tcp, bufs, inbox, 23, 101, iss(), out);
                    test.assert(r <= 1006 && r >= inet.drop_not_our_frame());
                    tried = tried + 1;
                    cut = cut + 10;
                }
                v = v + 1;
            }
            pkt[at] = kept;
            at = at + 1;
        }
        test.assert_eq(tried, 46 * 256 * 5);
    }
    return 0;
}

// The same of a SYN, whose options are read: every byte of them, and of the rest.
fn test_no_damage_to_a_syn_makes_serve_trap() -> [] int {
    region a {
        let tcp = alloc_slice[a](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[a](4 * inet.tcp_segment_max(), byte_of(0));
        let inbox = alloc_slice[a](4 * inet.tcp_inbox(), byte_of(0));
        let pkt = alloc_slice[a](64, byte_of(0));
        let out = alloc_slice[a](1100, byte_of(0));
        let n = set(pkt, "4500003011110000400655b50a0000010a0000029c400007fffffffa000000007002faf0d8e20000020405b401030307");
        var at = 0;
        var tried = 0;
        while at < n {
            let kept = pkt[at];
            var v = 0;
            while v < 256 {
                pkt[at] = byte_of(v);
                var z = 0;
                while z < 80 {
                    tcp[z] = 0;
                    z = z + 1;
                }
                let r = inet.serve(pkt, n, ours(), tcp, bufs, inbox, 0, 100, iss(), out);
                test.assert(r <= 1006 && r >= inet.drop_not_our_frame());
                tried = tried + 1;
                v = v + 1;
            }
            pkt[at] = kept;
            at = at + 1;
        }
        test.assert_eq(tried, 48 * 256);
    }
    return 0;
}
