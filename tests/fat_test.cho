import std.test;
import fat;

// `fat` with no disk under it. The sectors are real ones: from three volumes made by macOS's own tools
// (`hdiutil create -fs "MS-DOS FAT32"` and `FAT16`, one of them behind a partition table), with five files
// copied in by the system. What each sector must mean was read by a second implementation in another
// language (Python's `struct`), and is written here as numbers.

fn digit(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    return c - 'a' + 10;
}

fn set[&b, &s](buf: &!b [byte], hex: &s [byte]) -> [] int {
    var i = 0;
    while i * 2 + 1 < len(hex) {
        buf[i] = byte_of(digit(int_of(hex[i * 2])) * 16 + digit(int_of(hex[i * 2 + 1])));
        i = i + 1;
    }
    return i;
}

fn boot32() -> [] &static [byte] {
    return "";
}

fn boot16() -> [] &static [byte] {
    return "";
}

fn table32() -> [] &static [byte] {
    return "";
}

fn root32() -> [] &static [byte] {
    return "";
}

fn root16() -> [] &static [byte] {
    return "";
}

// ── where the volume is ──

fn test_a_disk_that_is_one_volume_starts_at_zero() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        set(s, boot32());
        test.assert_eq(fat.partition(s), 0);
        set(s, boot16());
        test.assert_eq(fat.partition(s), 0);
    }
    return 0;
}

fn test_a_partition_table_says_where_the_volume_starts() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        set(s, table32());
        test.assert_eq(fat.partition(s), 1);
        // a table with no FAT partition in it; and a sector that is neither
        s[446 + 4] = byte_of(131);
        test.assert_eq(fat.partition(s), -1);
        s[510] = byte_of(0);
        test.assert_eq(fat.partition(s), -1);
    }
    return 0;
}

// ── the volume's shape ──

fn test_a_fat32_volume_is_read_as_the_second_implementation_reads_it() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(s, boot32());
        test.assert_eq(fat.mount(s, 0, info), 0);
        test.assert_eq(info[0], 32);
        test.assert_eq(info[1], 1);
        test.assert_eq(info[2], 32);
        test.assert_eq(info[3], 1008);
        test.assert_eq(info[4], 2);
        test.assert_eq(info[5], 0);
        test.assert_eq(info[6], 2048);
        test.assert_eq(info[7], 129022);
        test.assert_eq(info[8], 0);
        test.assert_eq(info[9], 131070);
    }
    return 0;
}

fn test_a_fat16_volume_is_read_as_the_second_implementation_reads_it() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(s, boot16());
        test.assert_eq(fat.mount(s, 0, info), 0);
        test.assert_eq(info[0], 16);
        test.assert_eq(info[1], 4);
        test.assert_eq(info[2], 1);
        test.assert_eq(info[3], 32);
        test.assert_eq(info[4], 65);
        test.assert_eq(info[5], 32);
        test.assert_eq(info[6], 97);
        test.assert_eq(info[7], 8167);
        test.assert_eq(info[8], 0);
        test.assert_eq(info[9], 32768);
    }
    return 0;
}

fn test_a_volume_behind_a_partition_table_is_counted_from_its_start() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(s, boot32());
        test.assert_eq(fat.mount(s, 1, info), 0);
        test.assert_eq(info[0], 32);
        test.assert_eq(info[1], 1);
        test.assert_eq(info[2], 33);
        test.assert_eq(info[3], 1008);
        test.assert_eq(info[4], 2);
        test.assert_eq(info[5], 0);
        test.assert_eq(info[6], 2049);
        test.assert_eq(info[7], 129022);
        test.assert_eq(info[8], 1);
        test.assert_eq(info[9], 131070);
    }
    return 0;
}

fn test_what_is_not_a_volume_this_reads_is_refused_and_says_why() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        test.assert_eq(fat.mount(s, 0, info), fat.not_a_volume());
        set(s, boot16());
        // sectors of 1024 bytes
        s[12] = byte_of(4);
        test.assert_eq(fat.mount(s, 0, info), fat.not_512());
        set(s, boot16());
        // few enough sectors that it would be FAT12: 4000 in all
        s[19] = byte_of(160);
        s[20] = byte_of(15);
        test.assert_eq(fat.mount(s, 0, info), fat.fat12());
        set(s, boot16());
        // a cluster of three sectors is no volume's
        s[13] = byte_of(3);
        test.assert_eq(fat.mount(s, 0, info), fat.not_a_volume());
    }
    return 0;
}

// ── directories ──

// Entry `i` of `sector` is a file with this name, first cluster and length.
fn is_file[&s, &m](sector: &s [byte], i: int, name: &m [byte], cluster: int, size: int) -> [] int {
    region a {
        let got = alloc_slice[a](12, byte_of(0));
        let out = alloc_slice[a](3, 0);
        test.assert_eq(fat.entry(sector, i, got, out), fat.entry_file());
        test.assert(fat.named(got, out[0], name, 0, len(name)));
        test.assert_eq(out[0], len(name));
        test.assert_eq(out[1], cluster);
        test.assert_eq(out[2], size);
    }
    return 0;
}

fn test_the_files_macos_wrote_are_the_files_read() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let got = alloc_slice[a](12, byte_of(0));
        let out = alloc_slice[a](3, 0);
        set(s, root32());
        // entry 0 is the volume's label; the pieces of long names are skipped too
        test.assert_eq(fat.entry(s, 0, got, out), fat.entry_skip());
        is_file(s, 1, "HELLO.TXT", 11, 32);
        is_file(s, 4, "BIG.BIN", 28, 300000);
        is_file(s, 7, "EMPTY.TXT", 0, 0);
        is_file(s, 10, "EXACT.BIN", 646, 4096);
        // a file with a long name is seen under its short one
        is_file(s, 15, "A-LONG~9.TEX", 670, 32);
        test.assert_eq(fat.entry(s, 2, got, out), fat.entry_skip());
        set(s, root16());
        is_file(s, 4, "BIG.BIN", 9, 300000);
        // out of the sector; and a sector of zeros is the end of a directory
        test.assert_eq(fat.entry(s, 16, got, out), fat.entry_end());
        test.assert_eq(fat.entry(s, -1, got, out), fat.entry_end());
        var z = 0;
        while z < 512 {
            s[z] = byte_of(0);
            z = z + 1;
        }
        test.assert_eq(fat.entry(s, 0, got, out), fat.entry_end());
    }
    return 0;
}

fn test_a_name_is_the_same_in_either_case_and_no_other() -> [] int {
    test.assert(fat.named("KERNEL8.IMG", 11, "kernel8.img", 0, 11));
    test.assert(fat.named("KERNEL8.IMG", 11, "cat Kernel8.Img", 4, 15));
    test.assert(!fat.named("KERNEL8.IMG", 11, "kernel8.im", 0, 10));
    test.assert(!fat.named("KERNEL8.IMG", 11, "kernel9.img", 0, 11));
    test.assert(!fat.named("KERNEL8.IMG", 12, "kernel8.img", 0, 11));
    test.assert(!fat.named("KERNEL8.IMG", 11, "kernel8.img", 0, 12));
    return 0;
}

// ── clusters ──

fn test_a_file_is_followed_cluster_by_cluster_to_its_end() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(s, boot32());
        fat.mount(s, 0, info);
        // BIG.BIN starts at cluster 28: where that is, and where its entry in the table is
        test.assert_eq(fat.cluster_sector(info, 28), 2074);
        test.assert_eq(fat.fat_sector(info, 28), 32);
        set(s, "");
        test.assert_eq(fat.next(info, s, 28), 29);
        // its 586 clusters end at 613
        set(s, "");
        test.assert_eq(fat.next(info, s, 613), fat.chain_end());
        // no such cluster: before the first, and after the last
        test.assert_eq(fat.cluster_sector(info, 1), -1);
        test.assert_eq(fat.cluster_sector(info, info[7] + 2), -1);
        test.assert_eq(fat.cluster_sector(info, info[7] + 1), info[6] + (info[7] - 1) * info[1]);
        test.assert_eq(fat.fat_sector(info, 0), -1);
        test.assert_eq(fat.next(info, s, 0), fat.chain_broken());
        set(s, boot16());
        fat.mount(s, 0, info);
        test.assert_eq(fat.cluster_sector(info, 9), 125);
        test.assert_eq(fat.fat_sector(info, 9), 1);
        set(s, "");
        test.assert_eq(fat.next(info, s, 9), 10);
        test.assert_eq(fat.next(info, s, 155), fat.chain_end());
        // an entry that says "free" or "bad" breaks a chain
        s[9 * 2] = byte_of(0);
        s[9 * 2 + 1] = byte_of(0);
        test.assert_eq(fat.next(info, s, 9), fat.chain_broken());
        s[9 * 2] = byte_of(247);
        s[9 * 2 + 1] = byte_of(255);
        test.assert_eq(fat.next(info, s, 9), fat.chain_broken());
    }
    return 0;
}

// ── nothing traps ──

fn test_no_damage_to_a_first_sector_makes_mount_or_partition_trap() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(s, boot16());
        var at = 0;
        var tried = 0;
        // every value of every byte of the part that describes the volume, and of the two that end it
        while at < 512 {
            let kept = s[at];
            var v = 0;
            while v < 256 {
                s[at] = byte_of(v);
                let m = fat.mount(s, 3, info);
                test.assert(m <= 0 && m >= fat.fat12());
                let p = fat.partition(s);
                test.assert(p >= -1);
                tried = tried + 1;
                v = v + 1;
            }
            s[at] = kept;
            at = at + 1;
            if at == 64 {
                at = 446;
            }
        }
        test.assert_eq(tried, (64 + 66) * 256);
    }
    return 0;
}

fn test_no_damage_to_a_directory_or_a_table_makes_reading_trap() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let b = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        let got = alloc_slice[a](12, byte_of(0));
        let out = alloc_slice[a](3, 0);
        set(b, boot32());
        fat.mount(b, 0, info);
        set(s, root32());
        var at = 0;
        var tried = 0;
        // the first three entries, every byte, every value: each of the sixteen is still read
        while at < 96 {
            let kept = s[at];
            var v = 0;
            while v < 256 {
                s[at] = byte_of(v);
                var i = 0;
                while i < 16 {
                    let kind = fat.entry(s, i, got, out);
                    test.assert(kind >= 0 && kind <= 3);
                    if kind >= 2 {
                        test.assert(out[0] >= 0 && out[0] <= 12);
                    }
                    i = i + 1;
                }
                // and the same bytes read as a sector of the table
                let n = fat.next(info, s, 2 + at / 4);
                test.assert(n >= fat.chain_broken() && n < info[7] + 2);
                tried = tried + 1;
                v = v + 1;
            }
            s[at] = kept;
            at = at + 1;
        }
        test.assert_eq(tried, 96 * 256);
    }
    return 0;
}

// ── writing: the bytes of a sector, changed ──

fn test_the_two_facts_writing_needs_are_read_too() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(s, boot32());
        fat.mount(s, 0, info);
        // two copies of the table; FAT32's summary in sector 1
        test.assert_eq(info[10], 2);
        test.assert_eq(info[11], 1);
        fat.mount(s, 1, info);
        test.assert_eq(info[11], 2);
        set(s, boot16());
        fat.mount(s, 0, info);
        test.assert_eq(info[10], 2);
        test.assert_eq(info[11], 0);
    }
    return 0;
}

fn test_an_entry_made_here_is_the_entry_macos_made() -> [] int {
    region a {
        let theirs = alloc_slice[a](512, byte_of(0));
        let ours = alloc_slice[a](512, byte_of(0));
        let got = alloc_slice[a](12, byte_of(0));
        let out = alloc_slice[a](3, 0);
        set(theirs, root32());
        // the same file, written small: the name, the kind, the first cluster and the length are theirs
        test.assert_eq(fat.put_entry(ours, 1, "hello.txt", 0, 9, 11, 32), 0);
        var k = 0;
        while k < 12 {
            test.assert_eq(int_of(ours[32 + k]), int_of(theirs[32 + k]));
            k = k + 1;
        }
        test.assert_eq(int_of(ours[32 + 20]), int_of(theirs[32 + 20]));
        test.assert_eq(int_of(ours[32 + 21]), int_of(theirs[32 + 21]));
        k = 26;
        while k < 32 {
            test.assert_eq(int_of(ours[32 + k]), int_of(theirs[32 + k]));
            k = k + 1;
        }
        // and it reads back, here
        test.assert_eq(fat.entry(ours, 1, got, out), fat.entry_file());
        test.assert(fat.named(got, out[0], "HELLO.TXT", 0, 9));
        test.assert_eq(out[1], 11);
        test.assert_eq(out[2], 32);
        // a first cluster past 65535 is in two halves; a name with no dot
        test.assert_eq(fat.put_entry(ours, 15, "KERNEL8", 0, 7, 70000, 300000), 0);
        test.assert_eq(fat.entry(ours, 15, got, out), fat.entry_file());
        test.assert(fat.named(got, out[0], "kernel8", 0, 7));
        test.assert_eq(out[1], 70000);
        test.assert_eq(out[2], 300000);
        test.assert_eq(fat.set_extent(ours, 15, 12, 77), 0);
        fat.entry(ours, 15, got, out);
        test.assert_eq(out[1], 12);
        test.assert_eq(out[2], 77);
    }
    return 0;
}

// `name` is refused, and the sector is as it was.
fn refused[&m](name: &m [byte]) -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(7));
        test.assert_eq(fat.put_entry(s, 3, name, 0, len(name), 5, 5), -1);
        var k = 0;
        while k < 512 {
            test.assert_eq(int_of(s[k]), 7);
            k = k + 1;
        }
    }
    return 0;
}

fn test_what_is_not_a_short_name_is_not_written() -> [] int {
    refused("toolongname.txt");
    refused("a.long");
    refused("a b.txt");
    refused("a..b");
    refused(".txt");
    refused("a.");
    refused("a/b");
    refused("a*b");
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        test.assert_eq(fat.put_entry(s, 0, "x", 0, 0, 5, 5), -1);
        test.assert_eq(fat.put_entry(s, 16, "x", 0, 1, 5, 5), -1);
        test.assert_eq(fat.put_entry(s, 0, "x", 0, 1, -1, 5), -1);
        test.assert_eq(fat.put_entry(s, 0, "A-1_~!#.B$%", 0, 11, 2, 0), 0);
    }
    return 0;
}

fn test_a_place_for_a_new_entry_is_one_never_used_or_one_deleted() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        test.assert_eq(fat.free_slot(s), 0);
        set(s, root32());
        // macOS filled all sixteen of this sector
        test.assert_eq(fat.free_slot(s), -1);
        s[5 * 32] = byte_of(229);
        test.assert_eq(fat.free_slot(s), 5);
    }
    return 0;
}

fn test_a_free_cluster_is_found_and_chained() -> [] int {
    region a {
        let b = alloc_slice[a](512, byte_of(0));
        let s = alloc_slice[a](512, byte_of(0));
        let info = alloc_slice[a](fat.facts(), 0);
        set(b, boot16());
        fat.mount(b, 0, info);
        test.assert_eq(fat.per_sector(info), 256);
        set(s, "");
        // the first free cluster of this sector of the table, as the second implementation finds it
        test.assert_eq(fat.free_cluster(info, s, 0, 0), 2);
        test.assert_eq(fat.free_cluster(info, s, 0, 2 % 256 + 1), 2 + 1);
        test.assert_eq(fat.free_cluster(info, s, info[3], 0), -1);
        // made the last of a file, then made to be followed by the next: read back with `next`
        test.assert_eq(fat.set_next(info, s, 2, -1), 0);
        test.assert_eq(fat.next(info, s, 2), fat.chain_end());
        test.assert_eq(fat.free_cluster(info, s, 0, 0), 2 + 1);
        test.assert_eq(fat.set_next(info, s, 2, 2 + 1), 0);
        test.assert_eq(fat.next(info, s, 2), 2 + 1);
        test.assert_eq(fat.set_next(info, s, 1, -1), -1);
        test.assert_eq(fat.set_next(info, s, 2, 1), -1);
        set(b, boot32());
        fat.mount(b, 0, info);
        test.assert_eq(fat.per_sector(info), 128);
        set(s, "");
        test.assert_eq(fat.free_cluster(info, s, 4, 0), 622);
        // the top four bits of a FAT32 entry are not ours to change
        s[622 * 4 % 512 + 3] = byte_of(160);
        test.assert_eq(fat.set_next(info, s, 622, -1), 0);
        test.assert_eq(int_of(s[622 * 4 % 512 + 3]), 175);
        test.assert_eq(fat.next(info, s, 622), fat.chain_end());
        test.assert_eq(fat.set_next(info, s, 622, 70000), 0);
        test.assert_eq(fat.next(info, s, 622), 70000);
        test.assert_eq(int_of(s[622 * 4 % 512 + 3]) / 16, 10);
    }
    return 0;
}

fn test_fat32s_count_of_free_clusters_is_made_unknown() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        set(s, "");
        test.assert_eq(fat.summary_unknown(s), 0);
        var k = 488;
        while k < 496 {
            test.assert_eq(int_of(s[k]), 255);
            k = k + 1;
        }
        // any other sector is left alone
        set(s, boot32());
        test.assert_eq(fat.summary_unknown(s), -1);
        test.assert_eq(fat.summary_less(s, 3), -1);
        // a count that is one goes down by what was taken; "unknown" stays unknown
        set(s, "");
        s[488] = byte_of(16);
        s[489] = byte_of(39);
        s[490] = byte_of(2);
        s[491] = byte_of(0);
        test.assert_eq(fat.summary_less(s, 600), 0);
        test.assert_eq(int_of(s[488]) + int_of(s[489]) * 256 + int_of(s[490]) * 65536, 141072 - 600);
        test.assert_eq(fat.summary_unknown(s), 0);
        test.assert_eq(fat.summary_less(s, 600), 0);
        test.assert_eq(int_of(s[488]), 255);
    }
    return 0;
}

fn test_no_name_makes_put_entry_trap() -> [] int {
    region a {
        let s = alloc_slice[a](512, byte_of(0));
        let name = alloc_slice[a](12, byte_of(65));
        var at = 0;
        var tried = 0;
        while at < 12 {
            var v = 0;
            while v < 256 {
                name[at] = byte_of(v);
                var n = 0;
                while n <= 12 {
                    let r = fat.put_entry(s, at, name, 0, n, at, v);
                    test.assert(r == 0 || r == -1);
                    tried = tried + 1;
                    n = n + 1;
                }
                v = v + 1;
            }
            name[at] = byte_of(65);
            at = at + 1;
        }
        test.assert_eq(tried, 12 * 256 * 13);
    }
    return 0;
}
