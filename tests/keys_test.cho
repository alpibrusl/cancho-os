import std.test;
import keys;

// `keys` with no disk under it. The three keys are made by `ssh-keygen -t ed25519` for these tests and are
// nobody's; the 32 bytes each must give were taken from its line by a second implementation (Python's
// `base64`).

fn digit(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    return c - 'a' + 10;
}

// Are the 32 bytes at `key[at..]` the ones `hex` writes?
fn is_key[&k, &h](key: &k [byte], at: int, hex: &h [byte]) -> [] bool {
    var i = 0;
    while i < 32 {
        if int_of(key[at + i]) != digit(int_of(hex[i * 2])) * 16 + digit(int_of(hex[i * 2 + 1])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn first() -> [] &static [byte] {
    return "6316363dec1724abaf20928d9be7d1dbe945fd128beba78c036565df3baa1129";
}

fn second() -> [] &static [byte] {
    return "9f48c5f3633364a752f401f8859a274c8b4e4ab49a8cc13dd80631277c189d05";
}

fn third() -> [] &static [byte] {
    return "9cca26d89c8a42125df71ccff98cee79e0140e78684d6314a8af0d388eb9ed53";
}

// What `keys.line` makes of the whole of `text`.
fn role_of[&t](text: &t [byte]) -> [] int {
    var role = 0;
    region a {
        let key = alloc_slice[a](32, byte_of(0));
        role = keys.line(text, 0, len(text), key);
    }
    return role;
}

fn test_a_line_is_a_role_and_the_key_ssh_keygen_wrote() -> [] int {
    region a {
        let key = alloc_slice[a](32, byte_of(0));
        let l = "owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp cancho-os test key";
        test.assert_eq(keys.line(l, 0, len(l), key), keys.owner());
        test.assert(is_key(key, 0, first()));
        let m = "  reader ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ9IxfNjM2SnUvQB+IWaJ0yLTkq0mozBPdgGMSd8GJ0F";
        test.assert_eq(keys.line(m, 0, len(m), key), keys.reader());
        test.assert(is_key(key, 0, second()));
    }
    return 0;
}

fn test_what_is_not_a_key_is_not_one() -> [] int {
    // nothing to say: empty, blank, a comment
    test.assert_eq(role_of(""), 0);
    test.assert_eq(role_of("   "), 0);
    test.assert_eq(role_of("# the people who may log in"), 0);
    // no role, a role nobody has, another kind of key
    test.assert_eq(role_of("ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp"), -1);
    test.assert_eq(role_of("admin ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp"), -1);
    test.assert_eq(role_of("owner ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC7"), -1);
    // one character short; one that is not base64; the right length saying another kind inside
    test.assert_eq(role_of("owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhE"), -1);
    test.assert_eq(role_of("owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si*unjANlZd87qhEp"), -1);
    test.assert_eq(role_of("owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE4AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp"), -1);
    // more key than a key has
    test.assert_eq(role_of("owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEpAAAA"), -1);
    return 0;
}

fn test_a_file_is_read_line_by_line_after_the_keys_already_there() -> [] int {
    region a {
        let table = alloc_slice[a](4 * 32, byte_of(0));
        let roles = alloc_slice[a](4, 0);
        let skipped = alloc_slice[a](1, 0);
        // one key is there already (the one built into the image): it stays
        table[0] = byte_of(77);
        roles[0] = keys.owner();
        let file = "# who may log in\nreader ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ9IxfNjM2SnUvQB+IWaJ0yLTkq0mozBPdgGMSd8GJ0F a reader\r\n\nnot a key at all\nowner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJzKJticikISXfccz/mM7nngFA54aE1jFKivDTiOue1T\n";
        test.assert_eq(keys.load(file, len(file), table, roles, 1, skipped), 3);
        test.assert_eq(skipped[0], 1);
        test.assert_eq(int_of(table[0]), 77);
        test.assert_eq(roles[0], keys.owner());
        test.assert(is_key(table, 32, second()));
        test.assert_eq(roles[1], keys.reader());
        test.assert(is_key(table, 64, third()));
        test.assert_eq(roles[2], keys.owner());
        // the last line needs no line feed; and a table that is full takes no more
        let more = "owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp\nreader ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ9IxfNjM2SnUvQB+IWaJ0yLTkq0mozBPdgGMSd8GJ0F";
        test.assert_eq(keys.load(more, len(more), table, roles, 3, skipped), 4);
        test.assert_eq(skipped[0], 1);
        test.assert(is_key(table, 96, first()));
    }
    return 0;
}

fn test_no_damage_to_a_line_makes_it_trap() -> [] int {
    region a {
        let l = alloc_slice[a](100, byte_of(0));
        let key = alloc_slice[a](32, byte_of(0));
        let table = alloc_slice[a](64, byte_of(0));
        let roles = alloc_slice[a](2, 0);
        let skipped = alloc_slice[a](1, 0);
        let good = "owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp x\n";
        var i = 0;
        while i < len(good) {
            l[i] = good[i];
            i = i + 1;
        }
        let n = len(good);
        var at = 0;
        var tried = 0;
        while at < n {
            let kept = l[at];
            var v = 0;
            while v < 256 {
                l[at] = byte_of(v);
                var cut = 0;
                while cut <= n {
                    let r = keys.line(l, 0, cut, key);
                    test.assert(r >= -1 && r <= 3);
                    cut = cut + 11;
                }
                let c = keys.load(l, n, table, roles, 0, skipped);
                test.assert(c >= 0 && c <= 2);
                tried = tried + 1;
                v = v + 1;
            }
            l[at] = kept;
            at = at + 1;
        }
        test.assert_eq(tried, n * 256);
    }
    return 0;
}

// ---- grants --------------------------------------------------------------------------------------

fn agent_file() -> [] &static [byte] {
    return "owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp a person\nagent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ9IxfNjM2SnUvQB+IWaJ0yLTkq0mozBPdgGMSd8GJ0F read:/DOCS write:work/out/ the builder, since tuesday write:/\r\nagent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ9IxfNjM2SnUvQB+IWaJ0yLTkq0mozBPdgGMSd8GJ0F read:LOGS\n";
}

// The key of line `which` (0 the owner's, 1 the agent's) of `agent_file`, into `key`.
fn key_of[&k](which: int, key: &!k [byte]) -> [] int {
    let f = agent_file();
    var from = 0;
    var seen = 0;
    while from < len(f) {
        var to = from;
        while to < len(f) && int_of(f[to]) != 10 && int_of(f[to]) != 13 {
            to = to + 1;
        }
        if seen == which {
            return keys.line(f, from, to, key);
        }
        seen = seen + 1;
        from = to + 1;
    }
    return -1;
}

fn test_an_agents_line_grants_what_its_words_say_and_no_more() -> [] int {
    region a {
        let key = alloc_slice[a](32, byte_of(0));
        let gr = alloc_slice[a](keys.grant_room(), 0);
        let f = agent_file();
        test.assert_eq(key_of(1, key), keys.agent());
        // two words of the first line and one of the second; `write:/` after the words for people is not a grant
        test.assert_eq(keys.grants_for(f, len(f), key, gr, 0), 3);
        test.assert(keys.covers(gr, 1, "DOCS"));
        test.assert(keys.covers(gr, 1, "docs/a/b.txt"));
        test.assert(keys.covers(gr, 1, "/DOCS/"));
        test.assert(keys.covers(gr, 1, "LOGS/x"));
        // writing is under WORK/OUT only, and reading comes with it
        test.assert(keys.covers(gr, 2, "WORK/OUT/result.txt"));
        test.assert(keys.covers(gr, 1, "work/out/result.txt"));
        test.assert(!keys.covers(gr, 2, "DOCS/a.txt"));
        test.assert(!keys.covers(gr, 2, "WORK/other.txt"));
        test.assert(!keys.covers(gr, 2, "WORK"));
        // a name that only begins like a granted one is another name
        test.assert(!keys.covers(gr, 1, "DOCS2/a.txt"));
        test.assert(!keys.covers(gr, 1, "DOC"));
        test.assert(!keys.covers(gr, 2, "WORK/OUTSIDE/a.txt"));
        // nothing else: the top of the disk, the kernel's own names
        test.assert(!keys.covers(gr, 1, ""));
        test.assert(!keys.covers(gr, 1, "KEYS.TXT"));
        test.assert(!keys.covers(gr, 1, "OLD/00000001.V"));
        // the directories above what is granted may be passed through, and nothing beside them
        test.assert(keys.reaches(gr, ""));
        test.assert(keys.reaches(gr, "WORK"));
        test.assert(keys.reaches(gr, "work/"));
        test.assert(!keys.reaches(gr, "WORK/OUT"));
        test.assert(!keys.reaches(gr, "WOR"));
        test.assert(!keys.reaches(gr, "OLD"));
    }
    return 0;
}

fn test_a_key_with_no_agents_line_is_granted_nothing() -> [] int {
    region a {
        let key = alloc_slice[a](32, byte_of(0));
        let gr = alloc_slice[a](keys.grant_room(), 0);
        let f = agent_file();
        // the owner's key: it is not an agent's, and no line grants it anything
        test.assert_eq(key_of(0, key), keys.owner());
        test.assert_eq(keys.grants_for(f, len(f), key, gr, 0), 0);
        test.assert(!keys.covers(gr, 1, "DOCS"));
        test.assert(!keys.covers(gr, 1, ""));
        test.assert(!keys.reaches(gr, ""));
        // the whole disk is granted by `/`, and then everything is covered
        let all = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:/";
        test.assert_eq(keys.grants_for(all, len(all), key, gr, 0), 1);
        test.assert(keys.covers(gr, 1, ""));
        test.assert(keys.covers(gr, 1, "ANY/THING"));
        test.assert(!keys.covers(gr, 2, "ANY/THING"));
        // words that are not grants grant nothing: a path with `..`, a hidden part, an empty part, nothing at all
        let bad = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp write:A/../B";
        test.assert_eq(keys.grants_for(bad, len(bad), key, gr, 0), 0);
        let dot = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:.x";
        test.assert_eq(keys.grants_for(dot, len(dot), key, gr, 0), 0);
        let gap = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:A//B";
        test.assert_eq(keys.grants_for(gap, len(gap), key, gr, 0), 0);
        let none = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:";
        test.assert_eq(keys.grants_for(none, len(none), key, gr, 0), 0);
        // five words: the four there is room for
        let many = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:A read:B read:C read:D write:E";
        test.assert_eq(keys.grants_for(many, len(many), key, gr, 0), 4);
        test.assert(!keys.covers(gr, 1, "E"));
    }
    return 0;
}

fn test_no_bytes_make_reading_grants_trap() -> [] int {
    region a {
        let key = alloc_slice[a](32, byte_of(0));
        let gr = alloc_slice[a](keys.grant_room(), 0);
        let good = agent_file();
        let l = alloc_slice[a](len(good), byte_of(0));
        var i = 0;
        while i < len(good) {
            l[i] = good[i];
            i = i + 1;
        }
        key_of(1, key);
        var at = 0;
        var tried = 0;
        while at < len(good) {
            let kept = l[at];
            var v = 0;
            while v < 256 {
                l[at] = byte_of(v);
                let c = keys.grants_for(l, len(good), key, gr, 0);
                test.assert(c >= 0 && c <= 4);
                keys.covers(gr, 2, l[at..len(good)]);
                keys.reaches(gr, l[0..at]);
                tried = tried + 1;
                v = v + 37;
            }
            l[at] = kept;
            at = at + 1;
        }
        test.assert(tried > 1000);
        // and grants that are not well made: lengths no path has
        gr[0] = 9;
        gr[2] = 0 - 5;
        gr[66] = 4000;
        test.assert(!keys.covers(gr, 1, "A"));
        keys.reaches(gr, "A");
    }
    return 0;
}

fn test_a_grant_that_ends_on_a_day_holds_through_it_and_not_after() -> [] int {
    region a {
        let key = alloc_slice[a](32, byte_of(0));
        let gr = alloc_slice[a](keys.grant_room(), 0);
        key_of(0, key);
        let l = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:DOCS write:WORK until:2026-11-30 the builder";
        // 2026-11-30 23:59:59 UTC is 1796083199 (Python's calendar.timegm)
        test.assert_eq(keys.grants_for(l, len(l), key, gr, 1795790412), 2);
        test.assert(keys.covers(gr, 2, "WORK/a"));
        test.assert_eq(keys.grants_for(l, len(l), key, gr, 1796083199), 2);
        test.assert_eq(keys.grants_for(l, len(l), key, gr, 1796083200), 0);
        test.assert(!keys.covers(gr, 1, "DOCS/a"));
        // a board that has not been told the date takes what ends on a day to have ended
        test.assert_eq(keys.grants_for(l, len(l), key, gr, 0), 0);
        // a word that begins `until:` and is not a day ends the line's grants: it does not make them last
        let slip = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:DOCS until:2026-13-01";
        test.assert_eq(keys.grants_for(slip, len(slip), key, gr, 1795790412), 0);
        let slip2 = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:DOCS until:tomorrow";
        test.assert_eq(keys.grants_for(slip2, len(slip2), key, gr, 1795790412), 0);
        let slip3 = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:DOCS until:2026-06-31";
        test.assert_eq(keys.grants_for(slip3, len(slip3), key, gr, 1795790412), 0);
        // a line that ends takes back only its own grants: another line of the same key still holds
        let two = "agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp read:KEPT\nagent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGMWNj3sFySrryCSjZvn0dvpRf0Si+unjANlZd87qhEp write:GONE until:2020-01-01\n";
        test.assert_eq(keys.grants_for(two, len(two), key, gr, 1795790412), 1);
        test.assert(keys.covers(gr, 1, "KEPT/x"));
        test.assert(!keys.covers(gr, 1, "GONE/x"));
    }
    return 0;
}
