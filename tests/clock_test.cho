import std.test;
import clock;

// `clock` with no network under it. The dates are what Python's `time.gmtime` makes of the same seconds, and the
// answer is a packet laid out as RFC 4330 lays one out.

fn date[&w](unix: int, y: int, mo: int, d: int, h: int, mi: int, s: int, fd: int, ft: int, want: &w [byte]) -> [] bool {
    var ok = true;
    region r {
        let f = alloc_slice[r](6, 0);
        let t = alloc_slice[r](19, byte_of(0));
        clock.fields(unix, f);
        ok = f[0] == y && f[1] == mo && f[2] == d && f[3] == h && f[4] == mi && f[5] == s;
        ok = ok && clock.fat_date(unix) == fd && clock.fat_time(unix) == ft;
        ok = ok && clock.text(unix, t) == 19;
        var i = 0;
        while i < 19 {
            ok = ok && int_of(t[i]) == int_of(want[i]);
            i = i + 1;
        }
    }
    return ok;
}

fn test_seconds_become_the_date_another_implementation_gives() -> [] int {
    test.assert(date(0, 1970, 1, 1, 0, 0, 0, 33, 0, "1970-01-01 00:00:00"));
    test.assert(date(86399, 1970, 1, 1, 23, 59, 59, 33, 0, "1970-01-01 23:59:59"));
    test.assert(date(951782400, 2000, 2, 29, 0, 0, 0, 10333, 0, "2000-02-29 00:00:00"));
    test.assert(date(951868799, 2000, 2, 29, 23, 59, 59, 10333, 49021, "2000-02-29 23:59:59"));
    test.assert(date(1709208058, 2024, 2, 29, 12, 0, 58, 22621, 24605, "2024-02-29 12:00:58"));
    test.assert(date(1795790412, 2026, 11, 27, 14, 40, 12, 23931, 29958, "2026-11-27 14:40:12"));
    test.assert(date(4102444799, 2099, 12, 31, 23, 59, 59, 61343, 49021, "2099-12-31 23:59:59"));
    test.assert(date(1700000000, 2023, 11, 14, 22, 13, 20, 22382, 45482, "2023-11-14 22:13:20"));
    test.assert(date(2147483648, 2038, 1, 19, 3, 14, 8, 29747, 6596, "2038-01-19 03:14:08"));
    test.assert(date(4354819199, 2107, 12, 31, 23, 59, 59, 65439, 49021, "2107-12-31 23:59:59"));
    return 0;
}

// An answer to the question with `stamp`, saying `secs` seconds since 1900, into `m`.
fn reply[&m](m: &!m [byte], stamp: int, secs: int, first: int, stratum: int) -> [] int {
    var i = 0;
    while i < 48 {
        m[i] = byte_of(0);
        i = i + 1;
    }
    m[0] = byte_of(first);
    m[1] = byte_of(stratum);
    i = 0;
    while i < 8 {
        m[24 + i] = byte_of(stamp >> (56 - i * 8) & 255);
        i = i + 1;
    }
    m[40] = byte_of(secs >> 24 & 255);
    m[41] = byte_of(secs >> 16 & 255);
    m[42] = byte_of(secs >> 8 & 255);
    m[43] = byte_of(secs & 255);
    return 48;
}

fn test_an_answer_is_read_only_if_it_is_one_to_our_question() -> [] int {
    region a {
        let q = alloc_slice[a](48, byte_of(7));
        let m = alloc_slice[a](64, byte_of(0));
        let stamp = 0x1122334455667788;
        test.assert_eq(clock.question(q, stamp), 48);
        test.assert_eq(int_of(q[0]), 0x23);
        test.assert_eq(int_of(q[1]), 0);
        test.assert_eq(int_of(q[40]), 0x11);
        test.assert_eq(int_of(q[47]), 0x88);
        // 2026-11-27 14:40:12 is 1795790412 seconds after 1970 and 4004779212 after 1900
        reply(m, stamp, 4004779212, 0x24, 2);
        test.assert_eq(clock.answer(m, 0, 48, stamp), 1795790412);
        // another question's answer; a client's packet; a server that does not have the time; a short one
        test.assert_eq(clock.answer(m, 0, 48, stamp + 1), 0 - 1);
        reply(m, stamp, 4004779212, 0x23, 2);
        test.assert_eq(clock.answer(m, 0, 48, stamp), 0 - 1);
        reply(m, stamp, 4004779212, 0x24, 0);
        test.assert_eq(clock.answer(m, 0, 48, stamp), 0 - 1);
        reply(m, stamp, 4004779212, 0x24, 16);
        test.assert_eq(clock.answer(m, 0, 48, stamp), 0 - 1);
        reply(m, stamp, 4004779212, 0x24, 2);
        test.assert_eq(clock.answer(m, 0, 47, stamp), 0 - 1);
        test.assert_eq(clock.answer(m, 20, 48, stamp), 0 - 1);
        // a moment before this was written is not believed
        reply(m, stamp, 2208988800 + 1600000000, 0x24, 2);
        test.assert_eq(clock.answer(m, 0, 48, stamp), 0 - 1);
        // after 2036 the count of seconds starts again: 1000 then is 2036-02-07 06:44:56
        reply(m, stamp, 1000, 0x24, 1);
        test.assert_eq(clock.answer(m, 0, 48, stamp), 4294967296 + 1000 - 2208988800);
    }
    return 0;
}

fn test_no_bytes_make_reading_an_answer_trap() -> [] int {
    region a {
        let m = alloc_slice[a](60, byte_of(0));
        let f = alloc_slice[a](6, 0);
        let t = alloc_slice[a](19, byte_of(0));
        var v = 0;
        var tried = 0;
        while v < 256 {
            var i = 0;
            while i < 60 {
                m[i] = byte_of(v + i * 37 & 255);
                i = i + 1;
            }
            var n = 0;
            while n < 62 {
                let r = clock.answer(m, v % 13, n, v);
                test.assert(r >= 0 - 1);
                n = n + 7;
                tried = tried + 1;
            }
            v = v + 1;
        }
        test.assert(tried > 2000);
        // and no count of seconds makes a date trap
        clock.fields(0 - 5, f);
        test.assert_eq(f[0], 1970);
        clock.fields(253402300799, f);
        test.assert_eq(f[0], 9999);
        test.assert_eq(clock.fat_date(253402300799), 33);
        test.assert_eq(clock.text(1, t[0..10]), 0);
        test.assert_eq(clock.digits(1795790412, t), 10);
        test.assert_eq(int_of(t[0]), 49);
        test.assert_eq(int_of(t[9]), 50);
    }
    return 0;
}

fn test_a_day_is_the_seconds_another_implementation_counts() -> [] int {
    // Python's calendar.timegm of the first second of each day
    test.assert_eq(clock.day_start(1970, 1, 1), 0);
    test.assert_eq(clock.day_start(2000, 2, 29), 951782400);
    test.assert_eq(clock.day_start(2026, 11, 30), 1795996800);
    test.assert_eq(clock.day_start(2100, 3, 1), 4107542400);
    test.assert_eq(clock.day_start(9999, 12, 31), 253402214400);
    // days no month has, and years outside what is counted
    test.assert_eq(clock.day_start(2026, 2, 29), 0 - 1);
    test.assert_eq(clock.day_start(2026, 6, 31), 0 - 1);
    test.assert_eq(clock.day_start(2100, 2, 29), 0 - 1);
    test.assert_eq(clock.day_start(2026, 13, 1), 0 - 1);
    test.assert_eq(clock.day_start(2026, 0, 1), 0 - 1);
    test.assert_eq(clock.day_start(1969, 12, 31), 0 - 1);
    return 0;
}
