edition 14;

import feetech;
import calibration;
import kinematics;
import safety;

// cancho-os: the kernel. Every driver here is cancho. A register is reached through
// an `Mmio`, a capability whose type names the addresses it holds: `main` is given
// every address, cuts it into the pieces below, and each function is lent the pieces
// it needs, so its signature says which hardware it can touch and the compiler holds
// it to that (cancho docs/mmio.md). A system register, `wfi` and the TLB flush are
// reached through the `Cpu` capability, and a row names each one (cancho docs/cpu.md).
// The kernel calls no foreign code: `cancho authority` lists the addresses, the
// registers and the instructions, and says the program is bounded.
//   con    the console: the PL011 of a Pi 3 or a Pi 4
//   pins   the one register that routes GPIO14/15 to it
//   irq    the interrupt controller: the Pi 3's per-core block, the Pi 4's GIC-400
//   bus    the servo bus: the mini UART
//   tab    the eight translation tables (board/link.ld puts them at 2 MB)
//   code   the kernel's own image, to read the instruction a fault stopped at
//   probe  one byte of page 0 and one of the code, for `crash null` and `crash write`
//   fault  the word where board/boot.S notes the vector of a fault (-1: none)
// The link's two addresses the kernel needs (the end of the code and of the constants)
// are the words at 0x80010 and 0x80018 of the image, read through `code`.
// The kernel's state is one slice of ints, lent to whoever needs it (cancho has no
// mutable globals, and does not need them here):
//   k[0] UART base          k[1] board: 3 or 4 (0: not recognised)
//   k[2] GIC CPU interface  k[3] GIC distributor (both 0 on the Pi 3)
//   k[4] counter units per tick   k[5] ticks so far
//   k[6] translation tables used  k[7] peripheral window start   k[8] its end
//   k[9] servo bus UART base
// The system registers, by the numbers board_sys_read/board_sys_write take:
//   0 cntfrq_el0  1 cntvct_el0  2 cntv_ctl_el0  3 cntv_cval_el0  4 cntv_tval_el0
//   5 mair_el1    6 tcr_el1     7 ttbr0_el1     8 sctlr_el1      9 midr_el1

// ---- which board ------------------------------------------------------------
// One image for every board: the CPU says which one this is.
fn detect[&f, &s](cpu: &!f Cpu, k: &!s [int]) -> [cpu("midr_el1")] int {
    let part = cpu_read(cpu, "midr_el1") >> 4 & 0xfff;
    if part == 0xd03 {
        // Cortex-A53: Raspberry Pi 3 (BCM2837), and QEMU raspi3b
        k[1] = 3;
        k[0] = 0x3f201000;
        k[9] = 0x3f215000;
        k[7] = 0x3f000000;
        k[8] = 0x40200000;
    } else if part == 0xd08 {
        // Cortex-A72: Raspberry Pi 4 (BCM2711)
        k[1] = 4;
        k[0] = 0xfe201000;
        k[9] = 0xfe215000;
        k[2] = 0xff842000;
        k[3] = 0xff841000;
        k[7] = 0xfc000000;
        k[8] = 0x100000000;
    }
    return k[1];
}

// ---- UART (PL011) -----------------------------------------------------------
fn uart_init[&mc, &mp, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), pins: &!mp Mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), k: &!s [int]) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008")] int {
    let uart = k[0];
    let gpio = uart - 0x1000;
    mmio_write32(con, uart + 0x30, 0);
    // GPFSEL1: GPIO14/15 to ALT0 (TXD0/RXD0)
    let sel = mmio_read32(pins, gpio + 4) & ~(7 << 12 | 7 << 15);
    mmio_write32(pins, gpio + 4, sel | 4 << 12 | 4 << 15);
    mmio_write32(con, uart + 0x44, 0x7ff);
    // 115200 baud from a 48 MHz UART clock; 8N1, FIFOs on; enable, TX, RX
    mmio_write32(con, uart + 0x24, 26);
    mmio_write32(con, uart + 0x28, 3);
    mmio_write32(con, uart + 0x2c, 3 << 5 | 1 << 4);
    return mmio_write32(con, uart + 0x30, 1 | 1 << 8 | 1 << 9);
}

fn putc[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], c: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    let uart = k[0];
    while mmio_read32(con, uart + 0x18) & 32 != 0 {
    }
    return mmio_write32(con, uart, c);
}

fn puts[&mc, &s, &r](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], s: &r [byte]) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    var i = 0;
    while i < len(s) {
        putc(con, k, int_of(s[i]));
        i = i + 1;
    }
    return 0;
}

fn put_dec[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if v >= 10 {
        put_dec(con, k, v / 10);
    }
    return putc(con, k, 48 + v % 10);
}

fn put_digit[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], d: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if d < 10 {
        return putc(con, k, 48 + d);
    }
    return putc(con, k, 87 + d);
}

fn put_hex[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if v >= 16 {
        put_hex(con, k, v >> 4);
    }
    return put_digit(con, k, v & 15);
}

// All sixteen digits, for a register.
fn put_reg[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    puts(con, k, "0x");
    var shift = 60;
    while shift >= 0 {
        put_digit(con, k, v >> shift & 15);
        shift = shift - 4;
    }
    return 0;
}

// ---- time: the ARM generic timer, polled -------------------------------------
// Interrupts stay masked in the CPU. The timer still raises its line through the
// board's interrupt controller, which is what wakes `wfi`; the kernel then asks
// the controller what happened. No handler runs behind cancho's back, so there
// is no state shared with one.
fn tick_start[&f, &mi, &s](cpu: &!f Cpu, irq: &!mi Mmio("0x40000040..0x40000064,0xff841000..0xff842014"), k: &!s [int], hz: int) -> [cpu("cntfrq_el0"), cpu("cntv_ctl_el0"), cpu("cntv_tval_el0"), mmio("0x40000040..0x40000064,0xff841000..0xff842014")] int {
    k[4] = cpu_read(cpu, "cntfrq_el0") / hz;
    if k[1] == 4 {
        // GIC-400: virtual timer is private interrupt 27
        let gicd = k[3];
        mmio_write32(irq, gicd, 0);
        let prio = mmio_read32(irq, gicd + 0x400 + 24) & 0xffffff;
        mmio_write32(irq, gicd + 0x400 + 24, prio | 0xa0 << 24);
        mmio_write32(irq, gicd + 0x100, 1 << 27);
        mmio_write32(irq, gicd, 1);
        mmio_write32(irq, k[2] + 4, 0xff);
        mmio_write32(irq, k[2], 1);
    } else {
        // BCM2836 per-core block: route the virtual timer to core 0
        mmio_write32(irq, 0x40000040, 8);
    }
    cpu_write(cpu, "cntv_tval_el0", k[4]);
    return cpu_write(cpu, "cntv_ctl_el0", 1);
}

fn tick[&f, &s](cpu: &!f Cpu, k: &!s [int]) -> [cpu("cntv_cval_el0")] int {
    // from the last deadline, not from now: no drift
    cpu_write(cpu, "cntv_cval_el0", cpu_read(cpu, "cntv_cval_el0") + k[4]);
    k[5] = k[5] + 1;
    return 0;
}

// What the interrupt controller has pending, handled here and now.
fn poll[&f, &mi, &s](cpu: &!f Cpu, irq: &!mi Mmio("0x40000040..0x40000064,0xff841000..0xff842014"), k: &!s [int]) -> [cpu("cntv_cval_el0"), mmio("0x40000040..0x40000064,0xff841000..0xff842014")] int {
    if k[4] == 0 {
        return 0;
    }
    if k[1] == 4 {
        let iar = mmio_read32(irq, k[2] + 0xc);
        let id = iar & 0x3ff;
        if id == 27 {
            tick(cpu, k);
        }
        if id < 1020 {
            mmio_write32(irq, k[2] + 0x10, iar);
        }
    } else if mmio_read32(irq, 0x40000060) & 8 != 0 {
        tick(cpu, k);
    }
    return 0;
}

fn uptime_ms[&f](cpu: &!f Cpu) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let f = cpu_read(cpu, "cntfrq_el0");
    let c = cpu_read(cpu, "cntvct_el0");
    return c / f * 1000 + c % f * 1000 / f;
}

// Sleep until a key arrives, handling whatever else wakes the core meanwhile.
fn getc[&f, &mc, &mi, &s](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), irq: &!mi Mmio("0x40000040..0x40000064,0xff841000..0xff842014"), k: &!s [int]) -> [cpu("cntv_cval_el0"), cpu("wfi"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x40000040..0x40000064,0xff841000..0xff842014")] int {
    let uart = k[0];
    while mmio_read32(con, uart + 0x18) & 16 != 0 {
        if k[4] != 0 {
            cpu_do(cpu, "wfi");
        }
        poll(cpu, irq, k);
    }
    return mmio_read32(con, uart) & 255;
}

fn now_us[&f](cpu: &!f Cpu) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let f = cpu_read(cpu, "cntfrq_el0");
    let c = cpu_read(cpu, "cntvct_el0");
    return c / f * 1000000 + c % f * 1000000 / f;
}

// ---- the servo bus --------------------------------------------------------------
// The arm's servos (Feetech STS) share one serial line. On the emulated boards it is
// the second UART, the BCM283x "mini UART"; a Pi 5 will use a PL011 behind RP1, so
// these four functions are the part that is rewritten for it, and nothing above them is.
// Register offsets: 0x04 enables, 0x40 data, 0x44 interrupt enable, 0x48 FIFO control,
// 0x4c line control, 0x54 line status (bit 0 a byte is waiting, bit 5 room to send),
// 0x60 control, 0x68 baud.
fn bus_init[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    mmio_write32(bus, u + 4, 1);
    mmio_write32(bus, u + 0x60, 0);
    mmio_write32(bus, u + 0x44, 0);
    mmio_write32(bus, u + 0x4c, 3);
    mmio_write32(bus, u + 0x48, 0xc6);
    // 1 Mbaud from a 500 MHz core clock would be 61.5: not exact, and the emulator ignores
    // it. The real bus is the Pi 5 driver's problem.
    mmio_write32(bus, u + 0x68, 61);
    return mmio_write32(bus, u + 0x60, 3);
}

fn bus_put[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], c: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    while mmio_read32(bus, u + 0x54) & 32 == 0 {
    }
    return mmio_write32(bus, u + 0x40, c);
}

// The next byte, or -1 when none is waiting.
fn bus_get[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    if mmio_read32(bus, u + 0x54) & 1 == 0 {
        return -1;
    }
    return mmio_read32(bus, u + 0x40) & 255;
}

// What `transact` answers besides what `feetech.decode` does.
fn bus_timeout() -> [] int {
    return -90;
}

fn bus_overflow() -> [] int {
    return -91;
}

// Send `pkt[0..n]` and collect the status packet of servo `id` into `reply`, for at most
// `timeout_us`. Bytes already waiting are dropped first: a late answer to an earlier
// request must not be read as this one's. Answers what `feetech.decode` answers (the end
// of the packet, with `table` filled, or one of its errors), or `bus_timeout`/`bus_overflow`.
// The same shape as cancho-robot's `serial.transact`, on our own driver.
fn transact[&f, &mu, &s, &p, &r, &t](cpu: &!f Cpu, bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], pkt: &p [byte], n: int, reply: &!r [byte], id: int, table: &!t [int], timeout_us: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    while bus_get(bus, k) >= 0 {
    }
    var i = 0;
    while i < n {
        bus_put(bus, k, int_of(pkt[i]));
        i = i + 1;
    }
    let start = now_us(cpu);
    var got = 0;
    var result = feetech.need_more();
    while result == feetech.need_more() {
        let c = bus_get(bus, k);
        if c >= 0 {
            if got >= len(reply) {
                result = bus_overflow();
            } else {
                reply[got] = byte_of(c);
                got = got + 1;
                result = feetech.decode(reply[0..got], id, table);
            }
        } else if now_us(cpu) - start > timeout_us {
            result = bus_timeout();
        }
    }
    return result;
}

fn put_bus_error[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], code: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if code == bus_timeout() {
        return puts(con, k, "no answer");
    }
    if code == bus_overflow() {
        return puts(con, k, "answer too long");
    }
    return puts(con, k, feetech.error_tag(code));
}

// `servo scan`: ping ids 1 to 8 and say who answered. Read-only: this kernel builds no
// packet that can move a servo (src/feetech.cho has none).
fn servo_scan[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var found = 0;
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var id = 1;
        while id <= 8 {
            let n = feetech.ping(pkt, id);
            let got = transact(cpu, bus, k, pkt, n, reply, id, table, 20000);
            puts(con, k, "servo ");
            put_dec(con, k, id);
            if got > 0 {
                puts(con, k, ": present\r\n");
                found = found + 1;
            } else {
                puts(con, k, ": ");
                put_bus_error(con, k, got);
                puts(con, k, "\r\n");
            }
            id = id + 1;
        }
    }
    put_dec(con, k, found);
    return puts(con, k, " servos found\r\n");
}

// `servo pos`: the present position (register 56, two bytes) of servos 1 to 6, in raw ticks.
fn servo_pos[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var id = 1;
        while id <= 6 {
            let n = feetech.read(pkt, id, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, id, table, 20000);
            puts(con, k, "servo ");
            put_dec(con, k, id);
            if got > 0 && table[3] == 2 {
                puts(con, k, ": position ");
                put_dec(con, k, feetech.u16(reply, table[2]));
                puts(con, k, "\r\n");
            } else {
                puts(con, k, ": ");
                put_bus_error(con, k, got);
                puts(con, k, "\r\n");
            }
            id = id + 1;
        }
    }
    return 0;
}

// ---- the arm: ticks to degrees to where the gripper is ----------------------------
// Calibration and kinematics are cancho-robot's, unchanged (src/calibration.cho,
// src/kinematics.cho, src/so101.cho): there they are held to LeRobot and to placo. What
// is checked here is that they compute the same with no system under them.
//
// The span of each joint, in ticks: the left arm's calibration in cancho-robot
// (tests/fixtures/calibration/xle_left.json). A table in the kernel for now; it belongs
// to the robot, and will come with whatever hands the kernel its bus.
fn span_min(joint: int) -> [] int {
    if joint == 0 {
        return 884;
    }
    if joint == 1 {
        return 1056;
    }
    if joint == 2 {
        return 885;
    }
    if joint == 3 {
        return 2060;
    }
    return 0;
}

fn span_max(joint: int) -> [] int {
    if joint == 0 {
        return 3460;
    }
    if joint == 1 {
        return 3116;
    }
    if joint == 2 {
        return 3057;
    }
    if joint == 3 {
        return 3773;
    }
    return 4095;
}

fn put_int[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if v < 0 {
        putc(con, k, 45);
        return put_dec(con, k, 0 - v);
    }
    return put_dec(con, k, v);
}

// Where the gripper frame is for five joint angles, in micrometres, in the base's frame.
fn put_gripper[&mc, &s, &d](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], degrees: &d [float]) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    region r {
        let pose = alloc_slice[r](16, 0.0);
        if kinematics.forward(degrees, pose) != 0 {
            return puts(con, k, "kinematics refused the angles\r\n");
        }
        puts(con, k, "gripper at x ");
        put_int(con, k, truncate(pose[3] * 1000000.0));
        puts(con, k, " y ");
        put_int(con, k, truncate(pose[7] * 1000000.0));
        puts(con, k, " z ");
        put_int(con, k, truncate(pose[11] * 1000000.0));
    }
    return puts(con, k, " um\r\n");
}

// `arm zero`: the pose with every joint at zero. No bus involved: placo puts it at
// x 0.3913614702201581, y -9.212063114501261e-06, z 0.2264697102403328 metres.
fn arm_zero[&mc, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int]) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    region r {
        let degrees = alloc_slice[r](5, 0.0);
        put_gripper(con, k, degrees);
    }
    return 0;
}

// `arm pose`: read joints 1 to 5 from the bus, turn ticks into degrees, and say where
// that puts the gripper. Read-only.
fn arm_pose[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        let degrees = alloc_slice[r](5, 0.0);
        var joint = 0;
        var bad = 0;
        while joint < 5 && bad == 0 {
            let n = feetech.read(pkt, joint + 1, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, joint + 1, table, 20000);
            if got > 0 && table[3] == 2 {
                degrees[joint] = calibration.degrees(feetech.u16(reply, table[2]), span_min(joint), span_max(joint));
                puts(con, k, "joint ");
                put_dec(con, k, joint + 1);
                puts(con, k, ": ");
                put_int(con, k, truncate(degrees[joint] * 1000.0));
                puts(con, k, " mdeg\r\n");
            } else {
                puts(con, k, "joint ");
                put_dec(con, k, joint + 1);
                puts(con, k, ": ");
                put_bus_error(con, k, got);
                puts(con, k, "\r\n");
                bad = 1;
            }
            joint = joint + 1;
        }
        if bad == 0 {
            put_gripper(con, k, degrees);
        }
    }
    return 0;
}

// ---- the safety core, judging -----------------------------------------------------
// `arm check a1 a2 a3 a4 a5`: would the safety core let the arm go to these five angles
// (whole degrees) from where it is now? cancho-robot's `safety.approve`, unchanged, on the
// pose read from the bus: joint limits from the calibration spans, the workspace in the
// arm's own frame, the jump bound, the capsule collisions (tower and tray; the other arm
// is taken as absent), then the speed clamp for a 10 ms cycle. It answers and sends
// nothing: the kernel still holds no packet that moves a servo.

// Up to `len(out)` whole numbers, each possibly negative, from `line[from..n]`, separated
// by spaces. How many were read; -1 for anything that is not one.
fn numbers[&r, &o](line: &r [byte], from: int, n: int, out: &!o [int]) -> [] int {
    var i = from;
    var count = 0;
    var bad = false;
    while i < n && !bad {
        if int_of(line[i]) == 32 {
            i = i + 1;
        } else {
            var negative = false;
            if int_of(line[i]) == 45 {
                negative = true;
                i = i + 1;
            }
            var digits = 0;
            var v = 0;
            while i < n && int_of(line[i]) >= 48 && int_of(line[i]) <= 57 && digits < 6 {
                v = v * 10 + int_of(line[i]) - 48;
                digits = digits + 1;
                i = i + 1;
            }
            if digits == 0 || count >= len(out) || i < n && int_of(line[i]) != 32 {
                bad = true;
            } else {
                if negative {
                    v = 0 - v;
                }
                out[count] = v;
                count = count + 1;
            }
        }
    }
    if bad {
        return -1;
    }
    return count;
}

// Joints 1 to 5 from the bus, in degrees. 0, or the bus error (and which joint in `at`).
fn read_joints[&f, &mu, &s, &d, &a](cpu: &!f Cpu, bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], degrees: &!d [float], at: &!a [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var result = 0;
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var joint = 0;
        while joint < 5 && result == 0 {
            let n = feetech.read(pkt, joint + 1, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, joint + 1, table, 20000);
            if got > 0 && table[3] == 2 {
                degrees[joint] = calibration.degrees(feetech.u16(reply, table[2]), span_min(joint), span_max(joint));
            } else {
                at[0] = joint;
                result = got;
                if got >= 0 {
                    result = feetech.error_bad_length();
                }
            }
            joint = joint + 1;
        }
    }
    return result;
}

fn arm_check[&f, &mc, &mu, &s, &l](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], line: &l [byte], from: int, n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let wanted = alloc_slice[r](5, 0);
        if numbers(line, from, n, wanted) != 5 {
            return puts(con, k, "usage: arm check a1 a2 a3 a4 a5 (whole degrees)\r\n");
        }
        let current = alloc_slice[r](5, 0.0);
        let at = alloc_slice[r](1, 0);
        let read = read_joints(cpu, bus, k, current, at);
        if read != 0 {
            puts(con, k, "joint ");
            put_dec(con, k, at[0] + 1);
            puts(con, k, ": ");
            put_bus_error(con, k, read);
            return puts(con, k, "\r\n");
        }
        let request = alloc_slice[r](5, 0.0);
        let limits = alloc_slice[r](10, 0.0);
        var j = 0;
        while j < 5 {
            request[j] = float_of(wanted[j]);
            limits[j * 2] = calibration.degrees(span_min(j), span_min(j), span_max(j));
            limits[j * 2 + 1] = calibration.degrees(span_max(j), span_min(j), span_max(j));
            j = j + 1;
        }
        let goals = alloc_slice[r](5, 0.0);
        let scale = alloc_slice[r](1, 0.0);
        let joint = alloc_slice[r](1, 0);
        let other = alloc_slice[r](0, 0.0);
        // the left arm's mount on the robot (cancho-robot tests/safety_driver.cho)
        let mount = safety.Mount { x: -0.135, y: 0.133, z: 0.76, yaw_deg: 0.0 };
        var rule = 0;
        borrow mount as &m in {
            rule = safety.approve(request, current, limits, m, other, 0, 10, goals, scale, joint);
        }
        if rule == safety.rule_ok() {
            puts(con, k, "approved");
            if scale[0] < 1.0 {
                puts(con, k, ", slowed to ");
                put_int(con, k, truncate(scale[0] * 1000.0));
                puts(con, k, " per mille of the step");
            }
            puts(con, k, "\r\ngoals:");
            j = 0;
            while j < 5 {
                puts(con, k, " ");
                put_int(con, k, truncate(goals[j] * 1000.0));
                j = j + 1;
            }
            puts(con, k, " mdeg\r\n");
        } else {
            puts(con, k, "refused: ");
            puts(con, k, safety.rule_name(rule));
            if joint[0] >= 0 {
                puts(con, k, " (joint ");
                put_dec(con, k, joint[0] + 1);
                puts(con, k, ")");
            }
            puts(con, k, "\r\n");
        }
    }
    return puts(con, k, "nothing was sent\r\n");
}

// ---- memory: identity-mapped translation tables ---------------------------------
// 4 KB granule, 39-bit addresses, so level 1 is the top table. A descriptor is the
// address, the attributes below, and bit 0 (valid); bit 1 says "table" at levels 1
// and 2, and "page" at level 3.
// perm: 0 read+execute, 1 read-only, 2 read+write, 3 device (read+write, uncached)
fn attrs(perm: int) -> [] int {
    let af = 1 << 10;
    let inner = 3 << 8;
    let ro = 1 << 7;
    let pxn = 1 << 53;
    let uxn = 1 << 54;
    if perm == 0 {
        return af | inner | ro | uxn;
    }
    if perm == 1 {
        return af | inner | ro | pxn | uxn;
    }
    if perm == 2 {
        return af | inner | pxn | uxn;
    }
    // memory attribute 1 (device)
    return af | pxn | uxn | 4;
}

// The table a descriptor slot points to, made if the slot is empty. 0: none left,
// or the slot already maps a block.
fn next_table[&mt, &s](tab: &!mt Mmio("0x200000..0x208000"), k: &!s [int], slot: int) -> [mmio("0x200000..0x208000")] int {
    let d = mmio_read64(tab, slot);
    if d & 1 != 0 {
        if d & 2 == 0 {
            return 0;
        }
        return d & 0xfffffffff000;
    }
    if k[6] >= 8 {
        return 0;
    }
    let table = 0x200000 + k[6] * 4096;
    k[6] = k[6] + 1;
    mmio_write64(tab, slot, table | 3);
    return table;
}

// Identity-map [start, end) with one permission: 1 GB and 2 MB blocks where the
// range allows, 4 KB pages elsewhere. 0, or 1 when it cannot be done.
fn map[&mt, &s](tab: &!mt Mmio("0x200000..0x208000"), k: &!s [int], start: int, end: int, perm: int) -> [mmio("0x200000..0x208000")] int {
    if (start | end) & 0xfff != 0 || start > end || end > 1 << 39 {
        return 1;
    }
    let a = attrs(perm);
    let top = 0x200000;
    var va = start;
    var bad = 0;
    while va < end && bad == 0 {
        let l1 = top + (va >> 30) * 8;
        if va & 0x3fffffff == 0 && end - va >= 1 << 30 && mmio_read64(tab, l1) & 1 == 0 {
            mmio_write64(tab, l1, va | a | 1);
            va = va + (1 << 30);
        } else {
            let l2t = next_table(tab, k, l1);
            if l2t == 0 {
                bad = 1;
            } else {
                let l2 = l2t + (va >> 21 & 511) * 8;
                if va & 0x1fffff == 0 && end - va >= 1 << 21 && mmio_read64(tab, l2) & 1 == 0 {
                    mmio_write64(tab, l2, va | a | 1);
                    va = va + (1 << 21);
                } else {
                    let l3t = next_table(tab, k, l2);
                    if l3t == 0 {
                        bad = 1;
                    } else {
                        mmio_write64(tab, l3t + (va >> 12 & 511) * 8, va | a | 3);
                        va = va + 4096;
                    }
                }
            }
        }
    }
    return bad;
}

// One line of the memory map: map the range (when `apply`) or print it.
fn range[&mc, &mt, &s, &r](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), tab: &!mt Mmio("0x200000..0x208000"), k: &!s [int], apply: bool, name: &r [byte], start: int, end: int, perm: int) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x200000..0x208000")] int {
    if apply {
        return map(tab, k, start, end, perm);
    }
    puts(con, k, "  0x");
    put_hex(con, k, start);
    puts(con, k, " - 0x");
    put_hex(con, k, end);
    if perm == 0 {
        puts(con, k, "  r-x  ");
    } else if perm == 1 {
        puts(con, k, "  r--  ");
    } else if perm == 2 {
        puts(con, k, "  rw-  ");
    } else {
        puts(con, k, "  rw- device  ");
    }
    puts(con, k, name);
    puts(con, k, "\r\n");
    return 0;
}

// The whole address space the kernel may touch. Everything else, page 0 included,
// is unmapped: a null dereference is a fault, not a read of whatever is there.
fn memory_map[&mc, &mt, &mx, &s](con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), tab: &!mt Mmio("0x200000..0x208000"), code: &mx Mmio("0x80001..0x200000"), k: &!s [int], apply: bool) -> [mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x200000..0x208000"), mmio("0x80001..0x200000")] int {
    let image = 0x80000;
    let code_end = mmio_read64(code, 0x80010);
    let const_end = mmio_read64(code, 0x80018);
    var bad = range(con, tab, k, apply, "stack", 4096, image, 2);
    bad = bad + range(con, tab, k, apply, "kernel code", image, code_end, 0);
    bad = bad + range(con, tab, k, apply, "kernel constants", code_end, const_end, 1);
    // the first 960 MB: present on every board, below the GPU's share
    bad = bad + range(con, tab, k, apply, "kernel data and heap", const_end, 0x3c000000, 2);
    bad = bad + range(con, tab, k, apply, "peripherals", k[7], k[8], 3);
    return bad;
}

// Translation and the caches on. From here an access outside the map is a fault,
// and so is a write to code or constants, or a jump into data (WXN).
fn mmu_on[&f](cpu: &!f Cpu) -> [cpu("mair_el1"), cpu("sctlr_el1"), cpu("tcr_el1"), cpu("tlbi_vmalle1"), cpu("ttbr0_el1")] int {
    // attribute 0: normal memory, write-back; attribute 1: device
    cpu_write(cpu, "mair_el1", 0xff | 4 << 8);
    // 39-bit addresses; cacheable, inner-shareable table walks; no upper half yet; 40-bit physical
    cpu_write(cpu, "tcr_el1", 25 | 1 << 8 | 1 << 10 | 3 << 12 | 1 << 23 | 2 << 32);
    cpu_write(cpu, "ttbr0_el1", 0x200000);
    cpu_do(cpu, "tlbi_vmalle1");
    // the bits that must be one, then MMU, data cache, instruction cache, WXN
    return cpu_write(cpu, "sctlr_el1", 0x30d00800 | 1 | 1 << 2 | 1 << 12 | 1 << 19);
}

// ---- faults -------------------------------------------------------------------
// board/boot.S records an exception and calls main again; this is what main does then.
fn report_fault[&f, &mc, &mx, &mq, &s](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), code: &mx Mmio("0x80001..0x200000"), fault: &mq Mmio("0x208000..0x208008"), k: &!s [int]) -> [cpu("elr_el1"), cpu("esr_el1"), cpu("far_el1"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x80001..0x200000"), mmio("0x208000..0x208008")] int {
    let kind = mmio_read64(fault, 0x208000);
    let esr = cpu_read(cpu, "esr_el1");
    let elr = cpu_read(cpu, "elr_el1");
    let class = esr >> 26 & 63;
    let sync = kind & 3 == 0;
    puts(con, k, "\r\n*** ");
    // (only an address inside the image is read: a jump into nowhere must not fault again here)
    var stopped_at = 0;
    if elr >= 0x80004 && elr < 0x200000 - 3 && elr & 3 == 0 {
        stopped_at = mmio_read32(code, elr);
    }
    if sync && class == 0 && stopped_at == 0xc11f {
        // cancho's own checks (bounds, overflow, ...) end in `udf #0xc11f`
        puts(con, k, "cancho trap");
    } else if sync && (class == 0x25 || class == 0x21) {
        if class == 0x25 {
            puts(con, k, "data abort: ");
        } else {
            puts(con, k, "instruction abort: ");
        }
        let why = esr >> 2 & 15;
        if why == 1 {
            puts(con, k, "address not mapped");
        } else if why == 3 && class == 0x25 && esr & 64 != 0 {
            puts(con, k, "write to read-only memory");
        } else if why == 3 {
            puts(con, k, "permission denied");
        } else {
            puts(con, k, "other");
        }
    } else if sync {
        puts(con, k, "synchronous exception");
    } else if kind & 3 == 1 {
        puts(con, k, "unexpected irq");
    } else if kind & 3 == 2 {
        puts(con, k, "unexpected fiq");
    } else {
        puts(con, k, "serror");
    }
    puts(con, k, " (vector ");
    put_dec(con, k, kind);
    puts(con, k, ")\r\n    esr ");
    put_reg(con, k, esr);
    puts(con, k, "\r\n    elr ");
    put_reg(con, k, elr);
    puts(con, k, "\r\n    far ");
    put_reg(con, k, cpu_read(cpu, "far_el1"));
    return puts(con, k, "\r\nhalted.\r\n");
}

// ---- shell --------------------------------------------------------------------
fn same[&r, &s](line: &r [byte], n: int, word: &s [byte]) -> [] bool {
    if n != len(word) {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(line[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn run[&f, &mc, &mu, &mt, &mx, &mz, &s, &r](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), tab: &!mt Mmio("0x200000..0x208000"), code: &mx Mmio("0x80001..0x200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001"), k: &!s [int], line: &r [byte], n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000"), mmio("0x80001..0x200000"), mmio("0x0..0x1,0x80000..0x80001")] int {
    if n == 0 {
        return 0;
    }
    if same(line, n, "help") {
        puts(con, k, "commands: help, about, echo <text>, uptime, ticks, mem, servo scan, servo pos, arm zero, arm pose, arm check <5 angles>, crash [null|write]\r\n");
    } else if same(line, n, "about") {
        puts(con, k, "cancho-os 0.0.9: a kernel written in cancho, no Linux underneath (Raspberry Pi ");
        put_dec(con, k, k[1]);
        puts(con, k, ")\r\n");
    } else if n > 5 && same(line, 5, "echo ") {
        var i = 5;
        while i < n {
            putc(con, k, int_of(line[i]));
            i = i + 1;
        }
        puts(con, k, "\r\n");
    } else if same(line, n, "uptime") {
        let ms = uptime_ms(cpu);
        put_dec(con, k, ms / 1000);
        puts(con, k, ".");
        put_dec(con, k, ms % 1000 / 100);
        put_dec(con, k, ms % 100 / 10);
        put_dec(con, k, ms % 10);
        puts(con, k, " s\r\n");
    } else if same(line, n, "ticks") {
        put_dec(con, k, k[5]);
        puts(con, k, " timer interrupts\r\n");
    } else if same(line, n, "mem") {
        memory_map(con, tab, code, k, false);
    } else if same(line, n, "servo scan") {
        servo_scan(cpu, con, bus, k);
    } else if same(line, n, "servo pos") {
        servo_pos(cpu, con, bus, k);
    } else if same(line, n, "arm zero") {
        arm_zero(con, k);
    } else if same(line, n, "arm pose") {
        arm_pose(cpu, con, bus, k);
    } else if n > 10 && same(line, 10, "arm check ") {
        arm_check(cpu, con, bus, k, line, 10, n);
    } else if same(line, n, "crash null") {
        // page 0 is not mapped
        mmio_read8(probe, 0);
    } else if same(line, n, "crash write") {
        // the kernel's own code is mapped read+execute
        mmio_write8(probe, 0x80000, 0);
    } else if same(line, n, "crash") {
        // Read past the end of the line buffer: cancho's bounds check traps, and
        // the exception vector reports it instead of the machine hanging silently.
        putc(con, k, int_of(line[n + 4096]));
    } else {
        puts(con, k, "unknown command\r\n");
    }
    return 0;
}

fn shell[&f, &mc, &mi, &mu, &mt, &mx, &mz, &s](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), irq: &!mi Mmio("0x40000040..0x40000064,0xff841000..0xff842014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), tab: &!mt Mmio("0x200000..0x208000"), code: &mx Mmio("0x80001..0x200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntv_cval_el0"), cpu("cntvct_el0"), cpu("wfi"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x40000040..0x40000064,0xff841000..0xff842014"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000"), mmio("0x80001..0x200000"), mmio("0x0..0x1,0x80000..0x80001")] int {
    puts(con, k, "\r\ncancho-os booted. type `help`.\r\n");
    region r {
        let line = alloc_slice[r](128, byte_of(0));
        var n = 0;
        puts(con, k, "> ");
        while true {
            let c = getc(cpu, con, irq, k);
            if c == 13 || c == 10 {
                puts(con, k, "\r\n");
                run(cpu, con, bus, tab, code, probe, k, line, n);
                n = 0;
                puts(con, k, "> ");
            } else if (c == 127 || c == 8) && n > 0 {
                n = n - 1;
                putc(con, k, 8);
                putc(con, k, 32);
                putc(con, k, 8);
            } else if c >= 32 && c < 127 && n < 128 {
                line[n] = byte_of(c);
                n = n + 1;
                putc(con, k, c);
            }
        }
    }
    return 0;
}

fn kernel[&f, &mc, &mp, &mi, &mu, &mt, &mx, &mz, &mq](cpu: &!f Cpu, con: &!mc Mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), pins: &!mp Mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), irq: &!mi Mmio("0x40000040..0x40000064,0xff841000..0xff842014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), tab: &!mt Mmio("0x200000..0x208000"), code: &mx Mmio("0x80001..0x200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001"), fault: &mq Mmio("0x208000..0x208008")) -> [cpu("cntfrq_el0"), cpu("cntv_ctl_el0"), cpu("cntv_cval_el0"), cpu("cntv_tval_el0"), cpu("cntvct_el0"), cpu("elr_el1"), cpu("esr_el1"), cpu("far_el1"), cpu("mair_el1"), cpu("midr_el1"), cpu("sctlr_el1"), cpu("tcr_el1"), cpu("tlbi_vmalle1"), cpu("ttbr0_el1"), cpu("wfi"), mmio("0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), mmio("0x40000040..0x40000064,0xff841000..0xff842014"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000"), mmio("0x80001..0x200000"), mmio("0x0..0x1,0x80000..0x80001"), mmio("0x208000..0x208008")] int {
    region r {
        let k = alloc_slice[r](16, 0);
        if detect(cpu, k) == 0 {
            // a board this kernel has no addresses for: nothing can even be printed
            return 1;
        }
        if mmio_read64(fault, 0x208000) >= 0 {
            // entered again by the exception vector: say what happened, and stop
            return report_fault(cpu, con, code, fault, k);
        }
        uart_init(con, pins, k);
        // The tables start empty; table 0 of the pool is the top-level table.
        var slot = 0;
        while slot < 8 * 512 {
            mmio_write64(tab, 0x200000 + slot * 8, 0);
            slot = slot + 1;
        }
        k[6] = 1;
        if memory_map(con, tab, code, k, true) != 0 {
            puts(con, k, "\r\nmemory map refused; running without the MMU\r\n");
        } else {
            mmu_on(cpu);
        }
        tick_start(cpu, irq, k, 100);
        bus_init(bus, k);
        shell(cpu, con, irq, bus, tab, code, probe, k);
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker, mmio, cpu } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(out);
    release(ports);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    release(camera);
    release(mic);
    release(speaker);
    // Every address, cut into what each driver holds. No two share one.
    let (con, pins, irq, bus, tab, code, probe, fault) = narrow(mmio, "0x3f201000..0x3f201048,0xfe201000..0xfe201048", "0x3f200004..0x3f200008,0xfe200004..0xfe200008", "0x40000040..0x40000064,0xff841000..0xff842014", "0x3f215004..0x3f21506c,0xfe215004..0xfe21506c", "0x200000..0x208000", "0x80001..0x200000", "0x0..0x1,0x80000..0x80001", "0x208000..0x208008");
    var status = 0;
    borrow mut cpu as &!r in {
        borrow mut con as &!c in {
            borrow mut pins as &!p in {
                borrow mut irq as &!i in {
                    borrow mut bus as &!u in {
                        borrow mut tab as &!t in {
                            borrow code as &x in {
                                borrow mut probe as &!z in {
                                    borrow fault as &q in {
                                        status = kernel(r, c, p, i, u, t, x, z, q);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    release(cpu);
    release(con);
    release(pins);
    release(irq);
    release(bus);
    release(tab);
    release(code);
    release(probe);
    release(fault);
    return status;
}
