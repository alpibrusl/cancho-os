edition 14;

import feetech;
import calibration;
import kinematics;
import safety;
import inet;

// cancho-os: the kernel. Every driver here is cancho. A register is reached through
// an `Mmio`, a capability whose type names the addresses it holds: `main` is given
// every address, cuts it into the pieces below, and each function is lent the pieces
// it needs, so its signature says which hardware it can touch and the compiler holds
// it to that (cancho docs/mmio.md). A system register, `wfi` and the TLB flush are
// reached through the `Cpu` capability, and a row names each one (cancho docs/cpu.md).
// The kernel calls no foreign code: `cancho authority` lists the addresses, the
// registers and the instructions, and says the program is bounded.
//   con    the console: the PL011 of a Pi 3 or a Pi 4
//   pins   the one register that routes GPIO14/15 to it
//   irq    the interrupt controller: the Pi 3's per-core block, the Pi 4's GIC-400
//   bus    the second serial port, the mini UART: the servo bus, or the network link (`net up`)
//   tab    the eight translation tables (board/link.ld puts them at 2 MB)
//   code   the kernel's own image, to read the instruction a fault stopped at
//   probe  one byte of page 0 and one of the code, for `crash null` and `crash write`
//   fault  the word where board/boot.S notes the vector of a fault (-1: none)
//   vio    the virtio devices of QEMU's virt machine: the network card is one of them
//   dma    64 KB of memory a device reads and writes on its own: the card's queues and packets
// The link's two addresses the kernel needs (the end of the code and of the constants)
// are the words at 0x80010 and 0x80018 of the image, read through `code`.
// The kernel's state is one slice of ints, lent to whoever needs it (cancho has no
// mutable globals, and does not need them here):
//   k[0] UART base          k[1] board: Pi 3 or 4, 1 for QEMU virt (0: not recognised)
//   k[2] GIC CPU interface  k[3] GIC distributor (both 0 on the Pi 3)
//   k[4] counter units per tick   k[5] ticks so far
//   k[6] translation tables used  k[7] peripheral window start   k[8] its end
//   k[9] servo bus UART base (0: the board has no second serial port)
//   k[15] the virtio network card's registers (0: none)   k[16] k[17] k[18] its queues' counters   k[19] its address
//   k[14] where RAM starts: 0 on a Pi, 1 GB on QEMU's virt. The image, the tables and the fault note are at the same offsets from it
//   k[20] segments TCP took without a reply   k[21] k[22] the one neighbour remembered: its address, its card   k[23] pings sent
//   k[24] connections open   k[25] segments sent again
//   the shell over a connection: k[26] `putc` writes to it, not the serial port   k[27] bytes waiting to go there, at k[40..]
//   k[28] bytes of a telnet option still to skip   k[29] its connection, plus one (0: none)   k[30] its port (0: closed)
//   randomness: k[34] the generator (0 none, 1 virtio-rng, 3 the Pi 3's)   k[35] its registers   k[36] its queue's counter
//   k[37] words ready, at k[4136..]   k[38] words used to begin connections
//   k[31] the length of the line typed there   k[32] its last byte was a carriage return   k[33] bytes printed and not kept
//   k[10] the network link is up   k[11] packets answered   k[12] packets dropped   k[13] why the last one was
// The system registers, by the numbers board_sys_read/board_sys_write take:
//   0 cntfrq_el0  1 cntvct_el0  2 cntv_ctl_el0  3 cntv_cval_el0  4 cntv_tval_el0
//   5 mair_el1    6 tcr_el1     7 ttbr0_el1     8 sctlr_el1      9 midr_el1

// ---- which board ------------------------------------------------------------
// One image for every board: the CPU says which one this is.
fn detect[&f, &s](cpu: &!f Cpu, k: &!s [int]) -> [cpu("midr_el1")] int {
    let part = cpu_read(cpu, "midr_el1") >> 4 & 0xfff;
    if part == 0xd03 {
        // Cortex-A53: Raspberry Pi 3 (BCM2837), and QEMU raspi3b
        k[1] = 3;
        k[0] = 0x3f201000;
        k[9] = 0x3f215000;
        k[7] = 0x3f000000;
        k[8] = 0x40200000;
    } else if part == 0xd08 {
        // Cortex-A72: Raspberry Pi 4 (BCM2711)
        k[1] = 4;
        k[0] = 0xfe201000;
        k[9] = 0xfe215000;
        k[2] = 0xff842000;
        k[3] = 0xff841000;
        k[7] = 0xfc000000;
        k[8] = 0x100000000;
    } else if part == 0xd07 {
        // Cortex-A57: no Pi has one. It is how QEMU's `virt` machine is run here (run.sh, test.sh):
        // a PL011, a GIC and virtio devices, and RAM that starts at 1 GB instead of 0
        k[1] = 1;
        k[0] = 0x9000000;
        k[2] = 0x8010000;
        k[3] = 0x8000000;
        k[7] = 0x8000000;
        k[8] = 0xa200000;
        k[14] = 0x40000000;
    }
    return k[1];
}

// ---- UART (PL011) -----------------------------------------------------------
fn uart_init[&mc, &mp, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), pins: &!mp Mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008")] int {
    let uart = k[0];
    let gpio = uart - 0x1000;
    mmio_write32(con, uart + 0x30, 0);
    if k[1] >= 3 {
        // GPFSEL1: GPIO14/15 to ALT0 (TXD0/RXD0). (QEMU's virt has no pins to route.)
        let sel = mmio_read32(pins, gpio + 4) & ~(7 << 12 | 7 << 15);
        mmio_write32(pins, gpio + 4, sel | 4 << 12 | 4 << 15);
    }
    mmio_write32(con, uart + 0x44, 0x7ff);
    // 115200 baud from a 48 MHz UART clock; 8N1, FIFOs on; enable, TX, RX
    mmio_write32(con, uart + 0x24, 26);
    mmio_write32(con, uart + 0x28, 3);
    mmio_write32(con, uart + 0x2c, 3 << 5 | 1 << 4);
    return mmio_write32(con, uart + 0x30, 1 | 1 << 8 | 1 << 9);
}

fn putc[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], c: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if k[26] != 0 {
        // a line from the network is being run: what it prints waits here for the connection
        if k[27] < 4096 {
            k[40 + k[27]] = c;
            k[27] = k[27] + 1;
        } else {
            k[33] = k[33] + 1;
        }
        return 0;
    }
    let uart = k[0];
    while mmio_read32(con, uart + 0x18) & 32 != 0 {
    }
    return mmio_write32(con, uart, c);
}

fn puts[&mc, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], s: &r [byte]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    var i = 0;
    while i < len(s) {
        putc(con, k, int_of(s[i]));
        i = i + 1;
    }
    return 0;
}

fn put_dec[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if v >= 10 {
        put_dec(con, k, v / 10);
    }
    return putc(con, k, 48 + v % 10);
}

fn put_digit[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], d: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if d < 10 {
        return putc(con, k, 48 + d);
    }
    return putc(con, k, 87 + d);
}

fn put_hex[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if v >= 16 {
        put_hex(con, k, v >> 4);
    }
    return put_digit(con, k, v & 15);
}

// All sixteen digits, for a register.
fn put_reg[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    puts(con, k, "0x");
    var shift = 60;
    while shift >= 0 {
        put_digit(con, k, v >> shift & 15);
        shift = shift - 4;
    }
    return 0;
}

// ---- time: the ARM generic timer, polled -------------------------------------
// Interrupts stay masked in the CPU. The timer still raises its line through the
// board's interrupt controller, which is what wakes `wfi`; the kernel then asks
// the controller what happened. No handler runs behind cancho's back, so there
// is no state shared with one.
fn tick_start[&f, &mi, &s](cpu: &!f Cpu, irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), k: &!s [int], hz: int) -> [cpu("cntfrq_el0"), cpu("cntv_ctl_el0"), cpu("cntv_tval_el0"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014")] int {
    k[4] = cpu_read(cpu, "cntfrq_el0") / hz;
    if k[2] != 0 {
        // GIC-400: virtual timer is private interrupt 27
        let gicd = k[3];
        mmio_write32(irq, gicd, 0);
        let prio = mmio_read32(irq, gicd + 0x400 + 24) & 0xffffff;
        mmio_write32(irq, gicd + 0x400 + 24, prio | 0xa0 << 24);
        mmio_write32(irq, gicd + 0x100, 1 << 27);
        mmio_write32(irq, gicd, 1);
        mmio_write32(irq, k[2] + 4, 0xff);
        mmio_write32(irq, k[2], 1);
    } else {
        // BCM2836 per-core block: route the virtual timer to core 0
        mmio_write32(irq, 0x40000040, 8);
    }
    cpu_write(cpu, "cntv_tval_el0", k[4]);
    return cpu_write(cpu, "cntv_ctl_el0", 1);
}

fn tick[&f, &s](cpu: &!f Cpu, k: &!s [int]) -> [cpu("cntv_cval_el0")] int {
    // from the last deadline, not from now: no drift
    cpu_write(cpu, "cntv_cval_el0", cpu_read(cpu, "cntv_cval_el0") + k[4]);
    k[5] = k[5] + 1;
    return 0;
}

// What the interrupt controller has pending, handled here and now.
fn poll[&f, &mi, &s](cpu: &!f Cpu, irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), k: &!s [int]) -> [cpu("cntv_cval_el0"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014")] int {
    if k[4] == 0 {
        return 0;
    }
    if k[2] != 0 {
        let iar = mmio_read32(irq, k[2] + 0xc);
        let id = iar & 0x3ff;
        if id == 27 {
            tick(cpu, k);
        }
        if id < 1020 {
            mmio_write32(irq, k[2] + 0x10, iar);
        }
    } else if mmio_read32(irq, 0x40000060) & 8 != 0 {
        tick(cpu, k);
    }
    return 0;
}

fn uptime_ms[&f](cpu: &!f Cpu) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let f = cpu_read(cpu, "cntfrq_el0");
    let c = cpu_read(cpu, "cntvct_el0");
    return c / f * 1000 + c % f * 1000 / f;
}

// (It also answers -2 or -3 when the network has something for the shell: see `session`.)
// Sleep until a key arrives, handling whatever else wakes the core meanwhile. While the
// network link is up the core does not sleep: nothing wakes it when a byte arrives on the
// link (interrupts are polled, and the tick is every 10 ms), so it keeps looking.
fn getc[&f, &mc, &mi, &mu, &mr, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte]) -> [cpu("cntfrq_el0"), cpu("cntv_cval_el0"), cpu("cntvct_el0"), cpu("wfi"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    let uart = k[0];
    while mmio_read32(con, uart + 0x18) & 16 != 0 {
        if k[37] < 16 && k[34] != 0 {
            rng_fill(rng, vio, dma, k);
        }
        if k[10] != 0 {
            let ready = net_poll(bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rline, uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
            if ready != 0 {
                // not a key: -2 a line from the network is ready, -3 a connection is to be greeted
                return -1 - ready;
            }
        } else if k[4] != 0 {
            cpu_do(cpu, "wfi");
        }
        poll(cpu, irq, k);
    }
    return mmio_read32(con, uart) & 255;
}

fn now_us[&f](cpu: &!f Cpu) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let f = cpu_read(cpu, "cntfrq_el0");
    let c = cpu_read(cpu, "cntvct_el0");
    return c / f * 1000000 + c % f * 1000000 / f;
}

// ---- the servo bus --------------------------------------------------------------
// The arm's servos (Feetech STS) share one serial line. On the emulated boards it is
// the second UART, the BCM283x "mini UART"; a Pi 5 will use a PL011 behind RP1, so
// these four functions are the part that is rewritten for it, and nothing above them is.
// Register offsets: 0x04 enables, 0x40 data, 0x44 interrupt enable, 0x48 FIFO control,
// 0x4c line control, 0x54 line status (bit 0 a byte is waiting, bit 5 room to send),
// 0x60 control, 0x68 baud.
fn bus_init[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    mmio_write32(bus, u + 4, 1);
    mmio_write32(bus, u + 0x60, 0);
    mmio_write32(bus, u + 0x44, 0);
    mmio_write32(bus, u + 0x4c, 3);
    mmio_write32(bus, u + 0x48, 0xc6);
    // 1 Mbaud from a 500 MHz core clock would be 61.5: not exact, and the emulator ignores
    // it. The real bus is the Pi 5 driver's problem.
    mmio_write32(bus, u + 0x68, 61);
    return mmio_write32(bus, u + 0x60, 3);
}

fn bus_put[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], c: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    while mmio_read32(bus, u + 0x54) & 32 == 0 {
    }
    return mmio_write32(bus, u + 0x40, c);
}

// The next byte, or -1 when none is waiting.
fn bus_get[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    if mmio_read32(bus, u + 0x54) & 1 == 0 {
        return -1;
    }
    return mmio_read32(bus, u + 0x40) & 255;
}

// What `transact` answers besides what `feetech.decode` does.
fn bus_timeout() -> [] int {
    return -90;
}

fn bus_overflow() -> [] int {
    return -91;
}

// Send `pkt[0..n]` and collect the status packet of servo `id` into `reply`, for at most
// `timeout_us`. Bytes already waiting are dropped first: a late answer to an earlier
// request must not be read as this one's. Answers what `feetech.decode` answers (the end
// of the packet, with `table` filled, or one of its errors), or `bus_timeout`/`bus_overflow`.
// The same shape as cancho-robot's `serial.transact`, on our own driver.
fn transact[&f, &mu, &s, &p, &r, &t](cpu: &!f Cpu, bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], pkt: &p [byte], n: int, reply: &!r [byte], id: int, table: &!t [int], timeout_us: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    while bus_get(bus, k) >= 0 {
    }
    var i = 0;
    while i < n {
        bus_put(bus, k, int_of(pkt[i]));
        i = i + 1;
    }
    let start = now_us(cpu);
    var got = 0;
    var result = feetech.need_more();
    while result == feetech.need_more() {
        let c = bus_get(bus, k);
        if c >= 0 {
            if got >= len(reply) {
                result = bus_overflow();
            } else {
                reply[got] = byte_of(c);
                got = got + 1;
                result = feetech.decode(reply[0..got], id, table);
            }
        } else if now_us(cpu) - start > timeout_us {
            result = bus_timeout();
        }
    }
    return result;
}

// ---- the network link ---------------------------------------------------------------
// IPv4 over the second serial port, framed with SLIP (docs/network.md). The port is the
// servo bus's: `net up` gives it to the network, `net down` gives it back, and the servo
// commands refuse while it is up. Everything about packets is src/inet.cho, which holds
// no hardware; this is the part that moves bytes.

// 10.0.0.2. The other end of the line is whoever is there; SLIP has no addresses.
fn net_address() -> [] int {
    return 10 * 16777216 + 2;
}

// The next whole packet from the line, in `frame`: its length, or 0 if there is none yet.
// At most 256 bytes are taken at once.
fn slip_recv[&mu, &s, &n, &a](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], ns: &!n [int], frame: &!a [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var budget = 256;
    while budget > 0 {
        let c = bus_get(bus, k);
        if c < 0 {
            return 0;
        }
        budget = budget - 1;
        let got = inet.slip_feed(ns, frame, c);
        if got > 0 {
            return got;
        }
    }
    return 0;
}

// ---- the network card: virtio-net ---------------------------------------------------
// QEMU's virt machine has 32 places for a virtio device, 0x200 apart; a network card says
// device 1 (VIRTIO 1.2, section 4.2 for the registers, 5.1 for the card, 2.7 for a queue).
// The card and the driver share memory: two queues of eight entries, one to receive and
// one to send. A queue is three tables: descriptors (where a buffer is, how long), the
// ring of buffers offered to the card, and the ring of buffers it has finished with.
// That memory is `dma`, and nothing else is in it:
//     +0x0000 receive queue: descriptors, +0x100 offered, +0x200 finished
//     +0x0400 send queue, the same three
//     +0x1000 eight receive buffers of 2 KB     +0x5000 one send buffer
// Every packet has 12 bytes of the card's own header in front, all zero here.
// No interrupt is used: `vnet_poll` looks at the finished ring.

fn put16le[&md](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), at: int, v: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    mmio_write8(dma, at, v & 255);
    return mmio_write8(dma, at + 1, v >> 8 & 255);
}

fn get16le[&md](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), at: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    return mmio_read8(dma, at) | mmio_read8(dma, at + 1) << 8;
}

// Tell the card where queue `q`'s three tables are (they start at `at`), and that it is ready.
fn vnet_queue[&mv](vio: &!mv Mmio("0xa000000..0xa004000"), base: int, q: int, at: int) -> [mmio("0xa000000..0xa004000")] int {
    mmio_write32(vio, base + 0x30, q);
    if mmio_read32(vio, base + 0x34) < 8 {
        return 1;
    }
    mmio_write32(vio, base + 0x38, 8);
    mmio_write32(vio, base + 0x80, at & 0xffffffff);
    mmio_write32(vio, base + 0x84, at >> 32);
    mmio_write32(vio, base + 0x90, at + 0x100 & 0xffffffff);
    mmio_write32(vio, base + 0x94, at >> 32);
    mmio_write32(vio, base + 0xa0, at + 0x200 & 0xffffffff);
    mmio_write32(vio, base + 0xa4, at >> 32);
    mmio_write32(vio, base + 0x44, 1);
    return 0;
}

// Find the card and bring it up. k[15] is its registers afterwards, or 0 if there is none
// or it refused; k[19] is its address.
fn vnet_start[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    var base = 0;
    var slot = 0;
    while slot < 32 && base == 0 {
        let at = 0xa000000 + slot * 0x200;
        // "virt", version 2 (not the legacy interface), device 1
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 1 {
            base = at;
        }
        slot = slot + 1;
    }
    if base == 0 {
        return 1;
    }
    let d = k[14] + 0x210000;
    var z = 0;
    while z < 0x1000 {
        mmio_write64(dma, d + z, 0);
        z = z + 8;
    }
    // reset; then "I see you" (1), "I can drive you" (2)
    mmio_write32(vio, base + 0x70, 0);
    mmio_write32(vio, base + 0x70, 1);
    mmio_write32(vio, base + 0x70, 3);
    // of what the card offers, two things are taken: its address in its configuration
    // (bit 5) and the current version of the interface (bit 32)
    mmio_write32(vio, base + 0x14, 0);
    let low = mmio_read32(vio, base + 0x10);
    mmio_write32(vio, base + 0x14, 1);
    let high = mmio_read32(vio, base + 0x10);
    if low & 32 == 0 || high & 1 == 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    mmio_write32(vio, base + 0x24, 0);
    mmio_write32(vio, base + 0x20, 32);
    mmio_write32(vio, base + 0x24, 1);
    mmio_write32(vio, base + 0x20, 1);
    mmio_write32(vio, base + 0x70, 11);
    if mmio_read32(vio, base + 0x70) & 8 == 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    // every receive buffer is offered: the card may write (2) 2 KB at each
    var i = 0;
    while i < 8 {
        mmio_write64(dma, d + i * 16, d + 0x1000 + i * 0x800);
        mmio_write32(dma, d + i * 16 + 8, 0x800);
        put16le(dma, d + i * 16 + 12, 2);
        put16le(dma, d + 0x104 + i * 2, i);
        i = i + 1;
    }
    put16le(dma, d + 0x102, 8);
    k[16] = 8;
    k[17] = 0;
    k[18] = 0;
    if vnet_queue(vio, base, 0, d) != 0 || vnet_queue(vio, base, 1, d + 0x400) != 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    mmio_write32(vio, base + 0x70, 15);
    mmio_write32(vio, base + 0x50, 0);
    var mac = 0;
    var b = 0;
    while b < 6 {
        mac = mac << 8 | mmio_read8(vio, base + 0x100 + b);
        b = b + 1;
    }
    k[19] = mac;
    k[15] = base;
    return 0;
}

// Send `frame[0..n]`, and wait until the card has taken it.
fn vnet_send[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &b [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    let d = k[14] + 0x210000;
    let buf = d + 0x5000;
    mmio_write64(dma, buf, 0);
    mmio_write32(dma, buf + 8, 0);
    var i = 0;
    while i < n {
        mmio_write8(dma, buf + 12 + i, int_of(frame[i]));
        i = i + 1;
    }
    mmio_write64(dma, d + 0x400, buf);
    mmio_write32(dma, d + 0x408, 12 + n);
    put16le(dma, d + 0x40c, 0);
    put16le(dma, d + 0x504 + k[18] % 8 * 2, 0);
    k[18] = (k[18] + 1) % 65536;
    put16le(dma, d + 0x502, k[18]);
    mmio_write32(vio, k[15] + 0x50, 1);
    var spins = 0;
    while get16le(dma, d + 0x602) != k[18] && spins < 1000000 {
        spins = spins + 1;
    }
    return 0;
}

// The next frame the card has finished with, in `frame`: its length, or 0 if there is none.
// Its buffer is offered to the card again.
fn vnet_recv[&mv, &md, &s, &a](vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    let d = k[14] + 0x210000;
    var got = 0;
    while got == 0 && get16le(dma, d + 0x202) != k[17] {
        let entry = d + 0x204 + k[17] % 8 * 8;
        let id = mmio_read32(dma, entry) & 7;
        let n = mmio_read32(dma, entry + 4) - 12;
        if n > 0 && n <= len(frame) {
            var i = 0;
            while i < n {
                frame[i] = byte_of(mmio_read8(dma, d + 0x1000 + id * 0x800 + 12 + i));
                i = i + 1;
            }
            got = n;
        }
        put16le(dma, d + 0x104 + k[16] % 8 * 2, id);
        k[16] = (k[16] + 1) % 65536;
        put16le(dma, d + 0x102, k[16]);
        k[17] = (k[17] + 1) % 65536;
        mmio_write32(vio, k[15] + 0x50, 0);
    }
    // the card raises its interrupt line for each; nobody listens, and this lowers it
    let raised = mmio_read32(vio, k[15] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[15] + 0x64, raised);
    }
    return got;
}

// ---- randomness ------------------------------------------------------------------------
// Numbers nobody outside can guess, from the board's own generator (docs/random.md):
// on QEMU's virt a virtio device (number 4), which fills a buffer it is offered; on a Pi 3
// the BCM2835 generator (control +0, status +4 with the words ready in its top byte,
// data +8). A Pi 4 has another (the RNG200), which QEMU's Pi 4 does not have: no driver
// for it yet, and there the kernel has no randomness.
// k[34] says which (0: none), k[35] where. The virtio queue is in `dma`, after the
// network card's: +0x6000 its three tables, +0x6400 the buffer.

fn rng_start[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    if k[1] == 3 {
        k[35] = 0x3f104000;
        // the first words are to be thrown away: this many, the chip's own advice
        mmio_write32(rng, k[35] + 4, 0x40000);
        mmio_write32(rng, k[35], 1);
        k[34] = 3;
        return 0;
    }
    if k[1] != 1 {
        return 1;
    }
    var base = 0;
    var slot = 0;
    while slot < 32 && base == 0 {
        let at = 0xa000000 + slot * 0x200;
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 4 {
            base = at;
        }
        slot = slot + 1;
    }
    if base == 0 {
        return 1;
    }
    let d = k[14] + 0x216000;
    var z = 0;
    while z < 0x800 {
        mmio_write64(dma, d + z, 0);
        z = z + 8;
    }
    mmio_write32(vio, base + 0x70, 0);
    mmio_write32(vio, base + 0x70, 1);
    mmio_write32(vio, base + 0x70, 3);
    // nothing is asked of the device but the current version of the interface (bit 32)
    mmio_write32(vio, base + 0x24, 0);
    mmio_write32(vio, base + 0x20, 0);
    mmio_write32(vio, base + 0x24, 1);
    mmio_write32(vio, base + 0x20, 1);
    mmio_write32(vio, base + 0x70, 11);
    if mmio_read32(vio, base + 0x70) & 8 == 0 || vnet_queue(vio, base, 0, d) != 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    // one buffer of 16 bytes, which the device may write (2)
    mmio_write64(dma, d, d + 0x400);
    mmio_write32(dma, d + 8, 16);
    put16le(dma, d + 12, 2);
    mmio_write32(vio, base + 0x70, 15);
    k[36] = 0;
    k[35] = base;
    k[34] = 1;
    return 0;
}

// One word of 32 bits from the generator, or -1 if it gave none in time.
fn rng_word[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    var spins = 0;
    if k[34] == 3 {
        while mmio_read32(rng, k[35] + 4) >> 24 == 0 && spins < 1000000 {
            spins = spins + 1;
        }
        if mmio_read32(rng, k[35] + 4) >> 24 == 0 {
            return -1;
        }
        return mmio_read32(rng, k[35] + 8);
    }
    if k[34] != 1 {
        return -1;
    }
    let d = k[14] + 0x216000;
    // offer the buffer, say so, and wait for it to come back
    put16le(dma, d + 0x104 + k[36] % 8 * 2, 0);
    k[36] = (k[36] + 1) % 65536;
    put16le(dma, d + 0x102, k[36]);
    mmio_write32(vio, k[35] + 0x50, 0);
    while get16le(dma, d + 0x202) != k[36] && spins < 1000000 {
        spins = spins + 1;
    }
    let raised = mmio_read32(vio, k[35] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[35] + 0x64, raised);
    }
    if get16le(dma, d + 0x202) != k[36] {
        return -1;
    }
    // how many bytes the device says it wrote
    if mmio_read32(dma, d + 0x204 + (k[36] + 7) % 8 * 8 + 4) < 4 {
        return -1;
    }
    return mmio_read32(dma, d + 0x400);
}

// Keep 16 words ready at k[4136..]; k[37] is how many there are. What needs one takes it
// from there, and so needs no capability.
fn rng_fill[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    while k[34] != 0 && k[37] < 16 {
        let w = rng_word(rng, vio, dma, k);
        if w < 0 {
            return 1;
        }
        k[4136 + k[37]] = w;
        k[37] = k[37] + 1;
    }
    return 0;
}

fn put_rng_name[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if k[34] == 1 {
        return puts(con, k, "virtio-rng");
    }
    return puts(con, k, "the BCM2835 generator");
}

// `random`: sixteen bytes straight from the generator, and which one it is.
fn put_random[&mc, &mr, &mv, &md, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    if k[34] == 0 {
        return puts(con, k, "this board gave the kernel no source of randomness\r\n");
    }
    puts(con, k, "random (");
    put_rng_name(con, k);
    puts(con, k, "): ");
    var i = 0;
    while i < 4 {
        let w = rng_word(rng, vio, dma, k);
        if w < 0 {
            return puts(con, k, " the generator gave nothing\r\n");
        }
        var shift = 28;
        while shift >= 0 {
            put_hex(con, k, w >> shift & 15);
            shift = shift - 4;
        }
        i = i + 1;
    }
    return puts(con, k, "\r\n");
}

// ---- the two links as one -----------------------------------------------------------
// What arrives is a frame on the card and a bare packet on the serial line; `inet` has
// a function for each, and these four are where the kernel chooses.

fn link_recv[&mu, &mv, &md, &s, &n, &a](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 2 {
        return vnet_recv(vio, dma, k, frame);
    }
    return slip_recv(bus, k, ns, frame);
}

fn link_send[&mu, &mv, &md, &s, &b, &w](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], pkt: &b [byte], n: int, wire: &!w [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 2 {
        return vnet_send(vio, dma, k, pkt, n);
    }
    let w = inet.slip_encode(pkt, n, wire);
    var i = 0;
    while i < w {
        bus_put(bus, k, int_of(wire[i]));
        i = i + 1;
    }
    return 0;
}

// What arrived, `frame[0..n]`, given to `inet`, and its answer sent. `iss` is where a new
// connection's sequence numbers start if the pool of random words is empty: the counter's
// value, which is not a secret.
fn net_take[&mu, &mv, &md, &s, &a, &b, &w, &t, &g, &h](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte], n: int, reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    var m = 0;
    // a word nobody can guess, if the board has given any; else the counter
    var first = iss;
    if k[37] > 0 {
        first = k[4136 + k[37] - 1];
    }
    var at = 0;
    if k[10] == 2 {
        at = 14;
        m = inet.eth_serve(frame, n, k[19], net_address(), tcp, bufs, inbox, k[30], now, first, reply);
    } else {
        m = inet.serve(frame, n, net_address(), tcp, bufs, inbox, k[30], now, first, reply);
    }
    if k[37] > 0 && m >= at + 40 && int_of(reply[at + 9]) == 6 && int_of(reply[at + 33]) == 18 {
        // the reply opens a connection (SYN and ACK): it began at that word, which is not used again
        k[37] = k[37] - 1;
        k[38] = k[38] + 1;
    }
    if m > 0 {
        link_send(bus, vio, dma, k, reply, m, wire);
        k[11] = k[11] + 1;
    } else if m == 0 {
        k[20] = k[20] + 1;
    } else {
        k[12] = k[12] + 1;
        k[13] = m;
    }
    if k[29] != 0 && inet.tcp_state(tcp, k[29] - 1) != 2 && inet.tcp_state(tcp, k[29] - 1) != 3 {
        // the shell's connection has gone: what it had typed and what waited for it go with it
        k[29] = 0;
        k[27] = 0;
        k[28] = 0;
        k[31] = 0;
        k[32] = 0;
    }
    return 0;
}

// ---- the shell over a connection -----------------------------------------------------
// Port 23, when `net shell on` has opened it (docs/network.md, section 8). One connection
// at a time has the shell; another waits, unread. This function moves bytes between that
// connection and two things in the kernel: the line being typed there (`rline`, k[31]
// bytes of it) and the output waiting for it (k[40..], k[27] of it; `putc` fills it).
// It touches no hardware. Answers 1 when a whole line is in `rline`, 2 when a connection
// has just been given the shell and should be greeted, 0 otherwise.
fn session[&s, &t, &g, &h, &l, &w](k: &!s [int], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], wire: &!w [byte]) -> [] int {
    if k[30] == 0 {
        return 0;
    }
    if k[29] == 0 {
        var c = 0;
        while c < inet.tcp_count(tcp, bufs, inbox) && k[29] == 0 {
            if inet.tcp_port(tcp, c) == k[30] && (inet.tcp_state(tcp, c) == 2 || inet.tcp_state(tcp, c) == 3) {
                k[29] = c + 1;
            }
            c = c + 1;
        }
        if k[29] == 0 {
            return 0;
        }
        return 2;
    }
    let c = k[29] - 1;
    if k[27] > 0 {
        // output first: as much as the connection has room for
        var n = k[27];
        if n > len(wire) {
            n = len(wire);
        }
        var i = 0;
        while i < n {
            wire[i] = byte_of(k[40 + i] & 255);
            i = i + 1;
        }
        let took = inet.tcp_write(tcp, bufs, c, wire, 0, n);
        i = took;
        while i < k[27] {
            k[40 + i - took] = k[40 + i];
            i = i + 1;
        }
        k[27] = k[27] - took;
    }
    if k[27] > 0 {
        // nothing more is read until what was said has gone
        return 0;
    }
    while inet.tcp_read(tcp, inbox, c, wire, 1) == 1 {
        let ch = int_of(wire[0]);
        if k[28] > 0 {
            // the two bytes after a telnet client's 255: an option it asks about, not answered
            k[28] = k[28] - 1;
        } else if ch == 255 {
            k[28] = 2;
        } else if ch == 10 && k[32] != 0 {
            // the line feed of a carriage return and line feed: the line ended at the first
            k[32] = 0;
        } else if ch == 13 || ch == 10 {
            k[32] = 0;
            if ch == 13 {
                k[32] = 1;
            }
            return 1;
        } else {
            k[32] = 0;
            if ch >= 32 && ch < 127 && k[31] < len(rline) {
                rline[k[31]] = byte_of(ch);
                k[31] = k[31] + 1;
            }
        }
    }
    if inet.tcp_state(tcp, c) == 3 {
        // the other end has finished, and everything it sent has been answered: we finish too
        inet.tcp_close(tcp, c);
    }
    return 0;
}

// Take what has arrived, at most eight packets, and answer each; move the shell's bytes;
// then send again whatever a connection has had out too long, and whatever is new.
// Answers what `session` does.
fn net_poll[&mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    var budget = 8;
    while budget > 0 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n == 0 {
            budget = 0;
        } else {
            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, now, iss);
            budget = budget - 1;
        }
    }
    let ready = session(k, tcp, bufs, inbox, rline, wire);
    var c = 0;
    while c < inet.tcp_count(tcp, bufs, inbox) {
        var m = 0;
        if k[10] == 2 {
            m = inet.eth_tick(tcp, bufs, c, now, k[19], net_address(), reply);
        } else {
            m = inet.tcp_tick(tcp, bufs, c, now, net_address(), reply, 0);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
            k[25] = k[25] + 1;
        }
        // and what the shell's connection has to send that it has not sent
        if k[10] == 2 {
            m = inet.eth_flush(tcp, bufs, c, now, k[19], net_address(), reply);
        } else {
            m = inet.tcp_flush(tcp, bufs, c, now, net_address(), reply, 0);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
        }
        c = c + 1;
    }
    k[24] = inet.tcp_open(tcp, bufs, inbox);
    return ready;
}

// `a.b.c.d` at `line[from..n]` as a number, or -1.
fn address[&r](line: &r [byte], from: int, n: int) -> [] int {
    var value = 0;
    var part = 0;
    var parts = 0;
    var digits = 0;
    var i = from;
    while i < n {
        let c = int_of(line[i]);
        if c >= '0' && c <= '9' && digits < 3 {
            part = part * 10 + c - '0';
            digits = digits + 1;
        } else if c == '.' && digits > 0 && part < 256 && parts < 3 {
            value = value * 256 + part;
            part = 0;
            digits = 0;
            parts = parts + 1;
        } else {
            return -1;
        }
        i = i + 1;
    }
    if parts != 3 || digits == 0 || part > 255 {
        return -1;
    }
    return value * 256 + part;
}

fn put_address[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], a: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    put_dec(con, k, a >> 24 & 255);
    puts(con, k, ".");
    put_dec(con, k, a >> 16 & 255);
    puts(con, k, ".");
    put_dec(con, k, a >> 8 & 255);
    puts(con, k, ".");
    return put_dec(con, k, a & 255);
}

// `ping <address>`: the kernel speaks first. An echo request, and the time to its reply.
// On the card the address must first be asked for (ARP); the last answer is remembered.
// Whatever else arrives meanwhile is answered as always.
fn net_ping[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], line: &r [byte], from: int, len_line: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 0 {
        return puts(con, k, "the link is down: `net up` first\r\n");
    }
    let target = address(line, from, len_line);
    if target < 0 {
        return puts(con, k, "usage: ping <a.b.c.d>\r\n");
    }
    let ours = net_address();
    if k[10] == 2 && k[21] != target {
        let q = inet.arp_request(reply, k[19], ours, target);
        if q > 0 {
            vnet_send(vio, dma, k, reply, q);
        }
        let asked = now_us(cpu);
        var card = -1;
        while card < 0 && now_us(cpu) - asked < 1000000 {
            let n = link_recv(bus, vio, dma, k, ns, frame);
            if n > 0 {
                card = inet.arp_answer_from(frame, n, k[19], ours, target);
                if card < 0 {
                    net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
                }
            }
        }
        if card < 0 {
            puts(con, k, "nobody on this network says they are ");
            put_address(con, k, target);
            return puts(con, k, "\r\n");
        }
        k[21] = target;
        k[22] = card;
    }
    k[23] = k[23] + 1;
    var at = 0;
    if k[10] == 2 {
        at = 14;
    }
    var m = inet.echo_request(reply, at, ours, target, 51724, k[23], 32);
    if m > 0 && k[10] == 2 {
        m = inet.eth_frame(reply, m, k[22], k[19]);
    }
    if m <= 0 {
        return puts(con, k, "the request could not be built\r\n");
    }
    link_send(bus, vio, dma, k, reply, m, wire);
    let sent = now_us(cpu);
    while now_us(cpu) - sent < 1000000 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n > 0 {
            var hit = false;
            if k[10] == 2 {
                hit = n > 14 && inet.get16(frame, 12) == 2048 && inet.is_echo_reply(frame, 14, n - 14, ours, target, 51724, k[23]);
            } else {
                hit = inet.is_echo_reply(frame, 0, n, ours, target, 51724, k[23]);
            }
            if hit {
                let took = now_us(cpu) - sent;
                puts(con, k, "reply from ");
                put_address(con, k, target);
                puts(con, k, " in ");
                put_dec(con, k, took);
                return puts(con, k, " us\r\n");
            }
            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
        }
    }
    puts(con, k, "no reply from ");
    put_address(con, k, target);
    return puts(con, k, " within a second\r\n");
}

fn put_net[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if k[10] == 0 && k[9] == 0 && k[15] == 0 {
        puts(con, k, "no network card, and no second serial port");
    } else if k[10] == 0 {
        puts(con, k, "link down");
    } else if k[10] == 2 {
        puts(con, k, "link up: virtio-net, card ");
        var shift = 40;
        while shift >= 0 {
            put_hex(con, k, k[19] >> shift + 4 & 15);
            put_hex(con, k, k[19] >> shift & 15);
            if shift > 0 {
                puts(con, k, ":");
            }
            shift = shift - 8;
        }
        puts(con, k, ", address 10.0.0.2");
    } else {
        puts(con, k, "link up: SLIP on the second serial port, address 10.0.0.2");
    }
    puts(con, k, "\r\n");
    put_dec(con, k, k[11]);
    puts(con, k, " packets answered, ");
    put_dec(con, k, k[12]);
    puts(con, k, " dropped");
    if k[12] != 0 {
        puts(con, k, " (the last: ");
        if k[13] == inet.drop_short() {
            puts(con, k, "cut short");
        } else if k[13] == inet.drop_not_ipv4() {
            puts(con, k, "not IPv4");
        } else if k[13] == inet.drop_bad_header_checksum() {
            puts(con, k, "header checksum");
        } else if k[13] == inet.drop_not_ours() {
            puts(con, k, "for another address");
        } else if k[13] == inet.drop_fragment() {
            puts(con, k, "a fragment");
        } else if k[13] == inet.drop_bad_checksum() {
            puts(con, k, "checksum");
        } else if k[13] == inet.drop_not_our_frame() {
            puts(con, k, "a frame for another card");
        } else if k[13] == inet.drop_too_long() {
            puts(con, k, "too long");
        } else {
            puts(con, k, "nothing here answers it");
        }
        puts(con, k, ")");
    }
    puts(con, k, "\r\n");
    if k[34] != 0 && k[37] > 0 {
        puts(con, k, "connections begin at a random number (");
        put_rng_name(con, k);
        puts(con, k, ")\r\n");
    } else {
        puts(con, k, "connections begin at the counter's value: it can be guessed\r\n");
    }
    if k[30] != 0 {
        puts(con, k, "shell on port 23: ");
        if k[29] != 0 {
            puts(con, k, "a session is open\r\n");
        } else {
            puts(con, k, "nobody connected\r\n");
        }
    }
    if k[20] != 0 || k[24] != 0 || k[25] != 0 {
        puts(con, k, "tcp: ");
        put_dec(con, k, k[24]);
        puts(con, k, " open, ");
        put_dec(con, k, k[20]);
        puts(con, k, " segments taken without a reply, ");
        put_dec(con, k, k[25]);
        puts(con, k, " sent again\r\n");
    }
    return 0;
}

fn put_bus_error[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], code: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if code == bus_timeout() {
        return puts(con, k, "no answer");
    }
    if code == bus_overflow() {
        return puts(con, k, "answer too long");
    }
    return puts(con, k, feetech.error_tag(code));
}

// `servo scan`: ping ids 1 to 8 and say who answered. Read-only: this kernel builds no
// packet that can move a servo (src/feetech.cho has none).
fn servo_scan[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var found = 0;
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var id = 1;
        while id <= 8 {
            let n = feetech.ping(pkt, id);
            let got = transact(cpu, bus, k, pkt, n, reply, id, table, 20000);
            puts(con, k, "servo ");
            put_dec(con, k, id);
            if got > 0 {
                puts(con, k, ": present\r\n");
                found = found + 1;
            } else {
                puts(con, k, ": ");
                put_bus_error(con, k, got);
                puts(con, k, "\r\n");
            }
            id = id + 1;
        }
    }
    put_dec(con, k, found);
    return puts(con, k, " servos found\r\n");
}

// `servo pos`: the present position (register 56, two bytes) of servos 1 to 6, in raw ticks.
fn servo_pos[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var id = 1;
        while id <= 6 {
            let n = feetech.read(pkt, id, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, id, table, 20000);
            puts(con, k, "servo ");
            put_dec(con, k, id);
            if got > 0 && table[3] == 2 {
                puts(con, k, ": position ");
                put_dec(con, k, feetech.u16(reply, table[2]));
                puts(con, k, "\r\n");
            } else {
                puts(con, k, ": ");
                put_bus_error(con, k, got);
                puts(con, k, "\r\n");
            }
            id = id + 1;
        }
    }
    return 0;
}

// ---- the arm: ticks to degrees to where the gripper is ----------------------------
// Calibration and kinematics are cancho-robot's, unchanged (src/calibration.cho,
// src/kinematics.cho, src/so101.cho): there they are held to LeRobot and to placo. What
// is checked here is that they compute the same with no system under them.
//
// The span of each joint, in ticks: the left arm's calibration in cancho-robot
// (tests/fixtures/calibration/xle_left.json). A table in the kernel for now; it belongs
// to the robot, and will come with whatever hands the kernel its bus.
fn span_min(joint: int) -> [] int {
    if joint == 0 {
        return 884;
    }
    if joint == 1 {
        return 1056;
    }
    if joint == 2 {
        return 885;
    }
    if joint == 3 {
        return 2060;
    }
    return 0;
}

fn span_max(joint: int) -> [] int {
    if joint == 0 {
        return 3460;
    }
    if joint == 1 {
        return 3116;
    }
    if joint == 2 {
        return 3057;
    }
    if joint == 3 {
        return 3773;
    }
    return 4095;
}

fn put_int[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if v < 0 {
        putc(con, k, 45);
        return put_dec(con, k, 0 - v);
    }
    return put_dec(con, k, v);
}

// Where the gripper frame is for five joint angles, in micrometres, in the base's frame.
fn put_gripper[&mc, &s, &d](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], degrees: &d [float]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    region r {
        let pose = alloc_slice[r](16, 0.0);
        if kinematics.forward(degrees, pose) != 0 {
            return puts(con, k, "kinematics refused the angles\r\n");
        }
        puts(con, k, "gripper at x ");
        put_int(con, k, truncate(pose[3] * 1000000.0));
        puts(con, k, " y ");
        put_int(con, k, truncate(pose[7] * 1000000.0));
        puts(con, k, " z ");
        put_int(con, k, truncate(pose[11] * 1000000.0));
    }
    return puts(con, k, " um\r\n");
}

// `arm zero`: the pose with every joint at zero. No bus involved: placo puts it at
// x 0.3913614702201581, y -9.212063114501261e-06, z 0.2264697102403328 metres.
fn arm_zero[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    region r {
        let degrees = alloc_slice[r](5, 0.0);
        put_gripper(con, k, degrees);
    }
    return 0;
}

// `arm pose`: read joints 1 to 5 from the bus, turn ticks into degrees, and say where
// that puts the gripper. Read-only.
fn arm_pose[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        let degrees = alloc_slice[r](5, 0.0);
        var joint = 0;
        var bad = 0;
        while joint < 5 && bad == 0 {
            let n = feetech.read(pkt, joint + 1, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, joint + 1, table, 20000);
            if got > 0 && table[3] == 2 {
                degrees[joint] = calibration.degrees(feetech.u16(reply, table[2]), span_min(joint), span_max(joint));
                puts(con, k, "joint ");
                put_dec(con, k, joint + 1);
                puts(con, k, ": ");
                put_int(con, k, truncate(degrees[joint] * 1000.0));
                puts(con, k, " mdeg\r\n");
            } else {
                puts(con, k, "joint ");
                put_dec(con, k, joint + 1);
                puts(con, k, ": ");
                put_bus_error(con, k, got);
                puts(con, k, "\r\n");
                bad = 1;
            }
            joint = joint + 1;
        }
        if bad == 0 {
            put_gripper(con, k, degrees);
        }
    }
    return 0;
}

// ---- the safety core, judging -----------------------------------------------------
// `arm check a1 a2 a3 a4 a5`: would the safety core let the arm go to these five angles
// (whole degrees) from where it is now? cancho-robot's `safety.approve`, unchanged, on the
// pose read from the bus: joint limits from the calibration spans, the workspace in the
// arm's own frame, the jump bound, the capsule collisions (tower and tray; the other arm
// is taken as absent), then the speed clamp for a 10 ms cycle. It answers and sends
// nothing: the kernel still holds no packet that moves a servo.

// Up to `len(out)` whole numbers, each possibly negative, from `line[from..n]`, separated
// by spaces. How many were read; -1 for anything that is not one.
fn numbers[&r, &o](line: &r [byte], from: int, n: int, out: &!o [int]) -> [] int {
    var i = from;
    var count = 0;
    var bad = false;
    while i < n && !bad {
        if int_of(line[i]) == 32 {
            i = i + 1;
        } else {
            var negative = false;
            if int_of(line[i]) == 45 {
                negative = true;
                i = i + 1;
            }
            var digits = 0;
            var v = 0;
            while i < n && int_of(line[i]) >= 48 && int_of(line[i]) <= 57 && digits < 6 {
                v = v * 10 + int_of(line[i]) - 48;
                digits = digits + 1;
                i = i + 1;
            }
            if digits == 0 || count >= len(out) || i < n && int_of(line[i]) != 32 {
                bad = true;
            } else {
                if negative {
                    v = 0 - v;
                }
                out[count] = v;
                count = count + 1;
            }
        }
    }
    if bad {
        return -1;
    }
    return count;
}

// Joints 1 to 5 from the bus, in degrees. 0, or the bus error (and which joint in `at`).
fn read_joints[&f, &mu, &s, &d, &a](cpu: &!f Cpu, bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], degrees: &!d [float], at: &!a [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var result = 0;
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var joint = 0;
        while joint < 5 && result == 0 {
            let n = feetech.read(pkt, joint + 1, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, joint + 1, table, 20000);
            if got > 0 && table[3] == 2 {
                degrees[joint] = calibration.degrees(feetech.u16(reply, table[2]), span_min(joint), span_max(joint));
            } else {
                at[0] = joint;
                result = got;
                if got >= 0 {
                    result = feetech.error_bad_length();
                }
            }
            joint = joint + 1;
        }
    }
    return result;
}

fn arm_check[&f, &mc, &mu, &s, &l](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], line: &l [byte], from: int, n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let wanted = alloc_slice[r](5, 0);
        if numbers(line, from, n, wanted) != 5 {
            return puts(con, k, "usage: arm check a1 a2 a3 a4 a5 (whole degrees)\r\n");
        }
        let current = alloc_slice[r](5, 0.0);
        let at = alloc_slice[r](1, 0);
        let read = read_joints(cpu, bus, k, current, at);
        if read != 0 {
            puts(con, k, "joint ");
            put_dec(con, k, at[0] + 1);
            puts(con, k, ": ");
            put_bus_error(con, k, read);
            return puts(con, k, "\r\n");
        }
        let request = alloc_slice[r](5, 0.0);
        let limits = alloc_slice[r](10, 0.0);
        var j = 0;
        while j < 5 {
            request[j] = float_of(wanted[j]);
            limits[j * 2] = calibration.degrees(span_min(j), span_min(j), span_max(j));
            limits[j * 2 + 1] = calibration.degrees(span_max(j), span_min(j), span_max(j));
            j = j + 1;
        }
        let goals = alloc_slice[r](5, 0.0);
        let scale = alloc_slice[r](1, 0.0);
        let joint = alloc_slice[r](1, 0);
        let other = alloc_slice[r](0, 0.0);
        // the left arm's mount on the robot (cancho-robot tests/safety_driver.cho)
        let mount = safety.Mount { x: -0.135, y: 0.133, z: 0.76, yaw_deg: 0.0 };
        var rule = 0;
        borrow mount as &m in {
            rule = safety.approve(request, current, limits, m, other, 0, 10, goals, scale, joint);
        }
        if rule == safety.rule_ok() {
            puts(con, k, "approved");
            if scale[0] < 1.0 {
                puts(con, k, ", slowed to ");
                put_int(con, k, truncate(scale[0] * 1000.0));
                puts(con, k, " per mille of the step");
            }
            puts(con, k, "\r\ngoals:");
            j = 0;
            while j < 5 {
                puts(con, k, " ");
                put_int(con, k, truncate(goals[j] * 1000.0));
                j = j + 1;
            }
            puts(con, k, " mdeg\r\n");
        } else {
            puts(con, k, "refused: ");
            puts(con, k, safety.rule_name(rule));
            if joint[0] >= 0 {
                puts(con, k, " (joint ");
                put_dec(con, k, joint[0] + 1);
                puts(con, k, ")");
            }
            puts(con, k, "\r\n");
        }
    }
    return puts(con, k, "nothing was sent\r\n");
}

// ---- memory: identity-mapped translation tables ---------------------------------
// 4 KB granule, 39-bit addresses, so level 1 is the top table. A descriptor is the
// address, the attributes below, and bit 0 (valid); bit 1 says "table" at levels 1
// and 2, and "page" at level 3.
// perm: 0 read+execute, 1 read-only, 2 read+write, 3 device (read+write, uncached)
fn attrs(perm: int) -> [] int {
    let af = 1 << 10;
    let inner = 3 << 8;
    let ro = 1 << 7;
    let pxn = 1 << 53;
    let uxn = 1 << 54;
    if perm == 0 {
        return af | inner | ro | uxn;
    }
    if perm == 1 {
        return af | inner | ro | pxn | uxn;
    }
    if perm == 2 {
        return af | inner | pxn | uxn;
    }
    // memory attribute 1 (device)
    return af | pxn | uxn | 4;
}

// The table a descriptor slot points to, made if the slot is empty. 0: none left,
// or the slot already maps a block.
fn next_table[&mt, &s](tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), k: &!s [int], slot: int) -> [mmio("0x200000..0x208000,0x40200000..0x40208000")] int {
    let d = mmio_read64(tab, slot);
    if d & 1 != 0 {
        if d & 2 == 0 {
            return 0;
        }
        return d & 0xfffffffff000;
    }
    if k[6] >= 8 {
        return 0;
    }
    let table = k[14] + 0x200000 + k[6] * 4096;
    k[6] = k[6] + 1;
    mmio_write64(tab, slot, table | 3);
    return table;
}

// Identity-map [start, end) with one permission: 1 GB and 2 MB blocks where the
// range allows, 4 KB pages elsewhere. 0, or 1 when it cannot be done.
fn map[&mt, &s](tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), k: &!s [int], start: int, end: int, perm: int) -> [mmio("0x200000..0x208000,0x40200000..0x40208000")] int {
    if (start | end) & 0xfff != 0 || start > end || end > 1 << 39 {
        return 1;
    }
    let a = attrs(perm);
    let top = k[14] + 0x200000;
    var va = start;
    var bad = 0;
    while va < end && bad == 0 {
        let l1 = top + (va >> 30) * 8;
        if va & 0x3fffffff == 0 && end - va >= 1 << 30 && mmio_read64(tab, l1) & 1 == 0 {
            mmio_write64(tab, l1, va | a | 1);
            va = va + (1 << 30);
        } else {
            let l2t = next_table(tab, k, l1);
            if l2t == 0 {
                bad = 1;
            } else {
                let l2 = l2t + (va >> 21 & 511) * 8;
                if va & 0x1fffff == 0 && end - va >= 1 << 21 && mmio_read64(tab, l2) & 1 == 0 {
                    mmio_write64(tab, l2, va | a | 1);
                    va = va + (1 << 21);
                } else {
                    let l3t = next_table(tab, k, l2);
                    if l3t == 0 {
                        bad = 1;
                    } else {
                        mmio_write64(tab, l3t + (va >> 12 & 511) * 8, va | a | 3);
                        va = va + 4096;
                    }
                }
            }
        }
    }
    return bad;
}

// One line of the memory map: map the range (when `apply`) or print it.
fn range[&mc, &mt, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), k: &!s [int], apply: bool, name: &r [byte], start: int, end: int, perm: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x200000..0x208000,0x40200000..0x40208000")] int {
    if apply {
        return map(tab, k, start, end, perm);
    }
    puts(con, k, "  0x");
    put_hex(con, k, start);
    puts(con, k, " - 0x");
    put_hex(con, k, end);
    if perm == 0 {
        puts(con, k, "  r-x  ");
    } else if perm == 1 {
        puts(con, k, "  r--  ");
    } else if perm == 2 {
        puts(con, k, "  rw-  ");
    } else {
        puts(con, k, "  rw- device  ");
    }
    puts(con, k, name);
    puts(con, k, "\r\n");
    return 0;
}

// The whole address space the kernel may touch. Everything else, page 0 included,
// is unmapped: a null dereference is a fault, not a read of whatever is there.
fn memory_map[&mc, &mt, &mx, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), k: &!s [int], apply: bool) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000")] int {
    let image = k[14] + 0x80000;
    let code_end = mmio_read64(code, image + 0x10);
    let const_end = mmio_read64(code, image + 0x18);
    var bad = range(con, tab, k, apply, "stack", k[14] + 4096, image, 2);
    bad = bad + range(con, tab, k, apply, "kernel code", image, code_end, 0);
    bad = bad + range(con, tab, k, apply, "kernel constants", code_end, const_end, 1);
    // the first 960 MB: present on every board, below the GPU's share
    bad = bad + range(con, tab, k, apply, "kernel data and heap", const_end, k[14] + 0x3c000000, 2);
    bad = bad + range(con, tab, k, apply, "peripherals", k[7], k[8], 3);
    return bad;
}

// Translation and the caches on. From here an access outside the map is a fault,
// and so is a write to code or constants, or a jump into data (WXN).
fn mmu_on[&f](cpu: &!f Cpu, ram: int) -> [cpu("mair_el1"), cpu("sctlr_el1"), cpu("tcr_el1"), cpu("tlbi_vmalle1"), cpu("ttbr0_el1")] int {
    // attribute 0: normal memory, write-back; attribute 1: device
    cpu_write(cpu, "mair_el1", 0xff | 4 << 8);
    // 39-bit addresses; cacheable, inner-shareable table walks; no upper half yet; 40-bit physical
    cpu_write(cpu, "tcr_el1", 25 | 1 << 8 | 1 << 10 | 3 << 12 | 1 << 23 | 2 << 32);
    cpu_write(cpu, "ttbr0_el1", ram + 0x200000);
    cpu_do(cpu, "tlbi_vmalle1");
    // the bits that must be one, then MMU, data cache, instruction cache, WXN
    return cpu_write(cpu, "sctlr_el1", 0x30d00800 | 1 | 1 << 2 | 1 << 12 | 1 << 19);
}

// ---- faults -------------------------------------------------------------------
// board/boot.S records an exception and calls main again; this is what main does then.
fn report_fault[&f, &mc, &mx, &mq, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), fault: &mq Mmio("0x208000..0x208008,0x40208000..0x40208008"), k: &!s [int]) -> [cpu("elr_el1"), cpu("esr_el1"), cpu("far_el1"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x208000..0x208008,0x40208000..0x40208008")] int {
    let kind = mmio_read64(fault, k[14] + 0x208000);
    let esr = cpu_read(cpu, "esr_el1");
    let elr = cpu_read(cpu, "elr_el1");
    let class = esr >> 26 & 63;
    let sync = kind & 3 == 0;
    puts(con, k, "\r\n*** ");
    // (only an address inside the image is read: a jump into nowhere must not fault again here)
    var stopped_at = 0;
    if elr >= k[14] + 0x80004 && elr < k[14] + 0x200000 - 3 && elr & 3 == 0 {
        stopped_at = mmio_read32(code, elr);
    }
    if sync && class == 0 && stopped_at == 0xc11f {
        // cancho's own checks (bounds, overflow, ...) end in `udf #0xc11f`
        puts(con, k, "cancho trap");
    } else if sync && (class == 0x25 || class == 0x21) {
        if class == 0x25 {
            puts(con, k, "data abort: ");
        } else {
            puts(con, k, "instruction abort: ");
        }
        let why = esr >> 2 & 15;
        if why == 1 {
            puts(con, k, "address not mapped");
        } else if why == 3 && class == 0x25 && esr & 64 != 0 {
            puts(con, k, "write to read-only memory");
        } else if why == 3 {
            puts(con, k, "permission denied");
        } else {
            puts(con, k, "other");
        }
    } else if sync {
        puts(con, k, "synchronous exception");
    } else if kind & 3 == 1 {
        puts(con, k, "unexpected irq");
    } else if kind & 3 == 2 {
        puts(con, k, "unexpected fiq");
    } else {
        puts(con, k, "serror");
    }
    puts(con, k, " (vector ");
    put_dec(con, k, kind);
    puts(con, k, ")\r\n    esr ");
    put_reg(con, k, esr);
    puts(con, k, "\r\n    elr ");
    put_reg(con, k, elr);
    puts(con, k, "\r\n    far ");
    put_reg(con, k, cpu_read(cpu, "far_el1"));
    return puts(con, k, "\r\nhalted.\r\n");
}

// ---- shell --------------------------------------------------------------------
fn same[&r, &s](line: &r [byte], n: int, word: &s [byte]) -> [] bool {
    if n != len(word) {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(line[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn run[&f, &mc, &mu, &mt, &mx, &mz, &s, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), k: &!s [int], line: &r [byte], n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001")] int {
    if n == 0 {
        return 0;
    }
    if same(line, n, "help") {
        puts(con, k, "commands: help, about, echo <text>, uptime, ticks, mem, random, net [up|down], net shell [on|off], ping <address>, servo scan, servo pos, arm zero, arm pose, arm check <5 angles>, crash [null|write]\r\n");
    } else if same(line, n, "about") {
        puts(con, k, "cancho-os 0.0.14: a kernel written in cancho, no Linux underneath (");
        if k[1] >= 3 {
            puts(con, k, "Raspberry Pi ");
            put_dec(con, k, k[1]);
        } else {
            puts(con, k, "QEMU virt");
        }
        puts(con, k, ")\r\n");
    } else if n > 5 && same(line, 5, "echo ") {
        var i = 5;
        while i < n {
            putc(con, k, int_of(line[i]));
            i = i + 1;
        }
        puts(con, k, "\r\n");
    } else if same(line, n, "uptime") {
        let ms = uptime_ms(cpu);
        put_dec(con, k, ms / 1000);
        puts(con, k, ".");
        put_dec(con, k, ms % 1000 / 100);
        put_dec(con, k, ms % 100 / 10);
        put_dec(con, k, ms % 10);
        puts(con, k, " s\r\n");
    } else if same(line, n, "ticks") {
        put_dec(con, k, k[5]);
        puts(con, k, " timer interrupts\r\n");
    } else if same(line, n, "mem") {
        memory_map(con, tab, code, k, false);
    } else if k[9] == 0 && same(line, n, "net up") {
        if k[15] != 0 {
            k[10] = 2;
        }
        put_net(con, k);
    } else if k[9] == 0 && (same(line, n, "servo scan") || same(line, n, "servo pos") || same(line, n, "arm pose") || n > 10 && same(line, 10, "arm check ")) {
        puts(con, k, "this board has no second serial port\r\n");
    } else if same(line, n, "net up") {
        k[10] = 1;
        put_net(con, k);
    } else if same(line, n, "net down") {
        k[10] = 0;
        put_net(con, k);
    } else if same(line, n, "net shell on") && k[26] != 0 {
        puts(con, k, "only from the serial console\r\n");
    } else if same(line, n, "net shell on") {
        k[30] = 23;
        puts(con, k, "the shell is on port 23: no password, not encrypted, for a cable you trust\r\n");
    } else if same(line, n, "net shell off") {
        k[30] = 0;
        puts(con, k, "port 23 is closed\r\n");
    } else if same(line, n, "net") {
        put_net(con, k);
    } else if k[10] != 0 && (same(line, n, "servo scan") || same(line, n, "servo pos") || same(line, n, "arm pose") || n > 10 && same(line, 10, "arm check ")) {
        puts(con, k, "the second serial port is the network link: `net down` first\r\n");
    } else if same(line, n, "servo scan") {
        servo_scan(cpu, con, bus, k);
    } else if same(line, n, "servo pos") {
        servo_pos(cpu, con, bus, k);
    } else if same(line, n, "arm zero") {
        arm_zero(con, k);
    } else if same(line, n, "arm pose") {
        arm_pose(cpu, con, bus, k);
    } else if n > 10 && same(line, 10, "arm check ") {
        arm_check(cpu, con, bus, k, line, 10, n);
    } else if same(line, n, "crash null") {
        // page 0 is not mapped
        mmio_read8(probe, 0);
    } else if same(line, n, "crash write") {
        // the kernel's own code is mapped read+execute
        mmio_write8(probe, k[14] + 0x80000, 0);
    } else if same(line, n, "crash") {
        // Read past the end of the line buffer: cancho's bounds check traps, and
        // the exception vector reports it instead of the machine hanging silently.
        putc(con, k, int_of(line[n + 4096]));
    } else {
        puts(con, k, "unknown command\r\n");
    }
    return 0;
}

fn shell[&f, &mc, &mi, &mu, &mr, &mv, &md, &mt, &mx, &mz, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntv_cval_el0"), cpu("cntvct_el0"), cpu("wfi"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000"), mmio("0x3f104000..0x3f10400c")] int {
    puts(con, k, "\r\ncancho-os booted. type `help`.\r\n");
    region r {
        let line = alloc_slice[r](128, byte_of(0));
        // the network link's: the SLIP decoder's state, a received packet, the reply, the reply framed
        let ns = alloc_slice[r](inet.slip_state(), 0);
        let frame = alloc_slice[r](1600, byte_of(0));
        let reply = alloc_slice[r](1600, byte_of(0));
        let wire = alloc_slice[r](2 * inet.mtu() + 2, byte_of(0));
        // the connections' state, and the one segment each may have out
        let tcp = alloc_slice[r](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[r](4 * inet.tcp_segment_max(), byte_of(0));
        // what has arrived for the shell's port and not been read, and the line being typed there
        let inbox = alloc_slice[r](4 * inet.tcp_inbox(), byte_of(0));
        let rline = alloc_slice[r](128, byte_of(0));
        var n = 0;
        puts(con, k, "> ");
        while true {
            let c = getc(cpu, con, irq, bus, rng, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rline);
            if c == -3 {
                k[26] = 1;
                puts(con, k, "cancho-os: the kernel's shell. One session, not encrypted. Type `help`.\r\n> ");
                k[26] = 0;
            } else if c == -2 {
                // a line from the network: the same commands, and what they print goes back there
                k[26] = 1;
                if same(rline, k[31], "random") {
                    put_random(con, rng, vio, dma, k);
                } else if k[31] > 5 && same(rline, 5, "ping ") {
                    net_ping(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rline, 5, k[31]);
                } else {
                    run(cpu, con, bus, tab, code, probe, k, rline, k[31]);
                }
                if k[33] != 0 {
                    k[33] = 0;
                    k[27] = 4000;
                    puts(con, k, "\r\n[more was printed than is kept: cut]\r\n");
                }
                puts(con, k, "> ");
                k[26] = 0;
                k[31] = 0;
            } else if c == 13 || c == 10 {
                puts(con, k, "\r\n");
                if same(line, n, "random") {
                    put_random(con, rng, vio, dma, k);
                } else if n > 5 && same(line, 5, "ping ") {
                    net_ping(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, line, 5, n);
                } else {
                    run(cpu, con, bus, tab, code, probe, k, line, n);
                }
                n = 0;
                puts(con, k, "> ");
            } else if (c == 127 || c == 8) && n > 0 {
                n = n - 1;
                putc(con, k, 8);
                putc(con, k, 32);
                putc(con, k, 8);
            } else if c >= 32 && c < 127 && n < 128 {
                line[n] = byte_of(c);
                n = n + 1;
                putc(con, k, c);
            }
        }
    }
    return 0;
}

fn kernel[&f, &mc, &mp, &mi, &mu, &mr, &mv, &md, &mt, &mx, &mz, &mq](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), pins: &!mp Mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), fault: &mq Mmio("0x208000..0x208008,0x40208000..0x40208008")) -> [cpu("cntfrq_el0"), cpu("cntv_ctl_el0"), cpu("cntv_cval_el0"), cpu("cntv_tval_el0"), cpu("cntvct_el0"), cpu("elr_el1"), cpu("esr_el1"), cpu("far_el1"), cpu("mair_el1"), cpu("midr_el1"), cpu("sctlr_el1"), cpu("tcr_el1"), cpu("tlbi_vmalle1"), cpu("ttbr0_el1"), cpu("wfi"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), mmio("0x208000..0x208008,0x40208000..0x40208008"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000"), mmio("0x3f104000..0x3f10400c")] int {
    region r {
        let k = alloc_slice[r](40 + 4096 + 16, 0);
        if detect(cpu, k) == 0 {
            // a board this kernel has no addresses for: nothing can even be printed
            return 1;
        }
        if mmio_read64(fault, k[14] + 0x208000) >= 0 {
            // entered again by the exception vector: say what happened, and stop
            return report_fault(cpu, con, code, fault, k);
        }
        uart_init(con, pins, k);
        // The tables start empty; table 0 of the pool is the top-level table.
        var slot = 0;
        while slot < 8 * 512 {
            mmio_write64(tab, k[14] + 0x200000 + slot * 8, 0);
            slot = slot + 1;
        }
        k[6] = 1;
        if memory_map(con, tab, code, k, true) != 0 {
            puts(con, k, "\r\nmemory map refused; running without the MMU\r\n");
        } else {
            mmu_on(cpu, k[14]);
        }
        tick_start(cpu, irq, k, 100);
        if k[9] != 0 {
            bus_init(bus, k);
        }
        if k[1] == 1 {
            vnet_start(vio, dma, k);
        }
        rng_start(rng, vio, dma, k);
        shell(cpu, con, irq, bus, rng, vio, dma, tab, code, probe, k);
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker, mmio, cpu } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(out);
    release(ports);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    release(camera);
    release(mic);
    release(speaker);
    // Every address, cut into what each driver holds. No two share one.
    let (con, pins, irq, bus, tab, code, probe, rest) = narrow(mmio, "0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048", "0x3f200004..0x3f200008,0xfe200004..0xfe200008", "0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014", "0x3f215004..0x3f21506c,0xfe215004..0xfe21506c", "0x200000..0x208000,0x40200000..0x40208000", "0x80001..0x200000,0x40080001..0x40200000", "0x0..0x1,0x80000..0x80001,0x40080000..0x40080001", "0x208000..0x208008,0x210000..0x220000,0xa000000..0xa004000,0x3f104000..0x3f10400c,0x40208000..0x40208008,0x40210000..0x40220000");
    // (`narrow` cuts at most eight pieces: the last is cut again)
    let (fault, dma, vio, rng) = narrow(rest, "0x208000..0x208008,0x40208000..0x40208008", "0x210000..0x220000,0x40210000..0x40220000", "0xa000000..0xa004000", "0x3f104000..0x3f10400c");
    var status = 0;
    borrow mut cpu as &!r in {
        borrow mut con as &!c in {
            borrow mut pins as &!p in {
                borrow mut irq as &!i in {
                    borrow mut bus as &!u in {
                        borrow mut tab as &!t in {
                            borrow code as &x in {
                                borrow mut probe as &!z in {
                                    borrow fault as &q in {
                                        borrow mut vio as &!v in {
                                            borrow mut dma as &!d in {
                                                borrow mut rng as &!g in {
                                                    status = kernel(r, c, p, i, u, g, v, d, t, x, z, q);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    release(cpu);
    release(con);
    release(pins);
    release(irq);
    release(bus);
    release(tab);
    release(code);
    release(probe);
    release(fault);
    release(vio);
    release(dma);
    release(rng);
    return status;
}
