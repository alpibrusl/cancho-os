// cancho-os: the kernel. Every driver here is cancho. A register is reached through
// an `Mmio`, a capability whose type names the addresses it holds: `main` is given
// every address, cuts it into the pieces below, and each function is lent the pieces
// it needs, so its signature says which hardware it can touch and the compiler holds
// it to that (cancho docs/mmio.md). A system register, `wfi` and the TLB flush are
// reached through the `Cpu` capability, and a row names each one (cancho docs/cpu.md).
// The kernel calls no foreign code: `cancho authority` lists the addresses, the
// registers and the instructions, and says the program is bounded.
//   con    the console: the PL011 of a Pi 3 or a Pi 4
//   pins   the one register that routes GPIO14/15 to it
//   irq    the interrupt controller: the Pi 3's per-core block, the Pi 4's GIC-400
//   bus    the second serial port, the mini UART: the servo bus, or the network link (`net up`)
//   tab    the eight translation tables (board/link.ld puts them at 2 MB)
//   code   the kernel's own image, to read the instruction a fault stopped at
//   probe  one byte of page 0 and one of the code, for `crash null` and `crash write`
//   fault  the word where board/boot.S notes the vector of a fault (-1: none)
//   vio    the virtio devices of QEMU's virt machine: the network card is one of them
//   dma    64 KB of memory a device reads and writes on its own: the card's queues and packets
// The link's two addresses the kernel needs (the end of the code and of the constants)
// are the words at 0x80010 and 0x80018 of the image, read through `code`.
// The kernel's state is one slice of ints, lent to whoever needs it (cancho has no
// mutable globals, and does not need them here):
//   k[0] UART base          k[1] board: Pi 3 or 4, 1 for QEMU virt (0: not recognised)
//   k[2] GIC CPU interface  k[3] GIC distributor (both 0 on the Pi 3)
//   k[4] counter units per tick   k[5] ticks so far
//   k[6] translation tables used  k[7] peripheral window start   k[8] its end
//   k[9] servo bus UART base (0: the board has no second serial port)
//   k[15] the virtio network card's registers (0: none)   k[16] k[17] k[18] its queues' counters   k[19] its address
//   k[14] where RAM starts: 0 on a Pi, 1 GB on QEMU's virt. The image, the tables and the fault note are at the same offsets from it
//   k[20] segments TCP took without a reply   k[21] k[22] the one neighbour remembered: its address, its card   k[23] pings sent
//   k[24] connections open   k[25] segments sent again
//   the shell over a connection: k[26] `putc` writes to it, not the serial port   k[27] bytes waiting to go there, at k[40..]
//   k[28] bytes of a telnet option still to skip   k[29] its connection, plus one (0: none)   k[30] its port (0: closed)
//   randomness: k[34] the generator (0 none, 1 virtio-rng, 3 the Pi 3's)   k[35] its registers   k[36] its queue's counter
//   k[4154] our address   k[4155] the mask of our network   k[4156] the gateway   k[4157] the name server (0: none)   k[4158] the lease, s
//   k[4174] a port that was just closed, whose connections are to be hung up on
//   k[39] a command is waiting on the network (the shell's connection is not read)   k[4152] `exit` was typed over the connection
//   k[37] words ready, at k[4136..]   k[38] words used to begin connections
//   k[31] the length of the line typed there   k[32] its last byte was a carriage return   k[33] bytes printed and not kept
//   k[10] the network link is up   k[11] packets answered   k[12] packets dropped   k[13] why the last one was
// The system registers, by the numbers board_sys_read/board_sys_write take:
//   0 cntfrq_el0  1 cntvct_el0  2 cntv_ctl_el0  3 cntv_cval_el0  4 cntv_tval_el0
//   5 mair_el1    6 tcr_el1     7 ttbr0_el1     8 sctlr_el1      9 midr_el1

// ---- which board ------------------------------------------------------------
// One image for every board: the CPU says which one this is.
fn detect[&f, &s](cpu: &!f Cpu, k: &!s [int]) -> [cpu("midr_el1")] int {
    let part = cpu_read(cpu, "midr_el1") >> 4 & 0xfff;
    if part == 0xd03 {
        // Cortex-A53: Raspberry Pi 3 (BCM2837), and QEMU raspi3b
        k[1] = 3;
        k[0] = 0x3f201000;
        k[9] = 0x3f215000;
        k[7] = 0x3f000000;
        k[8] = 0x40200000;
    } else if part == 0xd08 {
        // Cortex-A72: Raspberry Pi 4 (BCM2711)
        k[1] = 4;
        k[0] = 0xfe201000;
        k[9] = 0xfe215000;
        k[2] = 0xff842000;
        k[3] = 0xff841000;
        k[7] = 0xfc000000;
        k[8] = 0x100000000;
    } else if part == 0xd0b {
        // Cortex-A76: Raspberry Pi 5 (BCM2712). Read from a running board's device tree
        // (docs/pi5.md); never run. Its own devices are above 64 GB: the debug connector's
        // PL011, and the same interrupt controller as a Pi 4. No second serial port: the
        // header's are behind the RP1 chip, and the robot's servo adapters behind USB.
        k[1] = 5;
        k[0] = 0x107d001000;
        k[2] = 0x107fffa000;
        k[3] = 0x107fff9000;
        k[7] = 0x107c000000;
        k[8] = 0x1080000000;
    } else if part == 0xd07 {
        // Cortex-A57: no Pi has one. It is how QEMU's `virt` machine is run here (run.sh, test.sh):
        // a PL011, a GIC and virtio devices, and RAM that starts at 1 GB instead of 0
        k[1] = 1;
        k[0] = 0x9000000;
        k[2] = 0x8010000;
        k[3] = 0x8000000;
        k[7] = 0x8000000;
        k[8] = 0xa200000;
        k[14] = 0x40000000;
    }
    return k[1];
}

// ---- UART (PL011) -----------------------------------------------------------
fn uart_init[&mc, &mp, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), pins: &!mp Mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008")] int {
    let uart = k[0];
    let gpio = uart - 0x1000;
    mmio_write32(con, uart + 0x30, 0);
    if k[1] == 3 || k[1] == 4 {
        // GPFSEL1: GPIO14/15 to ALT0 (TXD0/RXD0). (QEMU's virt has no pins to route.)
        let sel = mmio_read32(pins, gpio + 4) & ~(7 << 12 | 7 << 15);
        mmio_write32(pins, gpio + 4, sel | 4 << 12 | 4 << 15);
    }
    mmio_write32(con, uart + 0x44, 0x7ff);
    if k[1] == 5 {
        // a Pi 5's debug port has its own pins and a clock of 44,236,800 Hz: 115200 baud is 24 exactly
        mmio_write32(con, uart + 0x24, 24);
        mmio_write32(con, uart + 0x28, 0);
    } else {
        // 115200 baud from a 48 MHz UART clock (QEMU's virt ignores the divisor)
        mmio_write32(con, uart + 0x24, 26);
        mmio_write32(con, uart + 0x28, 3);
    }
    // 8N1, FIFOs on
    mmio_write32(con, uart + 0x2c, 3 << 5 | 1 << 4);
    return mmio_write32(con, uart + 0x30, 1 | 1 << 8 | 1 << 9);
}






// All sixteen digits, for a register.
fn put_reg[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    base.puts(con, k, "0x");
    var shift = 60;
    while shift >= 0 {
        base.put_digit(con, k, v >> shift & 15);
        shift = shift - 4;
    }
    return 0;
}

// ---- time: the ARM generic timer, polled -------------------------------------
// Interrupts stay masked in the CPU. The timer still raises its line through the
// board's interrupt controller, which is what wakes `wfi`; the kernel then asks
// the controller what happened. No handler runs behind cancho's back, so there
// is no state shared with one.
fn tick_start[&f, &mi, &s](cpu: &!f Cpu, irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), k: &!s [int], hz: int) -> [cpu("cntfrq_el0"), cpu("cntv_ctl_el0"), cpu("cntv_tval_el0"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014")] int {
    k[4] = cpu_read(cpu, "cntfrq_el0") / hz;
    if k[2] != 0 {
        // GIC-400: virtual timer is private interrupt 27
        let gicd = k[3];
        mmio_write32(irq, gicd, 0);
        let prio = mmio_read32(irq, gicd + 0x400 + 24) & 0xffffff;
        mmio_write32(irq, gicd + 0x400 + 24, prio | 0xa0 << 24);
        mmio_write32(irq, gicd + 0x100, 1 << 27);
        mmio_write32(irq, gicd, 1);
        mmio_write32(irq, k[2] + 4, 0xff);
        mmio_write32(irq, k[2], 1);
    } else {
        // BCM2836 per-core block: route the virtual timer to core 0
        mmio_write32(irq, 0x40000040, 8);
    }
    cpu_write(cpu, "cntv_tval_el0", k[4]);
    return cpu_write(cpu, "cntv_ctl_el0", 1);
}

fn tick[&f, &s](cpu: &!f Cpu, k: &!s [int]) -> [cpu("cntv_cval_el0")] int {
    // from the last deadline, not from now: no drift
    cpu_write(cpu, "cntv_cval_el0", cpu_read(cpu, "cntv_cval_el0") + k[4]);
    k[5] = k[5] + 1;
    return 0;
}

// What the interrupt controller has pending, handled here and now.
fn poll[&f, &mi, &s](cpu: &!f Cpu, irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), k: &!s [int]) -> [cpu("cntv_cval_el0"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014")] int {
    if k[4] == 0 {
        return 0;
    }
    if k[2] != 0 {
        let iar = mmio_read32(irq, k[2] + 0xc);
        let id = iar & 0x3ff;
        if id == 27 {
            tick(cpu, k);
        }
        if id < 1020 {
            mmio_write32(irq, k[2] + 0x10, iar);
        }
    } else if mmio_read32(irq, 0x40000060) & 8 != 0 {
        tick(cpu, k);
    }
    return 0;
}


// (It also answers -2 or -3 when the network has something for the shell: see `session`.)
// Sleep until a key arrives, handling whatever else wakes the core meanwhile. While the
// network link is up the core does not sleep: nothing wakes it when a byte arrives on the
// link (interrupts are polled, and the tick is every 10 ms), so it keeps looking.
fn getc[&f, &mc, &mi, &mu, &mr, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l, &si, &sb, &sx](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), vio: &!mv Mmio("0xa000000..0xa004000,0xfd580000..0xfd590000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], si: &!si [int], sb: &!sb [byte], sx: &!sx [byte]) -> [cpu("cntfrq_el0"), cpu("cntv_cval_el0"), cpu("cntvct_el0"), cpu("wfi"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0xa000000..0xa004000,0xfd580000..0xfd590000")] int {
    let uart = k[0];
    while mmio_read32(con, uart + 0x18) & 16 != 0 {
        if k[37] < 16 && k[34] != 0 {
            network.rng_fill(rng, vio, dma, k);
        }
        if k[10] != 0 {
            let ready = network.net_poll(bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rline, si, sb, sx, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
            if ready != 0 {
                // not a key: -2 a line from the network is ready, -3 a connection is to be greeted, -4 the
                // SSH host key has just been made
                return -1 - ready;
            }
        } else if k[4] != 0 {
            cpu_do(cpu, "wfi");
        }
        poll(cpu, irq, k);
    }
    return mmio_read32(con, uart) & 255;
}


// ---- the servo bus --------------------------------------------------------------
// The arm's servos (Feetech STS) share one serial line. On the emulated boards it is
// the second UART, the BCM283x "mini UART"; a Pi 5 will use a PL011 behind RP1, so
// these four functions are the part that is rewritten for it, and nothing above them is.
// Register offsets: 0x04 enables, 0x40 data, 0x44 interrupt enable, 0x48 FIFO control,
// 0x4c line control, 0x54 line status (bit 0 a byte is waiting, bit 5 room to send),
// 0x60 control, 0x68 baud.
fn bus_init[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    mmio_write32(bus, u + 4, 1);
    mmio_write32(bus, u + 0x60, 0);
    mmio_write32(bus, u + 0x44, 0);
    mmio_write32(bus, u + 0x4c, 3);
    mmio_write32(bus, u + 0x48, 0xc6);
    // 1 Mbaud from a 500 MHz core clock would be 61.5: not exact, and the emulator ignores
    // it. The real bus is the Pi 5 driver's problem.
    mmio_write32(bus, u + 0x68, 61);
    return mmio_write32(bus, u + 0x60, 3);
}



// What `transact` answers besides what `feetech.decode` does.
fn bus_timeout() -> [] int {
    return -90;
}

fn bus_overflow() -> [] int {
    return -91;
}

// Send `pkt[0..n]` and collect the status packet of servo `id` into `reply`, for at most
// `timeout_us`. Bytes already waiting are dropped first: a late answer to an earlier
// request must not be read as this one's. Answers what `feetech.decode` answers (the end
// of the packet, with `table` filled, or one of its errors), or `bus_timeout`/`bus_overflow`.
// The same shape as cancho-robot's `serial.transact`, on our own driver.
fn transact[&f, &mu, &s, &p, &r, &t](cpu: &!f Cpu, bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], pkt: &p [byte], n: int, reply: &!r [byte], id: int, table: &!t [int], timeout_us: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    while base.bus_get(bus, k) >= 0 {
    }
    var i = 0;
    while i < n {
        base.bus_put(bus, k, int_of(pkt[i]));
        i = i + 1;
    }
    let start = base.now_us(cpu);
    var got = 0;
    var result = feetech.need_more();
    while result == feetech.need_more() {
        let c = base.bus_get(bus, k);
        if c >= 0 {
            if got >= len(reply) {
                result = bus_overflow();
            } else {
                reply[got] = byte_of(c);
                got = got + 1;
                result = feetech.decode(reply[0..got], id, table);
            }
        } else if base.now_us(cpu) - start > timeout_us {
            result = bus_timeout();
        }
    }
    return result;
}

fn put_bus_error[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], code: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if code == bus_timeout() {
        return base.puts(con, k, "no answer");
    }
    if code == bus_overflow() {
        return base.puts(con, k, "answer too long");
    }
    return base.puts(con, k, feetech.error_tag(code));
}

// `servo scan`: ping ids 1 to 8 and say who answered. Read-only: this kernel builds no
// packet that can move a servo (src/feetech.cho has none).
fn servo_scan[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var found = 0;
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var id = 1;
        while id <= 8 {
            let n = feetech.ping(pkt, id);
            let got = transact(cpu, bus, k, pkt, n, reply, id, table, 20000);
            base.puts(con, k, "servo ");
            base.put_dec(con, k, id);
            if got > 0 {
                base.puts(con, k, ": present\r\n");
                found = found + 1;
            } else {
                base.puts(con, k, ": ");
                put_bus_error(con, k, got);
                base.puts(con, k, "\r\n");
            }
            id = id + 1;
        }
    }
    base.put_dec(con, k, found);
    return base.puts(con, k, " servos found\r\n");
}

// `servo pos`: the present position (register 56, two bytes) of servos 1 to 6, in raw ticks.
fn servo_pos[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var id = 1;
        while id <= 6 {
            let n = feetech.read(pkt, id, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, id, table, 20000);
            base.puts(con, k, "servo ");
            base.put_dec(con, k, id);
            if got > 0 && table[3] == 2 {
                base.puts(con, k, ": position ");
                base.put_dec(con, k, feetech.u16(reply, table[2]));
                base.puts(con, k, "\r\n");
            } else {
                base.puts(con, k, ": ");
                put_bus_error(con, k, got);
                base.puts(con, k, "\r\n");
            }
            id = id + 1;
        }
    }
    return 0;
}

// ---- the arm: ticks to degrees to where the gripper is ----------------------------
// Calibration and kinematics are cancho-robot's, unchanged (src/calibration.cho,
// src/kinematics.cho, src/so101.cho): there they are held to LeRobot and to placo. What
// is checked here is that they compute the same with no system under them.
//
// The span of each joint, in ticks: the left arm's calibration in cancho-robot
// (tests/fixtures/calibration/xle_left.json). A table in the kernel for now; it belongs
// to the robot, and will come with whatever hands the kernel its bus.
fn span_min(joint: int) -> [] int {
    if joint == 0 {
        return 884;
    }
    if joint == 1 {
        return 1056;
    }
    if joint == 2 {
        return 885;
    }
    if joint == 3 {
        return 2060;
    }
    return 0;
}

fn span_max(joint: int) -> [] int {
    if joint == 0 {
        return 3460;
    }
    if joint == 1 {
        return 3116;
    }
    if joint == 2 {
        return 3057;
    }
    if joint == 3 {
        return 3773;
    }
    return 4095;
}

fn put_int[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if v < 0 {
        base.putc(con, k, 45);
        return base.put_dec(con, k, 0 - v);
    }
    return base.put_dec(con, k, v);
}

// Where the gripper frame is for five joint angles, in micrometres, in the base's frame.
fn put_gripper[&mc, &s, &d](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], degrees: &d [float]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    region r {
        let pose = alloc_slice[r](16, 0.0);
        if kinematics.forward(degrees, pose) != 0 {
            return base.puts(con, k, "kinematics refused the angles\r\n");
        }
        base.puts(con, k, "gripper at x ");
        put_int(con, k, truncate(pose[3] * 1000000.0));
        base.puts(con, k, " y ");
        put_int(con, k, truncate(pose[7] * 1000000.0));
        base.puts(con, k, " z ");
        put_int(con, k, truncate(pose[11] * 1000000.0));
    }
    return base.puts(con, k, " um\r\n");
}

// `arm zero`: the pose with every joint at zero. No bus involved: placo puts it at
// x 0.3913614702201581, y -9.212063114501261e-06, z 0.2264697102403328 metres.
fn arm_zero[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    region r {
        let degrees = alloc_slice[r](5, 0.0);
        put_gripper(con, k, degrees);
    }
    return 0;
}

// `arm pose`: read joints 1 to 5 from the bus, turn ticks into degrees, and say where
// that puts the gripper. Read-only.
fn arm_pose[&f, &mc, &mu, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        let degrees = alloc_slice[r](5, 0.0);
        var joint = 0;
        var bad = 0;
        while joint < 5 && bad == 0 {
            let n = feetech.read(pkt, joint + 1, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, joint + 1, table, 20000);
            if got > 0 && table[3] == 2 {
                degrees[joint] = calibration.degrees(feetech.u16(reply, table[2]), span_min(joint), span_max(joint));
                base.puts(con, k, "joint ");
                base.put_dec(con, k, joint + 1);
                base.puts(con, k, ": ");
                put_int(con, k, truncate(degrees[joint] * 1000.0));
                base.puts(con, k, " mdeg\r\n");
            } else {
                base.puts(con, k, "joint ");
                base.put_dec(con, k, joint + 1);
                base.puts(con, k, ": ");
                put_bus_error(con, k, got);
                base.puts(con, k, "\r\n");
                bad = 1;
            }
            joint = joint + 1;
        }
        if bad == 0 {
            put_gripper(con, k, degrees);
        }
    }
    return 0;
}

// ---- the safety core, judging -----------------------------------------------------
// `arm check a1 a2 a3 a4 a5`: would the safety core let the arm go to these five angles
// (whole degrees) from where it is now? cancho-robot's `safety.approve`, unchanged, on the
// pose read from the bus: joint limits from the calibration spans, the workspace in the
// arm's own frame, the jump bound, the capsule collisions (tower and tray; the other arm
// is taken as absent), then the speed clamp for a 10 ms cycle. It answers and sends
// nothing: the kernel still holds no packet that moves a servo.

// Up to `len(out)` whole numbers, each possibly negative, from `line[from..n]`, separated
// by spaces. How many were read; -1 for anything that is not one.
fn numbers[&r, &o](line: &r [byte], from: int, n: int, out: &!o [int]) -> [] int {
    var i = from;
    var count = 0;
    var bad = false;
    while i < n && !bad {
        if int_of(line[i]) == 32 {
            i = i + 1;
        } else {
            var negative = false;
            if int_of(line[i]) == 45 {
                negative = true;
                i = i + 1;
            }
            var digits = 0;
            var v = 0;
            while i < n && int_of(line[i]) >= 48 && int_of(line[i]) <= 57 && digits < 6 {
                v = v * 10 + int_of(line[i]) - 48;
                digits = digits + 1;
                i = i + 1;
            }
            if digits == 0 || count >= len(out) || i < n && int_of(line[i]) != 32 {
                bad = true;
            } else {
                if negative {
                    v = 0 - v;
                }
                out[count] = v;
                count = count + 1;
            }
        }
    }
    if bad {
        return -1;
    }
    return count;
}

// Joints 1 to 5 from the bus, in degrees. 0, or the bus error (and which joint in `at`).
fn read_joints[&f, &mu, &s, &d, &a](cpu: &!f Cpu, bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], degrees: &!d [float], at: &!a [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var result = 0;
    region r {
        let pkt = alloc_slice[r](16, byte_of(0));
        let reply = alloc_slice[r](64, byte_of(0));
        let table = alloc_slice[r](feetech.slots(), 0);
        var joint = 0;
        while joint < 5 && result == 0 {
            let n = feetech.read(pkt, joint + 1, 56, 2);
            let got = transact(cpu, bus, k, pkt, n, reply, joint + 1, table, 20000);
            if got > 0 && table[3] == 2 {
                degrees[joint] = calibration.degrees(feetech.u16(reply, table[2]), span_min(joint), span_max(joint));
            } else {
                at[0] = joint;
                result = got;
                if got >= 0 {
                    result = feetech.error_bad_length();
                }
            }
            joint = joint + 1;
        }
    }
    return result;
}

fn arm_check[&f, &mc, &mu, &s, &l](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], line: &l [byte], from: int, n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    region r {
        let wanted = alloc_slice[r](5, 0);
        if numbers(line, from, n, wanted) != 5 {
            return base.puts(con, k, "usage: arm check a1 a2 a3 a4 a5 (whole degrees)\r\n");
        }
        let current = alloc_slice[r](5, 0.0);
        let at = alloc_slice[r](1, 0);
        let read = read_joints(cpu, bus, k, current, at);
        if read != 0 {
            base.puts(con, k, "joint ");
            base.put_dec(con, k, at[0] + 1);
            base.puts(con, k, ": ");
            put_bus_error(con, k, read);
            return base.puts(con, k, "\r\n");
        }
        let request = alloc_slice[r](5, 0.0);
        let limits = alloc_slice[r](10, 0.0);
        var j = 0;
        while j < 5 {
            request[j] = float_of(wanted[j]);
            limits[j * 2] = calibration.degrees(span_min(j), span_min(j), span_max(j));
            limits[j * 2 + 1] = calibration.degrees(span_max(j), span_min(j), span_max(j));
            j = j + 1;
        }
        let goals = alloc_slice[r](5, 0.0);
        let scale = alloc_slice[r](1, 0.0);
        let joint = alloc_slice[r](1, 0);
        let other = alloc_slice[r](0, 0.0);
        // the left arm's mount on the robot (cancho-robot tests/safety_driver.cho)
        let mount = safety.Mount { x: -0.135, y: 0.133, z: 0.76, yaw_deg: 0.0 };
        var rule = 0;
        borrow mount as &m in {
            rule = safety.approve(request, current, limits, m, other, 0, 10, goals, scale, joint);
        }
        if rule == safety.rule_ok() {
            base.puts(con, k, "approved");
            if scale[0] < 1.0 {
                base.puts(con, k, ", slowed to ");
                put_int(con, k, truncate(scale[0] * 1000.0));
                base.puts(con, k, " per mille of the step");
            }
            base.puts(con, k, "\r\ngoals:");
            j = 0;
            while j < 5 {
                base.puts(con, k, " ");
                put_int(con, k, truncate(goals[j] * 1000.0));
                j = j + 1;
            }
            base.puts(con, k, " mdeg\r\n");
        } else {
            base.puts(con, k, "refused: ");
            base.puts(con, k, safety.rule_name(rule));
            if joint[0] >= 0 {
                base.puts(con, k, " (joint ");
                base.put_dec(con, k, joint[0] + 1);
                base.puts(con, k, ")");
            }
            base.puts(con, k, "\r\n");
        }
    }
    return base.puts(con, k, "nothing was sent\r\n");
}

// ---- memory: identity-mapped translation tables ---------------------------------
// 4 KB granule, 39-bit addresses, so level 1 is the top table. A descriptor is the
// address, the attributes below, and bit 0 (valid); bit 1 says "table" at levels 1
// and 2, and "page" at level 3.
// perm: 0 read+execute, 1 read-only, 2 read+write, 3 device (read+write, uncached)
fn attrs(perm: int) -> [] int {
    let af = 1 << 10;
    let inner = 3 << 8;
    let ro = 1 << 7;
    let pxn = 1 << 53;
    let uxn = 1 << 54;
    if perm == 0 {
        return af | inner | ro | uxn;
    }
    if perm == 1 {
        return af | inner | ro | pxn | uxn;
    }
    if perm == 2 {
        return af | inner | pxn | uxn;
    }
    // memory attribute 1 (device)
    return af | pxn | uxn | 4;
}

// The table a descriptor slot points to, made if the slot is empty. 0: none left,
// or the slot already maps a block.
fn next_table[&mt, &s](tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), k: &!s [int], slot: int) -> [mmio("0x200000..0x208000,0x40200000..0x40208000")] int {
    let d = mmio_read64(tab, slot);
    if d & 1 != 0 {
        if d & 2 == 0 {
            return 0;
        }
        return d & 0xfffffffff000;
    }
    if k[6] >= 8 {
        return 0;
    }
    let table = k[14] + 0x200000 + k[6] * 4096;
    k[6] = k[6] + 1;
    mmio_write64(tab, slot, table | 3);
    return table;
}

// Identity-map [start, end) with one permission: 1 GB and 2 MB blocks where the
// range allows, 4 KB pages elsewhere. 0, or 1 when it cannot be done.
fn map[&mt, &s](tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), k: &!s [int], start: int, end: int, perm: int) -> [mmio("0x200000..0x208000,0x40200000..0x40208000")] int {
    if (start | end) & 0xfff != 0 || start > end || end > 1 << 39 {
        return 1;
    }
    let a = attrs(perm);
    let top = k[14] + 0x200000;
    var va = start;
    var bad = 0;
    while va < end && bad == 0 {
        let l1 = top + (va >> 30) * 8;
        if va & 0x3fffffff == 0 && end - va >= 1 << 30 && mmio_read64(tab, l1) & 1 == 0 {
            mmio_write64(tab, l1, va | a | 1);
            va = va + (1 << 30);
        } else {
            let l2t = next_table(tab, k, l1);
            if l2t == 0 {
                bad = 1;
            } else {
                let l2 = l2t + (va >> 21 & 511) * 8;
                if va & 0x1fffff == 0 && end - va >= 1 << 21 && mmio_read64(tab, l2) & 1 == 0 {
                    mmio_write64(tab, l2, va | a | 1);
                    va = va + (1 << 21);
                } else {
                    let l3t = next_table(tab, k, l2);
                    if l3t == 0 {
                        bad = 1;
                    } else {
                        mmio_write64(tab, l3t + (va >> 12 & 511) * 8, va | a | 3);
                        va = va + 4096;
                    }
                }
            }
        }
    }
    return bad;
}

// One line of the memory map: map the range (when `apply`) or print it.
fn range[&mc, &mt, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), k: &!s [int], apply: bool, name: &r [byte], start: int, end: int, perm: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x200000..0x208000,0x40200000..0x40208000")] int {
    if apply {
        return map(tab, k, start, end, perm);
    }
    base.puts(con, k, "  0x");
    base.put_hex(con, k, start);
    base.puts(con, k, " - 0x");
    base.put_hex(con, k, end);
    if perm == 0 {
        base.puts(con, k, "  r-x  ");
    } else if perm == 1 {
        base.puts(con, k, "  r--  ");
    } else if perm == 2 {
        base.puts(con, k, "  rw-  ");
    } else {
        base.puts(con, k, "  rw- device  ");
    }
    base.puts(con, k, name);
    base.puts(con, k, "\r\n");
    return 0;
}

// The whole address space the kernel may touch. Everything else, page 0 included,
// is unmapped: a null dereference is a fault, not a read of whatever is there.
fn memory_map[&mc, &mt, &mx, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), k: &!s [int], apply: bool) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000")] int {
    let image = k[14] + 0x80000;
    let code_end = mmio_read64(code, image + 0x10);
    let const_end = mmio_read64(code, image + 0x18);
    var bad = range(con, tab, k, apply, "stack", k[14] + 4096, image, 2);
    bad = bad + range(con, tab, k, apply, "kernel code", image, code_end, 0);
    bad = bad + range(con, tab, k, apply, "kernel constants", code_end, const_end, 1);
    // the first 960 MB: present on every board, below the GPU's share
    bad = bad + range(con, tab, k, apply, "kernel data", const_end, k[14] + 0x210000, 2);
    // what a network card reads and writes on its own is not cached: the kernel and the card must see
    // the same bytes, and the processor's cache-maintenance instructions are not ones `Cpu` offers
    bad = bad + range(con, tab, k, apply, "a card's memory", k[14] + 0x210000, k[14] + 0x220000, 3);
    bad = bad + range(con, tab, k, apply, "kernel data and heap", k[14] + 0x220000, k[14] + 0x3c000000, 2);
    bad = bad + range(con, tab, k, apply, "peripherals", k[7], k[8], 3);
    return bad;
}

// Translation and the caches on. From here an access outside the map is a fault,
// and so is a write to code or constants, or a jump into data (WXN).
fn mmu_on[&f](cpu: &!f Cpu, ram: int) -> [cpu("mair_el1"), cpu("sctlr_el1"), cpu("tcr_el1"), cpu("tlbi_vmalle1"), cpu("ttbr0_el1")] int {
    // attribute 0: normal memory, write-back; attribute 1: device
    cpu_write(cpu, "mair_el1", 0xff | 4 << 8);
    // 39-bit addresses; cacheable, inner-shareable table walks; no upper half yet; 40-bit physical
    cpu_write(cpu, "tcr_el1", 25 | 1 << 8 | 1 << 10 | 3 << 12 | 1 << 23 | 2 << 32);
    cpu_write(cpu, "ttbr0_el1", ram + 0x200000);
    cpu_do(cpu, "tlbi_vmalle1");
    // the bits that must be one, then MMU, data cache, instruction cache, WXN
    return cpu_write(cpu, "sctlr_el1", 0x30d00800 | 1 | 1 << 2 | 1 << 12 | 1 << 19);
}

// ---- faults -------------------------------------------------------------------
// board/boot.S records an exception and calls main again; this is what main does then.
fn report_fault[&f, &mc, &mx, &mq, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), fault: &mq Mmio("0x208000..0x208008,0x40208000..0x40208008"), k: &!s [int]) -> [cpu("elr_el1"), cpu("esr_el1"), cpu("far_el1"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x208000..0x208008,0x40208000..0x40208008")] int {
    let kind = mmio_read64(fault, k[14] + 0x208000);
    let esr = cpu_read(cpu, "esr_el1");
    let elr = cpu_read(cpu, "elr_el1");
    let class = esr >> 26 & 63;
    let sync = kind & 3 == 0;
    base.puts(con, k, "\r\n*** ");
    // (only an address inside the image is read: a jump into nowhere must not fault again here)
    var stopped_at = 0;
    if elr >= k[14] + 0x80004 && elr < k[14] + 0x200000 - 3 && elr & 3 == 0 {
        stopped_at = mmio_read32(code, elr);
    }
    if sync && class == 0 && stopped_at == 0xc11f {
        // cancho's own checks (bounds, overflow, ...) end in `udf #0xc11f`
        base.puts(con, k, "cancho trap");
    } else if sync && (class == 0x25 || class == 0x21) {
        if class == 0x25 {
            base.puts(con, k, "data abort: ");
        } else {
            base.puts(con, k, "instruction abort: ");
        }
        let why = esr >> 2 & 15;
        if why == 1 {
            base.puts(con, k, "address not mapped");
        } else if why == 3 && class == 0x25 && esr & 64 != 0 {
            base.puts(con, k, "write to read-only memory");
        } else if why == 3 {
            base.puts(con, k, "permission denied");
        } else {
            base.puts(con, k, "other");
        }
    } else if sync {
        base.puts(con, k, "synchronous exception");
    } else if kind & 3 == 1 {
        base.puts(con, k, "unexpected irq");
    } else if kind & 3 == 2 {
        base.puts(con, k, "unexpected fiq");
    } else {
        base.puts(con, k, "serror");
    }
    base.puts(con, k, " (vector ");
    base.put_dec(con, k, kind);
    base.puts(con, k, ")\r\n    esr ");
    put_reg(con, k, esr);
    base.puts(con, k, "\r\n    elr ");
    put_reg(con, k, elr);
    base.puts(con, k, "\r\n    far ");
    put_reg(con, k, cpu_read(cpu, "far_el1"));
    return base.puts(con, k, "\r\nhalted.\r\n");
}

// ---- shell --------------------------------------------------------------------
fn same[&r, &s](line: &r [byte], n: int, word: &s [byte]) -> [] bool {
    if n != len(word) {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(line[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn run[&f, &mc, &mu, &mt, &mx, &mz, &s, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), k: &!s [int], line: &r [byte], n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001")] int {
    if n == 0 {
        return 0;
    }
    if same(line, n, "help") {
        base.puts(con, k, "commands: help, about, echo <text>, uptime, ticks, mem, board, random, disk, ls, cat <name>, sum <name>, write <name> <text>, append <name> <text>, copy <from> <to>, net [up|down|eth|dhcp], net shell [on|off], net ssh [on|off], lookup <name>, ping <address or name>, http <address or name> <port>, servo scan, servo pos, arm zero, arm pose, arm check <5 angles>, crash [null|write], load <bytes>\r\n");
    } else if same(line, n, "about") {
        base.puts(con, k, "cancho-os 0.0.25: a kernel written in cancho (");
        if k[1] >= 3 {
            base.puts(con, k, "Raspberry Pi ");
            base.put_dec(con, k, k[1]);
        } else {
            base.puts(con, k, "QEMU virt");
        }
        base.puts(con, k, ")\r\n");
    } else if n > 5 && same(line, 5, "echo ") {
        var i = 5;
        while i < n {
            base.putc(con, k, int_of(line[i]));
            i = i + 1;
        }
        base.puts(con, k, "\r\n");
    } else if same(line, n, "uptime") {
        let ms = base.uptime_ms(cpu);
        base.put_dec(con, k, ms / 1000);
        base.puts(con, k, ".");
        base.put_dec(con, k, ms % 1000 / 100);
        base.put_dec(con, k, ms % 100 / 10);
        base.put_dec(con, k, ms % 10);
        base.puts(con, k, " s\r\n");
    } else if same(line, n, "ticks") {
        base.put_dec(con, k, k[5]);
        base.puts(con, k, " timer interrupts\r\n");
    } else if same(line, n, "mem") {
        memory_map(con, tab, code, k, false);
    } else if k[9] == 0 && same(line, n, "net up") {
        if k[15] != 0 {
            k[10] = 2;
        }
        network.put_net(con, k);
    } else if k[9] == 0 && (same(line, n, "servo scan") || same(line, n, "servo pos") || same(line, n, "arm pose") || n > 10 && same(line, 10, "arm check ")) {
        base.puts(con, k, "this board has no second serial port\r\n");
    } else if same(line, n, "net up") {
        k[10] = 1;
        network.put_net(con, k);
    } else if same(line, n, "net down") {
        k[10] = 0;
        network.put_net(con, k);
    } else if same(line, n, "net shell on") && k[26] != 0 {
        base.puts(con, k, "only from the serial console\r\n");
    } else if same(line, n, "net shell on") {
        k[30] = 23;
        k[4153] = 0;
        k[29] = 0;
        base.puts(con, k, "the shell is on port 23: no password, not encrypted, for a cable you trust\r\n");
    } else if same(line, n, "net shell off") {
        k[4174] = k[30];
        k[30] = 0;
        base.puts(con, k, "port 23 is closed\r\n");
    } else if same(line, n, "net") {
        network.put_net(con, k);
    } else if k[10] != 0 && (same(line, n, "servo scan") || same(line, n, "servo pos") || same(line, n, "arm pose") || n > 10 && same(line, 10, "arm check ")) {
        base.puts(con, k, "the second serial port is the network link: `net down` first\r\n");
    } else if same(line, n, "servo scan") {
        servo_scan(cpu, con, bus, k);
    } else if same(line, n, "servo pos") {
        servo_pos(cpu, con, bus, k);
    } else if same(line, n, "arm zero") {
        arm_zero(con, k);
    } else if same(line, n, "arm pose") {
        arm_pose(cpu, con, bus, k);
    } else if n > 10 && same(line, 10, "arm check ") {
        arm_check(cpu, con, bus, k, line, 10, n);
    } else if same(line, n, "crash null") {
        // page 0 is not mapped
        mmio_read8(probe, 0);
    } else if same(line, n, "crash write") {
        // the kernel's own code is mapped read+execute
        mmio_write8(probe, k[14] + 0x80000, 0);
    } else if same(line, n, "crash") {
        // Read past the end of the line buffer: cancho's bounds check traps, and
        // the exception vector reports it instead of the machine hanging silently.
        base.putc(con, k, int_of(line[n + 4096]));
    } else {
        base.puts(con, k, "unknown command\r\n");
    }
    return 0;
}

// Who may log in: the keys built into the image, which are owners', then those of KEYS.TXT on the disk,
// each with the role its line gives it (src/keys.cho). Read again whenever the file may have changed.
fn load_keys[&mv, &md, &s, &x](vio: &!mv Mmio("0xa000000..0xa004000,0xfd580000..0xfd590000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sx: &!x [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0xfd580000..0xfd590000")] int {
    region r {
        let file = alloc_slice[r](2048, byte_of(0));
        let roles = alloc_slice[r](8, 0);
        let skipped = alloc_slice[r](1, 0);
        var i = 0;
        while i < k[4180] && i < 8 {
            roles[i] = keys.owner();
            i = i + 1;
        }
        k[4164] = k[4180];
        k[4182] = 0;
        let n = disk.get(vio, dma, k, "KEYS.TXT", file);
        if n > 0 {
            k[4164] = keys.load(file, n, sx[352..608], roles, k[4180], skipped);
            k[4182] = skipped[0];
        }
        var mask = 0;
        i = 0;
        while i < k[4164] {
            if roles[i] == keys.owner() {
                mask = mask | 1 << i;
            }
            i = i + 1;
        }
        k[4177] = mask;
    }
    return k[4164];
}

// May a key that can only read run this line? The commands that change nothing and reach nowhere.
fn reading[&r](line: &r [byte], n: int) -> [] bool {
    if same(line, n, "help") || same(line, n, "about") || same(line, n, "uptime") || same(line, n, "ticks") || same(line, n, "mem") || same(line, n, "board") {
        return true;
    }
    if same(line, n, "net") || same(line, n, "disk") || same(line, n, "ls") || same(line, n, "versions") || same(line, n, "exit") || same(line, n, "arm zero") || n == 0 {
        return true;
    }
    return n > 4 && (same(line, 4, "cat ") || same(line, 4, "sum ")) || n > 5 && same(line, 5, "echo ");
}

// The host key as OpenSSH writes one: base64 of "ssh-ed25519" and the 32 bytes, each after its length.
fn put_host_key[&mc, &s, &x, &w](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], sx: &!x [byte], wire: &!w [byte]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    wire[0] = byte_of(0);
    wire[1] = byte_of(0);
    wire[2] = byte_of(0);
    wire[3] = byte_of(11);
    var i = 0;
    while i < 11 {
        wire[4 + i] = "ssh-ed25519"[i];
        i = i + 1;
    }
    wire[15] = byte_of(0);
    wire[16] = byte_of(0);
    wire[17] = byte_of(0);
    wire[18] = byte_of(32);
    i = 0;
    while i < 32 {
        wire[19 + i] = sx[32 + i];
        i = i + 1;
    }
    // 51 bytes are 17 threes: 68 characters and no padding
    i = 0;
    while i < 51 {
        let v = int_of(wire[i]) << 16 | int_of(wire[i + 1]) << 8 | int_of(wire[i + 2]);
        var shift = 18;
        while shift >= 0 {
            let d = v >> shift & 63;
            if d < 26 {
                base.putc(con, k, 'A' + d);
            } else if d < 52 {
                base.putc(con, k, 'a' + d - 26);
            } else if d < 62 {
                base.putc(con, k, '0' + d - 52);
            } else if d == 62 {
                base.putc(con, k, '+');
            } else {
                base.putc(con, k, '/');
            }
            shift = shift - 6;
        }
        i = i + 3;
    }
    return 0;
}

// ---- a kernel over the serial line (docs/load.md) ---------------------------------
// `load <bytes>`: the bytes go to `stage`, 16 bytes in (the boot stub wants a mark and the
// length in front), with their Adler-32 checksum (RFC 1950) said back. `go <checksum>`
// from the sender, who has the same file, and the kernel faults on purpose: the boot
// stub finds the mark and starts what was loaded. Anything else forgets it.
fn load[&f, &mc, &mg, &mz, &s, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), stage: &!mg Mmio("0x220000..0x420000,0x40220000..0x40420000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), k: &!s [int], line: &r [byte], n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x220000..0x420000,0x40220000..0x40420000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001")] int {
    var want = 0;
    var i = 5;
    while i < n && want >= 0 {
        let c = int_of(line[i]);
        if c < '0' || c > '9' || want > 9999999 {
            want = -1;
        } else {
            want = want * 10 + c - '0';
        }
        i = i + 1;
    }
    if want < 1024 || want > 0x1ffff0 {
        return base.puts(con, k, "usage: load <bytes>, a kernel of 1 KB to 2 MB\r\n");
    }
    let uart = k[0];
    let at = k[14] + 0x220000;
    base.puts(con, k, "send ");
    base.put_dec(con, k, want);
    base.puts(con, k, " bytes\r\n");
    var got = 0;
    var a = 1;
    var b = 0;
    var damaged = 0;
    var heard = base.uptime_ms(cpu);
    while got < want && damaged == 0 {
        if mmio_read32(con, uart + 0x18) & 16 == 0 {
            let d = mmio_read32(con, uart);
            if d & 0xf00 != 0 {
                // the port lost a byte, or misread one
                damaged = 1;
            }
            mmio_write8(stage, at + 16 + got, d & 255);
            a = (a + (d & 255)) % 65521;
            b = (b + a) % 65521;
            got = got + 1;
            if got & 1023 == 0 {
                heard = base.uptime_ms(cpu);
            }
        } else if base.uptime_ms(cpu) - heard > 3000 {
            damaged = 2;
        }
    }
    if damaged != 0 {
        base.puts(con, k, "\r\nnothing loaded: ");
        if damaged == 1 {
            base.puts(con, k, "the port lost a byte after ");
        } else {
            base.puts(con, k, "three seconds of silence after ");
        }
        base.put_dec(con, k, got);
        return base.puts(con, k, " bytes\r\n");
    }
    let sum = b << 16 | a;
    base.puts(con, k, "received ");
    base.put_dec(con, k, got);
    base.puts(con, k, " bytes, adler32 ");
    var shift = 28;
    while shift >= 0 {
        base.put_hex(con, k, sum >> shift & 15);
        shift = shift - 4;
    }
    base.puts(con, k, "\r\n`go <that checksum>` starts it; anything else forgets it\r\n");
    // the answer: `go ` and the same eight digits
    var typed = 0;
    var ok = true;
    var done = false;
    heard = base.uptime_ms(cpu);
    while !done {
        if mmio_read32(con, uart + 0x18) & 16 == 0 {
            let c = mmio_read32(con, uart) & 255;
            if c == 13 || c == 10 {
                done = true;
            } else {
                var expect = -1;
                if typed == 0 {
                    expect = 'g';
                } else if typed == 1 {
                    expect = 'o';
                } else if typed == 2 {
                    expect = ' ';
                } else if typed < 11 {
                    let nib = sum >> (10 - typed) * 4 & 15;
                    expect = '0' + nib;
                    if nib > 9 {
                        expect = 'a' + nib - 10;
                    }
                }
                if c != expect {
                    ok = false;
                }
                typed = typed + 1;
            }
        } else if base.uptime_ms(cpu) - heard > 30000 {
            ok = false;
            done = true;
        }
    }
    if !ok || typed != 11 {
        return base.puts(con, k, "forgotten\r\n");
    }
    base.puts(con, k, "starting it\r\n");
    // let the last of that leave the port (its flags: bit 7, nothing left to send; bit 3, still sending)
    while mmio_read32(con, uart + 0x18) & 0x88 != 0x80 {
    }
    mmio_write64(stage, at + 8, got);
    mmio_write64(stage, at, 0x6f6863616e6163);
    // not a crash: the way to the boot stub (page 0 is not mapped)
    mmio_read8(probe, k[14]);
    return 0;
}

fn shell[&f, &mc, &mi, &mu, &mr, &mg, &mw, &mv, &md, &mt, &mx, &mz, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), stage: &!mg Mmio("0x220000..0x420000,0x40220000..0x40420000"), vio: &!mv Mmio("0xa000000..0xa004000,0xfd580000..0xfd590000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntv_cval_el0"), cpu("cntvct_el0"), cpu("wfi"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0xfd580000..0xfd590000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0x220000..0x420000,0x40220000..0x40420000"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    base.puts(con, k, "\r\ncancho-os booted. type `help`.\r\n");
    region r {
        let line = alloc_slice[r](128, byte_of(0));
        // the network link's: the SLIP decoder's state, a received packet, the reply, the reply framed
        let ns = alloc_slice[r](inet.slip_state(), 0);
        let frame = alloc_slice[r](1600, byte_of(0));
        let reply = alloc_slice[r](1600, byte_of(0));
        let wire = alloc_slice[r](2 * inet.mtu() + 2, byte_of(0));
        // the connections' state, and the one segment each may have out
        let tcp = alloc_slice[r](4 * inet.tcp_conn(), 0);
        let bufs = alloc_slice[r](4 * inet.tcp_segment_max(), byte_of(0));
        // what has arrived for the shell's port and not been read, and the line being typed there
        let inbox = alloc_slice[r](4 * inet.tcp_inbox(), byte_of(0));
        let rline = alloc_slice[r](128, byte_of(0));
        let cmd = alloc_slice[r](128, byte_of(0));
        // SSH (src/sshd.cho): cancho-ssh's state for one connection, and the keys
        let si = alloc_slice[r](sshd.ints(), 0);
        let sb = alloc_slice[r](sshd.bytes(), byte_of(0));
        let sx = alloc_slice[r](sshd.extra(), byte_of(0));
        k[4180] = authorized.fill(sx[352..480]);
        k[4164] = k[4180];
        k[4177] = (1 << k[4180]) - 1;
        var n = 0;
        base.puts(con, k, "> ");
        while true {
            let c = getc(cpu, con, irq, bus, rng, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rline, si, sb, sx);
            if c == -4 {
                // the host key's public half, as a line for a client's known_hosts
                // a key that was drawn is kept, if there is a disk to keep it on: then it is the same key
                // after a restart, and a client that remembered it is not told the host has changed
                if k[4176] == 0 && disk.keep(con, vio, dma, k, "HOSTKEY.BIN", sx, 32) == 0 {
                    k[4176] = 2;
                }
                if k[4176] == 1 {
                    base.puts(con, k, "\r\nssh host key (read from the disk: the same as before the restart): ssh-ed25519 ");
                } else if k[4176] == 2 {
                    base.puts(con, k, "\r\nssh host key (new, and kept on the disk as HOSTKEY.BIN): ssh-ed25519 ");
                } else {
                    base.puts(con, k, "\r\nssh host key (it is another after every restart): ssh-ed25519 ");
                }
                put_host_key(con, k, sx, wire);
                base.puts(con, k, "\r\n> ");
                k[4160] = 2;
            } else if c == -3 {
                k[26] = 1;
                if k[4153] == 1 && k[4179] == 2 {
                    base.puts(con, k, "cancho-os: the kernel's shell, over SSH. `help` lists the commands, `exit` leaves.\r\n> ");
                } else if k[4153] == 1 {
                    base.puts(con, k, "cancho-os: the kernel's shell, over SSH, with a key that may only read. `help` lists the commands, `exit` leaves.\r\n> ");
                } else {
                    base.puts(con, k, "cancho-os: the kernel's shell. One session, not encrypted. Type `help`.\r\n> ");
                }
                k[26] = 0;
            } else if c == -2 {
                // a line from the network: the same commands, and what they print goes back there
                k[26] = 1;
                // (copied: a command may wait on the network, and that reads the connection's line)
                var i = 0;
                while i < k[31] {
                    cmd[i] = rline[i];
                    i = i + 1;
                }
                if same(cmd, k[31], "exit") {
                    base.puts(con, k, "bye\r\n");
                    k[4152] = 1;
                } else if k[4153] == 1 && k[4179] != 2 && !reading(cmd, k[31]) {
                    base.puts(con, k, "this key may only read: that needs an owner's key\r\n");
                } else if same(cmd, k[31], "random") {
                    network.put_random(con, rng, vio, dma, k);
                } else if disk.command(con, vio, dma, k, cmd, k[31], false) != 0 {
                    // (run: a command that uses the disk; one that may have changed who may log in)
                    if k[31] > 7 && (same(cmd, 7, "append ") || same(cmd, 6, "write ")) {
                        load_keys(vio, dma, k, sx);
                    }
                } else if network.net_command(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rng, fw, rline, cmd, k[31]) == 0 {
                    run(cpu, con, bus, tab, code, probe, k, cmd, k[31]);
                }
                if k[33] != 0 {
                    k[33] = 0;
                    k[27] = 4000;
                    base.puts(con, k, "\r\n[more was printed than is kept: cut]\r\n");
                }
                if k[4152] == 0 {
                    base.puts(con, k, "> ");
                }
                k[26] = 0;
                k[31] = 0;
            } else if c == 13 || c == 10 {
                base.puts(con, k, "\r\n");
                if same(line, n, "net ssh on") {
                    // who may log in, and the host key if the disk has kept one, before the port opens
                    load_keys(vio, dma, k, sx);
                    if k[4160] == 0 && disk.get(vio, dma, k, "HOSTKEY.BIN", sx[0..32]) == 32 {
                        sshd.adopt(k, sx, wire);
                        k[4176] = 1;
                    }
                }
                if n > 5 && same(line, 5, "load ") {
                    load(cpu, con, stage, probe, k, line, n);
                } else if same(line, n, "random") {
                    network.put_random(con, rng, vio, dma, k);
                } else if disk.command(con, vio, dma, k, line, n, true) != 0 {
                    // (a file was added or added to: it may be the one that says who may log in)
                    if n > 7 && (same(line, 7, "append ") || same(line, 6, "write ")) {
                        load_keys(vio, dma, k, sx);
                    }
                } else if network.net_command(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rng, fw, rline, line, n) == 0 {
                    run(cpu, con, bus, tab, code, probe, k, line, n);
                }
                n = 0;
                base.puts(con, k, "> ");
            } else if (c == 127 || c == 8) && n > 0 {
                n = n - 1;
                base.putc(con, k, 8);
                base.putc(con, k, 32);
                base.putc(con, k, 8);
            } else if c >= 32 && c < 127 && n < 128 {
                line[n] = byte_of(c);
                n = n + 1;
                base.putc(con, k, c);
            }
        }
    }
    return 0;
}

fn kernel[&f, &mc, &mp, &mi, &mu, &mr, &mg, &mw, &mv, &md, &mt, &mx, &mz, &mq](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), pins: &!mp Mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), irq: &!mi Mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), stage: &!mg Mmio("0x220000..0x420000,0x40220000..0x40420000"), vio: &!mv Mmio("0xa000000..0xa004000,0xfd580000..0xfd590000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), tab: &!mt Mmio("0x200000..0x208000,0x40200000..0x40208000"), code: &mx Mmio("0x80001..0x200000,0x40080001..0x40200000"), probe: &!mz Mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), fault: &mq Mmio("0x208000..0x208008,0x40208000..0x40208008")) -> [cpu("cntfrq_el0"), cpu("cntv_ctl_el0"), cpu("cntv_cval_el0"), cpu("cntv_tval_el0"), cpu("cntvct_el0"), cpu("elr_el1"), cpu("esr_el1"), cpu("far_el1"), cpu("mair_el1"), cpu("midr_el1"), cpu("sctlr_el1"), cpu("tcr_el1"), cpu("tlbi_vmalle1"), cpu("ttbr0_el1"), cpu("wfi"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f200004..0x3f200008,0xfe200004..0xfe200008"), mmio("0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x200000..0x208000,0x40200000..0x40208000"), mmio("0x80001..0x200000,0x40080001..0x40200000"), mmio("0x0..0x1,0x80000..0x80001,0x40080000..0x40080001"), mmio("0x208000..0x208008,0x40208000..0x40208008"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0xfd580000..0xfd590000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0x220000..0x420000,0x40220000..0x40420000"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    region r {
        let k = alloc_slice[r](40 + 4096 + 16 + 32, 0);
        // the address the kernel has until it is given another: 10.0.0.2 on a network of 256, gateway 10.0.0.1
        k[4154] = 0x0a000002;
        k[4155] = 0xffffff00;
        k[4156] = 0x0a000001;
        if detect(cpu, k) == 0 {
            // a board this kernel has no addresses for: nothing can even be printed
            return 1;
        }
        if mmio_read64(fault, k[14] + 0x208000) >= 0 {
            // entered again by the exception vector: say what happened, and stop
            return report_fault(cpu, con, code, fault, k);
        }
        uart_init(con, pins, k);
        // The tables start empty; table 0 of the pool is the top-level table.
        var slot = 0;
        while slot < 8 * 512 {
            mmio_write64(tab, k[14] + 0x200000 + slot * 8, 0);
            slot = slot + 1;
        }
        k[6] = 1;
        if memory_map(con, tab, code, k, true) != 0 {
            base.puts(con, k, "\r\nmemory map refused; running without the MMU\r\n");
        } else {
            mmu_on(cpu, k[14]);
        }
        tick_start(cpu, irq, k, 100);
        if k[9] != 0 {
            bus_init(bus, k);
        }
        if k[1] == 1 {
            network.vnet_start(vio, dma, k);
            disk.start(vio, dma, k);
        }
        network.rng_start(rng, vio, dma, k);
        shell(cpu, con, irq, bus, rng, fw, stage, vio, dma, tab, code, probe, k);
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker, mmio, cpu } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(out);
    release(ports);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    release(camera);
    release(mic);
    release(speaker);
    // Every address, cut into what each driver holds. No two share one.
    let (con, pins, irq, bus, tab, code, probe, rest) = narrow(mmio, "0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048", "0x3f200004..0x3f200008,0xfe200004..0xfe200008", "0x8000000..0x8000420,0x8010000..0x8010014,0x40000040..0x40000064,0xff841000..0xff842014,0x107fff9000..0x107fffa014", "0x3f215004..0x3f21506c,0xfe215004..0xfe21506c", "0x200000..0x208000,0x40200000..0x40208000", "0x80001..0x200000,0x40080001..0x40200000", "0x0..0x1,0x80000..0x80001,0x40080000..0x40080001", "0x208000..0x208008,0x210000..0x420000,0xa000000..0xa004000,0x3f00b880..0x3f00b8a4,0x3f104000..0x3f10400c,0x40208000..0x40208008,0x40210000..0x40420000,0xfd580000..0xfd590000,0xfe00b880..0xfe00b8a4,0xfe104000..0xfe104028");
    // (`narrow` cuts at most eight pieces: the last is cut again)
    let (fault, dma, vio, rng, stage, fw) = narrow(rest, "0x208000..0x208008,0x40208000..0x40208008", "0x210000..0x220000,0x40210000..0x40220000", "0xa000000..0xa004000,0xfd580000..0xfd590000", "0x3f104000..0x3f10400c,0xfe104000..0xfe104028", "0x220000..0x420000,0x40220000..0x40420000", "0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4");
    var status = 0;
    borrow mut cpu as &!r in {
        borrow mut con as &!c in {
            borrow mut pins as &!p in {
                borrow mut irq as &!i in {
                    borrow mut bus as &!u in {
                        borrow mut tab as &!t in {
                            borrow code as &x in {
                                borrow mut probe as &!z in {
                                    borrow fault as &q in {
                                        borrow mut vio as &!v in {
                                            borrow mut dma as &!d in {
                                                borrow mut rng as &!g in {
                                                    borrow mut stage as &!w in {
                                                        borrow mut fw as &!m in {
                                                            status = kernel(r, c, p, i, u, g, m, w, v, d, t, x, z, q);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    release(cpu);
    release(con);
    release(pins);
    release(irq);
    release(bus);
    release(tab);
    release(code);
    release(probe);
    release(fault);
    release(vio);
    release(dma);
    release(rng);
    release(stage);
    release(fw);
    return status;
}
