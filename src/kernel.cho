edition 5;

// The board is a capability: everything that touches hardware is a foreign
// symbol of the library "board", so `cancho authority` lists it exactly.
extern fn board_putc[&f](ffi: &f Ffi("board"), c: int) -> [ffi("board")] int;
extern fn board_getc[&f](ffi: &f Ffi("board")) -> [ffi("board")] int;

fn puts[&f, &r](b: &f Ffi("board"), s: &r [byte]) -> [ffi("board")] int {
    var i = 0;
    while i < len(s) {
        board_putc(b, int_of(s[i]));
        i = i + 1;
    }
    return 0;
}

fn same[&r, &s](line: &r [byte], n: int, word: &s [byte]) -> [] bool {
    if n != len(word) { return false; }
    var i = 0;
    while i < n {
        if int_of(line[i]) != int_of(word[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn run[&f, &r](b: &f Ffi("board"), line: &r [byte], n: int) -> [ffi("board")] int {
    if n == 0 { return 0; }
    if same(line, n, "help") {
        puts(b, "commands: help, about, echo <text>\r\n");
    } else if same(line, n, "about") {
        puts(b, "cancho-os 0.0.1: a kernel written in cancho, no Linux underneath\r\n");
    } else if n > 5 && same(line, 5, "echo ") {
        var i = 5;
        while i < n { board_putc(b, int_of(line[i])); i = i + 1; }
        puts(b, "\r\n");
    } else {
        puts(b, "unknown command\r\n");
    }
    return 0;
}

fn shell[&f](b: &f Ffi("board")) -> [ffi("board")] int {
    puts(b, "\r\ncancho-os booted. type `help`.\r\n");
    region r {
        let line = alloc_slice[r](128, byte_of(0));
        var n = 0;
        puts(b, "> ");
        while true {
            let c = board_getc(b);
            if c == 13 || c == 10 {
                puts(b, "\r\n");
                run(b, line, n);
                n = 0;
                puts(b, "> ");
            } else if (c == 127 || c == 8) && n > 0 {
                n = n - 1;
                board_putc(b, 8); board_putc(b, 32); board_putc(b, 8);
            } else if c >= 32 && c < 127 && n < 128 {
                line[n] = byte_of(c);
                n = n + 1;
                board_putc(b, c);
            }
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(io); release(fs); release(heap); release(args); release(net); release(clock);
    let board = narrow(ffi, "board");
    borrow board as &b in {
        shell(b);
    }
    release(board);
    return 0;
}
