edition 14;

module programs;

// programs.cho -- the programs built into the image that were written for a system, not for this kernel: each
// takes an `Io`, an `Args` or an `Fs` and has no word of the kernel in it (no `Mmio`, no `k`, no import of the
// kernel's modules). `hosted` in kernel.cho runs them inside the one block that lends them `ksys`
// (cancho docs/bare-system.md). A new one goes here, and gets a number in `hosted`.

// `tell <words>`: a function written as any program for a system is, with an `Io` and an `Args` and no word of
// this kernel in it. What it writes and the arguments it reads are answered by `ksys`, which the shell lends the
// console, the kernel's state and the line (cancho docs/bare-system.md). It is the first thing in the image
// that reaches the kernel only by asking it.
pub fn tell[&i, &g](io: &!i Io, args: &g Args) -> [io_write, args] int {
    var n = 1;
    while n < arg_count(args) {
        write_bytes(io, "argument ");
        putchar(io, '0' + n % 10);
        write_bytes(io, ": ");
        write_bytes(io, arg(args, n));
        putchar(io, 10);
        n = n + 1;
    }
    write_bytes(io, "that was a program written for a system, answered by the kernel\n");
    flush_out(io);
    return n - 1;
}
