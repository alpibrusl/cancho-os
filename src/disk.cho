edition 14;

module disk;

import base;
import fat;
import network;
import sdcard;

// disk.cho -- the kernel's side of storage (docs/storage.md): a disk as "read one sector", the first thing
// under that (virtio-blk, on QEMU's virt machine), and the commands that read a FAT volume with it.
// Everything about what a sector means is src/fat.cho, which holds no hardware.
//
// In the kernel's state: k[4170] the disk (0 none, 1 virtio-blk, 2 an SD card: src/sdcard.cho)   k[4254] whether
//   a Pi's card has been looked for
//   k[4170..] as before:   k[4171] how many sectors it has
//   k[4172] its registers   k[4173] its queue's counter   k[4175] sectors written since the start
//
// virtio-blk (VIRTIO 1.2, section 5.2): one queue; a request is three pieces chained together, a header
// (0 to read, the sector), 512 bytes for the data, and one byte in which the device says how it went. They
// are in `dma`, after the network card's and the generator's: +0x7000 the queue's three tables, +0x7400 the
// header, +0x7410 the status byte, +0x7800 the data.

// Find the disk and bring it up. 1 if there is none.
pub fn start[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var found = 0;
    var slot = 0;
    while slot < 32 && found == 0 {
        let at = 0xa000000 + slot * 0x200;
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 2 {
            found = at;
        }
        slot = slot + 1;
    }
    if found == 0 {
        return 1;
    }
    let q = k[14] + 0x217000;
    var z = 0;
    while z < 0x800 {
        mmio_write64(dma, q + z, 0);
        z = z + 8;
    }
    mmio_write32(vio, found + 0x70, 0);
    mmio_write32(vio, found + 0x70, 1);
    mmio_write32(vio, found + 0x70, 3);
    // nothing is asked of the device but the current version of the interface (bit 32)
    mmio_write32(vio, found + 0x24, 0);
    mmio_write32(vio, found + 0x20, 0);
    mmio_write32(vio, found + 0x24, 1);
    mmio_write32(vio, found + 0x20, 1);
    mmio_write32(vio, found + 0x70, 11);
    if mmio_read32(vio, found + 0x70) & 8 == 0 || network.vnet_queue(vio, found, 0, q) != 0 {
        mmio_write32(vio, found + 0x70, 128);
        return 1;
    }
    // the three pieces, chained: the header, the data (the device writes it: 2), the status (the same)
    mmio_write64(dma, q, q + 0x400);
    mmio_write32(dma, q + 8, 16);
    network.put16le(dma, q + 12, 1);
    network.put16le(dma, q + 14, 1);
    mmio_write64(dma, q + 16, q + 0x800);
    mmio_write32(dma, q + 24, 512);
    network.put16le(dma, q + 28, 1 | 2);
    network.put16le(dma, q + 30, 2);
    mmio_write64(dma, q + 32, q + 0x410);
    mmio_write32(dma, q + 40, 1);
    network.put16le(dma, q + 44, 2);
    mmio_write32(vio, found + 0x70, 15);
    // how many sectors, from the device's own description
    k[4171] = mmio_read32(vio, found + 0x100) | mmio_read32(vio, found + 0x104) << 32;
    k[4172] = found;
    k[4173] = 0;
    k[4170] = 1;
    return 0;
}

// One request to the device: sector `n` read into the data buffer, or written from it.
fn request[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], n: int, out: bool) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let q = k[14] + 0x217000;
    var kind = 0;
    // the middle piece is the data: the device writes it (2) when reading, and reads it when writing
    var flags = 1 | 2;
    if out {
        kind = 1;
        flags = 1;
    }
    network.put16le(dma, q + 28, flags);
    mmio_write32(dma, q + 0x400, kind);
    mmio_write32(dma, q + 0x404, 0);
    mmio_write64(dma, q + 0x408, n);
    mmio_write8(dma, q + 0x410, 255);
    network.put16le(dma, q + 0x104 + k[4173] % 8 * 2, 0);
    k[4173] = (k[4173] + 1) % 65536;
    network.put16le(dma, q + 0x102, k[4173]);
    mmio_write32(vio, k[4172] + 0x50, 0);
    // The device answers when the host's own disk has: usually at once, sometimes not for a second or
    // more on a busy host. The wait is counted in turns of this loop, not in time (no clock is held
    // here), so the count is large: a device that never answers stops the kernel for about a minute.
    var spins = 0;
    while network.get16le(dma, q + 0x202) != k[4173] && spins < 2000000000 {
        spins = spins + 1;
    }
    let raised = mmio_read32(vio, k[4172] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[4172] + 0x64, raised);
    }
    if network.get16le(dma, q + 0x202) != k[4173] || mmio_read8(dma, q + 0x410) != 0 {
        return 1;
    }
    return 0;
}

// Sector `n` of the disk, into `into`. 0, or 1 if there is no such sector or the device refused.
pub fn read[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], n: int, into: &!b [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4170] == 0 || n < 0 || n >= k[4171] || len(into) < 512 {
        return 1;
    }
    if k[4170] == 2 {
        return sdcard.read(vio, k, n, into);
    }
    if request(vio, dma, k, n, false) != 0 {
        return 1;
    }
    let q = k[14] + 0x217000;
    var i = 0;
    while i < 512 {
        into[i] = byte_of(mmio_read8(dma, q + 0x800 + i));
        i = i + 1;
    }
    return 0;
}

// Sector `n` of the disk, written from `from`. 0, or 1.
pub fn write[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], n: int, from: &!b [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4170] == 0 || n < 0 || n >= k[4171] || len(from) < 512 {
        return 1;
    }
    if k[4170] == 2 {
        k[4175] = k[4175] + 1;
        return sdcard.write(vio, k, n, from);
    }
    let q = k[14] + 0x217000;
    var i = 0;
    while i < 512 {
        mmio_write8(dma, q + 0x800 + i, int_of(from[i]));
        i = i + 1;
    }
    k[4175] = k[4175] + 1;
    return request(vio, dma, k, n, true);
}

// The volume on the disk, into `info` (what `fat.mount` fills). 0, or why not: 1 no disk, 2 it could not be
// read, 3 no FAT partition, or one of `fat.mount`'s refusals.
pub fn volume[&mv, &md, &s, &b, &i](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], info: &!i [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4170] == 0 && k[4254] == 0 && (k[1] == 3 || k[1] == 4) {
        // a Pi's card is looked for the first time the disk is wanted, and once
        k[4254] = 1;
        sdcard.start(vio, k);
    }
    if k[4170] == 0 {
        return 1;
    }
    if read(vio, dma, k, 0, sec) != 0 {
        return 2;
    }
    let at = fat.partition(sec);
    if at < 0 {
        return 3;
    }
    if at > 0 && read(vio, dma, k, at, sec) != 0 {
        return 2;
    }
    return fat.mount(sec, at, info);
}

pub fn put_why[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], why: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if why == 1 {
        if k[4255] > 1 {
            base.puts(con, k, "no disk: the SD card did not start (step ");
            base.put_dec(con, k, k[4255]);
            return base.puts(con, k, " of src/sdcard.cho)\r\n");
        }
        return base.puts(con, k, "no disk: QEMU's virt machine has one when it is given one, a Pi 3 or 4 when a card is in\r\n");
    }
    if why == 2 {
        return base.puts(con, k, "the disk could not be read\r\n");
    }
    if why == 3 {
        return base.puts(con, k, "no FAT volume on the disk, and no partition table that names one\r\n");
    }
    if why == fat.not_512() {
        return base.puts(con, k, "a volume whose sectors are not 512 bytes: not read here\r\n");
    }
    if why == fat.fat12() {
        return base.puts(con, k, "a FAT12 volume: not read here\r\n");
    }
    return base.puts(con, k, "what is on the disk is not a FAT volume\r\n");
}

// ---- walking a directory -------------------------------------------------------------------
// The top directory of a FAT16 volume is a fixed run of sectors; every other directory, and FAT32's top
// one, is a chain of clusters like a file. `dir` says which: 0 the top directory, else the first cluster
// of another. `st` is where the walk is: 0 whether it follows a chain   1 the cluster   2 sectors left
// of the run, or sectors given of the cluster   3 the next sector of the run   4 turns   5 the last cluster
pub fn walk_start[&i, &u](info: &i [int], dir: int, st: &!u [int]) -> [] int {
    st[4] = 0;
    st[5] = 0;
    if dir == 0 && info[0] == 16 {
        st[0] = 0;
        st[2] = info[5];
        st[3] = info[4];
    } else {
        st[0] = 1;
        st[1] = info[4];
        if dir != 0 {
            st[1] = dir;
        }
        st[2] = 0;
    }
    return 0;
}

// The directory's next sector: its number; 0 when there are no more; -1 if the disk failed. `wt` is used
// to follow the chain, and must not be a buffer that anything else counts on.
pub fn walk_next[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], wt: &!t [byte], info: &i [int], st: &!u [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    st[4] = st[4] + 1;
    if st[4] > 65536 {
        return 0;
    }
    if st[0] == 0 {
        if st[2] == 0 {
            return 0;
        }
        st[2] = st[2] - 1;
        st[3] = st[3] + 1;
        return st[3] - 1;
    }
    if st[2] == info[1] {
        let fs = fat.fat_sector(info, st[1]);
        if fs < 0 || read(vio, dma, k, fs, wt) != 0 {
            return -1;
        }
        let after = fat.next(info, wt, st[1]);
        if after < 2 {
            return 0;
        }
        st[1] = after;
        st[2] = 0;
    }
    let at = fat.cluster_sector(info, st[1]);
    if at < 0 {
        return 0;
    }
    st[5] = st[1];
    st[2] = st[2] + 1;
    return at + st[2] - 1;
}

// A directory, entry by entry. With `wanted[from..to]` empty every file in it is printed; otherwise the
// file of that name is looked for, and `out` is its entry (length of name, first cluster, bytes).
// Answers how many files were printed, or 1 if the one wanted was found, or -1 if the disk failed.
pub fn top[&mc, &mv, &md, &s, &b, &t, &i, &m, &o, &w](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], name: &!m [byte], out: &!o [int], dir: int, wanted: &w [byte], from: int, to: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var count = 0;
    var result = -2;
    region r {
        let st = alloc_slice[r](6, 0);
        let ls = alloc_slice[r](fat.long_state(), 0);
        let lname = alloc_slice[r](fat.long_room(), byte_of(0));
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
                if at != 0 {
                    result = -1;
                }
            }
            var i = 0;
            while i < 16 && going {
                let kind = fat.entry(sec, i, name, out);
                let long = fat.long(sec, i, kind, ls, lname);
                if kind == fat.entry_end() {
                    going = false;
                } else if kind == fat.entry_directory() && to == from && out[0] > 0 && int_of(name[0]) != '.' {
                    // a directory, in a listing: its name and a `/` (not `.` and `..`, which every directory has)
                    var c = 0;
                    while c < long {
                        base.putc(con, k, int_of(lname[c]));
                        c = c + 1;
                    }
                    while long == 0 && c < out[0] {
                        base.putc(con, k, int_of(name[c]));
                        c = c + 1;
                    }
                    base.puts(con, k, "/\r\n");
                } else if kind == fat.entry_file() {
                    if to > from {
                        if fat.named(name, out[0], wanted, from, to) || long > 0 && fat.named(lname, long, wanted, from, to) {
                            result = 1;
                            going = false;
                        }
                    } else {
                        // the long name if it has one, else the short; then spaces to the fourteenth column at least
                        var c = 0;
                        while c < long {
                            base.putc(con, k, int_of(lname[c]));
                            c = c + 1;
                        }
                        while long == 0 && c < out[0] {
                            base.putc(con, k, int_of(name[c]));
                            c = c + 1;
                        }
                        base.putc(con, k, 32);
                        c = c + 1;
                        while c < 14 {
                            base.putc(con, k, 32);
                            c = c + 1;
                        }
                        base.put_dec(con, k, out[2]);
                        base.puts(con, k, "\r\n");
                        count = count + 1;
                    }
                }
                i = i + 1;
            }
        }
    }
    if result != -2 {
        return result;
    }
    return count;
}

// The highest number a version in the directory `dir` has; 0 if there is none; -1 if the disk failed.
pub fn highest[&mv, &md, &s, &b, &t, &i, &m, &o](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], name: &!m [byte], out: &!o [int], dir: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var most = 0;
    region r {
        let st = alloc_slice[r](6, 0);
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
                if at != 0 {
                    most = -1;
                }
            }
            var i = 0;
            while i < 16 && going {
                let kind = fat.entry(sec, i, name, out);
                if kind == fat.entry_end() {
                    going = false;
                } else if kind == fat.entry_file() && fat.version_number(name, out[0]) > most {
                    most = fat.version_number(name, out[0]);
                }
                i = i + 1;
            }
        }
    }
    return most;
}

// The file that starts at `cluster` and is `size` bytes long, read to its end. With `show`, its text is
// printed (4,096 bytes at most; what is not a letter of ASCII as a dot). `sum` is two ints, and gets the two
// halves of the Adler-32 of all of it. Answers the bytes read, or -1.
pub fn whole[&mc, &mv, &md, &s, &b, &t, &i, &u](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], info: &i [int], first: int, size: int, show: bool, sum: &!u [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var a = 1;
    var b = 0;
    var done = 0;
    var cluster = first;
    var held = -1;
    var steps = 0;
    while done < size {
        let at = fat.cluster_sector(info, cluster);
        if at < 0 || steps > info[7] {
            return -1;
        }
        steps = steps + 1;
        var s = 0;
        while s < info[1] && done < size {
            if read(vio, dma, k, at + s, sec) != 0 {
                return -1;
            }
            var i = 0;
            while i < 512 && done < size {
                let c = int_of(sec[i]);
                a = (a + c) % 65521;
                b = (b + a) % 65521;
                if show && done < 4096 {
                    if c == 10 {
                        base.puts(con, k, "\r\n");
                    } else if c >= 32 && c < 127 {
                        base.putc(con, k, c);
                    } else if c != 13 {
                        base.putc(con, k, '.');
                    }
                }
                done = done + 1;
                i = i + 1;
            }
            s = s + 1;
        }
        if done < size {
            // the table says which cluster is next; its sector is read again only when it changes
            let fs = fat.fat_sector(info, cluster);
            if fs < 0 {
                return -1;
            }
            if fs != held {
                if read(vio, dma, k, fs, tab) != 0 {
                    return -1;
                }
                held = fs;
            }
            cluster = fat.next(info, tab, cluster);
            if cluster < 0 {
                // the file's clusters end before its length does
                return -1;
            }
        }
    }
    sum[0] = a;
    sum[1] = b;
    return done;
}

// ---- writing (docs/permissions.md says the order, and why) ---------------------------------
// A file's contents and the table's chain for them go to the disk first; the directory sector that
// names them goes last, and until it does the disk reads exactly as it did. Nothing that is there
// is ever changed: a file is added, or added to.
//
// `w` is a writer's state: 0 the first cluster it used   1 the last   2 how many sectors of the last
// are written   3 how many clusters it has taken   4 where in the table it last found a free cluster
// 5 which sector of the table `tab` holds (-1: none)   6 whether `tab` has changed since it was read

// Make `tab` hold sector `at` of the table, writing what it held first if that was changed.
pub fn table[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int], at: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if w[5] == at {
        return 0;
    }
    if kept(vio, dma, k, tab, info, w) != 0 {
        return 1;
    }
    if at < 0 || read(vio, dma, k, at, tab) != 0 {
        w[5] = -1;
        return 1;
    }
    w[5] = at;
    return 0;
}

// Write the table's sector that `tab` holds, to every copy of the table, if it was changed.
pub fn kept[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if w[6] == 0 || w[5] < 0 {
        return 0;
    }
    var copy = 0;
    while copy < info[10] {
        if write(vio, dma, k, w[5] + copy * info[3], tab) != 0 {
            return 1;
        }
        copy = copy + 1;
    }
    w[6] = 0;
    return 0;
}

// A free cluster, taken: it is marked as the last of a file, and chained after `after` if that is not 0.
// The cluster, or -1 if the disk is full or failed.
pub fn take[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int], after: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var index = w[4];
    var found = -1;
    var looked = 0;
    while found < 0 && looked <= info[3] {
        if table(vio, dma, k, tab, info, w, info[2] + index) != 0 {
            return -1;
        }
        found = fat.free_cluster(info, tab, index, 0);
        if found < 0 {
            index = (index + 1) % info[3];
            looked = looked + 1;
        }
    }
    if found < 0 {
        return -1;
    }
    w[4] = index;
    w[3] = w[3] + 1;
    fat.set_next(info, tab, found, -1);
    w[6] = 1;
    if after != 0 {
        if table(vio, dma, k, tab, info, w, fat.fat_sector(info, after)) != 0 {
            return -1;
        }
        fat.set_next(info, tab, after, found);
        w[6] = 1;
    }
    return found;
}

// The next sector of the file being written: `data`, to a cluster taken when the last is full.
pub fn put[&mv, &md, &s, &t, &i, &u, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int], data: &!b [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if w[1] == 0 || w[2] >= info[1] {
        let c = take(vio, dma, k, tab, info, w, w[1]);
        if c < 0 {
            return 1;
        }
        if w[0] == 0 {
            w[0] = c;
        }
        w[1] = c;
        w[2] = 0;
    }
    if write(vio, dma, k, fat.cluster_sector(info, w[1]) + w[2], data) != 0 {
        return 1;
    }
    w[2] = w[2] + 1;
    return 0;
}

// A directory, looked through for the name `wanted[from..to]` and for a place to put one. `o` gets:
//   0 whether something has that name   1 2 the sector and the entry that names it   3 4 its first cluster
//   and length   5 6 the sector and the entry of the first free place (-1: none)   7 the directory's last
//   cluster (0 for FAT16's top directory, which cannot grow)   8 what was found: 2 a file, 3 a directory
//   9 how long its long name is (0: it has none)   10 11 the sector and the entry where that name's pieces begin.
// 0, or 1 if the disk failed.
pub fn look[&mv, &md, &s, &b, &t, &i, &m, &n, &o, &r](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], dir: int, wanted: &r [byte], from: int, to: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    o[0] = 0;
    o[5] = -1;
    o[7] = 0;
    var failed = 0;
    region r {
        let st = alloc_slice[r](6, 0);
        let ls = alloc_slice[r](fat.long_state(), 0);
        let lname = alloc_slice[r](fat.long_room(), byte_of(0));
        var began_at = 0;
        var began_i = 0;
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
                if at != 0 {
                    failed = 1;
                }
            }
            if going {
                o[7] = st[5];
                if o[5] < 0 && fat.free_slot(sec) >= 0 {
                    o[5] = at;
                    o[6] = fat.free_slot(sec);
                }
            }
            var i = 0;
            while i < 16 && going {
                let kind = fat.entry(sec, i, name, out);
                if fat.long_begins(sec, i) {
                    began_at = at;
                    began_i = i;
                }
                let long = fat.long(sec, i, kind, ls, lname);
                if kind == fat.entry_end() {
                    going = false;
                } else if kind == fat.entry_file() || kind == fat.entry_directory() {
                    if fat.named(name, out[0], wanted, from, to) || long > 0 && fat.named(lname, long, wanted, from, to) {
                        // (with a long name: how long, and the sector and entry where its pieces begin)
                        o[9] = long;
                        o[10] = began_at;
                        o[11] = began_i;
                        o[0] = 1;
                        o[1] = at;
                        o[2] = i;
                        o[3] = out[1];
                        o[4] = out[2];
                        o[8] = kind;
                    }
                }
                i = i + 1;
            }
        }
    }
    return failed;
}

// Does an entry of the directory `dir` have exactly this short form? 1, or 0 (also if the disk failed: the
// caller's next step reads the same sectors and will say so).
pub fn has_raw[&mv, &md, &s, &b, &t, &i, &e](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], dir: int, eleven: &e [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var found = 0;
    region r {
        let st = alloc_slice[r](6, 0);
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
            }
            var i = 0;
            while i < 16 && going {
                if int_of(sec[i * 32]) == 0 {
                    going = false;
                } else if fat.is_raw(sec, i, eleven) {
                    found = 1;
                    going = false;
                }
                i = i + 1;
            }
        }
    }
    return found;
}

// A row of `need` entries of the directory `dir` that name nothing, in one sector: `o[5]`, `o[6]` the sector
// and the first of them (-1: no sector has such a row), and `o[7]` the directory's last cluster as `look`
// leaves it. A sector that is passed over is left with no never-used entry (`fat.close_end`).
pub fn free_row[&mv, &md, &s, &b, &t, &i, &o](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], dir: int, need: int, o: &!o [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    o[5] = -1;
    region r {
        let st = alloc_slice[r](6, 0);
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
            } else {
                o[7] = st[5];
                let row = fat.free_run(sec, need);
                if row >= 0 {
                    o[5] = at;
                    o[6] = row;
                    going = false;
                } else if fat.close_end(sec) > 0 {
                    // this sector is passed over: it must not be where the directory ends
                    write(vio, dma, k, at, sec);
                }
            }
        }
    }
    return 0;
}

// The entry that names something new, into the sector `sec`, which is the one `place` chose (`o[5]`): at
// `o[6]`, a short name's one entry; or the pieces of a long name (`o[9]` of them) and after them the entry
// with the short form `place` left in `alias`. One sector, so one write makes the whole name appear.
pub fn named_at[&b, &o, &e, &t](sec: &!b [byte], o: &o [int], alias: &e [byte], text: &t [byte], from: int, to: int, cluster: int, size: int, directory: bool) -> [] int {
    if o[9] == 0 {
        if directory {
            return fat.put_directory(sec, o[6], text, from, to, cluster);
        }
        return fat.put_entry(sec, o[6], text, from, to, cluster, size);
    }
    let pieces = o[9];
    let sum = fat.sum11(alias);
    var i = 0;
    while i < pieces {
        if fat.put_long(sec, o[6] + i, text, from, to, pieces - i, pieces, sum) != 0 {
            return -1;
        }
        i = i + 1;
    }
    return fat.put_raw(sec, o[6] + pieces, alias, cluster, size, directory);
}

// Everything before the first byte of something new in the directory `dir`: the name is one, nothing
// there has it, and there is a place for it (a directory that is a chain and has none is given another
// cluster). 0 with `o[5]`, `o[6]` the place; else the reason is printed and 1 answered.
pub fn place[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], dir: int, text: &r [byte], from: int, to: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    // a short name if it is one; else a long one, kept in pieces before an entry with a short form of it
    var pieces = 0;
    if fat.put_entry(sec, 0, text, from, to, 0, 0) != 0 {
        if !fat.long_ok(text, from, to) {
            base.puts(con, k, "not a name: up to 195 characters, none of \" * / : < > ? \\ |, no space or dot at either end\r\n");
            return 1;
        }
        pieces = fat.long_pieces(to - from);
    }
    if look(vio, dma, k, sec, wt, info, name, out, o, dir, text, from, to) != 0 {
        base.puts(con, k, "the disk could not be read\r\n");
        return 1;
    }
    if o[0] != 0 {
        base.puts(con, k, "there is something of that name already\r\n");
        return 1;
    }
    if pieces > 0 {
        // a short form no entry of the directory has, and a row of entries for the pieces and the entry
        var number = 1;
        var taken = true;
        while taken && number < 10000 {
            fat.alias(text, from, to, number, name);
            taken = has_raw(vio, dma, k, sec, wt, info, dir, name) != 0;
            if taken {
                number = number + 1;
            }
        }
        if taken {
            base.puts(con, k, "no short form is left for that name in this directory\r\n");
            return 1;
        }
        free_row(vio, dma, k, sec, wt, info, dir, pieces + 1, o);
    }
    o[9] = pieces;
    if o[5] < 0 {
        if o[7] == 0 {
            base.puts(con, k, "the top directory is full\r\n");
            return 1;
        }
        // one more cluster for the directory, empty, chained after its last
        let c = take(vio, dma, k, tab, info, w, o[7]);
        var z = 0;
        while z < 512 {
            sec[z] = byte_of(0);
            z = z + 1;
        }
        var bad = c < 0;
        var n = 0;
        while n < info[1] && !bad {
            bad = write(vio, dma, k, fat.cluster_sector(info, c) + n, sec) != 0;
            n = n + 1;
        }
        if bad || kept(vio, dma, k, tab, info, w) != 0 {
            base.puts(con, k, "the disk is full, or could not be written\r\n");
            return 1;
        }
        o[5] = fat.cluster_sector(info, c);
        o[6] = 0;
    }
    return 0;
}

// The directory versions are kept in, `OLD` in the top directory: its first cluster. With `make`, it is
// made if it is not there. 0: there is none. -1: it could not be read or made, and the reason is printed.
pub fn old_dir[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], make: bool) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if look(vio, dma, k, sec, wt, info, name, out, o, 0, "OLD", 0, 3) != 0 {
        base.puts(con, k, "the disk could not be read\r\n");
        return -1;
    }
    if o[0] != 0 {
        if o[8] != fat.entry_directory() {
            base.puts(con, k, "OLD is a file here, and versions need a directory of that name\r\n");
            return -1;
        }
        return o[3];
    }
    if !make {
        return 0;
    }
    if place(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, 0, "OLD", 0, 3) != 0 {
        return -1;
    }
    // its one cluster first: the two entries a directory begins with, and nothing else; then its name
    let c = take(vio, dma, k, tab, info, w, 0);
    var z = 0;
    while z < 512 {
        sec[z] = byte_of(0);
        z = z + 1;
    }
    var bad = c < 0;
    var n = 1;
    while n < info[1] && !bad {
        bad = write(vio, dma, k, fat.cluster_sector(info, c) + n, sec) != 0;
        n = n + 1;
    }
    if !bad {
        fat.put_dots(sec, c, 0);
        bad = write(vio, dma, k, fat.cluster_sector(info, c), sec) != 0;
    }
    bad = bad || kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, o[5], sec) != 0;
    if !bad {
        fat.put_directory(sec, o[6], "OLD", 0, 3, c);
        bad = write(vio, dma, k, o[5], sec) != 0;
    }
    if bad {
        base.puts(con, k, "the disk is full, or could not be written\r\n");
        return -1;
    }
    return c;
}

// What a file held (`cluster`, `size`) given a name of its own in `OLD`, so that it is kept when the file
// is changed or removed. Answers the version's number, with its name in `vname`; -1 with the reason printed.
pub fn version[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u, &v](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], vname: &!v [byte], cluster: int, size: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let oldc = old_dir(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, true);
    if oldc < 0 {
        return -1;
    }
    let last = highest(vio, dma, k, sec, wt, info, name, out, oldc);
    if last < 0 || fat.version_name(vname, last + 1) < 0 {
        base.puts(con, k, "the versions could not be read\r\n");
        return -1;
    }
    if place(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, oldc, vname, 0, 10) != 0 {
        return -1;
    }
    if kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, o[5], sec) != 0 || fat.put_entry(sec, o[6], vname, 0, 10, cluster, size) != 0 || write(vio, dma, k, o[5], sec) != 0 {
        base.puts(con, k, "the disk could not be written\r\n");
        return -1;
    }
    return last + 1;
}

// After a change that went through: FAT32's count of free clusters, a hint kept in a sector of its own, is
// brought down by what was taken. (After one that did not, it is left too high, which is what a hint may be.)
pub fn counted[&mv, &md, &s, &b, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], info: &i [int], w: &!u [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if info[11] == 0 || w[3] == 0 {
        return 0;
    }
    if read(vio, dma, k, info[11], sec) == 0 && fat.summary_less(sec, w[3]) == 0 {
        write(vio, dma, k, info[11], sec);
    }
    w[3] = 0;
    return 0;
}

// The last step of a new file: what is left of the table, then the directory entry that makes it exist.
pub fn name_it[&mv, &md, &s, &b, &t, &i, &o, &u, &r, &e](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], info: &i [int], o: &!o [int], w: &!u [int], alias: &e [byte], text: &r [byte], from: int, to: int, size: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, o[5], sec) != 0 {
        return 1;
    }
    if named_at(sec, o, alias, text, from, to, w[0], size, false) != 0 {
        return 1;
    }
    return write(vio, dma, k, o[5], sec);
}

// A name taken away from the directory `dir`: the entry at sector `es`, number `ei`, and before it the pieces
// of its long name if it has one (`long` characters, beginning at sector `ls`, entry `li`). The pieces go
// first and the entry last: until the entry goes the file is still there, under its short name.
pub fn unname[&mv, &md, &s, &b, &t, &i](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], dir: int, es: int, ei: int, long: int, ls: int, li: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var failed = 0;
    if long > 0 {
        region r {
            let st = alloc_slice[r](6, 0);
            walk_start(info, dir, st);
            var going = true;
            var erasing = false;
            while going {
                let at = walk_next(vio, dma, k, wt, info, st);
                if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                    going = false;
                    failed = 1;
                }
                var changed = false;
                var i = 0;
                while i < 16 && going {
                    if at == ls && i == li {
                        erasing = true;
                    }
                    if at == es && i == ei {
                        // the entry itself is left for the last write, below
                        going = false;
                        failed = 0;
                    } else if erasing {
                        fat.erase(sec, i);
                        changed = true;
                    }
                    i = i + 1;
                }
                if changed && write(vio, dma, k, at, sec) != 0 {
                    going = false;
                    failed = 1;
                }
            }
        }
    }
    if failed != 0 || read(vio, dma, k, es, sec) != 0 {
        return 1;
    }
    fat.erase(sec, ei);
    return write(vio, dma, k, es, sec);
}

// ---- adding to a file ------------------------------------------------------------------------

// More at the end of a file: `data[0..n]` after the `size` bytes that start at cluster `first`. The table is
// left in `tab` for `kept` to write; then `w[0]` is the file's first cluster, and the caller writes the
// directory's word for it, last. 0, or 1 if the disk is full or failed.
pub fn extend[&mv, &md, &s, &b, &t, &q, &i, &u, &d](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], w: &!u [int], first: int, size: int, data: &d [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let per = info[1] * 512;
    var bad = n < 0 || n > len(data);
    // the file's last cluster, and how much of it is used
    w[0] = first;
    var cluster = first;
    var steps = 0;
    var held = -1;
    while size > 0 && !bad && cluster >= 2 && steps <= info[7] {
        w[1] = cluster;
        let fs = fat.fat_sector(info, cluster);
        if fs != held {
            bad = fs < 0 || read(vio, dma, k, fs, wt) != 0;
            held = fs;
        }
        cluster = fat.next(info, wt, cluster);
        steps = steps + 1;
    }
    var i = 0;
    while i < 512 {
        sec[i] = byte_of(0);
        i = i + 1;
    }
    var fill = 0;
    if size > 0 && !bad {
        let used = (size - 1) % per + 1;
        w[2] = used / 512;
        fill = used % 512;
        if fill > 0 {
            // the sector the file ends in: what is past its end is not yet part of it
            bad = read(vio, dma, k, fat.cluster_sector(info, w[1]) + w[2], sec) != 0;
        }
    }
    var sent = 0;
    while sent < n && !bad {
        sec[fill] = data[sent];
        fill = fill + 1;
        sent = sent + 1;
        if fill == 512 || sent == n {
            bad = put(vio, dma, k, tab, info, w, sec) != 0;
            fill = 0;
            i = 0;
            while i < 512 {
                sec[i] = byte_of(0);
                i = i + 1;
            }
        }
    }
    if bad {
        return 1;
    }
    return 0;
}
