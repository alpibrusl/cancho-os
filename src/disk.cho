edition 14;

module disk;

import base;
import fat;
import network;
import record;
import sdcard;
import ssh_sha256 as sha;

// disk.cho -- the kernel's side of storage (docs/storage.md): a disk as "read one sector", the first thing
// under that (virtio-blk, on QEMU's virt machine), and the commands that read a FAT volume with it.
// Everything about what a sector means is src/fat.cho, which holds no hardware.
//
// In the kernel's state: k[4170] the disk (0 none, 1 virtio-blk, 2 an SD card: src/sdcard.cho)   k[4254] whether
//   a Pi's card has been looked for
//   k[4170..] as before:   k[4171] how many sectors it has
//   k[4172] its registers   k[4173] its queue's counter   k[4175] sectors written since the start
//
// virtio-blk (VIRTIO 1.2, section 5.2): one queue; a request is three pieces chained together, a header
// (0 to read, the sector), 512 bytes for the data, and one byte in which the device says how it went. They
// are in `dma`, after the network card's and the generator's: +0x7000 the queue's three tables, +0x7400 the
// header, +0x7410 the status byte, +0x7800 the data.

// Find the disk and bring it up. 1 if there is none.
pub fn start[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var found = 0;
    var slot = 0;
    while slot < 32 && found == 0 {
        let at = 0xa000000 + slot * 0x200;
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 2 {
            found = at;
        }
        slot = slot + 1;
    }
    if found == 0 {
        return 1;
    }
    let q = k[14] + 0x217000;
    var z = 0;
    while z < 0x800 {
        mmio_write64(dma, q + z, 0);
        z = z + 8;
    }
    mmio_write32(vio, found + 0x70, 0);
    mmio_write32(vio, found + 0x70, 1);
    mmio_write32(vio, found + 0x70, 3);
    // nothing is asked of the device but the current version of the interface (bit 32)
    mmio_write32(vio, found + 0x24, 0);
    mmio_write32(vio, found + 0x20, 0);
    mmio_write32(vio, found + 0x24, 1);
    mmio_write32(vio, found + 0x20, 1);
    mmio_write32(vio, found + 0x70, 11);
    if mmio_read32(vio, found + 0x70) & 8 == 0 || network.vnet_queue(vio, found, 0, q) != 0 {
        mmio_write32(vio, found + 0x70, 128);
        return 1;
    }
    // the three pieces, chained: the header, the data (the device writes it: 2), the status (the same)
    mmio_write64(dma, q, q + 0x400);
    mmio_write32(dma, q + 8, 16);
    network.put16le(dma, q + 12, 1);
    network.put16le(dma, q + 14, 1);
    mmio_write64(dma, q + 16, q + 0x800);
    mmio_write32(dma, q + 24, 512);
    network.put16le(dma, q + 28, 1 | 2);
    network.put16le(dma, q + 30, 2);
    mmio_write64(dma, q + 32, q + 0x410);
    mmio_write32(dma, q + 40, 1);
    network.put16le(dma, q + 44, 2);
    mmio_write32(vio, found + 0x70, 15);
    // how many sectors, from the device's own description
    k[4171] = mmio_read32(vio, found + 0x100) | mmio_read32(vio, found + 0x104) << 32;
    k[4172] = found;
    k[4173] = 0;
    k[4170] = 1;
    return 0;
}

// One request to the device: sector `n` read into the data buffer, or written from it.
fn request[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], n: int, out: bool) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let q = k[14] + 0x217000;
    var kind = 0;
    // the middle piece is the data: the device writes it (2) when reading, and reads it when writing
    var flags = 1 | 2;
    if out {
        kind = 1;
        flags = 1;
    }
    network.put16le(dma, q + 28, flags);
    mmio_write32(dma, q + 0x400, kind);
    mmio_write32(dma, q + 0x404, 0);
    mmio_write64(dma, q + 0x408, n);
    mmio_write8(dma, q + 0x410, 255);
    network.put16le(dma, q + 0x104 + k[4173] % 8 * 2, 0);
    k[4173] = (k[4173] + 1) % 65536;
    network.put16le(dma, q + 0x102, k[4173]);
    mmio_write32(vio, k[4172] + 0x50, 0);
    // The device answers when the host's own disk has: usually at once, sometimes not for a second or
    // more on a busy host. The wait is counted in turns of this loop, not in time (no clock is held
    // here), so the count is large: a device that never answers stops the kernel for about a minute.
    var spins = 0;
    while network.get16le(dma, q + 0x202) != k[4173] && spins < 2000000000 {
        spins = spins + 1;
    }
    let raised = mmio_read32(vio, k[4172] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[4172] + 0x64, raised);
    }
    if network.get16le(dma, q + 0x202) != k[4173] || mmio_read8(dma, q + 0x410) != 0 {
        return 1;
    }
    return 0;
}

// Sector `n` of the disk, into `into`. 0, or 1 if there is no such sector or the device refused.
pub fn read[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], n: int, into: &!b [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4170] == 0 || n < 0 || n >= k[4171] || len(into) < 512 {
        return 1;
    }
    if k[4170] == 2 {
        return sdcard.read(vio, k, n, into);
    }
    if request(vio, dma, k, n, false) != 0 {
        return 1;
    }
    let q = k[14] + 0x217000;
    var i = 0;
    while i < 512 {
        into[i] = byte_of(mmio_read8(dma, q + 0x800 + i));
        i = i + 1;
    }
    return 0;
}

// Sector `n` of the disk, written from `from`. 0, or 1.
pub fn write[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], n: int, from: &!b [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4170] == 0 || n < 0 || n >= k[4171] || len(from) < 512 {
        return 1;
    }
    if k[4170] == 2 {
        k[4175] = k[4175] + 1;
        return sdcard.write(vio, k, n, from);
    }
    let q = k[14] + 0x217000;
    var i = 0;
    while i < 512 {
        mmio_write8(dma, q + 0x800 + i, int_of(from[i]));
        i = i + 1;
    }
    k[4175] = k[4175] + 1;
    return request(vio, dma, k, n, true);
}

// The volume on the disk, into `info` (what `fat.mount` fills). 0, or why not: 1 no disk, 2 it could not be
// read, 3 no FAT partition, or one of `fat.mount`'s refusals.
fn volume[&mv, &md, &s, &b, &i](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], info: &!i [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4170] == 0 && k[4254] == 0 && (k[1] == 3 || k[1] == 4) {
        // a Pi's card is looked for the first time the disk is wanted, and once
        k[4254] = 1;
        sdcard.start(vio, k);
    }
    if k[4170] == 0 {
        return 1;
    }
    if read(vio, dma, k, 0, sec) != 0 {
        return 2;
    }
    let at = fat.partition(sec);
    if at < 0 {
        return 3;
    }
    if at > 0 && read(vio, dma, k, at, sec) != 0 {
        return 2;
    }
    return fat.mount(sec, at, info);
}

fn put_why[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], why: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if why == 1 {
        if k[4255] > 1 {
            base.puts(con, k, "no disk: the SD card did not start (step ");
            base.put_dec(con, k, k[4255]);
            return base.puts(con, k, " of src/sdcard.cho)\r\n");
        }
        return base.puts(con, k, "no disk: QEMU's virt machine has one when it is given one, a Pi 3 or 4 when a card is in\r\n");
    }
    if why == 2 {
        return base.puts(con, k, "the disk could not be read\r\n");
    }
    if why == 3 {
        return base.puts(con, k, "no FAT volume on the disk, and no partition table that names one\r\n");
    }
    if why == fat.not_512() {
        return base.puts(con, k, "a volume whose sectors are not 512 bytes: not read here\r\n");
    }
    if why == fat.fat12() {
        return base.puts(con, k, "a FAT12 volume: not read here\r\n");
    }
    return base.puts(con, k, "what is on the disk is not a FAT volume\r\n");
}

// ---- walking a directory -------------------------------------------------------------------
// The top directory of a FAT16 volume is a fixed run of sectors; every other directory, and FAT32's top
// one, is a chain of clusters like a file. `dir` says which: 0 the top directory, else the first cluster
// of another. `st` is where the walk is: 0 whether it follows a chain   1 the cluster   2 sectors left
// of the run, or sectors given of the cluster   3 the next sector of the run   4 turns   5 the last cluster
fn walk_start[&i, &u](info: &i [int], dir: int, st: &!u [int]) -> [] int {
    st[4] = 0;
    st[5] = 0;
    if dir == 0 && info[0] == 16 {
        st[0] = 0;
        st[2] = info[5];
        st[3] = info[4];
    } else {
        st[0] = 1;
        st[1] = info[4];
        if dir != 0 {
            st[1] = dir;
        }
        st[2] = 0;
    }
    return 0;
}

// The directory's next sector: its number; 0 when there are no more; -1 if the disk failed. `wt` is used
// to follow the chain, and must not be a buffer that anything else counts on.
fn walk_next[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], wt: &!t [byte], info: &i [int], st: &!u [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    st[4] = st[4] + 1;
    if st[4] > 65536 {
        return 0;
    }
    if st[0] == 0 {
        if st[2] == 0 {
            return 0;
        }
        st[2] = st[2] - 1;
        st[3] = st[3] + 1;
        return st[3] - 1;
    }
    if st[2] == info[1] {
        let fs = fat.fat_sector(info, st[1]);
        if fs < 0 || read(vio, dma, k, fs, wt) != 0 {
            return -1;
        }
        let after = fat.next(info, wt, st[1]);
        if after < 2 {
            return 0;
        }
        st[1] = after;
        st[2] = 0;
    }
    let at = fat.cluster_sector(info, st[1]);
    if at < 0 {
        return 0;
    }
    st[5] = st[1];
    st[2] = st[2] + 1;
    return at + st[2] - 1;
}

// A directory, entry by entry. With `wanted[from..to]` empty every file in it is printed; otherwise the
// file of that name is looked for, and `out` is its entry (length of name, first cluster, bytes).
// Answers how many files were printed, or 1 if the one wanted was found, or -1 if the disk failed.
fn top[&mc, &mv, &md, &s, &b, &t, &i, &m, &o, &w](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], name: &!m [byte], out: &!o [int], dir: int, wanted: &w [byte], from: int, to: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var count = 0;
    var result = -2;
    region r {
        let st = alloc_slice[r](6, 0);
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
                if at != 0 {
                    result = -1;
                }
            }
            var i = 0;
            while i < 16 && going {
                let kind = fat.entry(sec, i, name, out);
                if kind == fat.entry_end() {
                    going = false;
                } else if kind == fat.entry_file() {
                    if to > from {
                        if fat.named(name, out[0], wanted, from, to) {
                            result = 1;
                            going = false;
                        }
                    } else {
                        var c = 0;
                        while c < 14 {
                            if c < out[0] {
                                base.putc(con, k, int_of(name[c]));
                            } else {
                                base.putc(con, k, 32);
                            }
                            c = c + 1;
                        }
                        base.put_dec(con, k, out[2]);
                        base.puts(con, k, "\r\n");
                        count = count + 1;
                    }
                }
                i = i + 1;
            }
        }
    }
    if result != -2 {
        return result;
    }
    return count;
}

// The highest number a version in the directory `dir` has; 0 if there is none; -1 if the disk failed.
fn highest[&mv, &md, &s, &b, &t, &i, &m, &o](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], name: &!m [byte], out: &!o [int], dir: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var most = 0;
    region r {
        let st = alloc_slice[r](6, 0);
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
                if at != 0 {
                    most = -1;
                }
            }
            var i = 0;
            while i < 16 && going {
                let kind = fat.entry(sec, i, name, out);
                if kind == fat.entry_end() {
                    going = false;
                } else if kind == fat.entry_file() && fat.version_number(name, out[0]) > most {
                    most = fat.version_number(name, out[0]);
                }
                i = i + 1;
            }
        }
    }
    return most;
}

// The file that starts at `cluster` and is `size` bytes long, read to its end. With `show`, its text is
// printed (4,096 bytes at most; what is not a letter of ASCII as a dot). `sum` is two ints, and gets the two
// halves of the Adler-32 of all of it. Answers the bytes read, or -1.
fn whole[&mc, &mv, &md, &s, &b, &t, &i, &u](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], info: &i [int], first: int, size: int, show: bool, sum: &!u [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var a = 1;
    var b = 0;
    var done = 0;
    var cluster = first;
    var held = -1;
    var steps = 0;
    while done < size {
        let at = fat.cluster_sector(info, cluster);
        if at < 0 || steps > info[7] {
            return -1;
        }
        steps = steps + 1;
        var s = 0;
        while s < info[1] && done < size {
            if read(vio, dma, k, at + s, sec) != 0 {
                return -1;
            }
            var i = 0;
            while i < 512 && done < size {
                let c = int_of(sec[i]);
                a = (a + c) % 65521;
                b = (b + a) % 65521;
                if show && done < 4096 {
                    if c == 10 {
                        base.puts(con, k, "\r\n");
                    } else if c >= 32 && c < 127 {
                        base.putc(con, k, c);
                    } else if c != 13 {
                        base.putc(con, k, '.');
                    }
                }
                done = done + 1;
                i = i + 1;
            }
            s = s + 1;
        }
        if done < size {
            // the table says which cluster is next; its sector is read again only when it changes
            let fs = fat.fat_sector(info, cluster);
            if fs < 0 {
                return -1;
            }
            if fs != held {
                if read(vio, dma, k, fs, tab) != 0 {
                    return -1;
                }
                held = fs;
            }
            cluster = fat.next(info, tab, cluster);
            if cluster < 0 {
                // the file's clusters end before its length does
                return -1;
            }
        }
    }
    sum[0] = a;
    sum[1] = b;
    return done;
}

// ---- writing (docs/permissions.md says the order, and why) ---------------------------------
// A file's contents and the table's chain for them go to the disk first; the directory sector that
// names them goes last, and until it does the disk reads exactly as it did. Nothing that is there
// is ever changed: a file is added, or added to.
//
// `w` is a writer's state: 0 the first cluster it used   1 the last   2 how many sectors of the last
// are written   3 how many clusters it has taken   4 where in the table it last found a free cluster
// 5 which sector of the table `tab` holds (-1: none)   6 whether `tab` has changed since it was read

// Make `tab` hold sector `at` of the table, writing what it held first if that was changed.
fn table[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int], at: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if w[5] == at {
        return 0;
    }
    if kept(vio, dma, k, tab, info, w) != 0 {
        return 1;
    }
    if at < 0 || read(vio, dma, k, at, tab) != 0 {
        w[5] = -1;
        return 1;
    }
    w[5] = at;
    return 0;
}

// Write the table's sector that `tab` holds, to every copy of the table, if it was changed.
fn kept[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if w[6] == 0 || w[5] < 0 {
        return 0;
    }
    var copy = 0;
    while copy < info[10] {
        if write(vio, dma, k, w[5] + copy * info[3], tab) != 0 {
            return 1;
        }
        copy = copy + 1;
    }
    w[6] = 0;
    return 0;
}

// A free cluster, taken: it is marked as the last of a file, and chained after `after` if that is not 0.
// The cluster, or -1 if the disk is full or failed.
fn take[&mv, &md, &s, &t, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int], after: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var index = w[4];
    var found = -1;
    var looked = 0;
    while found < 0 && looked <= info[3] {
        if table(vio, dma, k, tab, info, w, info[2] + index) != 0 {
            return -1;
        }
        found = fat.free_cluster(info, tab, index, 0);
        if found < 0 {
            index = (index + 1) % info[3];
            looked = looked + 1;
        }
    }
    if found < 0 {
        return -1;
    }
    w[4] = index;
    w[3] = w[3] + 1;
    fat.set_next(info, tab, found, -1);
    w[6] = 1;
    if after != 0 {
        if table(vio, dma, k, tab, info, w, fat.fat_sector(info, after)) != 0 {
            return -1;
        }
        fat.set_next(info, tab, after, found);
        w[6] = 1;
    }
    return found;
}

// The next sector of the file being written: `data`, to a cluster taken when the last is full.
fn put[&mv, &md, &s, &t, &i, &u, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tab: &!t [byte], info: &i [int], w: &!u [int], data: &!b [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if w[1] == 0 || w[2] >= info[1] {
        let c = take(vio, dma, k, tab, info, w, w[1]);
        if c < 0 {
            return 1;
        }
        if w[0] == 0 {
            w[0] = c;
        }
        w[1] = c;
        w[2] = 0;
    }
    if write(vio, dma, k, fat.cluster_sector(info, w[1]) + w[2], data) != 0 {
        return 1;
    }
    w[2] = w[2] + 1;
    return 0;
}

// A directory, looked through for the name `wanted[from..to]` and for a place to put one. `o` gets:
//   0 whether something has that name   1 2 the sector and the entry that names it   3 4 its first cluster
//   and length   5 6 the sector and the entry of the first free place (-1: none)   7 the directory's last
//   cluster (0 for FAT16's top directory, which cannot grow)   8 what was found: 2 a file, 3 a directory.
// 0, or 1 if the disk failed.
fn look[&mv, &md, &s, &b, &t, &i, &m, &n, &o, &r](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!t [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], dir: int, wanted: &r [byte], from: int, to: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    o[0] = 0;
    o[5] = -1;
    o[7] = 0;
    var failed = 0;
    region r {
        let st = alloc_slice[r](6, 0);
        walk_start(info, dir, st);
        var going = true;
        while going {
            let at = walk_next(vio, dma, k, wt, info, st);
            if at <= 0 || read(vio, dma, k, at, sec) != 0 {
                going = false;
                if at != 0 {
                    failed = 1;
                }
            }
            if going {
                o[7] = st[5];
                if o[5] < 0 && fat.free_slot(sec) >= 0 {
                    o[5] = at;
                    o[6] = fat.free_slot(sec);
                }
            }
            var i = 0;
            while i < 16 && going {
                let kind = fat.entry(sec, i, name, out);
                if kind == fat.entry_end() {
                    going = false;
                } else if kind == fat.entry_file() || kind == fat.entry_directory() {
                    if fat.named(name, out[0], wanted, from, to) {
                        o[0] = 1;
                        o[1] = at;
                        o[2] = i;
                        o[3] = out[1];
                        o[4] = out[2];
                        o[8] = kind;
                    }
                }
                i = i + 1;
            }
        }
    }
    return failed;
}

// Everything before the first byte of something new in the directory `dir`: the name is one, nothing
// there has it, and there is a place for it (a directory that is a chain and has none is given another
// cluster). 0 with `o[5]`, `o[6]` the place; else the reason is printed and 1 answered.
fn place[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], dir: int, text: &r [byte], from: int, to: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if fat.put_entry(sec, 0, text, from, to, 0, 0) != 0 {
        base.puts(con, k, "not a short name: one to eight letters or digits, then perhaps a dot and one to three\r\n");
        return 1;
    }
    if look(vio, dma, k, sec, wt, info, name, out, o, dir, text, from, to) != 0 {
        base.puts(con, k, "the disk could not be read\r\n");
        return 1;
    }
    if o[0] != 0 {
        base.puts(con, k, "there is something of that name already\r\n");
        return 1;
    }
    if o[5] < 0 {
        if o[7] == 0 {
            base.puts(con, k, "the top directory is full\r\n");
            return 1;
        }
        // one more cluster for the directory, empty, chained after its last
        let c = take(vio, dma, k, tab, info, w, o[7]);
        var z = 0;
        while z < 512 {
            sec[z] = byte_of(0);
            z = z + 1;
        }
        var bad = c < 0;
        var n = 0;
        while n < info[1] && !bad {
            bad = write(vio, dma, k, fat.cluster_sector(info, c) + n, sec) != 0;
            n = n + 1;
        }
        if bad || kept(vio, dma, k, tab, info, w) != 0 {
            base.puts(con, k, "the disk is full, or could not be written\r\n");
            return 1;
        }
        o[5] = fat.cluster_sector(info, c);
        o[6] = 0;
    }
    return 0;
}

// The directory versions are kept in, `OLD` in the top directory: its first cluster. With `make`, it is
// made if it is not there. 0: there is none. -1: it could not be read or made, and the reason is printed.
fn old_dir[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], make: bool) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if look(vio, dma, k, sec, wt, info, name, out, o, 0, "OLD", 0, 3) != 0 {
        base.puts(con, k, "the disk could not be read\r\n");
        return -1;
    }
    if o[0] != 0 {
        if o[8] != fat.entry_directory() {
            base.puts(con, k, "OLD is a file here, and versions need a directory of that name\r\n");
            return -1;
        }
        return o[3];
    }
    if !make {
        return 0;
    }
    if place(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, 0, "OLD", 0, 3) != 0 {
        return -1;
    }
    // its one cluster first: the two entries a directory begins with, and nothing else; then its name
    let c = take(vio, dma, k, tab, info, w, 0);
    var z = 0;
    while z < 512 {
        sec[z] = byte_of(0);
        z = z + 1;
    }
    var bad = c < 0;
    var n = 1;
    while n < info[1] && !bad {
        bad = write(vio, dma, k, fat.cluster_sector(info, c) + n, sec) != 0;
        n = n + 1;
    }
    if !bad {
        fat.put_dots(sec, c, 0);
        bad = write(vio, dma, k, fat.cluster_sector(info, c), sec) != 0;
    }
    bad = bad || kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, o[5], sec) != 0;
    if !bad {
        fat.put_directory(sec, o[6], "OLD", 0, 3, c);
        bad = write(vio, dma, k, o[5], sec) != 0;
    }
    if bad {
        base.puts(con, k, "the disk is full, or could not be written\r\n");
        return -1;
    }
    return c;
}

// What a file held (`cluster`, `size`) given a name of its own in `OLD`, so that it is kept when the file
// is changed or removed. Answers the version's number, with its name in `vname`; -1 with the reason printed.
fn version[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u, &v](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], vname: &!v [byte], cluster: int, size: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let oldc = old_dir(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, true);
    if oldc < 0 {
        return -1;
    }
    let last = highest(vio, dma, k, sec, wt, info, name, out, oldc);
    if last < 0 || fat.version_name(vname, last + 1) < 0 {
        base.puts(con, k, "the versions could not be read\r\n");
        return -1;
    }
    if place(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, oldc, vname, 0, 10) != 0 {
        return -1;
    }
    if kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, o[5], sec) != 0 || fat.put_entry(sec, o[6], vname, 0, 10, cluster, size) != 0 || write(vio, dma, k, o[5], sec) != 0 {
        base.puts(con, k, "the disk could not be written\r\n");
        return -1;
    }
    return last + 1;
}

// After a change that went through: FAT32's count of free clusters, a hint kept in a sector of its own, is
// brought down by what was taken. (After one that did not, it is left too high, which is what a hint may be.)
fn counted[&mv, &md, &s, &b, &i, &u](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], info: &i [int], w: &!u [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if info[11] == 0 || w[3] == 0 {
        return 0;
    }
    if read(vio, dma, k, info[11], sec) == 0 && fat.summary_less(sec, w[3]) == 0 {
        write(vio, dma, k, info[11], sec);
    }
    w[3] = 0;
    return 0;
}

// The last step of a new file: what is left of the table, then the directory entry that makes it exist.
fn name_it[&mv, &md, &s, &b, &t, &i, &o, &u, &r](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], info: &i [int], o: &!o [int], w: &!u [int], text: &r [byte], from: int, to: int, size: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, o[5], sec) != 0 {
        return 1;
    }
    if fat.put_entry(sec, o[6], text, from, to, w[0], size) != 0 {
        return 1;
    }
    return write(vio, dma, k, o[5], sec);
}

// ---- the record (docs/permissions.md; the lines are `record`'s) ------------------------------
// LOG.TXT is only ever added to, a line a change, and each line is added before the last sector of the
// change it names is written: nothing takes effect that the record does not have. What the kernel keeps
// between changes is in `k`: 4186 whether the file has been walked   4187 its lines   4188..4251 the chain
// of its last line, as 64 hex digits   4252 the first line that does not follow (0: every line does)

// More at the end of a file: `data[0..n]` after the `size` bytes that start at cluster `first`. The table is
// left in `tab` for `kept` to write; then `w[0]` is the file's first cluster, and the caller writes the
// directory's word for it, last. 0, or 1 if the disk is full or failed.
fn extend[&mv, &md, &s, &b, &t, &q, &i, &u, &d](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], w: &!u [int], first: int, size: int, data: &d [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let per = info[1] * 512;
    var bad = n < 0 || n > len(data);
    // the file's last cluster, and how much of it is used
    w[0] = first;
    var cluster = first;
    var steps = 0;
    var held = -1;
    while size > 0 && !bad && cluster >= 2 && steps <= info[7] {
        w[1] = cluster;
        let fs = fat.fat_sector(info, cluster);
        if fs != held {
            bad = fs < 0 || read(vio, dma, k, fs, wt) != 0;
            held = fs;
        }
        cluster = fat.next(info, wt, cluster);
        steps = steps + 1;
    }
    var i = 0;
    while i < 512 {
        sec[i] = byte_of(0);
        i = i + 1;
    }
    var fill = 0;
    if size > 0 && !bad {
        let used = (size - 1) % per + 1;
        w[2] = used / 512;
        fill = used % 512;
        if fill > 0 {
            // the sector the file ends in: what is past its end is not yet part of it
            bad = read(vio, dma, k, fat.cluster_sector(info, w[1]) + w[2], sec) != 0;
        }
    }
    var sent = 0;
    while sent < n && !bad {
        sec[fill] = data[sent];
        fill = fill + 1;
        sent = sent + 1;
        if fill == 512 || sent == n {
            bad = put(vio, dma, k, tab, info, w, sec) != 0;
            fill = 0;
            i = 0;
            while i < 512 {
                sec[i] = byte_of(0);
                i = i + 1;
            }
        }
    }
    if bad {
        return 1;
    }
    return 0;
}

// LOG.TXT walked from its first line to its last, once after a start: how many lines, the chain of the last,
// and whether every line follows from the one before. 0; 1 if there is no such file; -1 if the disk failed.
fn record_load[&mv, &md, &s, &b, &q, &i, &m, &n, &o](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if look(vio, dma, k, sec, wt, info, name, out, o, 0, "LOG.TXT", 0, 7) != 0 {
        return -1;
    }
    if o[0] == 0 || o[8] != fat.entry_file() {
        return 1;
    }
    if k[4186] == 1 {
        return 0;
    }
    var bad = false;
    region r {
        let st = alloc_slice[r](record.walk_len(), 0);
        let prev = alloc_slice[r](64, byte_of(0));
        let ln = alloc_slice[r](512, byte_of(0));
        let state = alloc_slice[r](sha.state_len(), 0);
        let dig = alloc_slice[r](32, byte_of(0));
        let hex = alloc_slice[r](64, byte_of(0));
        record.start(st, prev);
        let size = o[4];
        var done = 0;
        var cluster = o[3];
        var held = -1;
        var steps = 0;
        while done < size && !bad && steps <= info[7] {
            let at = fat.cluster_sector(info, cluster);
            bad = at < 0;
            var n = 0;
            while n < info[1] && done < size && !bad {
                bad = read(vio, dma, k, at + n, sec) != 0;
                var i = 0;
                while i < 512 && done < size && !bad {
                    record.feed(st, prev, ln, state, dig, hex, int_of(sec[i]));
                    done = done + 1;
                    i = i + 1;
                }
                n = n + 1;
            }
            if done < size && !bad {
                let fs = fat.fat_sector(info, cluster);
                if fs != held {
                    bad = fs < 0 || read(vio, dma, k, fs, wt) != 0;
                    held = fs;
                }
                cluster = fat.next(info, wt, cluster);
                bad = bad || cluster < 0;
            }
            steps = steps + 1;
        }
        record.end(st);
        if !bad && done == size {
            k[4186] = 1;
            k[4187] = st[0];
            k[4252] = st[1];
            var i = 0;
            while i < 64 {
                k[4188 + i] = int_of(prev[i]);
                i = i + 1;
            }
        } else {
            bad = true;
        }
    }
    if bad {
        return -1;
    }
    return 0;
}

// Before a change: the record is there (an empty one is made on a disk that has none) and has been walked.
// `who` is 0 the console, 1 a key over SSH, 2 the open shell on port 23, 3 the kernel itself. 0; else the
// reason is printed and 1 answered.
fn ready[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], who: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var have = record_load(vio, dma, k, sec, wt, info, name, out, o);
    if have == 1 {
        if o[0] != 0 {
            base.puts(con, k, "LOG.TXT is a directory here, and the record needs a file of that name\r\n");
            return 1;
        }
        if place(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, 0, "LOG.TXT", 0, 7) != 0 {
            return 1;
        }
        if read(vio, dma, k, o[5], sec) != 0 || fat.put_entry(sec, o[6], "LOG.TXT", 0, 7, 0, 0) != 0 || write(vio, dma, k, o[5], sec) != 0 {
            have = -1;
        } else {
            have = record_load(vio, dma, k, sec, wt, info, name, out, o);
        }
    }
    if have != 0 {
        base.puts(con, k, "the record could not be read or made: nothing was changed\r\n");
        return 1;
    }
    if k[4252] != 0 && (who == 1 || who == 2) {
        base.puts(con, k, "the record does not follow at line ");
        base.put_dec(con, k, k[4252]);
        base.puts(con, k, ": until that is looked into, changes are taken at the console only\r\n");
        return 1;
    }
    return 0;
}

// One line more in the record, for a change that is about to take effect: who, what, to what, from what,
// which version it left, how many bytes and the SHA-256 of them (`hash`, when `hashed`). `cw` is the
// writer of the change itself, whose table sector may no longer be what the disk holds. 0, or 1.
fn record_add[&mv, &md, &s, &i, &u, &a, &r, &f, &h](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], info: &i [int], cw: &!u [int], who: int, action: &a [byte], text: &r [byte], from: int, to: int, src: &f [byte], sfrom: int, sto: int, version: int, size: int, hash: &h [byte], hashed: bool) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var bad = true;
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        let tab = alloc_slice[r](512, byte_of(0));
        let wt = alloc_slice[r](512, byte_of(0));
        let name = alloc_slice[r](12, byte_of(0));
        let out = alloc_slice[r](3, 0);
        let o = alloc_slice[r](10, 0);
        let w = alloc_slice[r](8, 0);
        w[5] = -1;
        let ln = alloc_slice[r](512, byte_of(0));
        let prev = alloc_slice[r](64, byte_of(0));
        let state = alloc_slice[r](sha.state_len(), 0);
        let dig = alloc_slice[r](32, byte_of(0));
        let hex = alloc_slice[r](64, byte_of(0));
        let key = alloc_slice[r](20, byte_of(0));
        var i = 0;
        while i < 64 {
            prev[i] = byte_of(k[4188 + i]);
            i = i + 1;
        }
        var at = record.number(ln, 0, k[4187] + 1);
        at = record.number(ln, at, k[5]);
        if who == 0 {
            at = record.word(ln, at, "console", 0, 7);
            at = record.word(ln, at, "console", 0, 7);
        } else if who == 1 {
            // the key that logged in, as the first 16 hex digits of the SHA-256 OpenSSH shows for it
            key[0] = byte_of('k');
            key[1] = byte_of('e');
            key[2] = byte_of('y');
            key[3] = byte_of(':');
            i = 0;
            while i < 16 {
                var v = 0;
                if i < 8 {
                    v = k[4184] >> 28 - i * 4 & 15;
                } else {
                    v = k[4185] >> 28 - (i - 8) * 4 & 15;
                }
                if v < 10 {
                    key[4 + i] = byte_of('0' + v);
                } else {
                    key[4 + i] = byte_of('a' + v - 10);
                }
                i = i + 1;
            }
            at = record.word(ln, at, key, 0, 20);
            if k[4179] == 2 {
                at = record.word(ln, at, "owner", 0, 5);
            } else {
                at = record.word(ln, at, "reader", 0, 6);
            }
        } else if who == 2 {
            at = record.word(ln, at, "port23", 0, 6);
            at = record.word(ln, at, "open", 0, 4);
        } else {
            at = record.word(ln, at, "kernel", 0, 6);
            at = record.word(ln, at, "kernel", 0, 6);
        }
        at = record.word(ln, at, action, 0, len(action));
        at = record.word(ln, at, text, from, to);
        if sto > sfrom {
            at = record.word(ln, at, src, sfrom, sto);
        } else {
            at = record.word(ln, at, "-", 0, 1);
        }
        if version > 0 {
            at = record.number(ln, at, version);
        } else {
            at = record.number(ln, at, -1);
        }
        at = record.number(ln, at, size);
        if hashed {
            at = record.hexes(ln, at, hash, 32);
        } else {
            at = record.word(ln, at, "-", 0, 1);
        }
        let n = record.sealed(ln, at, prev, state, dig, hex);
        if n > 0 && look(vio, dma, k, sec, wt, info, name, out, o, 0, "LOG.TXT", 0, 7) == 0 && o[0] != 0 && o[8] == fat.entry_file() {
            let es = o[1];
            let ei = o[2];
            let size_before = o[4];
            bad = extend(vio, dma, k, sec, tab, wt, info, w, o[3], size_before, ln, n) != 0 || kept(vio, dma, k, tab, info, w) != 0 || read(vio, dma, k, es, sec) != 0;
            if !bad {
                fat.set_extent(sec, ei, w[0], size_before + n);
                bad = write(vio, dma, k, es, sec) != 0;
            }
            if !bad {
                counted(vio, dma, k, sec, info, w);
                k[4187] = k[4187] + 1;
                i = 0;
                while i < 64 {
                    k[4188 + i] = int_of(prev[i]);
                    i = i + 1;
                }
            }
        }
    }
    cw[5] = -1;
    if bad {
        return 1;
    }
    return 0;
}

// ---- files the kernel keeps for itself (docs/permissions.md) ---------------------------------

// The file `wanted` of the top directory, into `into`: as much of it as fits. How many bytes; -1 if there
// is no disk, no volume or no such file.
pub fn get[&mv, &md, &s, &m, &d](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], wanted: &m [byte], into: &!d [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var got = -1;
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        let tab = alloc_slice[r](512, byte_of(0));
        let info = alloc_slice[r](fat.facts(), 0);
        let name = alloc_slice[r](12, byte_of(0));
        let out = alloc_slice[r](3, 0);
        let o = alloc_slice[r](10, 0);
        if volume(vio, dma, k, sec, info) == 0 && look(vio, dma, k, sec, tab, info, name, out, o, 0, wanted, 0, len(wanted)) == 0 && o[0] != 0 && o[8] == fat.entry_file() {
            var size = o[4];
            if size > len(into) {
                size = len(into);
            }
            got = 0;
            var cluster = o[3];
            var steps = 0;
            var bad = false;
            while got < size && !bad && steps <= info[7] {
                let at = fat.cluster_sector(info, cluster);
                bad = at < 0;
                var n = 0;
                while n < info[1] && got < size && !bad {
                    bad = read(vio, dma, k, at + n, sec) != 0;
                    var i = 0;
                    while i < 512 && got < size && !bad {
                        into[got] = sec[i];
                        got = got + 1;
                        i = i + 1;
                    }
                    n = n + 1;
                }
                if got < size && !bad {
                    let fs = fat.fat_sector(info, cluster);
                    bad = fs < 0 || read(vio, dma, k, fs, tab) != 0;
                    cluster = fat.next(info, tab, cluster);
                    bad = bad || cluster < 0;
                }
                steps = steps + 1;
            }
            if bad {
                got = -1;
            }
        }
    }
    return got;
}

// A new file `wanted` whose contents are `data[0..n]`, 512 bytes at most. 0 if it was made; 1 if not
// (no disk, a file of that name already, no room), with the reason printed where there is one to give.
pub fn keep[&mc, &mv, &md, &s, &m, &d](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], wanted: &m [byte], data: &d [byte], n: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var made = 1;
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        let tab = alloc_slice[r](512, byte_of(0));
        let info = alloc_slice[r](fat.facts(), 0);
        let name = alloc_slice[r](12, byte_of(0));
        let out = alloc_slice[r](3, 0);
        let o = alloc_slice[r](10, 0);
        let wt = alloc_slice[r](512, byte_of(0));
        let w = alloc_slice[r](8, 0);
        w[5] = -1;
        if n >= 0 && n <= 512 && n <= len(data) && volume(vio, dma, k, sec, info) == 0 {
            if ready(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, 3) == 0 && place(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, 0, wanted, 0, len(wanted)) == 0 {
                var i = 0;
                while i < 512 {
                    sec[i] = byte_of(0);
                    i = i + 1;
                }
                i = 0;
                while i < n {
                    sec[i] = data[i];
                    i = i + 1;
                }
                // what it holds may be a secret: the record has its name and its length, not its hash
                if put(vio, dma, k, tab, info, w, sec) == 0 && kept(vio, dma, k, tab, info, w) == 0 && record_add(vio, dma, k, info, w, 3, "keep", wanted, 0, len(wanted), wanted, 0, 0, 0, n, sec, false) == 0 && name_it(vio, dma, k, sec, tab, info, o, w, wanted, 0, len(wanted), n) == 0 {
                    counted(vio, dma, k, sec, info, w);
                    made = 0;
                }
            }
        }
    }
    return made;
}

// Is `text[from..to]` the name of the SSH host key's file? The shell neither shows nor copies nor adds to it.
fn secret[&r](text: &r [byte], from: int, to: int) -> [] bool {
    return fat.named("HOSTKEY.BIN", 11, text, from, to);
}

fn begins[&r, &w](text: &r [byte], n: int, word: &w [byte]) -> [] bool {
    if n < len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(text[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Where the first word of `text[from..n]` ends.
fn word[&r](text: &r [byte], from: int, n: int) -> [] int {
    var i = from;
    while i < n && int_of(text[i]) != ' ' {
        i = i + 1;
    }
    return i;
}

// The names the shell does not write, add to, copy onto or remove: the host key, the directory the versions
// are kept in, and the record.
fn kept_name[&r](text: &r [byte], from: int, to: int) -> [] bool {
    return secret(text, from, to) || fat.named("OLD", 3, text, from, to) || fat.named("LOG.TXT", 7, text, from, to);
}

// Is `text[from..to]` a file the board starts from? The firmware reads these before any kernel runs, and a
// wrong one stops the board until its card is mended on another machine. The kernel itself, the two files of
// settings, and anything the firmware loads (`.ELF`, `.DAT`, `.DTB`, `.BIN`, `.IMG`).
pub fn boot_name[&r](text: &r [byte], from: int, to: int) -> [] bool {
    if fat.named("CONFIG.TXT", 10, text, from, to) || fat.named("CMDLINE.TXT", 11, text, from, to) {
        return true;
    }
    if to - from < 5 || to > len(text) || from < 0 || int_of(text[to - 4]) != '.' {
        return false;
    }
    let a = int_of(text[to - 3]) | 32;
    let b = int_of(text[to - 2]) | 32;
    let c = int_of(text[to - 1]) | 32;
    return a == 'e' && b == 'l' && c == 'f' || a == 'd' && b == 'a' && c == 't' || a == 'd' && b == 't' && c == 'b' || a == 'b' && b == 'i' && c == 'n' || a == 'i' && b == 'm' && c == 'g';
}

// May `put` make or replace `text[from..to]`? A short name that is not one of the kernel's own.
pub fn put_name[&r](text: &r [byte], from: int, to: int) -> [] bool {
    var good = false;
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        good = !kept_name(text, from, to) && fat.put_entry(sec, 0, text, from, to, 0, 0) == 0;
    }
    return good;
}

// Does `text[from..to]` begin with `OLD/`, the way a version is named?
fn in_old[&r](text: &r [byte], from: int, to: int) -> [] bool {
    if to - from < 5 {
        return false;
    }
    return (int_of(text[from]) | 32) == 'o' && (int_of(text[from + 1]) | 32) == 'l' && (int_of(text[from + 2]) | 32) == 'd' && int_of(text[from + 3]) == '/';
}

// The file a command reads, `text[from..to]`: a name of the top directory, or `OLD/` and a version's.
// 0 with `o[3]`, `o[4]` its first cluster and its length; else the reason is printed and 1 answered.
fn source[&mc, &mv, &md, &s, &b, &t, &q, &i, &m, &n, &o, &u, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], sec: &!b [byte], tab: &!t [byte], wt: &!q [byte], info: &i [int], name: &!m [byte], out: &!n [int], o: &!o [int], w: &!u [int], text: &r [byte], from: int, to: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var dir = 0;
    var at = from;
    if in_old(text, from, to) {
        dir = old_dir(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, false);
        if dir < 0 {
            return 1;
        }
        if dir == 0 {
            base.puts(con, k, "no versions are kept on this disk yet\r\n");
            return 1;
        }
        at = from + 4;
    }
    if look(vio, dma, k, sec, wt, info, name, out, o, dir, text, at, to) != 0 {
        base.puts(con, k, "the disk could not be read\r\n");
        return 1;
    }
    if o[0] == 0 || o[8] != fat.entry_file() {
        base.puts(con, k, "no such file (short names only; `ls` lists them, and `versions` what is kept)\r\n");
        return 1;
    }
    return 0;
}

fn put_version[&mc, &s, &v](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], vname: &v [byte]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    base.puts(con, k, "OLD/");
    var i = 0;
    while i < 10 {
        base.putc(con, k, int_of(vname[i]));
        i = i + 1;
    }
    return 0;
}

// `write <name> <text>`, `append <name> <text>`, `copy <from> <to>`, `remove <name>` and `purge <number>`.
// What a file held is never lost by the first four: `write` over a file and `remove` leave it in `OLD`
// under a number, and the name is changed last. `purge` is the one that gives clusters back.
fn change[&mc, &mv, &md, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], text: &r [byte], n: int, what: int, who: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        let tab = alloc_slice[r](512, byte_of(0));
        let rsec = alloc_slice[r](512, byte_of(0));
        let rtab = alloc_slice[r](512, byte_of(0));
        let info = alloc_slice[r](fat.facts(), 0);
        let name = alloc_slice[r](12, byte_of(0));
        let vname = alloc_slice[r](12, byte_of(0));
        let hs = alloc_slice[r](sha.state_len(), 0);
        let hd = alloc_slice[r](32, byte_of(0));
        let out = alloc_slice[r](3, 0);
        let o = alloc_slice[r](10, 0);
        let w = alloc_slice[r](8, 0);
        w[5] = -1;
        // the words after the command
        var first = 6;
        if what == 2 || what == 4 {
            first = 7;
        } else if what == 3 {
            first = 5;
        }
        var mid = word(text, first, n);
        if what >= 4 {
            mid = n;
        }
        let why = volume(vio, dma, k, sec, info);
        if why != 0 {
            put_why(con, k, why);
        } else if what < 4 && (mid >= n - 1 || mid == first) {
            base.puts(con, k, "usage: write <name> <text>, append <name> <text>, copy <from> <to>\r\n");
        } else if ready(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, who) != 0 {
            // `ready` said why
        } else if what == 1 {
            // a file whose contents are the text and a line feed: a new one, or a new version of one
            if look(vio, dma, k, sec, rtab, info, name, out, o, 0, text, first, mid) != 0 {
                base.puts(con, k, "the disk could not be read\r\n");
            } else if o[0] != 0 && o[8] != fat.entry_file() {
                base.puts(con, k, "that is a directory\r\n");
            } else {
                let there = o[0] != 0;
                let es = o[1];
                let ei = o[2];
                let oc = o[3];
                let os = o[4];
                var ok = true;
                if !there {
                    ok = place(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, 0, text, first, mid) == 0;
                }
                var size = n - mid - 1;
                if size > 500 {
                    size = 500;
                }
                var i = 0;
                while i < 512 {
                    sec[i] = byte_of(0);
                    i = i + 1;
                }
                i = 0;
                while i < size {
                    sec[i] = text[mid + 1 + i];
                    i = i + 1;
                }
                sec[size] = byte_of(10);
                size = size + 1;
                sha.digest(sec[0..size], hd);
                if !ok {
                    // `place` said why
                } else if put(vio, dma, k, tab, info, w, sec) != 0 || kept(vio, dma, k, tab, info, w) != 0 {
                    base.puts(con, k, "the disk is full, or could not be written: nothing was changed\r\n");
                } else if !there {
                    if record_add(vio, dma, k, info, w, who, "write", text, first, mid, text, 0, 0, 0, size, hd, true) != 0 {
                        base.puts(con, k, "the record could not be added to: nothing was changed\r\n");
                    } else if name_it(vio, dma, k, sec, tab, info, o, w, text, first, mid, size) != 0 {
                        base.puts(con, k, "the disk could not be written: no file was made\r\n");
                    } else {
                        counted(vio, dma, k, sec, info, w);
                        base.puts(con, k, "written: ");
                        base.put_dec(con, k, size);
                        base.puts(con, k, " bytes\r\n");
                    }
                } else {
                    // what the file held gets its name in OLD first; then the file's own entry is pointed
                    // at the new contents, in one sector written once
                    let first_new = w[0];
                    let v = version(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, vname, oc, os);
                    var bad = v < 0;
                    if !bad && record_add(vio, dma, k, info, w, who, "write", text, first, mid, text, 0, 0, v, size, hd, true) != 0 {
                        base.puts(con, k, "the record could not be added to: nothing was changed\r\n");
                        bad = true;
                    }
                    bad = bad || read(vio, dma, k, es, sec) != 0;
                    if !bad {
                        fat.set_extent(sec, ei, first_new, size);
                        bad = write(vio, dma, k, es, sec) != 0;
                    }
                    if bad {
                        base.puts(con, k, "the file is as it was\r\n");
                    } else {
                        counted(vio, dma, k, sec, info, w);
                        base.puts(con, k, "written: ");
                        base.put_dec(con, k, size);
                        base.puts(con, k, " bytes; what was there is ");
                        put_version(con, k, vname);
                        base.puts(con, k, "\r\n");
                    }
                }
            }
        } else if what == 4 {
            // the file's contents get a name in OLD, and then its own name is taken away
            if look(vio, dma, k, sec, rtab, info, name, out, o, 0, text, first, mid) != 0 {
                base.puts(con, k, "the disk could not be read\r\n");
            } else if o[0] == 0 {
                base.puts(con, k, "no such file to remove\r\n");
            } else if o[8] != fat.entry_file() {
                base.puts(con, k, "that is a directory\r\n");
            } else {
                let es = o[1];
                let ei = o[2];
                let v = version(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, vname, o[3], o[4]);
                var bad = v < 0;
                if !bad && record_add(vio, dma, k, info, w, who, "remove", text, first, mid, text, 0, 0, v, -1, hd, false) != 0 {
                    base.puts(con, k, "the record could not be added to: nothing was changed\r\n");
                    bad = true;
                }
                bad = bad || read(vio, dma, k, es, sec) != 0;
                if !bad {
                    fat.erase(sec, ei);
                    bad = write(vio, dma, k, es, sec) != 0;
                }
                if bad {
                    base.puts(con, k, "the file is as it was\r\n");
                } else {
                    counted(vio, dma, k, sec, info, w);
                    base.puts(con, k, "removed; what it held is ");
                    put_version(con, k, vname);
                    base.puts(con, k, "\r\n");
                }
            }
        } else if what == 5 {
            // a version, given up for good: its name first, then its clusters
            var number = 0;
            var i = first;
            var digits = i < n && n - i <= 8;
            while i < n && digits {
                let c = int_of(text[i]);
                digits = c >= '0' && c <= '9';
                number = number * 10 + c - '0';
                i = i + 1;
            }
            var dir = 0;
            if digits && number > 0 {
                dir = old_dir(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, false);
            }
            if !digits || number == 0 {
                base.puts(con, k, "usage: purge <number>   (`versions` lists them)\r\n");
            } else if dir < 0 {
                // `old_dir` said why
            } else if dir == 0 || fat.version_name(vname, number) < 0 || look(vio, dma, k, sec, rtab, info, name, out, o, dir, vname, 0, 10) != 0 || o[0] == 0 {
                base.puts(con, k, "no such version\r\n");
            } else {
                var cluster = o[3];
                let es = o[1];
                let ei = o[2];
                var bad = record_add(vio, dma, k, info, w, who, "purge", vname, 0, 10, text, 0, 0, number, o[4], hd, false) != 0;
                if bad {
                    base.puts(con, k, "the record could not be added to: nothing was changed\r\n");
                }
                bad = bad || read(vio, dma, k, es, sec) != 0;
                if !bad {
                    fat.erase(sec, ei);
                    bad = write(vio, dma, k, es, sec) != 0;
                }
                var freed = 0;
                while cluster >= 2 && !bad && freed <= info[7] {
                    bad = table(vio, dma, k, tab, info, w, fat.fat_sector(info, cluster)) != 0;
                    if !bad {
                        let after = fat.next(info, tab, cluster);
                        fat.set_free(info, tab, cluster);
                        w[6] = 1;
                        freed = freed + 1;
                        cluster = after;
                    }
                }
                bad = bad || kept(vio, dma, k, tab, info, w) != 0;
                if !bad && info[11] != 0 && freed > 0 {
                    if read(vio, dma, k, info[11], sec) == 0 && fat.summary_more(sec, freed) == 0 {
                        write(vio, dma, k, info[11], sec);
                    }
                }
                if bad {
                    base.puts(con, k, "the disk could not be read or written\r\n");
                } else {
                    base.puts(con, k, "purged: ");
                    put_version(con, k, vname);
                    base.puts(con, k, ", ");
                    base.put_dec(con, k, freed);
                    base.puts(con, k, " clusters given back\r\n");
                }
            }
        } else if what == 3 {
            // a new file with the contents of another, or of a version, read as `sum` reads it
            if source(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, text, first, mid) == 0 {
                let from_cluster = o[3];
                let size = o[4];
                if place(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, 0, text, mid + 1, n) == 0 {
                    var done = 0;
                    var cluster = from_cluster;
                    var held = -1;
                    var bad = false;
                    sha.init(hs);
                    while done < size && !bad {
                        let at = fat.cluster_sector(info, cluster);
                        bad = at < 0;
                        var s = 0;
                        while s < info[1] && done < size && !bad {
                            bad = read(vio, dma, k, at + s, rsec) != 0;
                            // what is past the file's end in its last sector is not copied
                            var i = size - done;
                            while i < 512 {
                                rsec[i] = byte_of(0);
                                i = i + 1;
                            }
                            var m = size - done;
                            if m > 512 {
                                m = 512;
                            }
                            sha.update(hs, rsec[0..m]);
                            bad = bad || put(vio, dma, k, tab, info, w, rsec) != 0;
                            done = done + 512;
                            s = s + 1;
                        }
                        if done < size && !bad {
                            let fs = fat.fat_sector(info, cluster);
                            if fs != held {
                                bad = fs < 0 || read(vio, dma, k, fs, rtab) != 0;
                                held = fs;
                            }
                            cluster = fat.next(info, rtab, cluster);
                            bad = bad || cluster < 0;
                        }
                    }
                    bad = bad || kept(vio, dma, k, tab, info, w) != 0;
                    if !bad {
                        sha.final(hs, hd);
                        bad = record_add(vio, dma, k, info, w, who, "copy", text, mid + 1, n, text, first, mid, 0, size, hd, true) != 0;
                    }
                    if bad || name_it(vio, dma, k, sec, tab, info, o, w, text, mid + 1, n, size) != 0 {
                        base.puts(con, k, "the disk is full, or could not be read or written: no file was made\r\n");
                    } else {
                        counted(vio, dma, k, sec, info, w);
                        base.puts(con, k, "copied: ");
                        base.put_dec(con, k, size);
                        base.puts(con, k, " bytes\r\n");
                    }
                }
            }
        } else {
            // more at the end of a file that is there: its text and a line feed
            if look(vio, dma, k, sec, rtab, info, name, out, o, 0, text, first, mid) != 0 || o[0] == 0 || o[8] != fat.entry_file() {
                base.puts(con, k, "no such file to add to (`write` makes one)\r\n");
            } else {
                let size = o[4];
                let es = o[1];
                let ei = o[2];
                var more = n - mid - 1;
                if more > 500 {
                    more = 500;
                }
                var i = 0;
                while i < more {
                    rsec[i] = text[mid + 1 + i];
                    i = i + 1;
                }
                rsec[more] = byte_of(10);
                more = more + 1;
                sha.digest(rsec[0..more], hd);
                var bad = extend(vio, dma, k, sec, tab, rtab, info, w, o[3], size, rsec, more) != 0 || kept(vio, dma, k, tab, info, w) != 0;
                if !bad && record_add(vio, dma, k, info, w, who, "append", text, first, mid, text, 0, 0, 0, more, hd, true) != 0 {
                    base.puts(con, k, "the record could not be added to: nothing was changed\r\n");
                    bad = true;
                }
                // last, the directory's word for where the file starts and how long it is
                bad = bad || read(vio, dma, k, es, sec) != 0;
                if !bad {
                    fat.set_extent(sec, ei, w[0], size + more);
                    bad = write(vio, dma, k, es, sec) != 0;
                }
                if bad {
                    base.puts(con, k, "the disk is full, or could not be read or written: the file is as it was\r\n");
                } else {
                    counted(vio, dma, k, sec, info, w);
                    base.puts(con, k, "added: ");
                    base.put_dec(con, k, more);
                    base.puts(con, k, " bytes, ");
                    base.put_dec(con, k, size + more);
                    base.puts(con, k, " in all\r\n");
                }
            }
        }
    }
    return 1;
}

// `put`: a whole file that came over SSH and is waiting in memory (`size` bytes from `at`) becomes the file
// `text[from..to]`, new or in place of the one of that name. `want` is the SHA-256 the sender gave, as 64 hex
// digits: the bytes that came must have it, and so must the bytes the disk gives back once they are
// written, before the name is pointed at them. Then as `write`: the old contents to OLD, the line, the name.
// 0 if the file is now that; 1 if not, with the reason printed and the disk as it was.
pub fn store[&mc, &mv, &md, &mg, &s, &r, &h](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), stage: &!mg Mmio("0x220000..0x420000,0x40220000..0x40420000"), k: &!s [int], text: &r [byte], from: int, to: int, at: int, size: int, want: &h [byte], who: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x220000..0x420000,0x40220000..0x40420000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var done = 1;
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        let tab = alloc_slice[r](512, byte_of(0));
        let rtab = alloc_slice[r](512, byte_of(0));
        let info = alloc_slice[r](fat.facts(), 0);
        let name = alloc_slice[r](12, byte_of(0));
        let vname = alloc_slice[r](12, byte_of(0));
        let hs = alloc_slice[r](sha.state_len(), 0);
        let hd = alloc_slice[r](32, byte_of(0));
        let hx = alloc_slice[r](64, byte_of(0));
        let out = alloc_slice[r](3, 0);
        let o = alloc_slice[r](10, 0);
        let w = alloc_slice[r](8, 0);
        w[5] = -1;
        // what came, against what was sent
        sha.init(hs);
        var i = 0;
        while i < size {
            sha.update_byte(hs, mmio_read8(stage, at + i));
            i = i + 1;
        }
        sha.final(hs, hd);
        var same = len(want) >= 64;
        i = 0;
        while i < 32 && same {
            let hi = int_of(hd[i]) >> 4 & 15;
            let lo = int_of(hd[i]) & 15;
            hx[i * 2] = byte_of(hi + '0');
            if hi > 9 {
                hx[i * 2] = byte_of(hi - 10 + 'a');
            }
            hx[i * 2 + 1] = byte_of(lo + '0');
            if lo > 9 {
                hx[i * 2 + 1] = byte_of(lo - 10 + 'a');
            }
            same = int_of(hx[i * 2]) == (int_of(want[i * 2]) | 32) && int_of(hx[i * 2 + 1]) == (int_of(want[i * 2 + 1]) | 32) || int_of(hx[i * 2]) == int_of(want[i * 2]) && int_of(hx[i * 2 + 1]) == int_of(want[i * 2 + 1]);
            i = i + 1;
        }
        let why = volume(vio, dma, k, sec, info);
        if !same {
            base.puts(con, k, "what came does not have the SHA-256 that was given: nothing was written\r\n");
        } else if why != 0 {
            put_why(con, k, why);
        } else if ready(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, who) != 0 {
            // `ready` said why
        } else if look(vio, dma, k, sec, rtab, info, name, out, o, 0, text, from, to) != 0 {
            base.puts(con, k, "the disk could not be read\r\n");
        } else if o[0] != 0 && o[8] != fat.entry_file() {
            base.puts(con, k, "that is a directory\r\n");
        } else {
            let there = o[0] != 0;
            let es = o[1];
            let ei = o[2];
            let oc = o[3];
            let os = o[4];
            var bad = false;
            if !there {
                bad = place(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, 0, text, from, to) != 0;
            }
            let slot = o[5];
            let slot_i = o[6];
            // the contents, to clusters that were free
            var sent = 0;
            while sent < size && !bad {
                i = 0;
                while i < 512 {
                    if sent + i < size {
                        sec[i] = byte_of(mmio_read8(stage, at + sent + i));
                    } else {
                        sec[i] = byte_of(0);
                    }
                    i = i + 1;
                }
                bad = put(vio, dma, k, tab, info, w, sec) != 0;
                sent = sent + 512;
            }
            bad = bad || kept(vio, dma, k, tab, info, w) != 0;
            if bad {
                base.puts(con, k, "the disk is full, or could not be written: nothing was changed\r\n");
            }
            // read back from the disk, before anything names them: they must be what was sent
            let first_new = w[0];
            sha.init(hs);
            var got = 0;
            var cluster = first_new;
            var held = -1;
            var wrong = false;
            while got < size && !bad && !wrong {
                let cs = fat.cluster_sector(info, cluster);
                wrong = cs < 0;
                var s = 0;
                while s < info[1] && got < size && !wrong {
                    wrong = read(vio, dma, k, cs + s, sec) != 0;
                    i = 0;
                    while i < 512 && got < size && !wrong {
                        sha.update_byte(hs, int_of(sec[i]));
                        got = got + 1;
                        i = i + 1;
                    }
                    s = s + 1;
                }
                if got < size && !wrong {
                    let fs = fat.fat_sector(info, cluster);
                    if fs != held {
                        wrong = fs < 0 || read(vio, dma, k, fs, rtab) != 0;
                        held = fs;
                    }
                    cluster = fat.next(info, rtab, cluster);
                    wrong = wrong || cluster < 0;
                }
            }
            if !bad {
                sha.final(hs, sec[0..32]);
                i = 0;
                while i < 32 {
                    wrong = wrong || int_of(sec[i]) != int_of(hd[i]);
                    i = i + 1;
                }
                if wrong {
                    base.puts(con, k, "the disk did not give back what was written to it: nothing was changed\r\n");
                    bad = true;
                }
            }
            var v = 0;
            if !bad && there {
                v = version(con, vio, dma, k, sec, tab, rtab, info, name, out, o, w, vname, oc, os);
                bad = v < 0;
            }
            if !bad && record_add(vio, dma, k, info, w, who, "put", text, from, to, text, 0, 0, v, size, hd, true) != 0 {
                base.puts(con, k, "the record could not be added to: nothing was changed\r\n");
                bad = true;
            }
            // last, the one sector that makes the name mean the new contents
            if !bad && there {
                bad = read(vio, dma, k, es, sec) != 0;
                if !bad {
                    fat.set_extent(sec, ei, first_new, size);
                    bad = write(vio, dma, k, es, sec) != 0;
                }
            } else if !bad {
                bad = read(vio, dma, k, slot, sec) != 0 || fat.put_entry(sec, slot_i, text, from, to, first_new, size) != 0 || write(vio, dma, k, slot, sec) != 0;
            }
            if !bad {
                counted(vio, dma, k, sec, info, w);
                base.puts(con, k, "kept: ");
                base.put_dec(con, k, size);
                base.puts(con, k, " bytes, read back from the disk with the SHA-256 that was given");
                if there {
                    base.puts(con, k, "; what was there is ");
                    put_version(con, k, vname);
                }
                base.puts(con, k, "\r\n");
                done = 0;
            }
        }
    }
    return done;
}

// The commands that use the disk, for the shell: `disk`, `ls`, `versions`, `record`, `cat <name>`, `sum <name>`, and the
// five above. `console` says the line was typed at the serial console, where alone `purge` is taken.
// 1 if `text[0..n]` was one of them and has been run, 0 if it is another command.
pub fn command[&mc, &mv, &md, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], text: &r [byte], n: int, console: bool) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let is_disk = n == 4 && begins(text, n, "disk");
    let is_ls = n == 2 && begins(text, n, "ls");
    let is_versions = n == 8 && begins(text, n, "versions");
    let is_record = n == 6 && begins(text, n, "record");
    let is_cat = n > 4 && begins(text, n, "cat ");
    let is_sum = n > 4 && begins(text, n, "sum ");
    // what the shell will not touch: the host key as a source, and the kernel's own names as a place
    var first = 0;
    var what = 0;
    if is_cat || is_sum {
        first = 4;
    } else if n > 6 && begins(text, n, "write ") {
        first = 6;
        what = 1;
    } else if n > 7 && begins(text, n, "append ") {
        first = 7;
        what = 2;
    } else if n > 5 && begins(text, n, "copy ") {
        first = 5;
        what = 3;
    } else if n > 7 && begins(text, n, "remove ") {
        first = 7;
        what = 4;
    } else if n > 6 && begins(text, n, "purge ") {
        first = 6;
        what = 5;
    }
    if first > 0 && what != 5 {
        var mid = word(text, first, n);
        if what == 4 {
            mid = n;
        }
        if secret(text, first, mid) || what == 3 && mid < n && secret(text, mid + 1, n) {
            base.puts(con, k, "the host key is kept by the kernel: the shell does not show it, copy it or change it\r\n");
            return 1;
        }
        if what != 0 && what != 3 && kept_name(text, first, mid) || what == 3 && mid < n && kept_name(text, mid + 1, n) {
            base.puts(con, k, "that name is the kernel's: OLD holds the versions and LOG.TXT the record\r\n");
            return 1;
        }
    }
    if what != 0 && what != 5 && !console {
        var mid = word(text, first, n);
        if what == 4 {
            mid = n;
        }
        if what != 3 && boot_name(text, first, mid) || what == 3 && mid < n && boot_name(text, mid + 1, n) {
            base.puts(con, k, "a file the board starts from: it is changed with `put`, which checks every byte, or at the console\r\n");
            return 1;
        }
    }
    if what == 5 && !console {
        base.puts(con, k, "purge gives up a version for good, and is taken at the serial console only\r\n");
        return 1;
    }
    if what != 0 {
        // who is asking: the console, a key over SSH, or the open shell on port 23
        var who = 0;
        if !console {
            who = 2;
            if k[4153] == 1 {
                who = 1;
            }
        }
        return change(con, vio, dma, k, text, n, what, who);
    }
    if !is_disk && !is_ls && !is_cat && !is_sum && !is_versions && !is_record {
        return 0;
    }
    region r {
        let sec = alloc_slice[r](512, byte_of(0));
        let tab = alloc_slice[r](512, byte_of(0));
        let wt = alloc_slice[r](512, byte_of(0));
        let info = alloc_slice[r](fat.facts(), 0);
        let name = alloc_slice[r](12, byte_of(0));
        let out = alloc_slice[r](3, 0);
        let o = alloc_slice[r](10, 0);
        let w = alloc_slice[r](8, 0);
        w[5] = -1;
        let sum = alloc_slice[r](2, 0);
        let why = volume(vio, dma, k, sec, info);
        if why != 0 {
            put_why(con, k, why);
        } else if is_disk {
            if k[4170] == 2 {
                base.puts(con, k, "an SD card of ");
            } else {
                base.puts(con, k, "a disk of ");
            }
            base.put_dec(con, k, k[4171]);
            base.puts(con, k, " sectors (");
            base.put_dec(con, k, k[4171] / 2048);
            base.puts(con, k, " MB); a FAT");
            base.put_dec(con, k, info[0]);
            base.puts(con, k, " volume at sector ");
            base.put_dec(con, k, info[8]);
            base.puts(con, k, ", ");
            base.put_dec(con, k, info[7]);
            base.puts(con, k, " clusters of ");
            base.put_dec(con, k, info[1] * 512);
            base.puts(con, k, " bytes; ");
            base.put_dec(con, k, k[4175]);
            base.puts(con, k, " sectors written since the start\r\n");
        } else if is_ls {
            let count = top(con, vio, dma, k, sec, wt, info, name, out, 0, text, 0, 0);
            if count < 0 {
                base.puts(con, k, "the disk could not be read\r\n");
            } else {
                base.put_dec(con, k, count);
                base.puts(con, k, " files\r\n");
            }
        } else if is_record {
            let have = record_load(vio, dma, k, sec, wt, info, name, out, o);
            if have < 0 {
                base.puts(con, k, "the record could not be read\r\n");
            } else if have == 1 {
                base.puts(con, k, "no record on this disk yet: the first change makes LOG.TXT\r\n");
            } else {
                base.puts(con, k, "the record: ");
                base.put_dec(con, k, k[4187]);
                if k[4252] == 0 {
                    base.puts(con, k, " lines, each following from the one before (`cat LOG.TXT` shows them)\r\n");
                } else {
                    base.puts(con, k, " lines, and line ");
                    base.put_dec(con, k, k[4252]);
                    base.puts(con, k, " does not follow from the one before it: it was changed, or lines were taken out\r\n");
                }
            }
        } else if is_versions {
            let dir = old_dir(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, false);
            var count = 0;
            if dir > 0 {
                count = top(con, vio, dma, k, sec, wt, info, name, out, dir, text, 0, 0);
            }
            if count < 0 {
                base.puts(con, k, "the disk could not be read\r\n");
            } else if dir >= 0 {
                base.put_dec(con, k, count);
                base.puts(con, k, " versions kept (`cat OLD/<name>` shows one, `copy OLD/<name> <new>` brings one back)\r\n");
            }
        } else if source(con, vio, dma, k, sec, tab, wt, info, name, out, o, w, text, 4, n) == 0 {
            let size = o[4];
            let got = whole(con, vio, dma, k, sec, tab, info, o[3], size, is_cat, sum);
            if got < 0 {
                base.puts(con, k, "\r\nthe file could not be read to its end\r\n");
            } else if is_sum {
                base.put_dec(con, k, got);
                base.puts(con, k, " bytes, adler32 ");
                let v = sum[1] << 16 | sum[0];
                var shift = 28;
                while shift >= 0 {
                    base.put_hex(con, k, v >> shift & 15);
                    shift = shift - 4;
                }
                base.puts(con, k, "\r\n");
            } else if size > 4096 {
                base.puts(con, k, "\r\n[the first 4096 bytes of ");
                base.put_dec(con, k, size);
                base.puts(con, k, "]\r\n");
            }
        }
    }
    return 1;
}
