edition 14;

module base;

// base.cho -- what the rest of the kernel stands on: the serial console's output, the
// clock, and bytes to and from the second serial port. Split from kernel.cho, which had
// grown to the 2,000 lines a file may have; nothing here is new.
//
// `k` is the kernel's state (kernel.cho lists it). Here: k[0] is the console's registers,
// k[9] the second serial port's; k[26], k[27], k[33] and k[40..] are where `putc` writes
// while a line from the network is being run (docs/network.md, section 8); while k[4267] is not 0 it writes nowhere.

pub fn putc[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], c: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if k[4267] != 0 {
        // a hosted program is having the disk written for it: what the writer says is not the program's to print (ksys.cho)
        return 0;
    }
    if k[26] != 0 {
        // a line from the network is being run: what it prints waits here for the connection
        if k[27] < 4096 {
            k[40 + k[27]] = c;
            k[27] = k[27] + 1;
        } else {
            k[33] = k[33] + 1;
        }
        return 0;
    }
    let uart = k[0];
    while mmio_read32(con, uart + 0x18) & 32 != 0 {
    }
    return mmio_write32(con, uart, c);
}

pub fn puts[&mc, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], s: &r [byte]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    var i = 0;
    while i < len(s) {
        putc(con, k, int_of(s[i]));
        i = i + 1;
    }
    return 0;
}

pub fn put_dec[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if v >= 10 {
        put_dec(con, k, v / 10);
    }
    return putc(con, k, 48 + v % 10);
}

pub fn put_digit[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], d: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if d < 10 {
        return putc(con, k, 48 + d);
    }
    return putc(con, k, 87 + d);
}

pub fn put_hex[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], v: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if v >= 16 {
        put_hex(con, k, v >> 4);
    }
    return put_digit(con, k, v & 15);
}

pub fn uptime_ms[&f](cpu: &!f Cpu) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let f = cpu_read(cpu, "cntfrq_el0");
    let c = cpu_read(cpu, "cntvct_el0");
    return c / f * 1000 + c % f * 1000 / f;
}

pub fn now_us[&f](cpu: &!f Cpu) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let f = cpu_read(cpu, "cntfrq_el0");
    let c = cpu_read(cpu, "cntvct_el0");
    return c / f * 1000000 + c % f * 1000000 / f;
}

pub fn bus_put[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], c: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    while mmio_read32(bus, u + 0x54) & 32 == 0 {
    }
    return mmio_write32(bus, u + 0x40, c);
}

// The next byte, or -1 when none is waiting.
pub fn bus_get[&mu, &s](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    let u = k[9];
    if mmio_read32(bus, u + 0x54) & 1 == 0 {
        return -1;
    }
    return mmio_read32(bus, u + 0x40) & 255;
}
