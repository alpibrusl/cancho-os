edition 5;

module keys;

import clock;

// `keys` -- the file that says who may log in (docs/permissions.md): KEYS.TXT, a line a key,
//
//     owner ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... a name for people to read
//     reader ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
//     agent ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... read:/ write:WORK/OUT a name
//
// the role, then the key as `ssh-keygen` writes it. Pure, like `inet` and `fat`: it is given the file's
// bytes, never traps on any of them, and reads no disk. A line that is not a key is counted and skipped; so
// are an empty line and one that begins with `#`.

pub fn reader() -> [] int {
    return 1;
}

pub fn owner() -> [] int {
    return 2;
}

// An agent's key: it runs the tools and nothing else, and they reach only what its line grants it (`grants_for`).
pub fn agent() -> [] int {
    return 3;
}

// What a character of base64 stands for, or -1.
fn six(c: int) -> [] int {
    if c >= 65 && c <= 90 {
        return c - 65;
    }
    if c >= 97 && c <= 122 {
        return c - 71;
    }
    if c >= 48 && c <= 57 {
        return c + 4;
    }
    if c == 43 {
        return 62;
    }
    if c == 47 {
        return 63;
    }
    return -1;
}

// Byte `i` of the 51 that the 68 characters at `text[at..]` stand for.
fn decoded[&t](text: &t [byte], at: int, i: int) -> [] int {
    let g = at + i / 3 * 4;
    let v = six(int_of(text[g])) * 262144 + six(int_of(text[g + 1])) * 4096 + six(int_of(text[g + 2])) * 64 + six(int_of(text[g + 3]));
    if i % 3 == 0 {
        return v / 65536;
    }
    if i % 3 == 1 {
        return v / 256 % 256;
    }
    return v % 256;
}

fn is[&t, &w](text: &t [byte], at: int, end: int, word: &w [byte]) -> [] bool {
    if at + len(word) > end {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(text[at + i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The line `text[from..to]`: a role and an ed25519 key. Its role, with the key's 32 bytes in `key`; 0 for a
// line with nothing to say (empty, or a comment); -1 for one that is not a key.
pub fn line[&t, &k](text: &t [byte], from: int, to: int, key: &!k [byte]) -> [] int {
    if from < 0 || to > len(text) || len(key) < 32 {
        return -1;
    }
    var at = from;
    while at < to && (int_of(text[at]) == 32 || int_of(text[at]) == 9) {
        at = at + 1;
    }
    if at >= to || int_of(text[at]) == 35 || int_of(text[at]) == 13 {
        return 0;
    }
    var role = 0;
    if is(text, at, to, "owner ") {
        role = owner();
        at = at + 6;
    } else if is(text, at, to, "reader ") {
        role = reader();
        at = at + 7;
    } else if is(text, at, to, "agent ") {
        role = agent();
        at = at + 6;
    } else {
        return -1;
    }
    if !is(text, at, to, "ssh-ed25519 ") {
        return -1;
    }
    at = at + 12;
    // an ed25519 key is 51 bytes: 68 characters of base64, none of them padding
    if at + 68 > to {
        return -1;
    }
    var i = 0;
    while i < 68 {
        if six(int_of(text[at + i])) < 0 {
            return -1;
        }
        i = i + 1;
    }
    if at + 68 < to && int_of(text[at + 68]) != 32 && int_of(text[at + 68]) != 9 && int_of(text[at + 68]) != 13 {
        return -1;
    }
    // "ssh-ed25519" after its length, 11, then the key after its length, 32
    let kind = "ssh-ed25519";
    if decoded(text, at, 0) != 0 || decoded(text, at, 1) != 0 || decoded(text, at, 2) != 0 || decoded(text, at, 3) != 11 {
        return -1;
    }
    i = 0;
    while i < 11 {
        if decoded(text, at, 4 + i) != int_of(kind[i]) {
            return -1;
        }
        i = i + 1;
    }
    if decoded(text, at, 15) != 0 || decoded(text, at, 16) != 0 || decoded(text, at, 17) != 0 || decoded(text, at, 18) != 32 {
        return -1;
    }
    i = 0;
    while i < 32 {
        key[i] = byte_of(decoded(text, at, 19 + i));
        i = i + 1;
    }
    return role;
}

// Every key of the file `text[0..n]`, added to `table` (32 bytes each, end to end) after the `have` it
// holds already, with its role in `roles`. Answers how many the table holds afterwards; `skipped[0]` gets
// how many lines were not keys, and how many keys there was no room for.
pub fn load[&t, &b, &r, &s](text: &t [byte], n: int, table: &!b [byte], roles: &!r [int], have: int, skipped: &!s [int]) -> [] int {
    var count = have;
    if len(skipped) < 1 {
        return count;
    }
    skipped[0] = 0;
    if n < 0 || n > len(text) || have < 0 || have * 32 > len(table) || have > len(roles) {
        return count;
    }
    var from = 0;
    while from < n {
        var to = from;
        while to < n && int_of(text[to]) != 10 {
            to = to + 1;
        }
        if count < len(roles) && (count + 1) * 32 <= len(table) {
            let role = line(text, from, to, table[count * 32..count * 32 + 32]);
            if role > 0 {
                roles[count] = role;
                count = count + 1;
            } else if role < 0 {
                skipped[0] = skipped[0] + 1;
            }
        } else {
            skipped[0] = skipped[0] + 1;
        }
        from = to + 1;
    }
    return count;
}

// ---- grants (docs/permissions.md, slice 5) ---------------------------------------------------------
// An agent's line has, after its key, what it is granted: words `read:<path>` and `write:<path>`, a path being a
// directory of the disk and everything under it (`/` is the whole disk), and `net:<host>:<port>`, a machine a program
// may connect to (docs/network-out.md). `write` is `read` too; `net` is neither. The first word that is not one of
// those ends them: the rest of the line is for people to read.
//
// Grants are kept as whole numbers, `gr[0]` how many and then 64 for each: 1 read, 2 write or 3 net, the length of
// what follows, and its bytes (62 at most): a path without a `/` at either end, or `host:port`.

pub fn grant_room() -> [] int {
    return 1 + 4 * 64;
}

fn lower(c: int) -> [] int {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

// One word `text[at..end]` as a grant into `gr` at entry `e`: true if it is one. A path with an empty part, a part
// that begins with a dot, or more than 62 bytes is not.
fn grant_word[&t, &g](text: &t [byte], at: int, end: int, gr: &!g [int], e: int) -> [] bool {
    var kind = 0;
    var from = at;
    if is(text, at, end, "read:") {
        kind = 1;
        from = at + 5;
    } else if is(text, at, end, "write:") {
        kind = 2;
        from = at + 6;
    } else if is(text, at, end, "net:") {
        return net_word(text, at + 4, end, gr, e);
    } else {
        return false;
    }
    var to = end;
    while from < to && int_of(text[from]) == 47 {
        from = from + 1;
    }
    while to > from && int_of(text[to - 1]) == 47 {
        to = to - 1;
    }
    if from == at + 5 && kind == 1 && from == end || from == at + 6 && kind == 2 && from == end {
        // `read:` with nothing after it grants nothing
        return false;
    }
    if to - from > 62 {
        return false;
    }
    var i = from;
    var start = true;
    while i < to {
        let c = int_of(text[i]);
        if start && (c == 47 || c == 46) {
            return false;
        }
        start = c == 47;
        i = i + 1;
    }
    let base = 1 + e * 64;
    gr[base] = kind;
    gr[base + 1] = to - from;
    i = from;
    while i < to {
        gr[base + 2 + i - from] = int_of(text[i]);
        i = i + 1;
    }
    return true;
}

// `net:` then `text[from..end]` as a grant: a host (letters, digits, `.`, `-`, and `*.` in front for one label), a `:`,
// and a port from 1 to 65535. 62 bytes at most.
fn net_word[&t, &g](text: &t [byte], from: int, end: int, gr: &!g [int], e: int) -> [] bool {
    if end - from > 62 || end - from < 3 {
        return false;
    }
    var colon = end - 1;
    while colon > from && int_of(text[colon]) != 58 {
        colon = colon - 1;
    }
    if colon <= from || colon + 1 >= end || end - colon - 1 > 5 {
        return false;
    }
    var port = 0;
    var i = colon + 1;
    while i < end {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return false;
        }
        port = port * 10 + c - 48;
        i = i + 1;
    }
    if port < 1 || port > 65535 {
        return false;
    }
    i = from;
    if colon - from > 2 && int_of(text[from]) == 42 && int_of(text[from + 1]) == 46 {
        i = from + 2;
    }
    while i < colon {
        let c = lower(int_of(text[i]));
        if !(c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 46 || c == 45) {
            return false;
        }
        i = i + 1;
    }
    let base = 1 + e * 64;
    gr[base] = 3;
    gr[base + 1] = end - from;
    i = from;
    while i < end {
        gr[base + 2 + i - from] = int_of(text[i]);
        i = i + 1;
    }
    return true;
}

// A word `until:YYYY-MM-DD` at `text[at..end]`: the last second of that day, in UTC; -1 if the word begins `until:`
// and is not a day; -2 if it is another word.
fn until_word[&t](text: &t [byte], at: int, end: int) -> [] int {
    if !is(text, at, end, "until:") {
        return 0 - 2;
    }
    if end - at != 16 || int_of(text[at + 10]) != 45 || int_of(text[at + 13]) != 45 {
        return 0 - 1;
    }
    var v = 0;
    var year = 0;
    var month = 0;
    var i = at + 6;
    while i < end {
        let c = int_of(text[i]);
        if i == at + 10 {
            year = v;
            v = 0;
        } else if i == at + 13 {
            month = v;
            v = 0;
        } else if c < 48 || c > 57 {
            return 0 - 1;
        } else {
            v = v * 10 + c - 48;
        }
        i = i + 1;
    }
    let start = clock.day_start(year, month, v);
    if start < 0 {
        return 0 - 1;
    }
    return start + 86399;
}

// What the file `text[0..n]` grants the key `key` (32 bytes) at the time `now`, into `gr`: how many grants. Every
// `agent` line with that key adds its own, up to the four `gr` holds; a key with no such line is granted nothing.
//
// A line may end its grants with `until:YYYY-MM-DD`: they hold through that day (UTC) and not after. Such a line
// grants nothing if the day is over, if the board has not been told the date (`now` 0: what ends on a day is taken
// to have ended), or if the word is not a day: a line that was meant to end does not last for ever by a slip of
// the hand. Never traps.
pub fn grants_for[&t, &k, &g](text: &t [byte], n: int, key: &k [byte], gr: &!g [int], now: int) -> [] int {
    if len(gr) < 1 {
        return 0;
    }
    gr[0] = 0;
    if n < 0 || n > len(text) || len(key) < 32 {
        return 0;
    }
    let most = (len(gr) - 1) / 64;
    var from = 0;
    region r {
        let found = alloc_slice[r](32, byte_of(0));
        while from < n {
            var to = from;
            while to < n && int_of(text[to]) != 10 {
                to = to + 1;
            }
            var end = to;
            if end > from && int_of(text[end - 1]) == 13 {
                end = end - 1;
            }
            if line(text, from, end, found) == agent() {
                var same = true;
                var b = 0;
                while b < 32 {
                    same = same && int_of(found[b]) == int_of(key[b]);
                    b = b + 1;
                }
                // past `agent `, `ssh-ed25519 ` and the 68 characters of the key
                var at = from;
                while at < end && (int_of(text[at]) == 32 || int_of(text[at]) == 9) {
                    at = at + 1;
                }
                at = at + 6 + 12 + 68;
                var going = same;
                let before = gr[0];
                var ends = 0 - 2;
                while going && at < end {
                    while at < end && (int_of(text[at]) == 32 || int_of(text[at]) == 9) {
                        at = at + 1;
                    }
                    var stop = at;
                    while stop < end && int_of(text[stop]) != 32 && int_of(text[stop]) != 9 {
                        stop = stop + 1;
                    }
                    if stop > at && is(text, at, stop, "until:") {
                        ends = until_word(text, at, stop);
                        going = false;
                    } else {
                        going = stop > at && gr[0] < most && grant_word(text, at, stop, gr, gr[0]);
                        if going {
                            gr[0] = gr[0] + 1;
                        }
                    }
                    at = stop;
                }
                if same && ends != 0 - 2 && (ends < 0 || now <= 0 || now > ends) {
                    // the line's grants have ended, or cannot be said to hold: they are taken back
                    gr[0] = before;
                }
            }
            from = to + 1;
        }
    }
    return gr[0];
}

// Do the grants `gr` give the right `want` (1 read, 2 write) on `path`? One does if it is of that right or more and
// its path is `path` or a directory above it. Letters are compared without their case, as FAT compares names; a `/`
// at either end of `path` is passed over.
pub fn covers[&g, &p](gr: &g [int], want: int, path: &p [byte]) -> [] bool {
    if len(gr) < 1 {
        return false;
    }
    var from = 0;
    var to = len(path);
    while from < to && int_of(path[from]) == 47 {
        from = from + 1;
    }
    while to > from && int_of(path[to - 1]) == 47 {
        to = to - 1;
    }
    var e = 0;
    while e < gr[0] && 1 + (e + 1) * 64 <= len(gr) {
        let base = 1 + e * 64;
        let n = gr[base + 1];
        if gr[base] >= want && gr[base] <= 2 && n >= 0 && n <= 62 && n <= to - from {
            var same = true;
            var i = 0;
            while i < n && same {
                same = lower(gr[base + 2 + i]) == lower(int_of(path[from + i]));
                i = i + 1;
            }
            if same && (n == 0 || n == to - from || int_of(path[from + n]) == 47) {
                return true;
            }
        }
        e = e + 1;
    }
    return false;
}

// Is `path` a directory above something that is granted? Then it may be passed through on the way there, and seen
// to be a directory, without what else it holds being granted.
pub fn reaches[&g, &p](gr: &g [int], path: &p [byte]) -> [] bool {
    if len(gr) < 1 {
        return false;
    }
    var from = 0;
    var to = len(path);
    while from < to && int_of(path[from]) == 47 {
        from = from + 1;
    }
    while to > from && int_of(path[to - 1]) == 47 {
        to = to - 1;
    }
    let m = to - from;
    var e = 0;
    while e < gr[0] && 1 + (e + 1) * 64 <= len(gr) {
        let base = 1 + e * 64;
        let n = gr[base + 1];
        if gr[base] <= 2 && n > m && n <= 62 {
            var same = true;
            var i = 0;
            while i < m && same {
                same = lower(gr[base + 2 + i]) == lower(int_of(path[from + i]));
                i = i + 1;
            }
            if same && (m == 0 || gr[base + 2 + m] == 47) {
                return true;
            }
        }
        e = e + 1;
    }
    return false;
}

// Do the grants `gr` let a program connect to `host` (as it was asked, a name or an address) on `port`? One does if it
// is a `net:` grant of that port and that host, letters compared without their case; `*.example.org` stands for one
// label in front of `example.org`, as the language's bound does (cancho's `docs/net-bounds.md`).
pub fn net_allows[&g, &n](gr: &g [int], host: &n [byte], port: int) -> [] bool {
    if len(gr) < 1 || len(host) == 0 {
        return false;
    }
    var e = 0;
    while e < gr[0] && 1 + (e + 1) * 64 <= len(gr) {
        let base = 1 + e * 64;
        let n = gr[base + 1];
        if gr[base] == 3 && n >= 3 && n <= 62 {
            var colon = n - 1;
            while colon > 0 && gr[base + 2 + colon] != 58 {
                colon = colon - 1;
            }
            var p = 0;
            var i = colon + 1;
            while i < n {
                p = p * 10 + gr[base + 2 + i] - 48;
                i = i + 1;
            }
            if p == port && colon > 0 {
                var same = false;
                if colon > 2 && gr[base + 2] == 42 && gr[base + 3] == 46 {
                    // `*.` and a tail: one label, with no dot in it, then the tail with its dot
                    let tail = colon - 1;
                    if len(host) > tail {
                        let label = len(host) - tail;
                        same = true;
                        i = 0;
                        while i < len(host) && same {
                            if i < label {
                                same = int_of(host[i]) != 46;
                            } else {
                                same = lower(int_of(host[i])) == lower(gr[base + 3 + i - label]);
                            }
                            i = i + 1;
                        }
                    }
                } else if colon == len(host) {
                    same = true;
                    i = 0;
                    while i < colon && same {
                        same = lower(int_of(host[i])) == lower(gr[base + 2 + i]);
                        i = i + 1;
                    }
                }
                if same {
                    return true;
                }
            }
        }
        e = e + 1;
    }
    return false;
}
