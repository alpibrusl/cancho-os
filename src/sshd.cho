edition 14;

module sshd;

import inet;
import ssh_server as ssh;
import std.ed25519;
import ssh_sha256 as sha;

// sshd.cho -- the kernel's shell over SSH (docs/ssh.md). SSH itself is cancho-ssh, which is given bytes and
// gives bytes back; this file is the loop between it and three things the kernel already had: a connection
// (`inet.tcp_read`, `tcp_write`), the line being typed over it (`rline`, k[31] bytes of it) and the queue of
// what the shell printed (k[40..], k[27] of it, which `putc` fills). It holds no hardware.
//
// State, besides the kernel's `k`: `si` and `sb` are cancho-ssh's own; `sx` is this file's:
//    0..32 the host key's seed   32..64 its public half   64..96 a connection's 32 random bytes
//    96..352 what was read from the connection and not yet taken   352..608 the keys that may log in (8)
//    608..640 the key that logged in
// In `k`: k[29] the connection that has the shell, plus one   k[30] the port (22)   k[4153] 1: the port is SSH's
//    k[4160] the host key: 0 not made, 1 made and not yet shown, 2 shown   k[4161] k[4162] the unread bytes
//    k[4163] the session running (cancho-ssh's count; 0: none)   k[4164] how many keys may log in
//    k[4152] the session is to end when its output has gone
//    k[4177] which of the keys are owners' (a bit each; the others may only read)
//    k[4179] what the key that logged in may do: 2 an owner's, 1 a reader's, 3 an agent's (k[4273]: which keys are agents')
//    k[4258] bytes of a file still to come (`put`; 0: none is being received)   k[4259] bytes of it that came
//    k[4260] how many of them `step` has just left in `rline` (it then answers 4)
//    k[4279] what the session ends with: what the program it ran ended with, 126 for a line the key may not run, else 0
//    k[4268] 1: what is being received is a program's input, which ends when the client closes its side (kernel.cho)
//    k[4184] k[4185] the first eight bytes of that key's SHA-256 fingerprint, as two 32-bit numbers

pub fn ints() -> [] int {
    return ssh.ints_len();
}

pub fn bytes() -> [] int {
    return ssh.bytes_len(4096);
}

pub fn extra() -> [] int {
    return 640;
}

// The host key was read from the disk into `sx[0..32]`, not drawn: its public half is made, and it is to
// be shown like one that was.
pub fn adopt[&s, &x, &w](k: &!s [int], sx: &!x [byte], wire: &!w [byte]) -> [] int {
    ed25519.public_key_from_seed(sx[0..32], wire[0..32]);
    var p = 0;
    while p < 32 {
        sx[32 + p] = wire[p];
        p = p + 1;
    }
    k[4160] = 1;
    return 0;
}

// One byte for the client, by the same queue `putc` fills.
fn say[&s](k: &!s [int], c: int) -> [] int {
    if k[27] < 4096 {
        k[40 + k[27]] = c;
        k[27] = k[27] + 1;
    }
    return 0;
}

// Thirty-two bytes from the pool of random words (eight of them, used once), into `into`.
fn draw[&s, &d](k: &!s [int], into: &!d [byte]) -> [] int {
    var i = 0;
    while i < 8 {
        k[37] = k[37] - 1;
        let w = k[4136 + k[37]];
        k[4136 + k[37]] = 0;
        into[i * 4] = byte_of(w >> 24 & 255);
        into[i * 4 + 1] = byte_of(w >> 16 & 255);
        into[i * 4 + 2] = byte_of(w >> 8 & 255);
        into[i * 4 + 3] = byte_of(w & 255);
        i = i + 1;
    }
    return 0;
}

fn forget[&s, &i, &b](k: &!s [int], si: &!i [int], sb: &!b [byte]) -> [] int {
    ssh.forget(si, sb);
    k[29] = 0;
    k[27] = 0;
    k[28] = 0;
    k[31] = 0;
    k[32] = 0;
    k[4152] = 0;
    k[4161] = 0;
    k[4162] = 0;
    k[4163] = 0;
    return 0;
}

// What a program prints while it runs (ksys.out, docs/tools.md): the queue `putc` fills goes to the session as far as
// the client's window and the connection's room allow, and the connection is not read meanwhile (a program's input
// was collected before it began). How many bytes left the queue; the caller turns the network between calls.
pub fn drain[&s, &t, &g, &w, &i, &b](k: &!s [int], tcp: &!t [int], bufs: &!g [byte], wire: &!w [byte], si: &!i [int], sb: &!b [byte]) -> [] int {
    if k[29] == 0 || k[4163] == 0 {
        return 0;
    }
    let c = k[29] - 1;
    var taken = 0;
    if k[27] > 0 {
        var n = k[27];
        if n > len(wire) {
            n = len(wire);
        }
        var j = 0;
        while j < n {
            wire[j] = byte_of(k[40 + j] & 255);
            j = j + 1;
        }
        let wrote = ssh.write(si, sb, wire[0..n]);
        if wrote > 0 {
            j = wrote;
            while j < k[27] {
                k[40 + j - wrote] = k[40 + j];
                j = j + 1;
            }
            k[27] = k[27] - wrote;
            taken = wrote;
        }
    }
    let waiting = len(ssh.pending(si, sb));
    if waiting > 0 {
        let went = inet.tcp_write(tcp, bufs, c, ssh.pending(si, sb), 0, waiting);
        if went > 0 {
            ssh.sent(si, sb, went);
        }
    }
    return taken;
}

// One turn of the loop. Answers 1 when a whole line is in `rline` for the shell to run, 2 when a session has
// begun and should be greeted, 3 when the host key has just been made and should be shown on the console, 0
// otherwise.
pub fn step[&s, &t, &g, &h, &l, &w, &i, &b, &x](k: &!s [int], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], wire: &!w [byte], si: &!i [int], sb: &!b [byte], sx: &!x [byte], now: int) -> [] int {
    if k[30] == 0 || k[39] != 0 {
        return 0;
    }
    if k[4160] == 0 {
        // the host key: 32 bytes nobody else has, and the public half that goes with them
        if k[37] < 8 {
            return 0;
        }
        draw(k, sx[0..32]);
        ed25519.public_key_from_seed(sx[0..32], wire[0..32]);
        var p = 0;
        while p < 32 {
            sx[32 + p] = wire[p];
            p = p + 1;
        }
        k[4160] = 1;
        return 3;
    }
    if k[4160] == 1 {
        // made, or read from the disk (`adopt`), and not yet shown on the console
        return 3;
    }
    if k[29] != 0 && inet.tcp_state(tcp, k[29] - 1) != 2 && inet.tcp_state(tcp, k[29] - 1) != 3 {
        forget(k, si, sb);
    }
    if k[29] == 0 {
        var found = -1;
        var c = 0;
        while c < inet.tcp_count(tcp, bufs, inbox) && found < 0 {
            if inet.tcp_port(tcp, c) == k[30] && (inet.tcp_state(tcp, c) == 2 || inet.tcp_state(tcp, c) == 3) {
                found = c;
            }
            c = c + 1;
        }
        // a connection waits unread until the pool has the 32 bytes it is owed
        if found < 0 || k[37] < 8 {
            return 0;
        }
        forget(k, si, sb);
        draw(k, sx[64..96]);
        if ssh.start(si, sb, sx[0..32], sx[32..64], sx[64..96]) != 0 {
            inet.tcp_close(tcp, found);
            return 0;
        }
        k[29] = found + 1;
    }
    let c = k[29] - 1;
    var rounds = 0;
    while rounds < 8 {
        rounds = rounds + 1;
        // the rule of the loop (cancho-ssh, docs/cancho-os.md): the connection is read only when nothing else moved
        var moved = false;
        if k[4161] < k[4162] {
            let took = ssh.feed(si, sb, sx[96 + k[4161]..96 + k[4162]]);
            if took > 0 {
                k[4161] = k[4161] + took;
                moved = true;
            } else if took < 0 {
                k[4161] = k[4162];
            }
        }
        let waiting = len(ssh.pending(si, sb));
        if waiting > 0 {
            // only what the connection had room for is said to have gone
            let went = inet.tcp_write(tcp, bufs, c, ssh.pending(si, sb), 0, waiting);
            if went > 0 {
                ssh.sent(si, sb, went);
                moved = true;
            }
        }
        if ssh.wants(si) == ssh.want_auth() {
            ssh.auth_decide(si, sb, ssh.key_listed(sx[352..352 + k[4164] * 32], ssh.auth_key(si, sb)));
            moved = true;
        }
        if ssh.session(si) == ssh.session_none() {
            k[4163] = 0;
        } else if k[4163] != ssh.session_count(si) {
            k[4163] = ssh.session_count(si);
            // whose session: the key the last request named is the one that logged in
            k[4179] = 1;
            var who = 0;
            while who < k[4164] {
                var same = true;
                var b = 0;
                while b < 32 && same {
                    same = int_of(sx[352 + who * 32 + b]) == int_of(ssh.auth_key(si, sb)[b]);
                    b = b + 1;
                }
                if same && k[4177] >> who & 1 == 1 {
                    k[4179] = 2;
                } else if same && k[4273] >> who & 1 == 1 && k[4179] != 2 {
                    // an agent's key (and an owner's line for the same key is the one that counts)
                    k[4179] = 3;
                }
                who = who + 1;
            }
            // the key itself, for the kernel to find the line that says what it is granted
            var kb = 0;
            while kb < 32 && 608 + kb < len(sx) {
                sx[608 + kb] = ssh.auth_key(si, sb)[kb];
                kb = kb + 1;
            }
            // and which key: the start of the SHA-256 OpenSSH shows for it, for the record's lines
            region f {
                let hs = alloc_slice[f](sha.state_len(), 0);
                let hd = alloc_slice[f](32, byte_of(0));
                sha.init(hs);
                sha.update_u32(hs, 11);
                sha.update(hs, "ssh-ed25519");
                sha.update_u32(hs, 32);
                var q = 0;
                while q < 32 {
                    sha.update_byte(hs, int_of(ssh.auth_key(si, sb)[q]));
                    q = q + 1;
                }
                sha.final(hs, hd);
                k[4184] = int_of(hd[0]) << 24 | int_of(hd[1]) << 16 | int_of(hd[2]) << 8 | int_of(hd[3]);
                k[4185] = int_of(hd[4]) << 24 | int_of(hd[5]) << 16 | int_of(hd[6]) << 8 | int_of(hd[7]);
            }
            k[27] = 0;
            k[31] = 0;
            k[32] = 0;
            k[4152] = 0;
            k[4258] = 0;
            k[4268] = 0;
            if ssh.session(si) == ssh.session_command() {
                // `ssh host command`: the one line, and the session ends with it
                var n = 0;
                while n < len(ssh.command(si, sb)) && n < len(rline) {
                    rline[n] = ssh.command(si, sb)[n];
                    n = n + 1;
                }
                k[31] = n;
                k[4152] = 1;
                return 1;
            }
            return 2;
        }
        if k[4163] != 0 && k[27] > 0 {
            var n = k[27];
            if n > len(wire) {
                n = len(wire);
            }
            var j = 0;
            while j < n {
                wire[j] = byte_of(k[40 + j] & 255);
                j = j + 1;
            }
            let wrote = ssh.write(si, sb, wire[0..n]);
            if wrote > 0 {
                j = wrote;
                while j < k[27] {
                    k[40 + j - wrote] = k[40 + j];
                    j = j + 1;
                }
                k[27] = k[27] - wrote;
                moved = true;
            }
        }
        if ssh.wants(si) == ssh.want_data() {
            // what was typed, copied out so that it can be taken a byte at a time
            var have = 0;
            while have < len(ssh.received(si, sb)) && have < len(wire) {
                wire[have] = ssh.received(si, sb)[have];
                have = have + 1;
            }
            if k[4163] != 0 && k[4258] > 0 && have > 0 {
                // a file is being received (`put`): the bytes are the file's, not typing. As many as the
                // file still lacks are handed to the kernel in `rline`, which holds no line meanwhile.
                var take = have;
                if take > k[4258] {
                    take = k[4258];
                }
                if take > len(rline) {
                    take = len(rline);
                }
                var q = 0;
                while q < take {
                    rline[q] = wire[q];
                    q = q + 1;
                }
                k[4260] = take;
                ssh.consume(si, sb, take);
                return 4;
            }
            var used = have;
            var whole = false;
            if k[4163] != 0 && k[4152] == 0 {
                // a client that asked for a terminal echoes nothing itself: the kernel does
                let echo = ssh.terminal(si);
                used = 0;
                if k[27] > 0 {
                    // nothing more is read until what was said has gone
                    have = 0;
                }
                while used < have && !whole && k[4152] == 0 {
                    let ch = int_of(wire[used]);
                    used = used + 1;
                    if ch == 10 && k[32] != 0 {
                        k[32] = 0;
                    } else if ch == 13 || ch == 10 {
                        k[32] = 0;
                        if ch == 13 {
                            k[32] = 1;
                        }
                        if echo {
                            say(k, 13);
                            say(k, 10);
                        }
                        whole = true;
                    } else if ch == 127 || ch == 8 {
                        k[32] = 0;
                        if k[31] > 0 {
                            k[31] = k[31] - 1;
                            if echo {
                                say(k, 8);
                                say(k, 32);
                                say(k, 8);
                            }
                        }
                    } else if ch == 3 {
                        // Ctrl-C: the line is dropped
                        k[32] = 0;
                        k[31] = 0;
                        say(k, '^');
                        say(k, 'C');
                        say(k, 13);
                        say(k, 10);
                        say(k, '>');
                        say(k, ' ');
                    } else if ch == 4 && k[31] == 0 {
                        // Ctrl-D on an empty line: the session ends
                        k[4152] = 1;
                    } else {
                        k[32] = 0;
                        if ch >= 32 && ch < 127 && k[31] < len(rline) {
                            rline[k[31]] = byte_of(ch);
                            k[31] = k[31] + 1;
                            if echo {
                                say(k, ch);
                            }
                        }
                    }
                }
            }
            if used > 0 {
                ssh.consume(si, sb, used);
                moved = true;
            }
            if whole {
                return 1;
            }
        } else if k[4163] != 0 && ssh.peer_eof(si) && k[27] == 0 && k[4268] == 1 {
            // the client will send no more, and what it sent was a program's input: none is left to come
            k[4258] = 0;
            k[4260] = 0;
            return 4;
        } else if k[4163] != 0 && ssh.peer_eof(si) && k[27] == 0 {
            // the client will send no more (its input was a file, say): the session ends
            k[4152] = 1;
        }
        if k[4163] != 0 && k[4152] != 0 && k[27] == 0 {
            if ssh.exit_session(si, sb, k[4279]) == 0 {
                k[4163] = 0;
                k[4152] = 0;
                moved = true;
            }
        }
        if ssh.wants(si) == ssh.want_nothing() {
            if len(ssh.pending(si, sb)) == 0 {
                // the connection is over, from either side
                inet.tcp_close(tcp, c);
                forget(k, si, sb);
                return 0;
            }
        } else if !moved && k[4161] == k[4162] {
            k[4161] = 0;
            k[4162] = inet.tcp_read(tcp, inbox, c, sx[96..352], 256);
            if k[4162] == 0 {
                if inet.tcp_state(tcp, c) == 3 {
                    // the other end has finished without a word: so do we
                    inet.tcp_close(tcp, c);
                    forget(k, si, sb);
                } else if inet.tcp_quiet(tcp, c, now) > 300000 {
                    // nothing for five minutes: the kernel hangs up, and says so
                    ssh.disconnect(si, sb);
                }
                return 0;
            }
        }
    }
    return 0;
}
