edition 5;

module fat;

// `fat` -- reading a FAT16 or FAT32 volume (docs/storage.md), with no disk under it. Like `inet`, every
// function is pure (`[]`), allocates nothing and never traps, whatever the bytes: it is given a sector of 512
// bytes and says what the sector means, and whoever holds the disk does the reading. So the same file is
// tested on the machine that builds it (tests/fat_test.cho) and runs in the kernel.
//
// A volume is: a first sector that describes it; one or two copies of a table with an entry for each
// cluster (a cluster is a run of sectors, and its entry names the cluster that follows it in a file); then
// the clusters. A directory is 32-byte entries. In FAT16 the top directory is a fixed run of sectors before
// the clusters; in FAT32 it is a file like any other.
//
// What is here:  where the partition is; the volume's shape; a directory entry's short name, first cluster
//                and length; where a cluster is; which cluster is next. And, for writing: a free cluster in a
//                sector of the table, an entry of the table set, a directory entry made or its length changed.
//                Writing here is changing the bytes of a sector the caller holds; putting it on the disk, and
//                in what order, is the caller's (docs/permissions.md says the order).
// What is not:   replacing or removing a file; long names (an entry of one is skipped, and the file is seen under its short
//                alias); FAT12 and exFAT; sectors that are not 512 bytes.

pub fn sector() -> [] int {
    return 512;
}

// ── what `mount` says when the volume cannot be read ──

pub fn not_a_volume() -> [] int {
    return -1;
}

pub fn not_512() -> [] int {
    return -2;
}

pub fn fat12() -> [] int {
    return -3;
}

// The ints `mount` fills:
//   0 the kind, 16 or 32          1 sectors in a cluster        2 the table's first sector
//   3 sectors in one table        4 the top directory: its first sector (16) or its first cluster (32)
//   5 the top directory's sectors (16; 0 for 32)                6 the sector of cluster 2
//   7 how many clusters           8 where the volume starts     9 its sectors
//   10 how many copies of the table there are                   11 the sector of FAT32's summary (0: none)
pub fn facts() -> [] int {
    return 12;
}

fn le16[&b](s: &b [byte], at: int) -> [] int {
    return int_of(s[at]) + int_of(s[at + 1]) * 256;
}

fn le32[&b](s: &b [byte], at: int) -> [] int {
    return le16(s, at) + le16(s, at + 2) * 65536;
}

// Does this sector describe a volume? Its last two bytes, a jump at its start, 512-byte sectors (or it is
// refused later), a cluster of 1 to 128 sectors that is a power of two, one or two tables.
fn describes[&b](s: &b [byte]) -> [] bool {
    if len(s) < 512 || int_of(s[510]) != 85 || int_of(s[511]) != 170 {
        return false;
    }
    let jump = int_of(s[0]);
    if jump != 235 && jump != 233 {
        return false;
    }
    let spc = int_of(s[13]);
    let power = spc == 1 || spc == 2 || spc == 4 || spc == 8 || spc == 16 || spc == 32 || spc == 64 || spc == 128;
    let tables = int_of(s[16]);
    return power && (tables == 1 || tables == 2) && le16(s, 14) > 0;
}

// Where the volume starts, from the disk's first sector: 0 if that sector is the volume's own, else the
// start of the first FAT partition its table lists. -1: there is none.
pub fn partition[&b](s: &b [byte]) -> [] int {
    if len(s) < 512 || int_of(s[510]) != 85 || int_of(s[511]) != 170 {
        return -1;
    }
    if describes(s) {
        return 0;
    }
    var i = 0;
    while i < 4 {
        let at = 446 + i * 16;
        let kind = int_of(s[at + 4]);
        if kind == 1 || kind == 4 || kind == 6 || kind == 11 || kind == 12 || kind == 14 {
            return le32(s, at + 8);
        }
        i = i + 1;
    }
    return -1;
}

// The volume whose first sector is `s`, at sector `start` of the disk. 0 and `info` filled, or one of the
// three refusals above.
pub fn mount[&b, &i](s: &b [byte], start: int, info: &!i [int]) -> [] int {
    if len(info) < facts() || start < 0 || !describes(s) {
        return not_a_volume();
    }
    if le16(s, 11) != 512 {
        return not_512();
    }
    let spc = int_of(s[13]);
    let reserved = le16(s, 14);
    let tables = int_of(s[16]);
    let top_entries = le16(s, 17);
    var total = le16(s, 19);
    if total == 0 {
        total = le32(s, 32);
    }
    var table = le16(s, 22);
    if table == 0 {
        table = le32(s, 36);
    }
    let top_sectors = (top_entries * 32 + 511) / 512;
    let first = reserved + tables * table + top_sectors;
    if table == 0 || total <= first {
        return not_a_volume();
    }
    let clusters = (total - first) / spc;
    if clusters < 4085 {
        return fat12();
    }
    info[1] = spc;
    info[2] = start + reserved;
    info[3] = table;
    info[6] = start + first;
    info[7] = clusters;
    info[8] = start;
    info[9] = total;
    info[10] = tables;
    info[11] = 0;
    if clusters < 65525 {
        info[0] = 16;
        info[4] = start + reserved + tables * table;
        info[5] = top_sectors;
    } else {
        info[0] = 32;
        info[4] = le32(s, 44);
        info[5] = 0;
        if le16(s, 48) > 0 && le16(s, 48) < reserved {
            info[11] = start + le16(s, 48);
        }
    }
    return 0;
}

// ── directories ──

pub fn entry_end() -> [] int {
    return 0;
}

pub fn entry_skip() -> [] int {
    return 1;
}

pub fn entry_file() -> [] int {
    return 2;
}

pub fn entry_directory() -> [] int {
    return 3;
}

// Entry `i` (0 to 15) of the directory sector `s`. Answers what it is: the end of the directory; something
// to skip (a deleted entry, a piece of a long name, the volume's label); a file; a directory. For the last
// two, `name` gets the short name as it is written (`KERNEL8.IMG`), and `out` its length, the first cluster
// and the length of the file.
pub fn entry[&b, &m, &o](s: &b [byte], i: int, name: &!m [byte], out: &!o [int]) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 || len(name) < 12 || len(out) < 3 {
        return entry_end();
    }
    let at = i * 32;
    let first = int_of(s[at]);
    if first == 0 {
        return entry_end();
    }
    let attr = int_of(s[at + 11]);
    if first == 229 || attr % 16 == 15 || attr / 8 % 2 == 1 {
        return entry_skip();
    }
    var n = 0;
    var k = 0;
    while k < 8 {
        let c = int_of(s[at + k]);
        if c != 32 {
            // (a first byte of 5 stands for 229, which would read as "deleted")
            if k == 0 && c == 5 {
                name[n] = byte_of(229);
            } else {
                name[n] = s[at + k];
            }
            n = n + 1;
        }
        k = k + 1;
    }
    if int_of(s[at + 8]) != 32 || int_of(s[at + 9]) != 32 || int_of(s[at + 10]) != 32 {
        name[n] = byte_of(46);
        n = n + 1;
        k = 8;
        while k < 11 {
            if int_of(s[at + k]) != 32 {
                name[n] = s[at + k];
                n = n + 1;
            }
            k = k + 1;
        }
    }
    out[0] = n;
    out[1] = le16(s, at + 26) + le16(s, at + 20) * 65536;
    out[2] = le32(s, at + 28);
    if attr / 16 % 2 == 1 {
        return entry_directory();
    }
    return entry_file();
}

// ---- long names --------------------------------------------------------------------------------
// A name longer than eight letters, a dot and three is kept in entries of its own, before the entry that has
// the short form: thirteen characters each, the last piece first, each with a sum of the short name's eleven
// bytes so that pieces left behind by a system that did not know them are not taken for a name.
//
// A walk over a directory keeps `ls`: 0 the number of the piece seen last (0: none)   1 the sum the pieces
// carry   2 how many characters they hold. And `lname`, room for the characters: 260 bytes.
// Only what ASCII can say is kept: another character is read as `?`.

pub fn long_state() -> [] int {
    return 3;
}

pub fn long_room() -> [] int {
    return 260;
}

// Is entry `i` of the sector the first piece of a long name that is met (which is its last piece)?
pub fn long_begins[&b](s: &b [byte], i: int) -> [] bool {
    if len(s) < 512 || i < 0 || i > 15 {
        return false;
    }
    let first = int_of(s[i * 32]);
    return first != 229 && first != 0 && int_of(s[i * 32 + 11]) % 64 == 15 && first / 64 % 2 == 1;
}

fn long_char[&b, &l](s: &b [byte], at: int, lname: &!l [byte], to: int) -> [] int {
    let c = le16(s, at);
    if to < 0 || to >= len(lname) {
        return 0;
    }
    if c == 0 || c == 65535 {
        lname[to] = byte_of(0);
    } else if c < 32 || c > 126 {
        lname[to] = byte_of(63);
    } else {
        lname[to] = byte_of(c);
    }
    return 0;
}

// Entry `i` of the sector, which `entry` said is `kind`, taken into the walk. Called for every entry, in
// order. Answers how long the long name of this entry is, in `lname`, if it is a file or a directory with a
// whole long name before it whose sum is right; 0 otherwise.
pub fn long[&b, &t, &l](s: &b [byte], i: int, kind: int, ls: &!t [int], lname: &!l [byte]) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 || len(ls) < 3 || len(lname) < 260 {
        return 0;
    }
    let at = i * 32;
    let first = int_of(s[at]);
    if kind == entry_skip() && first != 229 && int_of(s[at + 11]) % 64 == 15 {
        let piece = first % 64;
        let sum = int_of(s[at + 13]);
        if piece < 1 || piece > 20 {
            ls[0] = 0;
            return 0;
        }
        if first / 64 % 2 == 1 {
            ls[1] = sum;
            ls[2] = piece * 13;
        } else if ls[0] != piece + 1 || ls[1] != sum {
            ls[0] = 0;
            return 0;
        }
        ls[0] = piece;
        let to = (piece - 1) * 13;
        var c = 0;
        while c < 5 {
            long_char(s, at + 1 + c * 2, lname, to + c);
            c = c + 1;
        }
        c = 0;
        while c < 6 {
            long_char(s, at + 14 + c * 2, lname, to + 5 + c);
            c = c + 1;
        }
        long_char(s, at + 28, lname, to + 11);
        long_char(s, at + 30, lname, to + 12);
        return 0;
    }
    var n = 0;
    if (kind == entry_file() || kind == entry_directory()) && ls[0] == 1 {
        // the sum of the short name's eleven bytes, each added after the sum is turned one bit to the right
        var sum = 0;
        var b = 0;
        while b < 11 {
            sum = (sum % 2 * 128 + sum / 2 + int_of(s[at + b])) % 256;
            b = b + 1;
        }
        if sum == ls[1] {
            while n < ls[2] && n < 260 && int_of(lname[n]) != 0 {
                n = n + 1;
            }
        }
    }
    ls[0] = 0;
    return n;
}

// May `text[from..to]` be written as a long name? 1 to 195 characters (fifteen pieces, so that the name and
// its entry fit one sector and are written at once), each of them print and none of `" * / : < > ? \ |`; no
// space or dot at either end.
pub fn long_ok[&t](text: &t [byte], from: int, to: int) -> [] bool {
    if from < 0 || to > len(text) || to <= from || to - from > 195 {
        return false;
    }
    let a = int_of(text[from]);
    let z = int_of(text[to - 1]);
    if a == 32 || a == 46 || z == 32 || z == 46 {
        return false;
    }
    var i = from;
    while i < to {
        let c = int_of(text[i]);
        if c < 32 || c > 126 || c == 34 || c == 42 || c == 47 || c == 58 || c == 60 || c == 62 || c == 63 || c == 92 || c == 124 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// How many pieces a long name of `n` characters is kept in.
pub fn long_pieces(n: int) -> [] int {
    if n <= 0 {
        return 0;
    }
    return (n + 12) / 13;
}

// The short form a long name is also given, into `eleven`: what of the name before its last dot may be in a
// short name, as many as leave room for `~` and `number`; then up to three of what follows that dot.
// `number` is 1 to 999999, and the caller takes the first that the directory does not have. 0, or -1.
pub fn alias[&t, &e](text: &t [byte], from: int, to: int, number: int, eleven: &!e [byte]) -> [] int {
    if from < 0 || to > len(text) || to <= from || number < 1 || number > 999999 || len(eleven) < 11 {
        return -1;
    }
    var k = 0;
    while k < 11 {
        eleven[k] = byte_of(32);
        k = k + 1;
    }
    var dot = -1;
    k = from;
    while k < to {
        if int_of(text[k]) == 46 {
            dot = k;
        }
        k = k + 1;
    }
    var stem_end = to;
    if dot > from {
        stem_end = dot;
    }
    var digits = 1;
    var d = number;
    while d >= 10 {
        digits = digits + 1;
        d = d / 10;
    }
    let room = 8 - 1 - digits;
    var n = 0;
    k = from;
    while k < stem_end && n < room {
        let c = upper(int_of(text[k]));
        if in_name(c) {
            eleven[n] = byte_of(c);
            n = n + 1;
        }
        k = k + 1;
    }
    if n == 0 {
        eleven[0] = byte_of(95);
        n = 1;
    }
    eleven[n] = byte_of(126);
    n = n + 1;
    var div = 1;
    k = 1;
    while k < digits {
        div = div * 10;
        k = k + 1;
    }
    while div > 0 {
        eleven[n] = byte_of(48 + number / div % 10);
        n = n + 1;
        div = div / 10;
    }
    if dot > from {
        var e = 0;
        k = dot + 1;
        while k < to && e < 3 {
            let c = upper(int_of(text[k]));
            if in_name(c) {
                eleven[8 + e] = byte_of(c);
                e = e + 1;
            }
            k = k + 1;
        }
    }
    return 0;
}

// The sum every piece of a long name carries: of the short form's eleven bytes.
pub fn sum11[&e](eleven: &e [byte]) -> [] int {
    if len(eleven) < 11 {
        return 0;
    }
    var sum = 0;
    var b = 0;
    while b < 11 {
        sum = (sum % 2 * 128 + sum / 2 + int_of(eleven[b])) % 256;
        b = b + 1;
    }
    return sum;
}

// Does entry `i` of the sector name something, with exactly these eleven bytes?
pub fn is_raw[&b, &e](s: &b [byte], i: int, eleven: &e [byte]) -> [] bool {
    if len(s) < 512 || i < 0 || i > 15 || len(eleven) < 11 {
        return false;
    }
    let first = int_of(s[i * 32]);
    if first == 0 || first == 229 || int_of(s[i * 32 + 11]) % 64 == 15 {
        return false;
    }
    var k = 0;
    while k < 11 {
        if int_of(s[i * 32 + k]) != int_of(eleven[k]) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// The first of `need` entries in a row that name nothing, in the sector. -1: there is no such row.
pub fn free_run[&b](s: &b [byte], need: int) -> [] int {
    if len(s) < 512 || need < 1 || need > 16 {
        return -1;
    }
    var run = 0;
    var i = 0;
    while i < 16 {
        let first = int_of(s[i * 32]);
        if first == 0 || first == 229 {
            run = run + 1;
            if run == need {
                return i - need + 1;
            }
        } else {
            run = 0;
        }
        i = i + 1;
    }
    return -1;
}

// Every entry of the sector that was never used is marked as one that was used and deleted. A directory ends
// at its first never-used entry, so a sector that is passed over for a later one must not keep any: what is
// written after it would be past the end. How many were marked.
pub fn close_end[&b](s: &!b [byte]) -> [] int {
    if len(s) < 512 {
        return 0;
    }
    var n = 0;
    var i = 0;
    while i < 16 {
        if int_of(s[i * 32]) == 0 {
            s[i * 32] = byte_of(229);
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// Piece `piece` (1 is the first thirteen characters) of the `pieces` of the long name `text[from..to]`, as
// entry `i` of the sector. On the disk the last piece comes first, and says that it is the last.
pub fn put_long[&b, &t](s: &!b [byte], i: int, text: &t [byte], from: int, to: int, piece: int, pieces: int, sum: int) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 || from < 0 || to > len(text) || to <= from || piece < 1 || piece > pieces || pieces > 20 || pieces != long_pieces(to - from) {
        return -1;
    }
    let at = i * 32;
    var k = 0;
    while k < 32 {
        s[at + k] = byte_of(0);
        k = k + 1;
    }
    var order = piece;
    if piece == pieces {
        order = piece + 64;
    }
    s[at] = byte_of(order);
    s[at + 11] = byte_of(15);
    s[at + 13] = byte_of(sum % 256);
    // thirteen characters of two bytes: the name's, then one zero if the name ends here, then 0xffff
    let n = to - from;
    k = 0;
    while k < 13 {
        var spot = at + 1 + k * 2;
        if k >= 11 {
            spot = at + 28 + (k - 11) * 2;
        } else if k >= 5 {
            spot = at + 14 + (k - 5) * 2;
        }
        let c = (piece - 1) * 13 + k;
        if c < n {
            s[spot] = text[from + c];
        } else if c > n {
            s[spot] = byte_of(255);
            s[spot + 1] = byte_of(255);
        }
        k = k + 1;
    }
    return 0;
}

// An entry whose short form is given as its eleven bytes: what a long name's pieces are followed by.
pub fn put_raw[&b, &e](s: &!b [byte], i: int, eleven: &e [byte], cluster: int, size: int, directory: bool) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 || len(eleven) < 11 || cluster < 0 || size < 0 {
        return -1;
    }
    let at = i * 32;
    var k = 0;
    while k < 32 {
        s[at + k] = byte_of(0);
        k = k + 1;
    }
    k = 0;
    while k < 11 {
        s[at + k] = eleven[k];
        k = k + 1;
    }
    s[at + 11] = byte_of(32);
    if directory {
        s[at + 11] = byte_of(16);
    }
    put16(s, at + 16, 33);
    put16(s, at + 18, 33);
    put16(s, at + 24, 33);
    put16(s, at + 20, cluster / 65536);
    put16(s, at + 26, cluster % 65536);
    put16(s, at + 28, size % 65536);
    put16(s, at + 30, size / 65536);
    return 0;
}

fn upper(c: int) -> [] int {
    if c >= 97 && c <= 122 {
        return c - 32;
    }
    return c;
}

// Is the short name `name[0..n]` the name `wanted[from..to]`, whatever the case of either?
pub fn named[&m, &w](name: &m [byte], n: int, wanted: &w [byte], from: int, to: int) -> [] bool {
    if n < 0 || n > len(name) || from < 0 || to > len(wanted) || to - from != n {
        return false;
    }
    var i = 0;
    while i < n {
        if upper(int_of(name[i])) != upper(int_of(wanted[from + i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ── clusters ──

// The first sector of `cluster`, or -1 if the volume has no such cluster.
pub fn cluster_sector[&i](info: &i [int], cluster: int) -> [] int {
    if len(info) < facts() || cluster < 2 || cluster >= info[7] + 2 {
        return -1;
    }
    return info[6] + (cluster - 2) * info[1];
}

// The sector of the table that holds `cluster`'s entry, or -1.
pub fn fat_sector[&i](info: &i [int], cluster: int) -> [] int {
    if len(info) < facts() || cluster < 2 || cluster >= info[7] + 2 {
        return -1;
    }
    var at = cluster * 2;
    if info[0] == 32 {
        at = cluster * 4;
    }
    if at / 512 >= info[3] {
        return -1;
    }
    return info[2] + at / 512;
}

pub fn chain_end() -> [] int {
    return -1;
}

pub fn chain_broken() -> [] int {
    return -2;
}

// The cluster after `cluster`, read from `s`, the sector `fat_sector` named. Or `chain_end`: it was the
// file's last. Or `chain_broken`: the entry says something a file's cluster cannot be followed by.
pub fn next[&i, &b](info: &i [int], s: &b [byte], cluster: int) -> [] int {
    if len(info) < facts() || len(s) < 512 || cluster < 2 || cluster >= info[7] + 2 {
        return chain_broken();
    }
    var v = 0;
    var last = 0;
    if info[0] == 32 {
        v = le32(s, cluster * 4 % 512) % 268435456;
        last = 268435448;
    } else {
        v = le16(s, cluster * 2 % 512);
        last = 65528;
    }
    if v >= last {
        return chain_end();
    }
    if v < 2 || v >= info[7] + 2 {
        return chain_broken();
    }
    return v;
}

// ── writing ─────────────────────────────────────────────────────────────────────────────────────────────
// Each of these changes the bytes of one sector the caller holds, or says where a change can be made.

fn put16[&b](s: &!b [byte], at: int, v: int) -> [] int {
    s[at] = byte_of(v % 256);
    s[at + 1] = byte_of(v / 256 % 256);
    return 0;
}

// How many entries of the table one sector holds.
pub fn per_sector[&i](info: &i [int]) -> [] int {
    if len(info) >= facts() && info[0] == 32 {
        return 128;
    }
    return 256;
}

// A free cluster among those whose entries are in sector `index` of the table (0 is its first sector),
// looking from entry `from` of that sector on. -1: none there.
pub fn free_cluster[&i, &b](info: &i [int], s: &b [byte], index: int, from: int) -> [] int {
    if len(info) < facts() || len(s) < 512 || index < 0 || index >= info[3] || from < 0 {
        return -1;
    }
    let per = per_sector(info);
    var i = from;
    while i < per {
        let cluster = index * per + i;
        if cluster >= 2 && cluster < info[7] + 2 {
            var v = 0;
            if info[0] == 32 {
                v = le32(s, i * 4) % 268435456;
            } else {
                v = le16(s, i * 2);
            }
            if v == 0 {
                return cluster;
            }
        }
        i = i + 1;
    }
    return -1;
}

// In `s`, the sector of the table that holds `cluster`'s entry: the cluster after it is `then`, or, with
// `then` -1, it is the last of its file. 0, or -1 if there is no such cluster or `then` is none.
pub fn set_next[&i, &b](info: &i [int], s: &!b [byte], cluster: int, then: int) -> [] int {
    if len(info) < facts() || len(s) < 512 || cluster < 2 || cluster >= info[7] + 2 {
        return -1;
    }
    if then != -1 && (then < 2 || then >= info[7] + 2) {
        return -1;
    }
    if info[0] == 32 {
        let at = cluster * 4 % 512;
        var v = then;
        if then == -1 {
            v = 268435455;
        }
        // the top four bits are not the entry's: they stay as they were
        let kept = int_of(s[at + 3]) / 16;
        put16(s, at, v % 65536);
        put16(s, at + 2, v / 65536 + kept * 4096);
    } else {
        var v = then;
        if then == -1 {
            v = 65535;
        }
        put16(s, cluster * 2 % 512, v);
    }
    return 0;
}

// The first entry of the directory sector `s` that names nothing (never used, or deleted). -1: none.
pub fn free_slot[&b](s: &b [byte]) -> [] int {
    if len(s) < 512 {
        return -1;
    }
    var i = 0;
    while i < 16 {
        let first = int_of(s[i * 32]);
        if first == 0 || first == 229 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// May this character be in a short name? Letters, digits and a few signs; no space, no dot.
fn in_name(c: int) -> [] bool {
    if c >= 65 && c <= 90 || c >= 48 && c <= 57 {
        return true;
    }
    return c == 95 || c == 45 || c == 126 || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 64;
}

// Entry `i` of the directory sector `s` made to name a file: `text[from..to]` as its short name (one to
// eight characters, then perhaps a dot and one to three; letters are stored as capitals), `cluster` its
// first cluster (0 for an empty file) and `size` its length. 0, or -1 if that is not a short name.
pub fn put_entry[&b, &t](s: &!b [byte], i: int, text: &t [byte], from: int, to: int, cluster: int, size: int) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 || from < 0 || to > len(text) || to <= from || cluster < 0 || size < 0 {
        return -1;
    }
    // the name is checked whole before a byte of the sector changes
    var dot = -1;
    var k = from;
    while k < to {
        let c = upper(int_of(text[k]));
        if c == 46 {
            if dot >= 0 {
                return -1;
            }
            dot = k;
        } else if !in_name(c) {
            return -1;
        }
        k = k + 1;
    }
    var stem = to - from;
    var ext = 0;
    if dot >= 0 {
        stem = dot - from;
        ext = to - dot - 1;
        if ext < 1 || ext > 3 {
            return -1;
        }
    }
    if stem < 1 || stem > 8 {
        return -1;
    }
    let at = i * 32;
    k = 0;
    while k < 32 {
        s[at + k] = byte_of(0);
        k = k + 1;
    }
    k = 0;
    while k < 11 {
        s[at + k] = byte_of(32);
        k = k + 1;
    }
    k = 0;
    while k < stem {
        s[at + k] = byte_of(upper(int_of(text[from + k])));
        k = k + 1;
    }
    k = 0;
    while k < ext {
        s[at + 8 + k] = byte_of(upper(int_of(text[dot + 1 + k])));
        k = k + 1;
    }
    // an ordinary file ("archive"); and a date, since none at all is not one: 1 January 1980, the first
    // there is. The kernel has no clock that knows the day.
    s[at + 11] = byte_of(32);
    put16(s, at + 16, 33);
    put16(s, at + 18, 33);
    put16(s, at + 24, 33);
    put16(s, at + 20, cluster / 65536);
    put16(s, at + 26, cluster % 65536);
    put16(s, at + 28, size % 65536);
    put16(s, at + 30, size / 65536);
    return 0;
}

// Entry `i` of `s` given another first cluster and length: what adding to a file changes, last of all.
pub fn set_extent[&b](s: &!b [byte], i: int, cluster: int, size: int) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 || cluster < 0 || size < 0 {
        return -1;
    }
    let at = i * 32;
    put16(s, at + 20, cluster / 65536);
    put16(s, at + 26, cluster % 65536);
    put16(s, at + 28, size % 65536);
    put16(s, at + 30, size / 65536);
    return 0;
}

// FAT32 keeps a count of free clusters in a sector of its own, as a hint. After a write it is wrong, and
// the honest value is "not known", which is all ones. 0, or -1 if `s` is not that sector.
pub fn summary_unknown[&b](s: &!b [byte]) -> [] int {
    if len(s) < 512 || le32(s, 0) != 1096897106 || le32(s, 484) != 1631679090 {
        return -1;
    }
    var k = 488;
    while k < 496 {
        s[k] = byte_of(255);
        k = k + 1;
    }
    return 0;
}

// The same sector, when `taken` clusters have just been put to use: the count goes down by that many, if it
// was a count. 0, or -1 if `s` is not that sector.
pub fn summary_less[&b](s: &!b [byte], taken: int) -> [] int {
    if len(s) < 512 || le32(s, 0) != 1096897106 || le32(s, 484) != 1631679090 {
        return -1;
    }
    let free = le32(s, 488);
    if taken < 0 || free == 4294967295 || free < taken {
        return 0;
    }
    put16(s, 488, (free - taken) % 65536);
    put16(s, 490, (free - taken) / 65536);
    return 0;
}

// ── directories made, entries removed, clusters given back ──────────────────────────────────────────────

// Entry `i` of `s` made to name a directory whose first cluster is `cluster`: as `put_entry`, but a
// directory (its length is always written as 0).
pub fn put_directory[&b, &t](s: &!b [byte], i: int, text: &t [byte], from: int, to: int, cluster: int) -> [] int {
    if cluster < 2 || put_entry(s, i, text, from, to, cluster, 0) != 0 {
        return -1;
    }
    s[i * 32 + 11] = byte_of(16);
    return 0;
}

// The first two entries every directory but the top one begins with, in `s`, the first sector of its first
// cluster: `.`, the directory itself, and `..`, the one it is in (0 when that is the top directory).
pub fn put_dots[&b](s: &!b [byte], itself: int, parent: int) -> [] int {
    if len(s) < 512 || itself < 2 || parent < 0 {
        return -1;
    }
    var e = 0;
    while e < 2 {
        let at = e * 32;
        var k = 0;
        while k < 32 {
            s[at + k] = byte_of(0);
            k = k + 1;
        }
        k = 0;
        while k < 11 {
            s[at + k] = byte_of(32);
            k = k + 1;
        }
        s[at] = byte_of(46);
        var c = itself;
        if e == 1 {
            s[at + 1] = byte_of(46);
            c = parent;
        }
        s[at + 11] = byte_of(16);
        put16(s, at + 16, 33);
        put16(s, at + 18, 33);
        put16(s, at + 24, 33);
        put16(s, at + 20, c / 65536);
        put16(s, at + 26, c % 65536);
        e = e + 1;
    }
    return 0;
}

// Entry `i` of `s` names nothing any more: it is marked deleted. What it named is not touched.
pub fn erase[&b](s: &!b [byte], i: int) -> [] int {
    if len(s) < 512 || i < 0 || i > 15 {
        return -1;
    }
    s[i * 32] = byte_of(229);
    return 0;
}

// In `s`, the sector of the table that holds `cluster`'s entry: the cluster is free again.
pub fn set_free[&i, &b](info: &i [int], s: &!b [byte], cluster: int) -> [] int {
    if len(info) < facts() || len(s) < 512 || cluster < 2 || cluster >= info[7] + 2 {
        return -1;
    }
    if info[0] == 32 {
        let at = cluster * 4 % 512;
        let kept = int_of(s[at + 3]) / 16;
        put16(s, at, 0);
        put16(s, at + 2, kept * 4096);
    } else {
        put16(s, cluster * 2 % 512, 0);
    }
    return 0;
}

// FAT32's count of free clusters, when `given` have just been given back: up by that many, if it was a count.
pub fn summary_more[&b](s: &!b [byte], given: int) -> [] int {
    if len(s) < 512 || le32(s, 0) != 1096897106 || le32(s, 484) != 1631679090 {
        return -1;
    }
    let free = le32(s, 488);
    if given < 0 || free == 4294967295 || free + given > 4294967294 {
        return 0;
    }
    put16(s, 488, (free + given) % 65536);
    put16(s, 490, (free + given) / 65536);
    return 0;
}

// The name of version `n` of something, in `name` (12 bytes): eight digits and `.V`. Answers its length, 10.
pub fn version_name[&m](name: &!m [byte], n: int) -> [] int {
    if len(name) < 10 || n < 0 || n > 99999999 {
        return -1;
    }
    var v = n;
    var i = 7;
    while i >= 0 {
        name[i] = byte_of(48 + v % 10);
        v = v / 10;
        i = i - 1;
    }
    name[8] = byte_of(46);
    name[9] = byte_of(86);
    return 10;
}

// If `name[0..n]` is a version's name, its number; -1 otherwise.
pub fn version_number[&m](name: &m [byte], n: int) -> [] int {
    if n != 10 || len(name) < 10 || int_of(name[8]) != 46 || upper(int_of(name[9])) != 86 {
        return -1;
    }
    var v = 0;
    var i = 0;
    while i < 8 {
        let c = int_of(name[i]);
        if c < 48 || c > 57 {
            return -1;
        }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    return v;
}
