edition 5;

module inet;

// `inet` -- the first slice of a network stack (docs/network.md): IPv4 packets framed with SLIP, and the two
// answers a machine gives before it does anything else: an ICMP echo reply (`ping`) and a UDP echo (port 7).
//
// Sans-io, as `feetech` is: every function is pure (`[]`), allocates nothing, holds no hardware and never traps,
// whatever the bytes. A driver feeds received bytes to `slip_feed`, gives each whole frame to `answer`, and sends
// what `slip_encode` makes of the reply. So the same file is tested on the machine that builds it
// (tests/inet_test.cho) and runs in the kernel.
//
// What is here:   SLIP (RFC 1055); the IPv4 header (RFC 791), validated; ICMP echo (RFC 792); UDP (RFC 768)
//                 with its checksum, for port 7 only (RFC 862); TCP (RFC 9293) for the same port, whose state
//                 the caller owns; an echo request and an ARP request of our own.
// Under it, two links: SLIP for a serial line, and Ethernet frames with ARP (RFC 826) for a network card.
// What is not:    fragments, IP options in a reply, ICMP errors, IPv6, a connection opened from here. A packet
//                 that needs one of them is dropped, and the verdict says which.

// The largest packet taken or sent: SLIP's customary 1006 bytes (RFC 1055).
pub fn mtu() -> [] int {
    return 1006;
}

// ── what `answer` says when it sends nothing ─────────────────────────────────────────────────────────────

pub fn drop_short() -> [] int {
    return -1;
}

pub fn drop_not_ipv4() -> [] int {
    return -2;
}

pub fn drop_bad_header_checksum() -> [] int {
    return -3;
}

pub fn drop_not_ours() -> [] int {
    return -4;
}

pub fn drop_fragment() -> [] int {
    return -5;
}

pub fn drop_bad_checksum() -> [] int {
    return -6;
}

pub fn drop_unsupported() -> [] int {
    return -7;
}

pub fn drop_too_long() -> [] int {
    return -8;
}

// ── bytes ───────────────────────────────────────────────────────────────────────────────────────────────

pub fn get16[&b](buf: &b [byte], at: int) -> [] int {
    return int_of(buf[at]) * 256 + int_of(buf[at + 1]);
}

pub fn get32[&b](buf: &b [byte], at: int) -> [] int {
    return get16(buf, at) * 65536 + get16(buf, at + 2);
}

fn put16[&b](buf: &!b [byte], at: int, v: int) -> [] int {
    buf[at] = byte_of(v / 256 % 256);
    buf[at + 1] = byte_of(v % 256);
    return 0;
}

fn put32[&b](buf: &!b [byte], at: int, v: int) -> [] int {
    put16(buf, at, v / 65536 % 65536);
    return put16(buf, at + 2, v % 65536);
}

// The Internet checksum's sum (RFC 1071): `buf[from..to]` as big-endian 16-bit words, an odd last byte padded
// with zero, added to `seed` with the carries folded back in. Between 0 and 65535.
pub fn sum16[&b](buf: &b [byte], from: int, to: int, seed: int) -> [] int {
    var s = seed;
    var i = from;
    while i + 1 < to {
        s = s + int_of(buf[i]) * 256 + int_of(buf[i + 1]);
        i = i + 2;
    }
    if i < to {
        s = s + int_of(buf[i]) * 256;
    }
    while s > 65535 {
        s = s % 65536 + s / 65536;
    }
    return s;
}

// The checksum field for data whose sum is `sum`: its complement.
pub fn complement(sum: int) -> [] int {
    return 65535 - sum;
}

// ── SLIP ────────────────────────────────────────────────────────────────────────────────────────────────
// A frame ends with END (192). Inside it END is sent as ESC, 220 and ESC (219) as ESC, 221.

// The decoder's state, three ints the caller owns and starts at zero: how many bytes of the frame so far,
// whether the last byte was ESC, and whether the frame has outgrown `frame` (it is then dropped whole).
pub fn slip_state() -> [] int {
    return 3;
}

// One received byte. Answers the length of a whole frame, now in `frame[0..length]`, or 0 while there is none.
// An empty frame (two ENDs in a row, which a sender may put before a packet) is not a frame.
pub fn slip_feed[&s, &f](state: &!s [int], frame: &!f [byte], c: int) -> [] int {
    if c == 192 {
        let n = state[0];
        let lost = state[2] != 0 || state[1] != 0;
        state[0] = 0;
        state[1] = 0;
        state[2] = 0;
        if lost {
            return 0;
        }
        return n;
    }
    var value = c;
    if state[1] != 0 {
        state[1] = 0;
        if c == 220 {
            value = 192;
        } else if c == 221 {
            value = 219;
        } else {
            // not a sequence SLIP has: the frame cannot be trusted
            state[2] = 1;
        }
    } else if c == 219 {
        state[1] = 1;
        return 0;
    }
    if state[0] >= len(frame) || value < 0 || value > 255 {
        state[2] = 1;
        return 0;
    }
    frame[state[0]] = byte_of(value);
    state[0] = state[0] + 1;
    return 0;
}

// `pkt[0..n]` as a SLIP frame in `out`, an END before it and one after. Answers its length, or -1 if `out` is
// too small (twice `n` and two more always fits).
pub fn slip_encode[&p, &o](pkt: &p [byte], n: int, out: &!o [byte]) -> [] int {
    if n < 0 || n > len(pkt) || len(out) < 2 {
        return -1;
    }
    out[0] = byte_of(192);
    var at = 1;
    var i = 0;
    while i < n {
        let c = int_of(pkt[i]);
        if at + 3 > len(out) {
            return -1;
        }
        if c == 192 {
            out[at] = byte_of(219);
            out[at + 1] = byte_of(220);
            at = at + 2;
        } else if c == 219 {
            out[at] = byte_of(219);
            out[at + 1] = byte_of(221);
            at = at + 2;
        } else {
            out[at] = pkt[i];
            at = at + 1;
        }
        i = i + 1;
    }
    out[at] = byte_of(192);
    return at + 1;
}

// ── IPv4 ────────────────────────────────────────────────────────────────────────────────────────────────

// The header of a reply at `out[o..]`: 20 bytes, no options, identification 0, not fragmented, 64 hops.
fn header[&o](out: &!o [byte], o: int, total: int, protocol: int, from: int, to: int) -> [] int {
    out[o] = byte_of(69);
    out[o + 1] = byte_of(0);
    put16(out, o + 2, total);
    put16(out, o + 4, 0);
    put16(out, o + 6, 0);
    out[o + 8] = byte_of(64);
    out[o + 9] = byte_of(protocol);
    put16(out, o + 10, 0);
    put32(out, o + 12, from);
    put32(out, o + 16, to);
    return put16(out, o + 10, complement(sum16(out, o, o + 20, 0)));
}

// The sum of the pseudo-header UDP and TCP add to their checksum: the two addresses, the protocol and the length.
fn pseudo(from: int, to: int, protocol: int, length: int) -> [] int {
    var s = from / 65536 + from % 65536 + to / 65536 + to % 65536 + protocol + length;
    while s > 65535 {
        s = s % 65536 + s / 65536;
    }
    return s;
}

// The received packet `pkt[0..n]`, on a machine whose address is `ours` (a 32-bit number, `10.0.0.2` is
// 0x0a000002). Answers the length of the reply, written to `out`, or one of the `drop_*` above.
//
// A packet is taken only if it is whole: version 4, a header of at least 20 bytes whose checksum holds, a total
// length that fits what arrived, no fragment, addressed to `ours`. Then an echo request gets an echo reply with
// the same identifier, sequence number and data, and a datagram to UDP port 7 gets its data back.
pub fn answer[&p, &o](pkt: &p [byte], n: int, ours: int, out: &!o [byte]) -> [] int {
    return answer_at(pkt, 0, n, ours, out, 0);
}

// The header of the packet `pkt[at..at + n]`, held to everything a packet must be before it is read further.
// Answers the header's length, or the `drop_*` that says what is wrong.
fn checked[&p](pkt: &p [byte], at: int, n: int, ours: int) -> [] int {
    if at < 0 || n < 20 || at + n > len(pkt) {
        return drop_short();
    }
    let first = int_of(pkt[at]);
    if first / 16 != 4 {
        return drop_not_ipv4();
    }
    let ihl = first % 16 * 4;
    let total = get16(pkt, at + 2);
    if ihl < 20 || total < ihl || total > n {
        return drop_short();
    }
    if sum16(pkt, at, at + ihl, 0) != 65535 {
        return drop_bad_header_checksum();
    }
    if get32(pkt, at + 16) != ours {
        return drop_not_ours();
    }
    // more fragments, or an offset: bits 13 and 0..12 of the word at 6
    if get16(pkt, at + 6) % 16384 != 0 {
        return drop_fragment();
    }
    return ihl;
}

// `answer` for a packet that sits inside a frame: it is `pkt[at..at + n]`, and the reply goes to `out[o..]`.
pub fn answer_at[&p, &o](pkt: &p [byte], at: int, n: int, ours: int, out: &!o [byte], o: int) -> [] int {
    if o < 0 {
        return drop_short();
    }
    let ihl = checked(pkt, at, n, ours);
    if ihl < 0 {
        return ihl;
    }
    let total = get16(pkt, at + 2);
    let peer = get32(pkt, at + 12);
    let protocol = int_of(pkt[at + 9]);
    let body = total - ihl;
    let from = at + ihl;
    if o + 20 + body > len(out) || 20 + body > mtu() {
        return drop_too_long();
    }
    if protocol == 1 {
        // ICMP: type, code, checksum, then for an echo the identifier, the sequence number and the data
        if body < 8 {
            return drop_short();
        }
        if sum16(pkt, from, from + body, 0) != 65535 {
            return drop_bad_checksum();
        }
        if int_of(pkt[from]) != 8 || int_of(pkt[from + 1]) != 0 {
            return drop_unsupported();
        }
        header(out, o, 20 + body, 1, ours, peer);
        var i = 0;
        while i < body {
            out[o + 20 + i] = pkt[from + i];
            i = i + 1;
        }
        out[o + 20] = byte_of(0);
        put16(out, o + 22, 0);
        put16(out, o + 22, complement(sum16(out, o + 20, o + 20 + body, 0)));
        return 20 + body;
    }
    if protocol == 17 {
        // UDP: source port, destination port, length, checksum (0: the sender computed none)
        if body < 8 || get16(pkt, from + 4) != body {
            return drop_short();
        }
        if get16(pkt, from + 6) != 0 && sum16(pkt, from, from + body, pseudo(peer, ours, 17, body)) != 65535 {
            return drop_bad_checksum();
        }
        if get16(pkt, from + 2) != 7 {
            return drop_unsupported();
        }
        header(out, o, 20 + body, 17, ours, peer);
        put16(out, o + 20, 7);
        put16(out, o + 22, get16(pkt, from));
        put16(out, o + 24, body);
        put16(out, o + 26, 0);
        var j = 8;
        while j < body {
            out[o + 20 + j] = pkt[from + j];
            j = j + 1;
        }
        var sum = complement(sum16(out, o + 20, o + 20 + body, pseudo(ours, peer, 17, body)));
        if sum == 0 {
            // zero means "no checksum": the same value is sent as all ones
            sum = 65535;
        }
        put16(out, o + 26, sum);
        return 20 + body;
    }
    return drop_unsupported();
}

// ── Ethernet and ARP ────────────────────────────────────────────────────────────────────────────────────
// A frame is the destination's address, the sender's (six bytes each, here one number), a type, and the
// packet. The four bytes of the frame check are the card's, not here. A frame is at least 60 bytes: a short
// one is padded with zeros.

pub fn drop_not_our_frame() -> [] int {
    return -9;
}

pub fn get48[&b](buf: &b [byte], at: int) -> [] int {
    return get16(buf, at) * 4294967296 + get32(buf, at + 2);
}

fn put48[&b](buf: &!b [byte], at: int, v: int) -> [] int {
    put16(buf, at, v / 4294967296 % 65536);
    return put32(buf, at + 2, v % 4294967296);
}

// The received frame `frame[0..n]`, on a card whose address is `mac` and a machine whose address is `ours`.
// Answers the length of the reply frame, written to `out`, or one of the `drop_*`.
//
// Two things are answered. An ARP request for `ours` ("who has this address?", RFC 826) gets `mac`. An IPv4
// packet sent to `mac` gets what `answer` gives it, sent back to the card it came from: the kernel only ever
// replies, so it needs no table of who is where.
pub fn eth_answer[&p, &o](frame: &p [byte], n: int, mac: int, ours: int, out: &!o [byte]) -> [] int {
    if n < 14 || n > len(frame) || len(out) < 60 {
        return drop_short();
    }
    let to = get48(frame, 0);
    let sender = get48(frame, 6);
    let kind = get16(frame, 12);
    var length = 0;
    if kind == 2054 {
        // ARP for Ethernet and IPv4: hardware 1, protocol 0x0800, sizes 6 and 4, operation 1 (request),
        // then the sender's two addresses and the target's two
        if n < 42 {
            return drop_short();
        }
        if get16(frame, 14) != 1 || get16(frame, 16) != 2048 || int_of(frame[18]) != 6 || int_of(frame[19]) != 4 || get16(frame, 20) != 1 {
            return drop_unsupported();
        }
        if get32(frame, 38) != ours {
            return drop_not_ours();
        }
        put16(out, 14, 1);
        put16(out, 16, 2048);
        out[18] = byte_of(6);
        out[19] = byte_of(4);
        put16(out, 20, 2);
        put48(out, 22, mac);
        put32(out, 28, ours);
        put48(out, 32, get48(frame, 22));
        put32(out, 38, get32(frame, 28));
        length = 42;
    } else if kind == 2048 {
        if to != mac {
            return drop_not_our_frame();
        }
        let m = answer_at(frame, 14, n - 14, ours, out, 14);
        if m < 0 {
            return m;
        }
        length = 14 + m;
    } else {
        return drop_unsupported();
    }
    return eth_wrap(out, length, sender, mac, kind);
}

// The 14 bytes in front of `out[14..length]`, and zeros after it up to 60. Answers the frame's length.
fn eth_wrap[&o](out: &!o [byte], length: int, to: int, mac: int, kind: int) -> [] int {
    if length < 14 || length > len(out) || len(out) < 60 {
        return drop_short();
    }
    put48(out, 0, to);
    put48(out, 6, mac);
    put16(out, 12, kind);
    var end = length;
    while end < 60 {
        out[end] = byte_of(0);
        end = end + 1;
    }
    return end;
}

// ── TCP ─────────────────────────────────────────────────────────────────────────────────────────────────
// A connection is state, and nothing here keeps any: the caller owns it. `tcp` is `tcp_conn()` ints for each
// connection and `bufs` is `tcp_segment_max()` bytes for each, both zero to begin with; how many connections
// there can be is how many of both fit. The clock is the caller's too: `now`, in milliseconds.
//
// What a connection does (docs/network.md, section 7): it is opened from the other end, to port 7, and what
// arrives is sent back. What it has sent and not had acknowledged it keeps, in one buffer of one segment's
// size; the window it advertises is the room left in that buffer, so it never takes what it could not send
// back, and never takes back room it has offered. `tcp_tick` sends the buffer again when it has waited too
// long. Only the next byte expected is taken; anything else is told what is expected.
//
// One more port can be the caller's (`port`; 0 for none). What arrives there is not echoed: it waits in
// `inbox`, `tcp_inbox()` bytes for each connection, until the caller takes it with `tcp_read`. The caller
// answers with `tcp_write`, and `tcp_flush` makes the segment. The window of such a connection is the room
// in its part of `inbox`. If the other end finishes first the connection stays, so that it can still be
// answered, until the caller ends it with `tcp_close`.
//
// The ints of connection c, at tcp[c * 20 ..]:
//    0 state: 0 free, 1 opening (our SYN is out), 2 open, 3 the other end has finished and we have not
//      (the caller's port only), 4 the other end has finished and our FIN is out, 5 we have finished and
//      the other end has not, 6 we are opening it (our SYN is out, and it has not been answered)
//    1 the other end's address   2 its port   3 our port
//    4 the first sequence number of ours not acknowledged   5 the next not yet sent   6 the next we expect
//    7 how many bytes of data are out (they are in `bufs`)   8 what else is out: 1 a FIN after them, 2 a SYN
//    9 when the oldest of it was last sent   10 how many times it has been sent again
//    11 the most this connection holds or sends at once   12 the card to send to (0 on a line with none)
//    13 when the other end was last heard
//    14 how many bytes wait in `inbox`
//    16 whether the window was narrow when it was last said, so that a `tcp_read` must be followed by saying it

pub fn tcp_conn() -> [] int {
    return 20;
}

// The bytes of `inbox` each connection has: what has arrived on the caller's port and not been read.
pub fn tcp_inbox() -> [] int {
    return 256;
}

pub fn tcp_segment_max() -> [] int {
    return mtu() - 40;
}

// How many connections `tcp`, `bufs` and `inbox` have room for.
pub fn tcp_count[&t, &b, &i](tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte]) -> [] int {
    var count = len(tcp) / tcp_conn();
    if len(bufs) / tcp_segment_max() < count {
        count = len(bufs) / tcp_segment_max();
    }
    if len(inbox) / tcp_inbox() < count {
        count = len(inbox) / tcp_inbox();
    }
    return count;
}

// How many of them are in use.
pub fn tcp_open[&t, &b, &i](tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte]) -> [] int {
    let count = tcp_count(tcp, bufs, inbox);
    var c = 0;
    var used = 0;
    while c < count {
        if tcp[c * 20] != 0 {
            used = used + 1;
        }
        c = c + 1;
    }
    return used;
}

// The state of connection `c` (0: there is none), and the port of ours it is on.
pub fn tcp_state[&t](tcp: &!t [int], c: int) -> [] int {
    if c < 0 || c * 20 + 20 > len(tcp) {
        return 0;
    }
    return tcp[c * 20];
}

pub fn tcp_port[&t](tcp: &!t [int], c: int) -> [] int {
    if c < 0 || c * 20 + 20 > len(tcp) {
        return 0;
    }
    return tcp[c * 20 + 3];
}

// Sequence numbers are 32 bits and wrap: how far `a` is past `b`.
fn past(a: int, b: int) -> [] int {
    return (a - b + 4294967296) % 4294967296;
}

fn plus(a: int, n: int) -> [] int {
    return (a + n) % 4294967296;
}

// One segment at `out[o..]`, with its IPv4 header: `n` bytes of data from `bufs[data..]`, and the one option
// there is, the most we take in a segment, if `mss` is not zero. Flags: 1 FIN, 2 SYN, 4 RST, 8 PSH, 16 ACK.
fn segment[&b, &o](out: &!o [byte], o: int, from: int, to: int, sport: int, dport: int, seq: int, ack: int, flags: int, window: int, mss: int, bufs: &!b [byte], data: int, n: int) -> [] int {
    var hl = 20;
    if mss > 0 {
        hl = 24;
    }
    let total = 20 + hl + n;
    if o < 0 || n < 0 || data < 0 || o + total > len(out) || data + n > len(bufs) || total > mtu() {
        return drop_too_long();
    }
    header(out, o, total, 6, from, to);
    let s = o + 20;
    put16(out, s, sport);
    put16(out, s + 2, dport);
    put32(out, s + 4, seq);
    put32(out, s + 8, ack);
    out[s + 12] = byte_of(hl / 4 * 16);
    out[s + 13] = byte_of(flags);
    put16(out, s + 14, window);
    put16(out, s + 16, 0);
    put16(out, s + 18, 0);
    if mss > 0 {
        out[s + 20] = byte_of(2);
        out[s + 21] = byte_of(4);
        put16(out, s + 22, mss);
    }
    var i = 0;
    while i < n {
        out[s + hl + i] = bufs[data + i];
        i = i + 1;
    }
    put16(out, s + 16, complement(sum16(out, s, s + hl + n, pseudo(from, to, 6, hl + n))));
    return total;
}

// What connection `c` has to say. `from` is where in its unacknowledged data the segment starts: 0 sends all
// that is out again (its SYN, its data, its FIN), more than 0 sends only what was added since. -1: nothing but
// where it stands, an acknowledgement and a window.
fn tcp_say[&t, &b, &o](tcp: &!t [int], bufs: &!b [byte], c: int, ours: int, from: int, out: &!o [byte], o: int) -> [] int {
    let b = c * 20;
    var window = 0;
    if tcp[b] <= 2 || tcp[b] == 6 {
        // the room left for what arrives: on port 7 it is echoed from the same buffer, so what is out takes
        // from it; on the caller's port it waits in `inbox`
        window = tcp[b + 11] - tcp[b + 7];
        if tcp[b + 3] != 7 {
            window = tcp_inbox() - tcp[b + 14];
        }
        tcp[b + 16] = 0;
        if window * 2 < tcp_inbox() {
            tcp[b + 16] = 1;
        }
    }
    if from < 0 || from > tcp[b + 7] {
        return segment(out, o, ours, tcp[b + 1], tcp[b + 3], tcp[b + 2], tcp[b + 5], tcp[b + 6], 16, window, 0, bufs, 0, 0);
    }
    var flags = 16;
    var mss = 0;
    if tcp[b + 8] == 2 {
        flags = 18;
        if tcp[b] == 6 {
            // a SYN of our own answers nothing
            flags = 2;
        }
        mss = tcp_segment_max();
    }
    if tcp[b + 8] == 1 {
        flags = 17;
    }
    if tcp[b + 7] > from {
        flags = flags + 8;
    }
    // all that is out has now been sent: the next sequence number is past it (a SYN or a FIN counts one)
    tcp[b + 5] = plus(tcp[b + 4], tcp[b + 7]);
    if tcp[b + 8] != 0 {
        tcp[b + 5] = plus(tcp[b + 5], 1);
    }
    return segment(out, o, ours, tcp[b + 1], tcp[b + 3], tcp[b + 2], plus(tcp[b + 4], from), tcp[b + 6], flags, window, mss, bufs, c * tcp_segment_max() + from, tcp[b + 7] - from);
}

// The most the other end takes in a segment, from the options of its SYN at `pkt[from + 20..from + doff]`;
// 536 if it does not say (RFC 9293, section 3.7.1).
fn peer_mss[&p](pkt: &p [byte], from: int, doff: int) -> [] int {
    var mss = 536;
    var i = from + 20;
    let end = from + doff;
    while i < end {
        let kind = int_of(pkt[i]);
        if kind == 0 {
            return mss;
        }
        if kind == 1 {
            i = i + 1;
        } else {
            if i + 1 >= end {
                return mss;
            }
            let l = int_of(pkt[i + 1]);
            if l < 2 || i + l > end {
                return mss;
            }
            if kind == 2 && l == 4 && get16(pkt, i + 2) > 0 {
                mss = get16(pkt, i + 2);
            }
            i = i + l;
        }
    }
    return mss;
}

// A place for a new connection: a free one, or else the one that has been silent longest if that is a
// minute or more. -1 if there is none.
fn tcp_slot[&t](tcp: &!t [int], count: int, now: int) -> [] int {
    var c = 0;
    var oldest = -1;
    var silent = 59999;
    while c < count {
        if tcp[c * 20] == 0 {
            return c;
        }
        if now - tcp[c * 20 + 13] > silent {
            silent = now - tcp[c * 20 + 13];
            oldest = c;
        }
        c = c + 1;
    }
    return oldest;
}

// The segment in the packet `pkt[at..]`, whose header `checked` has passed. Answers the length of what to
// send back, written to `out[o..]`; 0 if the segment was taken and there is nothing to say; or a `drop_*`.
// `iss` is the sequence number a new connection starts from: the caller should make it hard to guess.
// `via` is the card the packet came from, kept for `eth_tick`.
fn tcp_at[&p, &t, &b, &i, &o](pkt: &p [byte], at: int, ours: int, tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte], port: int, now: int, iss: int, via: int, out: &!o [byte], o: int) -> [] int {
    let ihl = int_of(pkt[at]) % 16 * 4;
    let from = at + ihl;
    let body = get16(pkt, at + 2) - ihl;
    let peer = get32(pkt, at + 12);
    if body < 20 {
        return drop_short();
    }
    let doff = int_of(pkt[from + 12]) / 16 * 4;
    if doff < 20 || doff > body {
        return drop_short();
    }
    if sum16(pkt, from, from + body, pseudo(peer, ours, 6, body)) != 65535 {
        return drop_bad_checksum();
    }
    let sport = get16(pkt, from);
    let dport = get16(pkt, from + 2);
    let seq = get32(pkt, from + 4);
    let ack = get32(pkt, from + 8);
    let flags = int_of(pkt[from + 13]);
    let syn = flags / 2 % 2;
    let rst = flags / 4 % 2;
    let acks = flags / 16 % 2;
    let count = tcp_count(tcp, bufs, inbox);
    var c = 0;
    var found = -1;
    while c < count {
        if tcp[c * 20] != 0 && tcp[c * 20 + 1] == peer && tcp[c * 20 + 2] == sport && tcp[c * 20 + 3] == dport {
            found = c;
        }
        c = c + 1;
    }
    if found < 0 {
        if rst != 0 {
            return 0;
        }
        var slot = -1;
        if (dport == 7 || port != 0 && dport == port) && syn != 0 && acks == 0 {
            slot = tcp_slot(tcp, count, now);
        }
        if slot < 0 {
            // nothing listens there, or it is not how a connection begins, or there is no room: a reset
            // (RFC 9293, section 3.10.7.1)
            if acks != 0 {
                return segment(out, o, ours, peer, dport, sport, ack, 0, 4, 0, 0, bufs, 0, 0);
            }
            return segment(out, o, ours, peer, dport, sport, 0, plus(seq, body - doff + syn + flags % 2), 20, 0, 0, bufs, 0, 0);
        }
        let b = slot * 20;
        var room = peer_mss(pkt, from, doff);
        if room > tcp_segment_max() {
            room = tcp_segment_max();
        }
        tcp[b] = 1;
        tcp[b + 1] = peer;
        tcp[b + 2] = sport;
        tcp[b + 3] = dport;
        tcp[b + 4] = iss % 4294967296;
        tcp[b + 5] = plus(tcp[b + 4], 1);
        // data sent with a SYN is not taken: only the SYN is acknowledged
        tcp[b + 6] = plus(seq, 1);
        tcp[b + 7] = 0;
        tcp[b + 8] = 2;
        tcp[b + 9] = now;
        tcp[b + 10] = 0;
        tcp[b + 11] = room;
        tcp[b + 12] = via;
        tcp[b + 13] = now;
        tcp[b + 14] = 0;
        tcp[b + 16] = 0;
        return tcp_say(tcp, bufs, slot, ours, 0, out, o);
    }
    let b = found * 20;
    if tcp[b] == 6 {
        // our own SYN is out. The answer is a SYN that acknowledges it, or a reset that does
        let answers = acks != 0 && tcp[b + 5] != tcp[b + 4] && ack == tcp[b + 5];
        if rst != 0 {
            if answers {
                tcp[b] = 0;
            }
            return 0;
        }
        if acks != 0 && !answers {
            return segment(out, o, ours, peer, dport, sport, ack, 0, 4, 0, 0, bufs, 0, 0);
        }
        if syn == 0 || acks == 0 {
            // a SYN alone: both ends opening at once, which is not done here
            return 0;
        }
        var room = peer_mss(pkt, from, doff);
        if room > tcp_segment_max() {
            room = tcp_segment_max();
        }
        tcp[b] = 2;
        tcp[b + 4] = ack;
        tcp[b + 6] = plus(seq, 1);
        tcp[b + 8] = 0;
        tcp[b + 10] = 0;
        tcp[b + 11] = room;
        tcp[b + 13] = now;
        return tcp_say(tcp, bufs, found, ours, -1, out, o);
    }
    if rst != 0 {
        // believed only if it is exactly the next segment expected
        if seq == tcp[b + 6] {
            tcp[b] = 0;
        }
        return 0;
    }
    if syn != 0 {
        return tcp_say(tcp, bufs, found, ours, -1, out, o);
    }
    if acks == 0 {
        return 0;
    }
    // Only the next byte expected is taken. A segment from before it has been taken already and is here
    // again; one from after it has overtaken another. What either carries is not taken, but what it
    // acknowledges counts, and it is told where we stand.
    let aside = seq != tcp[b + 6];
    var n = body - doff;
    var fin = flags % 2;
    if aside {
        n = 0;
        fin = 0;
    }
    tcp[b + 13] = now;
    let out_now = past(tcp[b + 5], tcp[b + 4]);
    let acked = past(ack, tcp[b + 4]);
    if acked > out_now {
        // an acknowledgement of something never sent
        if tcp[b] == 1 {
            return segment(out, o, ours, peer, dport, sport, ack, 0, 4, 0, 0, bufs, 0, 0);
        }
        return tcp_say(tcp, bufs, found, ours, -1, out, o);
    }
    let base = found * tcp_segment_max();
    // all that there is to send, sent or not: an acknowledgement of less is not of everything
    var whole = tcp[b + 7];
    if tcp[b + 8] != 0 {
        whole = whole + 1;
    }
    var freed = 0;
    if acked > 0 {
        // some of what was out has arrived: the rest moves to the front, and its timer starts again
        freed = acked;
        if freed > tcp[b + 7] {
            freed = tcp[b + 7];
        }
        var i = freed;
        while i < tcp[b + 7] {
            bufs[base + i - freed] = bufs[base + i];
            i = i + 1;
        }
        tcp[b + 7] = tcp[b + 7] - freed;
        tcp[b + 4] = plus(tcp[b + 4], acked);
        tcp[b + 9] = now;
        tcp[b + 10] = 0;
        if acked == whole {
            tcp[b + 8] = 0;
            if tcp[b] == 4 {
                // our FIN has arrived: the connection is over
                tcp[b] = 0;
                return 0;
            }
        }
        if tcp[b] == 1 {
            tcp[b] = 2;
        }
    } else if tcp[b] == 1 {
        // the opening is not acknowledged by this
        return segment(out, o, ours, peer, dport, sport, ack, 0, 4, 0, 0, bufs, 0, 0);
    }
    if tcp[b] == 5 && (n > 0 || fin != 0) {
        // we have finished: what the other end still sends is acknowledged and not kept
        tcp[b + 6] = plus(tcp[b + 6], n);
        if fin == 0 {
            return tcp_say(tcp, bufs, found, ours, -1, out, o);
        }
        tcp[b + 6] = plus(tcp[b + 6], 1);
        let last = tcp_say(tcp, bufs, found, ours, -1, out, o);
        if tcp[b + 8] == 0 {
            // and it has our FIN: both have finished
            tcp[b] = 0;
        } else {
            tcp[b] = 4;
        }
        return last;
    }
    if tcp[b + 3] != 7 && tcp[b] == 2 && (n > 0 || fin != 0) {
        // the caller's port: what arrives waits in `inbox`, as much of it as there is room for
        let held = tcp[b + 14];
        var take = n;
        if take > tcp_inbox() - held {
            take = tcp_inbox() - held;
        }
        if take < 0 {
            take = 0;
        }
        var i = 0;
        while i < take {
            inbox[found * tcp_inbox() + held + i] = pkt[from + doff + i];
            i = i + 1;
        }
        tcp[b + 6] = plus(tcp[b + 6], take);
        tcp[b + 14] = held + take;
        if fin != 0 && take == n {
            // the other end has finished; we have not, until the caller says so
            tcp[b + 6] = plus(tcp[b + 6], 1);
            tcp[b] = 3;
        }
        return tcp_say(tcp, bufs, found, ours, -1, out, o);
    }
    if tcp[b] == 2 && (n > 0 || fin != 0) {
        // the echo: what arrives goes after what is still out, as much of it as there is room for, and it
        // is kept there until it is acknowledged
        let start = tcp[b + 7];
        var take = n;
        if take > tcp[b + 11] - start {
            take = tcp[b + 11] - start;
        }
        if take < 0 {
            take = 0;
        }
        var i = 0;
        while i < take {
            bufs[base + start + i] = pkt[from + doff + i];
            i = i + 1;
        }
        tcp[b + 6] = plus(tcp[b + 6], take);
        tcp[b + 7] = start + take;
        tcp[b + 5] = plus(tcp[b + 5], take);
        let closing = fin != 0 && take == n;
        if closing {
            // the other end has finished, so we do: our FIN goes after the last of the data
            tcp[b + 6] = plus(tcp[b + 6], 1);
            tcp[b + 8] = 1;
            tcp[b + 5] = plus(tcp[b + 5], 1);
            tcp[b] = 4;
        }
        if take == 0 && !closing {
            // no room: the window, zero, says so
            return tcp_say(tcp, bufs, found, ours, -1, out, o);
        }
        if start == 0 {
            tcp[b + 9] = now;
        }
        return tcp_say(tcp, bufs, found, ours, start, out, o);
    }
    if freed > 0 && tcp[b + 3] == 7 || aside || n > 0 || fin != 0 {
        // room was made on port 7, so the window is wider; or the segment was not the next one; or it came after
        // the other end's FIN, when there is nothing more for it to send
        return tcp_say(tcp, bufs, found, ours, -1, out, o);
    }
    return 0;
}

// `answer_at`, and TCP besides: a segment for port 7, or for `port` if that is not 0, is taken into `tcp`,
// `bufs` and `inbox`. Answers what `answer_at` does, or 0 when a segment was taken and there is nothing to
// send back.
pub fn serve_at[&p, &t, &b, &i, &o](pkt: &p [byte], at: int, n: int, ours: int, tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte], port: int, now: int, iss: int, via: int, out: &!o [byte], o: int) -> [] int {
    let m = answer_at(pkt, at, n, ours, out, o);
    // `answer_at` says "unsupported" only of a packet whose header it has checked
    if m != drop_unsupported() || int_of(pkt[at + 9]) != 6 {
        return m;
    }
    return tcp_at(pkt, at, ours, tcp, bufs, inbox, port, now, iss, via, out, o);
}

pub fn serve[&p, &t, &b, &i, &o](pkt: &p [byte], n: int, ours: int, tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte], port: int, now: int, iss: int, out: &!o [byte]) -> [] int {
    return serve_at(pkt, 0, n, ours, tcp, bufs, inbox, port, now, iss, 0, out, 0);
}

// `eth_answer`, and TCP besides.
pub fn eth_serve[&p, &t, &b, &i, &o](frame: &p [byte], n: int, mac: int, ours: int, tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte], port: int, now: int, iss: int, out: &!o [byte]) -> [] int {
    let m = eth_answer(frame, n, mac, ours, out);
    // "unsupported" of an IPv4 packet sent to this card: its header has been checked
    if m != drop_unsupported() || n < 34 || get16(frame, 12) != 2048 || get48(frame, 0) != mac || int_of(frame[23]) != 6 {
        return m;
    }
    let sender = get48(frame, 6);
    let t = tcp_at(frame, 14, ours, tcp, bufs, inbox, port, now, iss, sender, out, 14);
    if t <= 0 {
        return t;
    }
    return eth_wrap(out, 14 + t, sender, mac, 2048);
}

// ── the caller's port ──
// What these four do to a connection on port 7, or to one that is not there, is nothing: they answer 0.

fn tcp_mine[&t](tcp: &!t [int], c: int) -> [] bool {
    if c < 0 || c * 20 + 20 > len(tcp) {
        return false;
    }
    return tcp[c * 20 + 3] != 7 && (tcp[c * 20] == 2 || tcp[c * 20] == 3);
}

// Take up to `most` of the bytes that have arrived on connection `c`, into `into`. How many were taken.
pub fn tcp_read[&t, &i, &d](tcp: &!t [int], inbox: &!i [byte], c: int, into: &!d [byte], most: int) -> [] int {
    if !tcp_mine(tcp, c) || (c + 1) * tcp_inbox() > len(inbox) {
        return 0;
    }
    let b = c * 20;
    let held = tcp[b + 14];
    var n = held;
    if n > most {
        n = most;
    }
    if n > len(into) {
        n = len(into);
    }
    if n <= 0 || held > tcp_inbox() {
        return 0;
    }
    let base = c * tcp_inbox();
    var i = 0;
    while i < n {
        into[i] = inbox[base + i];
        i = i + 1;
    }
    while i < held {
        inbox[base + i - n] = inbox[base + i];
        i = i + 1;
    }
    tcp[b + 14] = held - n;
    return n;
}

// Give connection `c` the bytes `data[at..at + n]` to send. How many it had room for: the rest must be
// offered again later. Nothing is sent until `tcp_flush`.
pub fn tcp_write[&t, &b, &d](tcp: &!t [int], bufs: &!b [byte], c: int, data: &d [byte], at: int, n: int) -> [] int {
    if !tcp_mine(tcp, c) || (c + 1) * tcp_segment_max() > len(bufs) || at < 0 {
        return 0;
    }
    let b = c * 20;
    var k = n;
    if k > tcp[b + 11] - tcp[b + 7] {
        k = tcp[b + 11] - tcp[b + 7];
    }
    if k > len(data) - at {
        k = len(data) - at;
    }
    if k <= 0 {
        return 0;
    }
    let base = c * tcp_segment_max() + tcp[b + 7];
    var i = 0;
    while i < k {
        bufs[base + i] = data[at + i];
        i = i + 1;
    }
    tcp[b + 7] = tcp[b + 7] + k;
    return k;
}

// We have finished with connection `c`: our FIN goes after what is still to be sent, and no more can be
// written. If the other end had finished first that is the end of it; if not, the connection waits for
// its FIN. 1 if the connection was there to close, 0 if not.
pub fn tcp_close[&t](tcp: &!t [int], c: int) -> [] int {
    if !tcp_mine(tcp, c) {
        return 0;
    }
    tcp[c * 20 + 8] = 1;
    if tcp[c * 20] == 3 {
        tcp[c * 20] = 4;
    } else {
        tcp[c * 20] = 5;
    }
    return 1;
}

// How long connection `c` has heard nothing, in the caller's milliseconds.
pub fn tcp_quiet[&t](tcp: &!t [int], c: int, now: int) -> [] int {
    if c < 0 || c * 20 + 20 > len(tcp) || tcp[c * 20] == 0 {
        return 0;
    }
    return now - tcp[c * 20 + 13];
}

// Open a connection to `port` of the machine `peer`, from our port `from` (not 7, and not one in use
// with that machine). `via` is the card to send to, as for `eth_tick`. Answers the connection, or -1 if
// there is no place for one. Nothing is sent until `tcp_flush`; `tcp_state` then says how it goes: 6 while
// the SYN is unanswered, 2 when it is open, 0 if it was refused or five more tries got no answer.
pub fn tcp_dial[&t, &b, &i](tcp: &!t [int], bufs: &!b [byte], inbox: &!i [byte], peer: int, port: int, from: int, now: int, iss: int, via: int) -> [] int {
    if from == 7 || from < 1 || from > 65535 || port < 1 || port > 65535 {
        return -1;
    }
    let c = tcp_slot(tcp, tcp_count(tcp, bufs, inbox), now);
    if c < 0 {
        return -1;
    }
    let b = c * 20;
    tcp[b] = 6;
    tcp[b + 1] = peer;
    tcp[b + 2] = port;
    tcp[b + 3] = from;
    tcp[b + 4] = iss % 4294967296;
    tcp[b + 5] = tcp[b + 4];
    tcp[b + 6] = 0;
    tcp[b + 7] = 0;
    tcp[b + 8] = 2;
    tcp[b + 9] = now;
    tcp[b + 10] = 0;
    tcp[b + 11] = tcp_segment_max();
    tcp[b + 12] = via;
    tcp[b + 13] = now;
    tcp[b + 14] = 0;
    tcp[b + 16] = 0;
    return c;
}

// What connection `c` has to send that it has not sent: what was written, its FIN, or a window that has
// widened since it was last said to be narrow. Written to `out[o..]`; its length, or 0 for nothing.
pub fn tcp_flush[&t, &b, &o](tcp: &!t [int], bufs: &!b [byte], c: int, now: int, ours: int, out: &!o [byte], o: int) -> [] int {
    if c < 0 || c * 20 + 20 > len(tcp) || tcp[c * 20] < 2 || tcp[c * 20 + 3] == 7 {
        return 0;
    }
    let b = c * 20;
    let sent = past(tcp[b + 5], tcp[b + 4]);
    var whole = tcp[b + 7];
    if tcp[b + 8] != 0 {
        whole = whole + 1;
    }
    var m = 0;
    if whole > sent {
        if sent == 0 {
            tcp[b + 9] = now;
            tcp[b + 10] = 0;
        }
        m = tcp_say(tcp, bufs, c, ours, sent, out, o);
    } else if tcp[b] == 2 && tcp[b + 16] == 1 && (tcp_inbox() - tcp[b + 14]) * 2 >= tcp_inbox() {
        m = tcp_say(tcp, bufs, c, ours, -1, out, o);
    }
    if m < 0 {
        return 0;
    }
    return m;
}

// The same in a frame, to the card the connection was opened from.
pub fn eth_flush[&t, &b, &o](tcp: &!t [int], bufs: &!b [byte], c: int, now: int, mac: int, ours: int, out: &!o [byte]) -> [] int {
    let m = tcp_flush(tcp, bufs, c, now, ours, out, 14);
    if m <= 0 {
        return 0;
    }
    let w = eth_wrap(out, 14 + m, tcp[c * 20 + 12], mac, 2048);
    if w < 0 {
        return 0;
    }
    return w;
}

// Time passing for connection `c`: if its segment has been out too long (1 s, then 2, 4, 8, 16), it is
// written to `out[o..]` again and its length answered. After the fifth time the connection is dropped.
// 0: nothing to send.
pub fn tcp_tick[&t, &b, &o](tcp: &!t [int], bufs: &!b [byte], c: int, now: int, ours: int, out: &!o [byte], o: int) -> [] int {
    if c < 0 || c * 20 + 20 > len(tcp) {
        return 0;
    }
    let b = c * 20;
    if tcp[b] == 5 && tcp[b + 4] == tcp[b + 5] && now - tcp[b + 13] > 60000 {
        // we finished a minute ago and the other end never has
        tcp[b] = 0;
        return 0;
    }
    if tcp[b] == 0 || tcp[b + 4] == tcp[b + 5] {
        return 0;
    }
    var wait = 1000;
    var i = 0;
    while i < tcp[b + 10] && i < 5 {
        wait = wait * 2;
        i = i + 1;
    }
    if now - tcp[b + 9] < wait {
        return 0;
    }
    if tcp[b + 10] >= 5 {
        tcp[b] = 0;
        return 0;
    }
    tcp[b + 10] = tcp[b + 10] + 1;
    tcp[b + 9] = now;
    let m = tcp_say(tcp, bufs, c, ours, 0, out, o);
    if m < 0 {
        return 0;
    }
    return m;
}

// The same in a frame, to the card the connection was opened from.
pub fn eth_tick[&t, &b, &o](tcp: &!t [int], bufs: &!b [byte], c: int, now: int, mac: int, ours: int, out: &!o [byte]) -> [] int {
    let m = tcp_tick(tcp, bufs, c, now, ours, out, 14);
    if m <= 0 {
        return 0;
    }
    let w = eth_wrap(out, 14 + m, tcp[c * 20 + 12], mac, 2048);
    if w < 0 {
        return 0;
    }
    return w;
}

// ── speaking first ──────────────────────────────────────────────────────────────────────────────────────

// An echo request (`ping`) to `to` at `out[o..]`, with `n` bytes of data. Answers its length, or -1.
pub fn echo_request[&o](out: &!o [byte], o: int, ours: int, to: int, id: int, seq: int, n: int) -> [] int {
    if o < 0 || n < 0 || 28 + n > mtu() || o + 28 + n > len(out) {
        return -1;
    }
    header(out, o, 28 + n, 1, ours, to);
    out[o + 20] = byte_of(8);
    out[o + 21] = byte_of(0);
    put16(out, o + 22, 0);
    put16(out, o + 24, id % 65536);
    put16(out, o + 26, seq % 65536);
    var i = 0;
    while i < n {
        out[o + 28 + i] = byte_of(48 + i % 64);
        i = i + 1;
    }
    put16(out, o + 22, complement(sum16(out, o + 20, o + 28 + n, 0)));
    return 28 + n;
}

// Is the packet `pkt[at..at + n]` the reply to that request: whole, from `from`, an echo reply with this
// identifier and sequence number?
pub fn is_echo_reply[&p](pkt: &p [byte], at: int, n: int, ours: int, from: int, id: int, seq: int) -> [] bool {
    let ihl = checked(pkt, at, n, ours);
    if ihl < 0 {
        return false;
    }
    let body = get16(pkt, at + 2) - ihl;
    let s = at + ihl;
    if body < 8 || int_of(pkt[at + 9]) != 1 || get32(pkt, at + 12) != from {
        return false;
    }
    if sum16(pkt, s, s + body, 0) != 65535 {
        return false;
    }
    return int_of(pkt[s]) == 0 && int_of(pkt[s + 1]) == 0 && get16(pkt, s + 4) == id % 65536 && get16(pkt, s + 6) == seq % 65536;
}

// "Who has `target`?", to every card (RFC 826). A frame of 60 bytes in `out`; answers 60, or -1.
pub fn arp_request[&o](out: &!o [byte], mac: int, ours: int, target: int) -> [] int {
    if len(out) < 60 {
        return -1;
    }
    put16(out, 14, 1);
    put16(out, 16, 2048);
    out[18] = byte_of(6);
    out[19] = byte_of(4);
    put16(out, 20, 1);
    put48(out, 22, mac);
    put32(out, 28, ours);
    put48(out, 32, 0);
    put32(out, 38, target);
    return eth_wrap(out, 42, 281474976710655, mac, 2054);
}

// If the frame is `who` answering that question to us, its card's address; -1 otherwise.
pub fn arp_answer_from[&p](frame: &p [byte], n: int, mac: int, ours: int, who: int) -> [] int {
    if n < 42 || n > len(frame) {
        return -1;
    }
    if get48(frame, 0) != mac || get16(frame, 12) != 2054 || get16(frame, 14) != 1 || get16(frame, 16) != 2048 {
        return -1;
    }
    if int_of(frame[18]) != 6 || int_of(frame[19]) != 4 || get16(frame, 20) != 2 {
        return -1;
    }
    if get32(frame, 28) != who || get32(frame, 38) != ours {
        return -1;
    }
    return get48(frame, 22);
}

// The packet already at `out[14..14 + n]`, made a frame for the card `to`. Answers the frame's length, or a drop.
pub fn eth_frame[&o](out: &!o [byte], n: int, to: int, mac: int) -> [] int {
    return eth_wrap(out, 14 + n, to, mac, 2048);
}
