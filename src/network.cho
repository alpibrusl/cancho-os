edition 14;

module network;

import base;
import inet;
import sshd;

// network.cho -- the kernel's side of the network: the two links (SLIP on the second serial
// port, a virtio card), the board's random number generator, the shell over a connection,
// and the commands that speak first. Everything about packets is src/inet.cho, which holds
// no hardware; this is the part that moves bytes. Split from kernel.cho; `k` is the
// kernel's state, which kernel.cho lists.

// ---- the network link ---------------------------------------------------------------
// IPv4 over the second serial port, framed with SLIP (docs/network.md). The port is the
// servo bus's: `net up` gives it to the network, `net down` gives it back, and the servo
// commands refuse while it is up. Everything about packets is src/inet.cho, which holds
// no hardware; this is the part that moves bytes.

// The next whole packet from the line, in `frame`: its length, or 0 if there is none yet.
// At most 256 bytes are taken at once.
pub fn slip_recv[&mu, &s, &n, &a](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], ns: &!n [int], frame: &!a [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var budget = 256;
    while budget > 0 {
        let c = base.bus_get(bus, k);
        if c < 0 {
            return 0;
        }
        budget = budget - 1;
        let got = inet.slip_feed(ns, frame, c);
        if got > 0 {
            return got;
        }
    }
    return 0;
}

// ---- the network card: virtio-net ---------------------------------------------------
// QEMU's virt machine has 32 places for a virtio device, 0x200 apart; a network card says
// device 1 (VIRTIO 1.2, section 4.2 for the registers, 5.1 for the card, 2.7 for a queue).
// The card and the driver share memory: two queues of eight entries, one to receive and
// one to send. A queue is three tables: descriptors (where a buffer is, how long), the
// ring of buffers offered to the card, and the ring of buffers it has finished with.
// That memory is `dma`, and nothing else is in it:
//     +0x0000 receive queue: descriptors, +0x100 offered, +0x200 finished
//     +0x0400 send queue, the same three
//     +0x1000 eight receive buffers of 2 KB     +0x5000 one send buffer
// Every packet has 12 bytes of the card's own header in front, all zero here.
// No interrupt is used: `vnet_poll` looks at the finished ring.

pub fn put16le[&md](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), at: int, v: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    mmio_write8(dma, at, v & 255);
    return mmio_write8(dma, at + 1, v >> 8 & 255);
}

pub fn get16le[&md](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), at: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    return mmio_read8(dma, at) | mmio_read8(dma, at + 1) << 8;
}

// Tell the card where queue `q`'s three tables are (they start at `at`), and that it is ready.
pub fn vnet_queue[&mv](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), base: int, q: int, at: int) -> [mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    mmio_write32(vio, base + 0x30, q);
    if mmio_read32(vio, base + 0x34) < 8 {
        return 1;
    }
    mmio_write32(vio, base + 0x38, 8);
    mmio_write32(vio, base + 0x80, at & 0xffffffff);
    mmio_write32(vio, base + 0x84, at >> 32);
    mmio_write32(vio, base + 0x90, at + 0x100 & 0xffffffff);
    mmio_write32(vio, base + 0x94, at >> 32);
    mmio_write32(vio, base + 0xa0, at + 0x200 & 0xffffffff);
    mmio_write32(vio, base + 0xa4, at >> 32);
    mmio_write32(vio, base + 0x44, 1);
    return 0;
}

// Find the card and bring it up. k[15] is its registers afterwards, or 0 if there is none
// or it refused; k[19] is its address.
pub fn vnet_start[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var base = 0;
    var slot = 0;
    while slot < 32 && base == 0 {
        let at = 0xa000000 + slot * 0x200;
        // "virt", version 2 (not the legacy interface), device 1
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 1 {
            base = at;
        }
        slot = slot + 1;
    }
    if base == 0 {
        return 1;
    }
    let d = k[14] + 0x210000;
    var z = 0;
    while z < 0x1000 {
        mmio_write64(dma, d + z, 0);
        z = z + 8;
    }
    // reset; then "I see you" (1), "I can drive you" (2)
    mmio_write32(vio, base + 0x70, 0);
    mmio_write32(vio, base + 0x70, 1);
    mmio_write32(vio, base + 0x70, 3);
    // of what the card offers, two things are taken: its address in its configuration
    // (bit 5) and the current version of the interface (bit 32)
    mmio_write32(vio, base + 0x14, 0);
    let low = mmio_read32(vio, base + 0x10);
    mmio_write32(vio, base + 0x14, 1);
    let high = mmio_read32(vio, base + 0x10);
    if low & 32 == 0 || high & 1 == 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    mmio_write32(vio, base + 0x24, 0);
    mmio_write32(vio, base + 0x20, 32);
    mmio_write32(vio, base + 0x24, 1);
    mmio_write32(vio, base + 0x20, 1);
    mmio_write32(vio, base + 0x70, 11);
    if mmio_read32(vio, base + 0x70) & 8 == 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    // every receive buffer is offered: the card may write (2) 2 KB at each
    var i = 0;
    while i < 8 {
        mmio_write64(dma, d + i * 16, d + 0x1000 + i * 0x800);
        mmio_write32(dma, d + i * 16 + 8, 0x800);
        put16le(dma, d + i * 16 + 12, 2);
        put16le(dma, d + 0x104 + i * 2, i);
        i = i + 1;
    }
    put16le(dma, d + 0x102, 8);
    k[16] = 8;
    k[17] = 0;
    k[18] = 0;
    if vnet_queue(vio, base, 0, d) != 0 || vnet_queue(vio, base, 1, d + 0x400) != 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    mmio_write32(vio, base + 0x70, 15);
    mmio_write32(vio, base + 0x50, 0);
    var mac = 0;
    var b = 0;
    while b < 6 {
        mac = mac << 8 | mmio_read8(vio, base + 0x100 + b);
        b = b + 1;
    }
    k[19] = mac;
    k[15] = base;
    return 0;
}

// Send `frame[0..n]`, and wait until the card has taken it.
pub fn vnet_send[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &b [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let d = k[14] + 0x210000;
    let buf = d + 0x5000;
    mmio_write64(dma, buf, 0);
    mmio_write32(dma, buf + 8, 0);
    var i = 0;
    while i < n {
        mmio_write8(dma, buf + 12 + i, int_of(frame[i]));
        i = i + 1;
    }
    mmio_write64(dma, d + 0x400, buf);
    mmio_write32(dma, d + 0x408, 12 + n);
    put16le(dma, d + 0x40c, 0);
    put16le(dma, d + 0x504 + k[18] % 8 * 2, 0);
    k[18] = (k[18] + 1) % 65536;
    put16le(dma, d + 0x502, k[18]);
    mmio_write32(vio, k[15] + 0x50, 1);
    var spins = 0;
    while get16le(dma, d + 0x602) != k[18] && spins < 1000000 {
        spins = spins + 1;
    }
    return 0;
}

// The next frame the card has finished with, in `frame`: its length, or 0 if there is none.
// Its buffer is offered to the card again.
pub fn vnet_recv[&mv, &md, &s, &a](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let d = k[14] + 0x210000;
    var got = 0;
    while got == 0 && get16le(dma, d + 0x202) != k[17] {
        let entry = d + 0x204 + k[17] % 8 * 8;
        let id = mmio_read32(dma, entry) & 7;
        let n = mmio_read32(dma, entry + 4) - 12;
        if n > 0 && n <= len(frame) {
            var i = 0;
            while i < n {
                frame[i] = byte_of(mmio_read8(dma, d + 0x1000 + id * 0x800 + 12 + i));
                i = i + 1;
            }
            got = n;
        }
        put16le(dma, d + 0x104 + k[16] % 8 * 2, id);
        k[16] = (k[16] + 1) % 65536;
        put16le(dma, d + 0x102, k[16]);
        k[17] = (k[17] + 1) % 65536;
        mmio_write32(vio, k[15] + 0x50, 0);
    }
    // the card raises its interrupt line for each; nobody listens, and this lowers it
    let raised = mmio_read32(vio, k[15] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[15] + 0x64, raised);
    }
    return got;
}

// ---- the firmware ------------------------------------------------------------------------
// A Pi's firmware keeps facts about the board and answers questions about them through a
// "mailbox": the address of a message is written to one register and read back from
// another when it has been answered in place. The message is in `dma` (at +0xc000, which
// no card uses), where the firmware and the kernel see the same bytes. Three questions
// are asked, and nothing is ever set: the board's revision (tag 0x10002), its card's
// address (0x10003), its serial number (0x10004). A fourth since the SD card: how fast a
// clock runs (0x30002), which the card's controller does not say itself.
// Registers, from 0x3f00b880 on a Pi 3 and 0xfe00b880 on a Pi 4: +0x00 read, +0x18 status
// (bit 31 no room to write, bit 30 nothing to read), +0x20 write. Channel 8.

// Ask `tag`. 0 when the firmware has answered, its answer's bytes then at `fw_byte`.
fn fw_ask[&mw, &md, &s](fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], tag: int, arg: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    var m = 0;
    if k[1] == 3 {
        m = 0x3f00b880;
    } else if k[1] == 4 {
        m = 0xfe00b880;
    } else {
        return 1;
    }
    let b = k[14] + 0x21c000;
    // 32 bytes in all, a request; one tag with room for 8 bytes of answer; the end
    mmio_write32(dma, b, 32);
    mmio_write32(dma, b + 4, 0);
    mmio_write32(dma, b + 8, tag);
    mmio_write32(dma, b + 12, 8);
    mmio_write32(dma, b + 16, 0);
    mmio_write32(dma, b + 20, arg);
    mmio_write32(dma, b + 24, 0);
    mmio_write32(dma, b + 28, 0);
    var spins = 0;
    while mmio_read32(fw, m + 0x18) >> 31 & 1 != 0 && spins < 1000000 {
        spins = spins + 1;
    }
    mmio_write32(fw, m + 0x20, b | 8);
    var answered = false;
    spins = 0;
    while !answered && spins < 1000000 {
        if mmio_read32(fw, m + 0x18) >> 30 & 1 == 0 {
            answered = mmio_read32(fw, m) & 15 == 8;
        }
        spins = spins + 1;
    }
    if !answered || mmio_read32(dma, b + 4) != 0x80000000 || mmio_read32(dma, b + 16) >> 31 & 1 == 0 {
        return 1;
    }
    return 0;
}

fn fw_byte[&md, &s](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], i: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    return mmio_read8(dma, k[14] + 0x21c000 + 20 + i);
}

// How fast the clock `id` runs, in Hz (1 the Pi 3's SD controller's, 12 the Pi 4's); 0 if the firmware
// did not say.
pub fn fw_clock[&mw, &md, &s](fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], id: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    if fw_ask(fw, dma, k, 0x30002, id) != 0 {
        return 0;
    }
    return fw_byte(dma, k, 4) | fw_byte(dma, k, 5) << 8 | fw_byte(dma, k, 6) << 16 | fw_byte(dma, k, 7) << 24;
}

// `board`: what the firmware says this board is.
fn put_board[&mc, &mw, &md, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    if fw_ask(fw, dma, k, 0x10002, 0) != 0 {
        return base.puts(con, k, "this board has no firmware to ask, or it did not answer\r\n");
    }
    base.puts(con, k, "revision ");
    var i = 3;
    while i >= 0 {
        base.put_hex(con, k, fw_byte(dma, k, i) >> 4);
        base.put_hex(con, k, fw_byte(dma, k, i) & 15);
        i = i - 1;
    }
    if fw_ask(fw, dma, k, 0x10004, 0) == 0 {
        base.puts(con, k, ", serial ");
        i = 7;
        while i >= 0 {
            base.put_hex(con, k, fw_byte(dma, k, i) >> 4);
            base.put_hex(con, k, fw_byte(dma, k, i) & 15);
            i = i - 1;
        }
    }
    if fw_ask(fw, dma, k, 0x10003, 0) == 0 {
        base.puts(con, k, ", card address ");
        i = 0;
        while i < 6 {
            base.put_hex(con, k, fw_byte(dma, k, i) >> 4);
            base.put_hex(con, k, fw_byte(dma, k, i) & 15);
            if i < 5 {
                base.puts(con, k, ":");
            }
            i = i + 1;
        }
    }
    return base.puts(con, k, "\r\n");
}

// ---- the Pi 4's network card: GENET ----------------------------------------------------
// BCM2711's Ethernet controller (docs/genet.md), at 0xfd580000, version 5. Written from
// NetBSD's bcmgenet.c and FreeBSD's if_genet.c (both BSD-2-Clause). Only a real board
// has one: QEMU's Pi 4 does not, and reading its address there is a fault, so nothing
// here runs until `net eth` is typed.
// The card and the driver share `dma`, mapped uncached: sixteen receive buffers of 2 KB
// at +0x0000, eight to send at +0x8000. The card finds them through descriptors that
// are its own registers (three words each: length and flags, then the address), in two
// rings the driver sizes: 16 of the 256 there are.
//   +0x000 version     +0x004 port mode     +0x008 receive buffer reset     +0x08c RGMII
//   +0x200.. interrupts (all masked: the card is polled)     +0x300 receive buffer control
//   +0x808 the MAC's command (bit 0 send, 1 receive, 2..3 speed, 4 take every frame,
//          13 reset)   +0x80c +0x810 its address   +0x814 longest frame   +0xe14 MDIO
//   +0x2000 receive descriptors, +0x3000 the ring's registers, +0x3040 the DMA's
//   +0x4000 send descriptors,    +0x5000 the ring's registers, +0x5040 the DMA's

fn genet_wait[&f](cpu: &!f Cpu, us: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    let from = base.now_us(cpu);
    while base.now_us(cpu) - from < us {
    }
    return 0;
}

// A register of the transceiver beside the card (the PHY, at address 1 on a Pi 4), read
// through the card. -1 if the card gives up.
fn genet_phy_read[&mv](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), reg: int) -> [mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let m = 0xfd580000 + 0xe14;
    let cmd = 2 << 26 | 1 << 21 | reg << 16;
    mmio_write32(vio, m, cmd);
    mmio_write32(vio, m, cmd | 1 << 29);
    var spins = 0;
    while mmio_read32(vio, m) & 1 << 29 != 0 && spins < 1000000 {
        spins = spins + 1;
    }
    let v = mmio_read32(vio, m);
    if v & 1 << 29 != 0 || v & 1 << 28 != 0 {
        return -1;
    }
    return v & 0xffff;
}

fn genet_phy_write[&mv](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), reg: int, value: int) -> [mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let m = 0xfd580000 + 0xe14;
    let cmd = 1 << 26 | 1 << 21 | reg << 16 | value & 0xffff;
    mmio_write32(vio, m, cmd);
    mmio_write32(vio, m, cmd | 1 << 29);
    var spins = 0;
    while mmio_read32(vio, m) & 1 << 29 != 0 && spins < 1000000 {
        spins = spins + 1;
    }
    return 0;
}

// Reset the card, give it its rings and buffers, and tell the transceiver how the two are
// wired. k[15] is the card afterwards and k[19] its address; 1 if it is not the card expected.
pub fn genet_start[&f, &mv, &md, &mw, &s](cpu: &!f Cpu, vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    let g = 0xfd580000;
    if mmio_read32(vio, g) >> 24 & 15 != 6 {
        // version 5 says 6 here
        return 1;
    }
    // the address the firmware gave the card, before the reset forgets it
    var mac = (mmio_read32(vio, g + 0x80c) & 0xffffffff) << 16 | mmio_read32(vio, g + 0x810) & 0xffff;
    // the board's own address is the firmware's to say; an old firmware leaves the card's registers
    // at zero. If neither is to be had: one of the kind anyone may make up, 02:63:61:6e:63:04
    if fw_ask(fw, dma, k, 0x10003, 0) == 0 {
        var own = 0;
        var b = 0;
        while b < 6 {
            own = own << 8 | fw_byte(dma, k, b);
            b = b + 1;
        }
        if own != 0 {
            mac = own;
        }
    }
    if mac == 0 {
        mac = 0x0263616e6304;
    }
    mmio_write32(vio, g + 0x008, 2);
    genet_wait(cpu, 10);
    mmio_write32(vio, g + 0x008, 0);
    genet_wait(cpu, 10);
    mmio_write32(vio, g + 0x808, 0);
    mmio_write32(vio, g + 0x808, 1 << 15 | 1 << 13);
    genet_wait(cpu, 10);
    mmio_write32(vio, g + 0x808, 0);
    // counters cleared; the longest frame taken; two bytes before each frame, so that what
    // follows the 14 of its header is aligned
    mmio_write32(vio, g + 0xd80, 7);
    mmio_write32(vio, g + 0xd80, 0);
    mmio_write32(vio, g + 0x814, 1536);
    mmio_write32(vio, g + 0x300, mmio_read32(vio, g + 0x300) | 2);
    mmio_write32(vio, g + 0x3b4, 1);
    // no interrupt is wanted
    mmio_write32(vio, g + 0x210, 0xffffffff);
    mmio_write32(vio, g + 0x208, 0xffffffff);
    // the transceiver is outside the chip
    mmio_write32(vio, g + 0x004, 3);
    mmio_write32(vio, g + 0x80c, mac >> 16 & 0xffffffff);
    mmio_write32(vio, g + 0x810, mac & 0xffff);
    // both directions stopped while their rings are made
    mmio_write32(vio, g + 0x3044, 0);
    mmio_write32(vio, g + 0x5044, 0);
    mmio_write32(vio, g + 0xb34, 1);
    genet_wait(cpu, 10);
    mmio_write32(vio, g + 0xb34, 0);
    mmio_write32(vio, g + 0x304c, 8);
    mmio_write32(vio, g + 0x504c, 8);
    let d = k[14] + 0x210000;
    var i = 0;
    while i < 16 {
        mmio_write32(vio, g + 0x2000 + i * 12 + 4, d + i * 0x800);
        mmio_write32(vio, g + 0x2000 + i * 12 + 8, 0);
        mmio_write32(vio, g + 0x4000 + i * 12 + 4, d + 0x8000 + (i & 7) * 0x800);
        mmio_write32(vio, g + 0x4000 + i * 12 + 8, 0);
        i = i + 1;
    }
    // the receive ring (the last, number 16): 16 buffers of 2 KB, descriptors 0 to 15
    let rx = g + 0x3000;
    mmio_write32(vio, rx, 0);
    mmio_write32(vio, rx + 0x08, 0);
    mmio_write32(vio, rx + 0x0c, 0);
    mmio_write32(vio, rx + 0x10, 16 << 16 | 2048);
    mmio_write32(vio, rx + 0x14, 0);
    mmio_write32(vio, rx + 0x1c, 16 * 3 - 1);
    mmio_write32(vio, rx + 0x28, 5 << 16 | 1);
    mmio_write32(vio, rx + 0x2c, 0);
    mmio_write32(vio, g + 0x3040, 1 << 16);
    let tx = g + 0x5000;
    mmio_write32(vio, tx, 0);
    mmio_write32(vio, tx + 0x08, 0);
    mmio_write32(vio, tx + 0x0c, 0);
    mmio_write32(vio, tx + 0x10, 16 << 16 | 2048);
    mmio_write32(vio, tx + 0x14, 0);
    mmio_write32(vio, tx + 0x1c, 16 * 3 - 1);
    mmio_write32(vio, tx + 0x24, 1);
    mmio_write32(vio, tx + 0x28, 0);
    mmio_write32(vio, tx + 0x2c, 0);
    mmio_write32(vio, g + 0x5040, 1 << 16);
    // where the card's own counters start, whatever the reset left in them
    k[17] = mmio_read32(vio, rx + 0x08) & 0xffff;
    mmio_write32(vio, rx + 0x0c, k[17]);
    k[18] = mmio_read32(vio, tx + 0x08) & 0xffff;
    mmio_write32(vio, tx + 0x0c, k[18]);
    mmio_write32(vio, g + 0x3044, 1 | 1 << 17);
    mmio_write32(vio, g + 0x5044, 1 | 1 << 17);
    // RGMII to the transceiver, which delays the receive clock itself ("rgmii-rxid")
    let oob = mmio_read32(vio, g + 0x08c) & ~(1 << 5) & ~(1 << 16);
    mmio_write32(vio, g + 0x08c, oob | 1 << 6 | 1 << 4);
    // and the transceiver told so: its receive clock delayed (shadow 7 of register 0x18,
    // bit 8), its send clock not (shadow 3 of register 0x1c, bit 9)
    genet_phy_write(vio, 0x18, 0x7007);
    let aux = genet_phy_read(vio, 0x18);
    if aux >= 0 {
        genet_phy_write(vio, 0x18, aux & 0x7ff8 | 0x8000 | 0x100 | 7);
    }
    genet_phy_write(vio, 0x1c, 3 << 10);
    let clk = genet_phy_read(vio, 0x1c);
    if clk >= 0 {
        genet_phy_write(vio, 0x1c, 0x8000 | 3 << 10 | clk & 0x1ff);
    }
    // negotiate again with whoever is on the cable
    genet_phy_write(vio, 0, 0x1200);
    k[19] = mac;
    k[15] = g;
    return 0;
}

// Is there a cable, and at what speed did the two ends agree? 0 for no cable; else 10, 100
// or 1000, and the MAC is set to it and told to send and receive.
pub fn genet_link[&mv, &s](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), k: &!s [int]) -> [mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    // the status register remembers a lost link until it is read: read twice
    genet_phy_read(vio, 1);
    let status = genet_phy_read(vio, 1);
    if status < 0 || status & 4 == 0 || status & 0x20 == 0 {
        return 0;
    }
    var speed = 10;
    var bits = 0;
    let giga = genet_phy_read(vio, 9) << 2 & genet_phy_read(vio, 10);
    let common = genet_phy_read(vio, 4) & genet_phy_read(vio, 5);
    if giga & 0xc00 != 0 {
        speed = 1000;
        bits = 2;
    } else if common & 0x180 != 0 {
        speed = 100;
        bits = 1;
    }
    // every frame is taken (bit 4): `inet` drops what is not for this card
    mmio_write32(vio, k[15] + 0x808, bits << 2 | 1 << 4 | 3);
    return speed;
}

fn genet_send[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &b [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if n < 14 || n > 1536 {
        return 1;
    }
    let slot = k[18] & 15;
    // (eight buffers for sixteen descriptors: a frame has left before the next is written)
    let buf = k[14] + 0x218000 + (slot & 7) * 0x800;
    var i = 0;
    while i < n {
        mmio_write8(dma, buf + i, int_of(frame[i]));
        i = i + 1;
    }
    // the length; one whole frame (first and last piece); the card adds the check
    mmio_write32(vio, k[15] + 0x4000 + slot * 12, n << 16 | 0x1f80 | 0x2000 | 0x4000 | 0x40);
    k[18] = (k[18] + 1) & 0xffff;
    mmio_write32(vio, k[15] + 0x5000 + 0x0c, k[18]);
    var spins = 0;
    while mmio_read32(vio, k[15] + 0x5000 + 0x08) & 0xffff != k[18] && spins < 1000000 {
        spins = spins + 1;
    }
    return 0;
}

fn genet_recv[&mv, &md, &s, &a](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var got = 0;
    while got == 0 && mmio_read32(vio, k[15] + 0x3000 + 0x08) & 0xffff != k[17] {
        let slot = k[17] & 15;
        // the length counts the two bytes in front. If the four of the frame's check are behind,
        // they stay: `inet` goes by the lengths inside the frame, and takes what follows as padding
        let n = (mmio_read32(vio, k[15] + 0x2000 + slot * 12) >> 16 & 0xfff) - 2;
        let buf = k[14] + 0x210000 + slot * 0x800 + 2;
        if n >= 14 && n <= len(frame) && n <= 2040 {
            var i = 0;
            while i < n {
                frame[i] = byte_of(mmio_read8(dma, buf + i));
                i = i + 1;
            }
            got = n;
        }
        k[17] = (k[17] + 1) & 0xffff;
        mmio_write32(vio, k[15] + 0x3000 + 0x0c, k[17]);
    }
    return got;
}

// Whichever card the board has.
fn card_send[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &b [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[1] == 4 {
        return genet_send(vio, dma, k, frame, n);
    }
    return vnet_send(vio, dma, k, frame, n);
}

fn card_recv[&mv, &md, &s, &a](vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[1] == 4 {
        return genet_recv(vio, dma, k, frame);
    }
    return vnet_recv(vio, dma, k, frame);
}

// `net eth` on a Pi 4: bring the card up, wait up to five seconds for the cable, and make
// it the link.
pub fn net_eth[&f, &mc, &mv, &md, &mr, &mw, &s](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), k: &!s [int]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    if k[1] != 4 {
        return base.puts(con, k, "`net eth` is for a Pi 4's own card; on this board `net up` is the link there is\r\n");
    }
    k[10] = 0;
    if genet_start(cpu, vio, dma, fw, k) != 0 {
        base.puts(con, k, "not the card expected: its version register says ");
        base.put_dec(con, k, mmio_read32(vio, 0xfd580000) >> 24 & 15);
        return base.puts(con, k, "\r\n");
    }
    // the board's generator too: like the card, only a real Pi 4 has one, so it is not touched at boot
    if k[34] == 0 {
        k[35] = 0xfe104000;
        if mmio_read32(rng, k[35]) & 0x1fff == 0 {
            // the first numbers are thrown away (this many bits); two words before it says it has any;
            // then on, sampling at 1 MHz
            mmio_write32(rng, k[35] + 0x10, 0x40000);
            mmio_write32(rng, k[35] + 0x24, 2 << 8);
            mmio_write32(rng, k[35], 3 << 13 | 0x1fff);
        }
        k[34] = 4;
    }
    base.puts(con, k, "GENET, transceiver ");
    var shift = 12;
    let id1 = genet_phy_read(vio, 2);
    let id2 = genet_phy_read(vio, 3);
    while shift >= 0 {
        base.put_hex(con, k, id1 >> shift & 15);
        shift = shift - 4;
    }
    shift = 12;
    while shift >= 0 {
        base.put_hex(con, k, id2 >> shift & 15);
        shift = shift - 4;
    }
    base.puts(con, k, "\r\n");
    let from = base.now_us(cpu);
    var speed = 0;
    while speed == 0 && base.now_us(cpu) - from < 5000000 {
        genet_wait(cpu, 100000);
        speed = genet_link(vio, k);
    }
    if speed == 0 {
        return base.puts(con, k, "no cable, or nobody at its other end, after five seconds\r\n");
    }
    k[10] = 2;
    base.puts(con, k, "cable in, ");
    base.put_dec(con, k, speed);
    base.puts(con, k, " Mb/s\r\n");
    return put_net(con, k);
}

// ---- randomness ------------------------------------------------------------------------
// Numbers nobody outside can guess, from the board's own generator (docs/random.md):
// on QEMU's virt a virtio device (number 4), which fills a buffer it is offered; on a Pi 3
// the BCM2835 generator (control +0, status +4 with the words ready in its top byte,
// data +8). A Pi 4 has another (the RNG200), which QEMU's Pi 4 does not have: no driver
// for it yet, and there the kernel has no randomness.
// k[34] says which (0: none), k[35] where. The virtio queue is in `dma`, after the
// network card's: +0x6000 its three tables, +0x6400 the buffer.

pub fn rng_start[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[1] == 3 {
        k[35] = 0x3f104000;
        // the first words are to be thrown away: this many, the chip's own advice
        mmio_write32(rng, k[35] + 4, 0x40000);
        mmio_write32(rng, k[35], 1);
        k[34] = 3;
        return 0;
    }
    if k[1] != 1 {
        return 1;
    }
    var base = 0;
    var slot = 0;
    while slot < 32 && base == 0 {
        let at = 0xa000000 + slot * 0x200;
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 4 {
            base = at;
        }
        slot = slot + 1;
    }
    if base == 0 {
        return 1;
    }
    let d = k[14] + 0x216000;
    var z = 0;
    while z < 0x800 {
        mmio_write64(dma, d + z, 0);
        z = z + 8;
    }
    mmio_write32(vio, base + 0x70, 0);
    mmio_write32(vio, base + 0x70, 1);
    mmio_write32(vio, base + 0x70, 3);
    // nothing is asked of the device but the current version of the interface (bit 32)
    mmio_write32(vio, base + 0x24, 0);
    mmio_write32(vio, base + 0x20, 0);
    mmio_write32(vio, base + 0x24, 1);
    mmio_write32(vio, base + 0x20, 1);
    mmio_write32(vio, base + 0x70, 11);
    if mmio_read32(vio, base + 0x70) & 8 == 0 || vnet_queue(vio, base, 0, d) != 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    // one buffer of 16 bytes, which the device may write (2)
    mmio_write64(dma, d, d + 0x400);
    mmio_write32(dma, d + 8, 16);
    put16le(dma, d + 12, 2);
    mmio_write32(vio, base + 0x70, 15);
    k[36] = 0;
    k[35] = base;
    k[34] = 1;
    return 0;
}

// One word of 32 bits from the generator, or -1 if it gave none in time.
pub fn rng_word[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var spins = 0;
    if k[34] == 4 {
        // a Pi 4's RNG200: +0x24 says how many words wait (its low byte), +0x20 gives one
        while mmio_read32(rng, k[35] + 0x24) & 255 == 0 && spins < 1000000 {
            spins = spins + 1;
        }
        if mmio_read32(rng, k[35] + 0x24) & 255 == 0 {
            return -1;
        }
        return mmio_read32(rng, k[35] + 0x20);
    }
    if k[34] == 3 {
        while mmio_read32(rng, k[35] + 4) >> 24 == 0 && spins < 1000000 {
            spins = spins + 1;
        }
        if mmio_read32(rng, k[35] + 4) >> 24 == 0 {
            return -1;
        }
        return mmio_read32(rng, k[35] + 8);
    }
    if k[34] != 1 {
        return -1;
    }
    let d = k[14] + 0x216000;
    // offer the buffer, say so, and wait for it to come back
    put16le(dma, d + 0x104 + k[36] % 8 * 2, 0);
    k[36] = (k[36] + 1) % 65536;
    put16le(dma, d + 0x102, k[36]);
    mmio_write32(vio, k[35] + 0x50, 0);
    while get16le(dma, d + 0x202) != k[36] && spins < 1000000 {
        spins = spins + 1;
    }
    let raised = mmio_read32(vio, k[35] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[35] + 0x64, raised);
    }
    if get16le(dma, d + 0x202) != k[36] {
        return -1;
    }
    // how many bytes the device says it wrote
    if mmio_read32(dma, d + 0x204 + (k[36] + 7) % 8 * 8 + 4) < 4 {
        return -1;
    }
    return mmio_read32(dma, d + 0x400);
}

// Keep 16 words ready at k[4136..]; k[37] is how many there are. What needs one takes it
// from there, and so needs no capability.
pub fn rng_fill[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    while k[34] != 0 && k[37] < 16 {
        let w = rng_word(rng, vio, dma, k);
        if w < 0 {
            return 1;
        }
        k[4136 + k[37]] = w;
        k[37] = k[37] + 1;
    }
    return 0;
}

pub fn put_rng_name[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if k[34] == 1 {
        return base.puts(con, k, "virtio-rng");
    }
    if k[34] == 4 {
        return base.puts(con, k, "the RNG200");
    }
    return base.puts(con, k, "the BCM2835 generator");
}

// `random`: sixteen bytes straight from the generator, and which one it is.
pub fn put_random[&mc, &mr, &mv, &md, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[34] == 0 && k[1] == 4 {
        return base.puts(con, k, "not started: on a Pi 4 the generator is started with the card, by `net eth`\r\n");
    }
    if k[34] == 0 {
        return base.puts(con, k, "this board gave the kernel no source of randomness\r\n");
    }
    base.puts(con, k, "random (");
    put_rng_name(con, k);
    base.puts(con, k, "): ");
    var i = 0;
    while i < 4 {
        let w = rng_word(rng, vio, dma, k);
        if w < 0 {
            return base.puts(con, k, " the generator gave nothing\r\n");
        }
        var shift = 28;
        while shift >= 0 {
            base.put_hex(con, k, w >> shift & 15);
            shift = shift - 4;
        }
        i = i + 1;
    }
    return base.puts(con, k, "\r\n");
}

// ---- the two links as one -----------------------------------------------------------
// What arrives is a frame on the card and a bare packet on the serial line; `inet` has
// a function for each, and these four are where the kernel chooses.

pub fn link_recv[&mu, &mv, &md, &s, &n, &a](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[10] == 2 {
        return card_recv(vio, dma, k, frame);
    }
    return slip_recv(bus, k, ns, frame);
}

pub fn link_send[&mu, &mv, &md, &s, &b, &w](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], pkt: &b [byte], n: int, wire: &!w [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[10] == 2 {
        return card_send(vio, dma, k, pkt, n);
    }
    let w = inet.slip_encode(pkt, n, wire);
    var i = 0;
    while i < w {
        base.bus_put(bus, k, int_of(wire[i]));
        i = i + 1;
    }
    return 0;
}

// What arrived, `frame[0..n]`, given to `inet`, and its answer sent. `iss` is where a new
// connection's sequence numbers start if the pool of random words is empty: the counter's
// value, which is not a secret.
pub fn net_take[&mu, &mv, &md, &s, &a, &b, &w, &t, &g, &h](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte], n: int, reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var m = 0;
    // a word nobody can guess, if the board has given any; else the counter
    var first = iss;
    if k[37] > 0 {
        first = k[4136 + k[37] - 1];
    }
    var at = 0;
    if k[10] == 2 {
        at = 14;
        m = inet.eth_serve(frame, n, k[19], k[4154], tcp, bufs, inbox, k[30], now, first, reply);
    } else {
        m = inet.serve(frame, n, k[4154], tcp, bufs, inbox, k[30], now, first, reply);
    }
    if k[37] > 0 && m >= at + 40 && int_of(reply[at + 9]) == 6 && int_of(reply[at + 33]) == 18 {
        // the reply opens a connection (SYN and ACK): it began at that word, which is not used again
        k[37] = k[37] - 1;
        k[38] = k[38] + 1;
    }
    if m > 0 {
        link_send(bus, vio, dma, k, reply, m, wire);
        k[11] = k[11] + 1;
    } else if m == 0 {
        k[20] = k[20] + 1;
    } else {
        k[12] = k[12] + 1;
        k[13] = m;
    }
    if k[29] != 0 && inet.tcp_state(tcp, k[29] - 1) != 2 && inet.tcp_state(tcp, k[29] - 1) != 3 {
        // the shell's connection has gone: what it had typed and what waited for it go with it
        k[29] = 0;
        k[27] = 0;
        k[28] = 0;
        k[31] = 0;
        k[32] = 0;
        k[4152] = 0;
    }
    return 0;
}

// Take what has arrived, at most eight packets, and answer each; then send again whatever a
// connection has had out too long, and whatever is new.
pub fn net_pump[&mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    var budget = 8;
    while budget > 0 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n == 0 {
            budget = 0;
        } else {
            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, now, iss);
            budget = budget - 1;
        }
    }
    var c = 0;
    while c < inet.tcp_count(tcp, bufs, inbox) {
        var m = 0;
        if k[10] == 2 {
            m = inet.eth_tick(tcp, bufs, c, now, k[19], k[4154], reply);
        } else {
            m = inet.tcp_tick(tcp, bufs, c, now, k[4154], reply, 0);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
            k[25] = k[25] + 1;
        }
        // and what the shell's connection has to send that it has not sent
        if k[10] == 2 {
            m = inet.eth_flush(tcp, bufs, c, now, k[19], k[4154], reply);
        } else {
            m = inet.tcp_flush(tcp, bufs, c, now, k[4154], reply, 0);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
        }
        c = c + 1;
    }
    k[24] = inet.tcp_open(tcp, bufs, inbox);
    return 0;
}

// What `getc` does while it waits for a key: move the shell's bytes to and from the connection
// that has it (through SSH, on port 22), then `net_pump`. Answers what `sshd.step` does.
pub fn net_poll[&mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l, &si, &sb, &sx](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], si: &!si [int], sb: &!sb [byte], sx: &!sx [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4174] != 0 {
        // a port was just closed (`net ssh off`): whoever was connected to it is hung up
        // on, since nothing will read or answer them now
        var c = 0;
        while c < inet.tcp_count(tcp, bufs, inbox) {
            if inet.tcp_port(tcp, c) == k[4174] {
                inet.tcp_close(tcp, c);
            }
            c = c + 1;
        }
        k[4174] = 0;
        k[29] = 0;
    }
    var ready = 0;
    if k[4153] == 1 {
        ready = sshd.step(k, tcp, bufs, inbox, rline, wire, si, sb, sx, now);
    }
    net_pump(bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, now, iss);
    return ready;
}

// `a.b.c.d` at `line[from..n]` as a number, or -1.
pub fn address[&r](line: &r [byte], from: int, n: int) -> [] int {
    var value = 0;
    var part = 0;
    var parts = 0;
    var digits = 0;
    var i = from;
    while i < n {
        let c = int_of(line[i]);
        if c >= '0' && c <= '9' && digits < 3 {
            part = part * 10 + c - '0';
            digits = digits + 1;
        } else if c == '.' && digits > 0 && part < 256 && parts < 3 {
            value = value * 256 + part;
            part = 0;
            digits = 0;
            parts = parts + 1;
        } else {
            return -1;
        }
        i = i + 1;
    }
    if parts != 3 || digits == 0 || part > 255 {
        return -1;
    }
    return value * 256 + part;
}

pub fn put_address[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], a: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    base.put_dec(con, k, a >> 24 & 255);
    base.puts(con, k, ".");
    base.put_dec(con, k, a >> 16 & 255);
    base.puts(con, k, ".");
    base.put_dec(con, k, a >> 8 & 255);
    base.puts(con, k, ".");
    return base.put_dec(con, k, a & 255);
}

// Whose card is a packet for `target` sent to? The machine's own if it is on our network,
// else the gateway's. Asked of every card (ARP), unless it is the neighbour already
// remembered. Its card's address; 0 on the serial line, which has none; -1 if nobody answers
// within a second. Whatever else arrives meanwhile is answered as always.
pub fn resolve[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], target: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[10] != 2 {
        return 0;
    }
    // a machine outside our network is reached through the gateway's card
    let hop = inet.next_hop(k[4154], k[4155], k[4156], target);
    if hop == 0 {
        base.puts(con, k, "no gateway is known, and ");
        put_address(con, k, target);
        base.puts(con, k, " is not on this network\r\n");
        return -1;
    }
    if k[21] == hop {
        return k[22];
    }
    let ours = k[4154];
    let q = inet.arp_request(reply, k[19], ours, hop);
    if q > 0 {
        card_send(vio, dma, k, reply, q);
    }
    let asked = base.now_us(cpu);
    var card = -1;
    while card < 0 && base.now_us(cpu) - asked < 1000000 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n > 0 {
            card = inet.arp_answer_from(frame, n, k[19], ours, hop);
            if card < 0 {
                net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
            }
        }
    }
    if card < 0 {
        base.puts(con, k, "nobody on this network says they are ");
        put_address(con, k, hop);
        base.puts(con, k, "\r\n");
        return -1;
    }
    k[21] = hop;
    k[22] = card;
    return card;
}

// `data[from..to]` copied to `out[at..]`, as much as fits. Where the next byte goes.
fn put_bytes[&o, &d](out: &!o [byte], at: int, data: &d [byte], from: int, to: int) -> [] int {
    var i = from;
    var w = at;
    while i < to && w < len(out) {
        out[w] = data[i];
        w = w + 1;
        i = i + 1;
    }
    return w;
}

// `http <address> <port>`: the kernel opens a connection, asks for `/` in HTTP/1.0, and
// prints what comes back until the other end finishes, for at most five seconds. The
// shell waits meanwhile; the network is served as always.
pub fn net_http[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], dest: int, name: &r [byte], from: int, to: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let target = dest / 65536;
    let card = resolve(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, target);
    if card < 0 {
        return 0;
    }
    // a number nobody can guess to begin at, if there is one; and a port of ours not used a moment ago
    var first = cpu_read(cpu, "cntvct_el0");
    if k[37] > 0 {
        k[37] = k[37] - 1;
        first = k[4136 + k[37]];
    }
    k[23] = k[23] + 1;
    let c = inet.tcp_dial(tcp, bufs, inbox, target, dest % 65536, 49152 + k[23] % 16384, base.uptime_ms(cpu), first, card);
    if c < 0 {
        return base.puts(con, k, "no room for another connection\r\n");
    }
    let began = base.uptime_ms(cpu);
    var opened = false;
    var printed = 0;
    k[39] = 1;
    while inet.tcp_state(tcp, c) != 0 && base.uptime_ms(cpu) - began < 5000 {
        net_pump(bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
        let state = inet.tcp_state(tcp, c);
        if state == 2 && !opened {
            opened = true;
            // the request: its first line, and whom it is for, as the user named it (a server that
            // answers for several names needs that)
            var w = 0;
            w = put_bytes(wire, w, "GET / HTTP/1.0\r\nHost: ", 0, 22);
            w = put_bytes(wire, w, name, from, to);
            w = put_bytes(wire, w, "\r\n\r\n", 0, 4);
            inet.tcp_write(tcp, bufs, c, wire, 0, w);
        }
        let n = inet.tcp_read(tcp, inbox, c, wire, 256);
        var i = 0;
        while i < n {
            let ch = int_of(wire[i]);
            if ch == 10 {
                base.puts(con, k, "\r\n");
            } else if ch >= 32 && ch < 127 {
                base.putc(con, k, ch);
            } else if ch != 13 {
                base.putc(con, k, '.');
            }
            i = i + 1;
        }
        printed = printed + n;
        if state == 3 && n == 0 {
            // the other end has finished and all of it is printed: we finish too
            inet.tcp_close(tcp, c);
        }
    }
    if inet.tcp_state(tcp, c) != 0 {
        // five seconds: hang up, and let the closing happen behind the shell
        inet.tcp_close(tcp, c);
    }
    k[39] = 0;
    if !opened {
        base.puts(con, k, "no connection to ");
        put_address(con, k, target);
        base.puts(con, k, " port ");
        base.put_dec(con, k, dest % 65536);
        return base.puts(con, k, ": refused, or no answer\r\n");
    }
    base.puts(con, k, "\r\n[");
    base.put_dec(con, k, printed);
    return base.puts(con, k, " bytes]\r\n");
}

// `ping <address>`: the kernel speaks first. An echo request, and the time to its reply.
// On the card the address must first be asked for (ARP); the last answer is remembered.
// Whatever else arrives meanwhile is answered as always.
pub fn net_ping[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], target: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[10] == 0 {
        return base.puts(con, k, "the link is down: `net up` first\r\n");
    }
    if target < 0 {
        return 0;
    }
    let ours = k[4154];
    if resolve(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, target) < 0 {
        return 0;
    }
    k[23] = k[23] + 1;
    var at = 0;
    if k[10] == 2 {
        at = 14;
    }
    var m = inet.echo_request(reply, at, ours, target, 51724, k[23], 32);
    if m > 0 && k[10] == 2 {
        m = inet.eth_frame(reply, m, k[22], k[19]);
    }
    if m <= 0 {
        return base.puts(con, k, "the request could not be built\r\n");
    }
    link_send(bus, vio, dma, k, reply, m, wire);
    let sent = base.now_us(cpu);
    while base.now_us(cpu) - sent < 1000000 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n > 0 {
            var hit = false;
            if k[10] == 2 {
                hit = n > 14 && inet.get16(frame, 12) == 2048 && inet.is_echo_reply(frame, 14, n - 14, ours, target, 51724, k[23]);
            } else {
                hit = inet.is_echo_reply(frame, 0, n, ours, target, 51724, k[23]);
            }
            if hit {
                let took = base.now_us(cpu) - sent;
                base.puts(con, k, "reply from ");
                put_address(con, k, target);
                base.puts(con, k, " in ");
                base.put_dec(con, k, took);
                return base.puts(con, k, " us\r\n");
            }
            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
        }
    }
    base.puts(con, k, "no reply from ");
    put_address(con, k, target);
    return base.puts(con, k, " within a second\r\n");
}

// ---- names, and an address that is given (docs/addresses.md) ------------------------

fn put_text[&mc, &s, &r](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int], text: &r [byte], from: int, to: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    var i = from;
    while i < to {
        base.putc(con, k, int_of(text[i]));
        i = i + 1;
    }
    return 0;
}

// The address of the name `name[from..to]`, asked of the name server over UDP: twice at
// most, two seconds each. -1, and the reason printed, if there is none to be had.
// A servo packet sent to the machine that has the servo bus, and that machine's answer (docs/netbus.md):
// one datagram each way. `out` gets what the servo said, which is nothing when no servo answered.
// How many bytes; -1 if the machine could not be reached or sent nothing back in time.
pub fn bus_exchange[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &r, &o](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], pkt: &r [byte], n: int, out: &!o [byte], wait_us: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let ours = k[4154];
    let peer = k[4262];
    let card = resolve(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, peer);
    if card < 0 {
        return -1;
    }
    var at = 0;
    if k[10] == 2 {
        at = 14;
    }
    // a port of ours not used a moment ago, so that a late answer to the last packet is not taken for this one's
    k[23] = k[23] + 1;
    let port = 49152 + k[23] % 16384;
    var m = inet.udp_packet(reply, at, ours, peer, port, k[4263], pkt, 0, n);
    if m > 0 && k[10] == 2 {
        m = inet.eth_frame(reply, m, card, k[19]);
    }
    if m <= 0 {
        return -1;
    }
    link_send(bus, vio, dma, k, reply, m, wire);
    // the other machine waits for the servo as long as this one would have, and then the answer crosses
    // the network: a fifth of a second more is allowed for that
    let asked = base.now_us(cpu);
    var got = -1;
    while got < 0 && base.now_us(cpu) - asked < wait_us + 200000 {
        let size = link_recv(bus, vio, dma, k, ns, frame);
        if size > 0 {
            var d = -1;
            if k[10] != 2 {
                d = inet.udp_data(frame, 0, size, ours, peer, k[4263], port);
            } else if size > 14 && inet.get16(frame, 12) == 2048 {
                d = inet.udp_data(frame, 14, size - 14, ours, peer, k[4263], port);
            }
            if d >= 0 {
                got = inet.udp_size(frame, d);
                if got > len(out) {
                    got = len(out);
                }
                var i = 0;
                while i < got {
                    out[i] = frame[d + i];
                    i = i + 1;
                }
            } else {
                net_take(bus, vio, dma, k, frame, size, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
            }
        }
    }
    return got;
}

pub fn net_lookup[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], name: &r [byte], from: int, to: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[4157] == 0 {
        base.puts(con, k, "no name server is known: `net dhcp` asks for one\r\n");
        return -1;
    }
    let ours = k[4154];
    let server = k[4157];
    let card = resolve(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, server);
    if card < 0 {
        return -1;
    }
    // the question's number and our port: from the generator if there is one, since whoever
    // guesses both can answer in the server's place
    var id = cpu_read(cpu, "cntvct_el0");
    if k[37] > 0 {
        k[37] = k[37] - 1;
        id = k[4136 + k[37]];
    }
    let port = 49152 + id / 65536 % 16384;
    var at = 0;
    if k[10] == 2 {
        at = 14;
    }
    var found = inet.dns_not_an_answer();
    var tries = 0;
    while tries < 2 && found == inet.dns_not_an_answer() {
        let q = inet.dns_question(wire, 0, id, name, from, to);
        if q < 0 {
            base.puts(con, k, "not a name: ");
            put_text(con, k, name, from, to);
            base.puts(con, k, "\r\n");
            return -1;
        }
        var m = inet.udp_packet(reply, at, ours, server, port, 53, wire, 0, q);
        if m > 0 && k[10] == 2 {
            m = inet.eth_frame(reply, m, card, k[19]);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
        }
        let asked = base.now_us(cpu);
        while found == inet.dns_not_an_answer() && base.now_us(cpu) - asked < 2000000 {
            let n = link_recv(bus, vio, dma, k, ns, frame);
            if n > 0 {
                var d = -1;
                if k[10] != 2 {
                    d = inet.udp_data(frame, 0, n, ours, server, 53, port);
                } else if n > 14 && inet.get16(frame, 12) == 2048 {
                    d = inet.udp_data(frame, 14, n - 14, ours, server, 53, port);
                }
                if d >= 0 {
                    found = inet.dns_address(frame, d, inet.udp_size(frame, d), id);
                } else {
                    net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
                }
            }
        }
        tries = tries + 1;
    }
    if found >= 0 {
        return found;
    }
    if found == inet.dns_no_such_name() {
        base.puts(con, k, "no such name: ");
        put_text(con, k, name, from, to);
    } else if found == inet.dns_no_address() {
        put_text(con, k, name, from, to);
        base.puts(con, k, " has no address the name server would give");
    } else {
        base.puts(con, k, "the name server ");
        put_address(con, k, server);
        base.puts(con, k, " did not answer");
    }
    base.puts(con, k, "\r\n");
    return -1;
}

// `a.b.c.d` or a name, at `text[from..to]`: its address, or -1 with the reason printed.
fn host[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], text: &r [byte], from: int, to: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let a = address(text, from, to);
    if a >= 0 {
        return a;
    }
    return net_lookup(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, text, from, to);
}

// `net dhcp`: ask whoever is on the network for an address (DISCOVER, the OFFER, REQUEST, the
// ACK), twice at most, five seconds for each answer (a home router took more than two
// to acknowledge). What the server says becomes the
// kernel's address, mask, gateway and name server.
pub fn net_dhcp[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte]) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    if k[10] != 2 {
        return base.puts(con, k, "an address is asked for on a network card: this link is not one, or it is down\r\n");
    }
    var xid = cpu_read(cpu, "cntvct_el0") % 4294967296;
    if k[37] > 0 {
        k[37] = k[37] - 1;
        xid = k[4136 + k[37]];
    }
    var given = 0;
    // how far the exchange got, for when it fails: the address offered, and what answered the request
    var offered_was = 0;
    var answer_was = -1;
    var server_was = 0;
    region r {
        let facts = alloc_slice[r](inet.dhcp_facts(), 0);
        var tries = 0;
        while tries < 2 && given == 0 {
            // who will give this card an address?
            var m = inet.dhcp_discover(reply, k[19], xid);
            if m > 0 {
                card_send(vio, dma, k, reply, m);
            }
            var what = -1;
            var asked = base.now_us(cpu);
            while what != 2 && base.now_us(cpu) - asked < 5000000 {
                let n = link_recv(bus, vio, dma, k, ns, frame);
                if n > 0 {
                    what = inet.dhcp_answer(frame, n, k[19], xid, facts);
                    if what < 0 {
                        net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
                    }
                }
            }
            if what == 2 && facts[0] != 0 {
                // the address offered is asked for, of the server that offered it
                let offered = facts[0];
                offered_was = offered;
                server_was = facts[4];
                m = inet.dhcp_request(reply, k[19], xid, offered, facts[4]);
                if m > 0 {
                    card_send(vio, dma, k, reply, m);
                }
                what = -1;
                asked = base.now_us(cpu);
                while what != 5 && what != 6 && base.now_us(cpu) - asked < 5000000 {
                    let n = link_recv(bus, vio, dma, k, ns, frame);
                    if n > 0 {
                        what = inet.dhcp_answer(frame, n, k[19], xid, facts);
                        if what < 0 {
                            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
                        }
                    }
                }
                answer_was = what;
                if what == 5 && facts[0] == offered {
                    given = 1;
                    k[4154] = facts[0];
                    k[4155] = facts[1];
                    if k[4155] == 0 {
                        k[4155] = 0xffffff00;
                    }
                    k[4156] = facts[2];
                    k[4157] = facts[3];
                    k[4158] = facts[5];
                    // whoever was remembered was a neighbour on the old network
                    k[21] = 0;
                }
            }
            tries = tries + 1;
        }
    }
    if given == 0 && offered_was != 0 {
        put_address(con, k, offered_was);
        base.puts(con, k, " was offered by ");
        put_address(con, k, server_was);
        base.puts(con, k, ", but asking for it got ");
        if answer_was == 6 {
            base.puts(con, k, "a refusal");
        } else if answer_was == 5 {
            base.puts(con, k, "an acknowledgement of another address");
        } else {
            base.puts(con, k, "no answer");
        }
        return base.puts(con, k, "; the kernel keeps the address it had\r\n");
    }
    if given == 0 {
        return base.puts(con, k, "nobody on this network gave an address; the kernel keeps the one it had\r\n");
    }
    base.puts(con, k, "address ");
    put_address(con, k, k[4154]);
    base.puts(con, k, ", mask ");
    put_address(con, k, k[4155]);
    base.puts(con, k, ", gateway ");
    put_address(con, k, k[4156]);
    base.puts(con, k, ", names from ");
    put_address(con, k, k[4157]);
    base.puts(con, k, "\r\nit is lent for ");
    base.put_dec(con, k, k[4158]);
    return base.puts(con, k, " s, and the kernel does not ask again when that is over\r\n");
}

fn begins[&r, &w](text: &r [byte], n: int, word: &w [byte]) -> [] bool {
    if n < len(word) {
        return false;
    }
    var i = 0;
    while i < len(word) {
        if int_of(text[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The commands that use the network, for the shell: `ping`, `http`, `lookup`, `net dhcp`.
// 1 if `text[0..n]` was one of them and has been run, 0 if it is another command.
// `rline` is the line being typed over the shell's connection, which `http` must leave
// alone while it waits; `text` is never that buffer.
pub fn net_command[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l, &r, &mr, &mw](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rng: &!mr Mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), fw: &!mw Mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4"), rline: &!l [byte], text: &r [byte], n: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), mmio("0x3f104000..0x3f10400c,0xfe104000..0xfe104028"), mmio("0x3f00b880..0x3f00b8a4,0xfe00b880..0xfe00b8a4")] int {
    if n == 13 && begins(text, n, "servo via off") {
        k[4262] = 0;
        base.puts(con, k, "the servo bus is this board's own again\r\n");
        return 1;
    }
    if n > 10 && begins(text, n, "servo via ") {
        // `servo via <address> <port>`: the bus is another machine's, which passes packets on (docs/netbus.md)
        var sp = 10;
        while sp < n && int_of(text[sp]) != ' ' {
            sp = sp + 1;
        }
        let to = address(text, 10, sp);
        var port = 0;
        var i = sp + 1;
        var digits = i < n;
        while i < n && digits {
            let c = int_of(text[i]);
            digits = c >= '0' && c <= '9' && port < 65536;
            port = port * 10 + c - '0';
            i = i + 1;
        }
        if k[26] != 0 {
            base.puts(con, k, "only from the serial console\r\n");
        } else if to <= 0 || !digits || port <= 0 || port > 65535 {
            base.puts(con, k, "usage: servo via <address> <port>, or servo via off\r\n");
        } else if k[10] == 0 {
            base.puts(con, k, "the network is down: `net up` or `net eth` first\r\n");
        } else {
            k[4262] = to;
            k[4263] = port;
            base.puts(con, k, "the servo bus is the one at ");
            put_address(con, k, to);
            base.puts(con, k, " port ");
            base.put_dec(con, k, port);
            base.puts(con, k, ": packets that read, passed on by that machine\r\n");
        }
        return 1;
    }
    if n == 10 && begins(text, n, "net ssh on") {
        if k[26] != 0 {
            base.puts(con, k, "only from the serial console\r\n");
        } else if k[34] == 0 {
            base.puts(con, k, "not without random numbers: with guessable ones SSH protects nothing (on a Pi 4, `net eth` starts the generator)\r\n");
        } else {
            k[30] = 22;
            k[4153] = 1;
            k[29] = 0;
            base.puts(con, k, "ssh is on port 22; keys built into this image that may log in: ");
            base.put_dec(con, k, k[4180]);
            if k[4164] > k[4180] {
                base.puts(con, k, ", and from KEYS.TXT on the disk: ");
                base.put_dec(con, k, k[4164] - k[4180]);
            }
            if k[4182] != 0 {
                base.puts(con, k, " (");
                base.put_dec(con, k, k[4182]);
                base.puts(con, k, " lines of it are not keys, or there was no room)");
            }
            if k[4164] == 0 {
                base.puts(con, k, " (so nobody can: AUTHORIZED=key.pub ./build.sh)");
            }
            base.puts(con, k, "\r\n");
        }
        return 1;
    }
    if n == 11 && begins(text, n, "net ssh off") {
        k[4174] = k[30];
        k[30] = 0;
        k[4153] = 0;
        base.puts(con, k, "port 22 is closed\r\n");
        return 1;
    }
    if n == 5 && begins(text, n, "board") {
        put_board(con, fw, dma, k);
        return 1;
    }
    if n > 12 && begins(text, n, "net address ") {
        // an address by hand, on a network of 256, with no gateway: for a network that gives none
        let a = address(text, 12, n);
        if a < 0 {
            base.puts(con, k, "usage: net address <a.b.c.d>\r\n");
            return 1;
        }
        k[4154] = a;
        k[4155] = 0xffffff00;
        k[4156] = 0;
        k[21] = 0;
        put_net(con, k);
        return 1;
    }
    if n == 7 && begins(text, n, "net eth") {
        net_eth(cpu, con, vio, dma, rng, fw, k);
        return 1;
    }
    if n == 8 && begins(text, n, "net dhcp") {
        net_dhcp(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox);
        return 1;
    }
    if n > 7 && begins(text, n, "lookup ") {
        let a = net_lookup(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, text, 7, n);
        if a >= 0 {
            put_text(con, k, text, 7, n);
            base.puts(con, k, " is ");
            put_address(con, k, a);
            base.puts(con, k, "\r\n");
        }
        return 1;
    }
    if n > 5 && begins(text, n, "ping ") {
        if k[10] == 0 {
            base.puts(con, k, "the link is down: `net up` first\r\n");
            return 1;
        }
        net_ping(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, host(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, text, 5, n));
        return 1;
    }
    if n > 5 && begins(text, n, "http ") {
        if k[10] == 0 {
            base.puts(con, k, "the link is down: `net up` first\r\n");
            return 1;
        }
        // the port is what follows the last space
        var sp = n - 1;
        while sp > 5 && int_of(text[sp]) != ' ' {
            sp = sp - 1;
        }
        var port = 0;
        var i = sp + 1;
        while i < n && port >= 0 {
            let c = int_of(text[i]);
            if c < '0' || c > '9' || port > 6553 {
                port = -1;
            } else {
                port = port * 10 + c - '0';
            }
            i = i + 1;
        }
        if sp <= 5 || port < 1 || port > 65535 {
            base.puts(con, k, "usage: http <address or name> <port>\r\n");
            return 1;
        }
        let a = host(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, text, 5, sp);
        if a >= 0 {
            net_http(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, a * 65536 + port, text, 5, sp);
        }
        return 1;
    }
    return 0;
}

pub fn put_net[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048")] int {
    if k[10] == 0 && k[9] == 0 && k[15] == 0 {
        base.puts(con, k, "no network card, and no second serial port");
    } else if k[10] == 0 {
        base.puts(con, k, "link down");
    } else if k[10] == 2 {
        if k[1] == 4 {
            base.puts(con, k, "link up: the Pi 4's Ethernet, card ");
        } else {
            base.puts(con, k, "link up: virtio-net, card ");
        }
        var shift = 40;
        while shift >= 0 {
            base.put_hex(con, k, k[19] >> shift + 4 & 15);
            base.put_hex(con, k, k[19] >> shift & 15);
            if shift > 0 {
                base.puts(con, k, ":");
            }
            shift = shift - 8;
        }
        base.puts(con, k, ", address ");
        put_address(con, k, k[4154]);
    } else {
        base.puts(con, k, "link up: SLIP on the second serial port, address ");
        put_address(con, k, k[4154]);
    }
    base.puts(con, k, "\r\n");
    if k[10] == 2 {
        base.puts(con, k, "gateway ");
        if k[4156] != 0 {
            put_address(con, k, k[4156]);
        } else {
            base.puts(con, k, "none");
        }
        base.puts(con, k, ", names from ");
        if k[4157] != 0 {
            put_address(con, k, k[4157]);
        } else {
            base.puts(con, k, "nobody (`net dhcp` asks for a name server)");
        }
        base.puts(con, k, "\r\n");
    }
    base.put_dec(con, k, k[11]);
    base.puts(con, k, " packets answered, ");
    base.put_dec(con, k, k[12]);
    base.puts(con, k, " dropped");
    if k[12] != 0 {
        base.puts(con, k, " (the last: ");
        if k[13] == inet.drop_short() {
            base.puts(con, k, "cut short");
        } else if k[13] == inet.drop_not_ipv4() {
            base.puts(con, k, "not IPv4");
        } else if k[13] == inet.drop_bad_header_checksum() {
            base.puts(con, k, "header checksum");
        } else if k[13] == inet.drop_not_ours() {
            base.puts(con, k, "for another address");
        } else if k[13] == inet.drop_fragment() {
            base.puts(con, k, "a fragment");
        } else if k[13] == inet.drop_bad_checksum() {
            base.puts(con, k, "checksum");
        } else if k[13] == inet.drop_not_our_frame() {
            base.puts(con, k, "a frame for another card");
        } else if k[13] == inet.drop_too_long() {
            base.puts(con, k, "too long");
        } else {
            base.puts(con, k, "nothing here answers it");
        }
        base.puts(con, k, ")");
    }
    base.puts(con, k, "\r\n");
    if k[34] != 0 && k[37] > 0 {
        base.puts(con, k, "connections begin at a random number (");
        put_rng_name(con, k);
        base.puts(con, k, ")\r\n");
    } else {
        base.puts(con, k, "connections begin at the counter's value: it can be guessed\r\n");
    }
    if k[30] != 0 && k[4153] == 1 {
        base.puts(con, k, "ssh on port 22: ");
        if k[29] != 0 {
            base.puts(con, k, "a session is open\r\n");
        } else {
            base.puts(con, k, "nobody connected\r\n");
        }
    }
    if k[4262] != 0 {
        base.puts(con, k, "servo bus: through ");
        put_address(con, k, k[4262]);
        base.puts(con, k, " port ");
        base.put_dec(con, k, k[4263]);
        base.puts(con, k, "\r\n");
    }
    if k[20] != 0 || k[24] != 0 || k[25] != 0 {
        base.puts(con, k, "tcp: ");
        base.put_dec(con, k, k[24]);
        base.puts(con, k, " open, ");
        base.put_dec(con, k, k[20]);
        base.puts(con, k, " segments taken without a reply, ");
        base.put_dec(con, k, k[25]);
        base.puts(con, k, " sent again\r\n");
    }
    return 0;
}

