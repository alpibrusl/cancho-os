edition 14;

module network;

import base;
import inet;

// network.cho -- the kernel's side of the network: the two links (SLIP on the second serial
// port, a virtio card), the board's random number generator, the shell over a connection,
// and the commands that speak first. Everything about packets is src/inet.cho, which holds
// no hardware; this is the part that moves bytes. Split from kernel.cho; `k` is the
// kernel's state, which kernel.cho lists.

// ---- the network link ---------------------------------------------------------------
// IPv4 over the second serial port, framed with SLIP (docs/network.md). The port is the
// servo bus's: `net up` gives it to the network, `net down` gives it back, and the servo
// commands refuse while it is up. Everything about packets is src/inet.cho, which holds
// no hardware; this is the part that moves bytes.

// 10.0.0.2. The other end of the line is whoever is there; SLIP has no addresses.
pub fn net_address() -> [] int {
    return 10 * 16777216 + 2;
}

// The next whole packet from the line, in `frame`: its length, or 0 if there is none yet.
// At most 256 bytes are taken at once.
pub fn slip_recv[&mu, &s, &n, &a](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), k: &!s [int], ns: &!n [int], frame: &!a [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c")] int {
    var budget = 256;
    while budget > 0 {
        let c = base.bus_get(bus, k);
        if c < 0 {
            return 0;
        }
        budget = budget - 1;
        let got = inet.slip_feed(ns, frame, c);
        if got > 0 {
            return got;
        }
    }
    return 0;
}

// ---- the network card: virtio-net ---------------------------------------------------
// QEMU's virt machine has 32 places for a virtio device, 0x200 apart; a network card says
// device 1 (VIRTIO 1.2, section 4.2 for the registers, 5.1 for the card, 2.7 for a queue).
// The card and the driver share memory: two queues of eight entries, one to receive and
// one to send. A queue is three tables: descriptors (where a buffer is, how long), the
// ring of buffers offered to the card, and the ring of buffers it has finished with.
// That memory is `dma`, and nothing else is in it:
//     +0x0000 receive queue: descriptors, +0x100 offered, +0x200 finished
//     +0x0400 send queue, the same three
//     +0x1000 eight receive buffers of 2 KB     +0x5000 one send buffer
// Every packet has 12 bytes of the card's own header in front, all zero here.
// No interrupt is used: `vnet_poll` looks at the finished ring.

pub fn put16le[&md](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), at: int, v: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    mmio_write8(dma, at, v & 255);
    return mmio_write8(dma, at + 1, v >> 8 & 255);
}

pub fn get16le[&md](dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), at: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000")] int {
    return mmio_read8(dma, at) | mmio_read8(dma, at + 1) << 8;
}

// Tell the card where queue `q`'s three tables are (they start at `at`), and that it is ready.
pub fn vnet_queue[&mv](vio: &!mv Mmio("0xa000000..0xa004000"), base: int, q: int, at: int) -> [mmio("0xa000000..0xa004000")] int {
    mmio_write32(vio, base + 0x30, q);
    if mmio_read32(vio, base + 0x34) < 8 {
        return 1;
    }
    mmio_write32(vio, base + 0x38, 8);
    mmio_write32(vio, base + 0x80, at & 0xffffffff);
    mmio_write32(vio, base + 0x84, at >> 32);
    mmio_write32(vio, base + 0x90, at + 0x100 & 0xffffffff);
    mmio_write32(vio, base + 0x94, at >> 32);
    mmio_write32(vio, base + 0xa0, at + 0x200 & 0xffffffff);
    mmio_write32(vio, base + 0xa4, at >> 32);
    mmio_write32(vio, base + 0x44, 1);
    return 0;
}

// Find the card and bring it up. k[15] is its registers afterwards, or 0 if there is none
// or it refused; k[19] is its address.
pub fn vnet_start[&mv, &md, &s](vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    var base = 0;
    var slot = 0;
    while slot < 32 && base == 0 {
        let at = 0xa000000 + slot * 0x200;
        // "virt", version 2 (not the legacy interface), device 1
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 1 {
            base = at;
        }
        slot = slot + 1;
    }
    if base == 0 {
        return 1;
    }
    let d = k[14] + 0x210000;
    var z = 0;
    while z < 0x1000 {
        mmio_write64(dma, d + z, 0);
        z = z + 8;
    }
    // reset; then "I see you" (1), "I can drive you" (2)
    mmio_write32(vio, base + 0x70, 0);
    mmio_write32(vio, base + 0x70, 1);
    mmio_write32(vio, base + 0x70, 3);
    // of what the card offers, two things are taken: its address in its configuration
    // (bit 5) and the current version of the interface (bit 32)
    mmio_write32(vio, base + 0x14, 0);
    let low = mmio_read32(vio, base + 0x10);
    mmio_write32(vio, base + 0x14, 1);
    let high = mmio_read32(vio, base + 0x10);
    if low & 32 == 0 || high & 1 == 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    mmio_write32(vio, base + 0x24, 0);
    mmio_write32(vio, base + 0x20, 32);
    mmio_write32(vio, base + 0x24, 1);
    mmio_write32(vio, base + 0x20, 1);
    mmio_write32(vio, base + 0x70, 11);
    if mmio_read32(vio, base + 0x70) & 8 == 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    // every receive buffer is offered: the card may write (2) 2 KB at each
    var i = 0;
    while i < 8 {
        mmio_write64(dma, d + i * 16, d + 0x1000 + i * 0x800);
        mmio_write32(dma, d + i * 16 + 8, 0x800);
        put16le(dma, d + i * 16 + 12, 2);
        put16le(dma, d + 0x104 + i * 2, i);
        i = i + 1;
    }
    put16le(dma, d + 0x102, 8);
    k[16] = 8;
    k[17] = 0;
    k[18] = 0;
    if vnet_queue(vio, base, 0, d) != 0 || vnet_queue(vio, base, 1, d + 0x400) != 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    mmio_write32(vio, base + 0x70, 15);
    mmio_write32(vio, base + 0x50, 0);
    var mac = 0;
    var b = 0;
    while b < 6 {
        mac = mac << 8 | mmio_read8(vio, base + 0x100 + b);
        b = b + 1;
    }
    k[19] = mac;
    k[15] = base;
    return 0;
}

// Send `frame[0..n]`, and wait until the card has taken it.
pub fn vnet_send[&mv, &md, &s, &b](vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &b [byte], n: int) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    let d = k[14] + 0x210000;
    let buf = d + 0x5000;
    mmio_write64(dma, buf, 0);
    mmio_write32(dma, buf + 8, 0);
    var i = 0;
    while i < n {
        mmio_write8(dma, buf + 12 + i, int_of(frame[i]));
        i = i + 1;
    }
    mmio_write64(dma, d + 0x400, buf);
    mmio_write32(dma, d + 0x408, 12 + n);
    put16le(dma, d + 0x40c, 0);
    put16le(dma, d + 0x504 + k[18] % 8 * 2, 0);
    k[18] = (k[18] + 1) % 65536;
    put16le(dma, d + 0x502, k[18]);
    mmio_write32(vio, k[15] + 0x50, 1);
    var spins = 0;
    while get16le(dma, d + 0x602) != k[18] && spins < 1000000 {
        spins = spins + 1;
    }
    return 0;
}

// The next frame the card has finished with, in `frame`: its length, or 0 if there is none.
// Its buffer is offered to the card again.
pub fn vnet_recv[&mv, &md, &s, &a](vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    let d = k[14] + 0x210000;
    var got = 0;
    while got == 0 && get16le(dma, d + 0x202) != k[17] {
        let entry = d + 0x204 + k[17] % 8 * 8;
        let id = mmio_read32(dma, entry) & 7;
        let n = mmio_read32(dma, entry + 4) - 12;
        if n > 0 && n <= len(frame) {
            var i = 0;
            while i < n {
                frame[i] = byte_of(mmio_read8(dma, d + 0x1000 + id * 0x800 + 12 + i));
                i = i + 1;
            }
            got = n;
        }
        put16le(dma, d + 0x104 + k[16] % 8 * 2, id);
        k[16] = (k[16] + 1) % 65536;
        put16le(dma, d + 0x102, k[16]);
        k[17] = (k[17] + 1) % 65536;
        mmio_write32(vio, k[15] + 0x50, 0);
    }
    // the card raises its interrupt line for each; nobody listens, and this lowers it
    let raised = mmio_read32(vio, k[15] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[15] + 0x64, raised);
    }
    return got;
}

// ---- randomness ------------------------------------------------------------------------
// Numbers nobody outside can guess, from the board's own generator (docs/random.md):
// on QEMU's virt a virtio device (number 4), which fills a buffer it is offered; on a Pi 3
// the BCM2835 generator (control +0, status +4 with the words ready in its top byte,
// data +8). A Pi 4 has another (the RNG200), which QEMU's Pi 4 does not have: no driver
// for it yet, and there the kernel has no randomness.
// k[34] says which (0: none), k[35] where. The virtio queue is in `dma`, after the
// network card's: +0x6000 its three tables, +0x6400 the buffer.

pub fn rng_start[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    if k[1] == 3 {
        k[35] = 0x3f104000;
        // the first words are to be thrown away: this many, the chip's own advice
        mmio_write32(rng, k[35] + 4, 0x40000);
        mmio_write32(rng, k[35], 1);
        k[34] = 3;
        return 0;
    }
    if k[1] != 1 {
        return 1;
    }
    var base = 0;
    var slot = 0;
    while slot < 32 && base == 0 {
        let at = 0xa000000 + slot * 0x200;
        if mmio_read32(vio, at) == 0x74726976 && mmio_read32(vio, at + 4) == 2 && mmio_read32(vio, at + 8) == 4 {
            base = at;
        }
        slot = slot + 1;
    }
    if base == 0 {
        return 1;
    }
    let d = k[14] + 0x216000;
    var z = 0;
    while z < 0x800 {
        mmio_write64(dma, d + z, 0);
        z = z + 8;
    }
    mmio_write32(vio, base + 0x70, 0);
    mmio_write32(vio, base + 0x70, 1);
    mmio_write32(vio, base + 0x70, 3);
    // nothing is asked of the device but the current version of the interface (bit 32)
    mmio_write32(vio, base + 0x24, 0);
    mmio_write32(vio, base + 0x20, 0);
    mmio_write32(vio, base + 0x24, 1);
    mmio_write32(vio, base + 0x20, 1);
    mmio_write32(vio, base + 0x70, 11);
    if mmio_read32(vio, base + 0x70) & 8 == 0 || vnet_queue(vio, base, 0, d) != 0 {
        mmio_write32(vio, base + 0x70, 128);
        return 1;
    }
    // one buffer of 16 bytes, which the device may write (2)
    mmio_write64(dma, d, d + 0x400);
    mmio_write32(dma, d + 8, 16);
    put16le(dma, d + 12, 2);
    mmio_write32(vio, base + 0x70, 15);
    k[36] = 0;
    k[35] = base;
    k[34] = 1;
    return 0;
}

// One word of 32 bits from the generator, or -1 if it gave none in time.
pub fn rng_word[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    var spins = 0;
    if k[34] == 3 {
        while mmio_read32(rng, k[35] + 4) >> 24 == 0 && spins < 1000000 {
            spins = spins + 1;
        }
        if mmio_read32(rng, k[35] + 4) >> 24 == 0 {
            return -1;
        }
        return mmio_read32(rng, k[35] + 8);
    }
    if k[34] != 1 {
        return -1;
    }
    let d = k[14] + 0x216000;
    // offer the buffer, say so, and wait for it to come back
    put16le(dma, d + 0x104 + k[36] % 8 * 2, 0);
    k[36] = (k[36] + 1) % 65536;
    put16le(dma, d + 0x102, k[36]);
    mmio_write32(vio, k[35] + 0x50, 0);
    while get16le(dma, d + 0x202) != k[36] && spins < 1000000 {
        spins = spins + 1;
    }
    let raised = mmio_read32(vio, k[35] + 0x60);
    if raised != 0 {
        mmio_write32(vio, k[35] + 0x64, raised);
    }
    if get16le(dma, d + 0x202) != k[36] {
        return -1;
    }
    // how many bytes the device says it wrote
    if mmio_read32(dma, d + 0x204 + (k[36] + 7) % 8 * 8 + 4) < 4 {
        return -1;
    }
    return mmio_read32(dma, d + 0x400);
}

// Keep 16 words ready at k[4136..]; k[37] is how many there are. What needs one takes it
// from there, and so needs no capability.
pub fn rng_fill[&mr, &mv, &md, &s](rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    while k[34] != 0 && k[37] < 16 {
        let w = rng_word(rng, vio, dma, k);
        if w < 0 {
            return 1;
        }
        k[4136 + k[37]] = w;
        k[37] = k[37] + 1;
    }
    return 0;
}

pub fn put_rng_name[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if k[34] == 1 {
        return base.puts(con, k, "virtio-rng");
    }
    return base.puts(con, k, "the BCM2835 generator");
}

// `random`: sixteen bytes straight from the generator, and which one it is.
pub fn put_random[&mc, &mr, &mv, &md, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), rng: &!mr Mmio("0x3f104000..0x3f10400c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x3f104000..0x3f10400c"), mmio("0xa000000..0xa004000")] int {
    if k[34] == 0 {
        return base.puts(con, k, "this board gave the kernel no source of randomness\r\n");
    }
    base.puts(con, k, "random (");
    put_rng_name(con, k);
    base.puts(con, k, "): ");
    var i = 0;
    while i < 4 {
        let w = rng_word(rng, vio, dma, k);
        if w < 0 {
            return base.puts(con, k, " the generator gave nothing\r\n");
        }
        var shift = 28;
        while shift >= 0 {
            base.put_hex(con, k, w >> shift & 15);
            shift = shift - 4;
        }
        i = i + 1;
    }
    return base.puts(con, k, "\r\n");
}

// ---- the two links as one -----------------------------------------------------------
// What arrives is a frame on the card and a bare packet on the serial line; `inet` has
// a function for each, and these four are where the kernel chooses.

pub fn link_recv[&mu, &mv, &md, &s, &n, &a](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 2 {
        return vnet_recv(vio, dma, k, frame);
    }
    return slip_recv(bus, k, ns, frame);
}

pub fn link_send[&mu, &mv, &md, &s, &b, &w](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], pkt: &b [byte], n: int, wire: &!w [byte]) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 2 {
        return vnet_send(vio, dma, k, pkt, n);
    }
    let w = inet.slip_encode(pkt, n, wire);
    var i = 0;
    while i < w {
        base.bus_put(bus, k, int_of(wire[i]));
        i = i + 1;
    }
    return 0;
}

// What arrived, `frame[0..n]`, given to `inet`, and its answer sent. `iss` is where a new
// connection's sequence numbers start if the pool of random words is empty: the counter's
// value, which is not a secret.
pub fn net_take[&mu, &mv, &md, &s, &a, &b, &w, &t, &g, &h](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], frame: &!a [byte], n: int, reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    var m = 0;
    // a word nobody can guess, if the board has given any; else the counter
    var first = iss;
    if k[37] > 0 {
        first = k[4136 + k[37] - 1];
    }
    var at = 0;
    if k[10] == 2 {
        at = 14;
        m = inet.eth_serve(frame, n, k[19], net_address(), tcp, bufs, inbox, k[30], now, first, reply);
    } else {
        m = inet.serve(frame, n, net_address(), tcp, bufs, inbox, k[30], now, first, reply);
    }
    if k[37] > 0 && m >= at + 40 && int_of(reply[at + 9]) == 6 && int_of(reply[at + 33]) == 18 {
        // the reply opens a connection (SYN and ACK): it began at that word, which is not used again
        k[37] = k[37] - 1;
        k[38] = k[38] + 1;
    }
    if m > 0 {
        link_send(bus, vio, dma, k, reply, m, wire);
        k[11] = k[11] + 1;
    } else if m == 0 {
        k[20] = k[20] + 1;
    } else {
        k[12] = k[12] + 1;
        k[13] = m;
    }
    if k[29] != 0 && inet.tcp_state(tcp, k[29] - 1) != 2 && inet.tcp_state(tcp, k[29] - 1) != 3 {
        // the shell's connection has gone: what it had typed and what waited for it go with it
        k[29] = 0;
        k[27] = 0;
        k[28] = 0;
        k[31] = 0;
        k[32] = 0;
        k[4152] = 0;
    }
    return 0;
}

// ---- the shell over a connection -----------------------------------------------------
// Port 23, when `net shell on` has opened it (docs/network.md, section 8). One connection
// at a time has the shell; another waits, unread. This function moves bytes between that
// connection and two things in the kernel: the line being typed there (`rline`, k[31]
// bytes of it) and the output waiting for it (k[40..], k[27] of it; `putc` fills it).
// It touches no hardware. Answers 1 when a whole line is in `rline`, 2 when a connection
// has just been given the shell and should be greeted, 0 otherwise.
pub fn session[&s, &t, &g, &h, &l, &w](k: &!s [int], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], wire: &!w [byte], now: int) -> [] int {
    if k[29] != 0 && inet.tcp_state(tcp, k[29] - 1) != 2 && inet.tcp_state(tcp, k[29] - 1) != 3 {
        // the shell's connection has gone
        k[29] = 0;
        k[27] = 0;
        k[28] = 0;
        k[31] = 0;
        k[32] = 0;
        k[4152] = 0;
    }
    if k[30] == 0 || k[39] != 0 {
        // the port is closed; or a command is itself waiting on the network, and the line it was typed
        // on must not be read further meanwhile
        return 0;
    }
    if k[29] == 0 {
        var c = 0;
        while c < inet.tcp_count(tcp, bufs, inbox) && k[29] == 0 {
            if inet.tcp_port(tcp, c) == k[30] && (inet.tcp_state(tcp, c) == 2 || inet.tcp_state(tcp, c) == 3) {
                k[29] = c + 1;
            }
            c = c + 1;
        }
        if k[29] == 0 {
            return 0;
        }
        return 2;
    }
    let c = k[29] - 1;
    if k[27] > 0 {
        // output first: as much as the connection has room for
        var n = k[27];
        if n > len(wire) {
            n = len(wire);
        }
        var i = 0;
        while i < n {
            wire[i] = byte_of(k[40 + i] & 255);
            i = i + 1;
        }
        let took = inet.tcp_write(tcp, bufs, c, wire, 0, n);
        i = took;
        while i < k[27] {
            k[40 + i - took] = k[40 + i];
            i = i + 1;
        }
        k[27] = k[27] - took;
    }
    if k[27] > 0 {
        // nothing more is read until what was said has gone
        return 0;
    }
    if k[4152] != 0 || inet.tcp_quiet(tcp, c, now) > 300000 {
        // `exit` was typed there, or nothing has been for five minutes: the kernel hangs up
        k[4152] = 0;
        inet.tcp_close(tcp, c);
        return 0;
    }
    while inet.tcp_read(tcp, inbox, c, wire, 1) == 1 {
        let ch = int_of(wire[0]);
        if k[28] > 0 {
            // the two bytes after a telnet client's 255: an option it asks about, not answered
            k[28] = k[28] - 1;
        } else if ch == 255 {
            k[28] = 2;
        } else if ch == 10 && k[32] != 0 {
            // the line feed of a carriage return and line feed: the line ended at the first
            k[32] = 0;
        } else if ch == 13 || ch == 10 {
            k[32] = 0;
            if ch == 13 {
                k[32] = 1;
            }
            return 1;
        } else {
            k[32] = 0;
            if ch >= 32 && ch < 127 && k[31] < len(rline) {
                rline[k[31]] = byte_of(ch);
                k[31] = k[31] + 1;
            }
        }
    }
    if inet.tcp_state(tcp, c) == 3 {
        // the other end has finished, and everything it sent has been answered: we finish too
        inet.tcp_close(tcp, c);
    }
    return 0;
}

// Take what has arrived, at most eight packets, and answer each; move the shell's bytes;
// then send again whatever a connection has had out too long, and whatever is new.
// Answers what `session` does.
pub fn net_poll[&mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l](bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], now: int, iss: int) -> [mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    var budget = 8;
    while budget > 0 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n == 0 {
            budget = 0;
        } else {
            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, now, iss);
            budget = budget - 1;
        }
    }
    let ready = session(k, tcp, bufs, inbox, rline, wire, now);
    var c = 0;
    while c < inet.tcp_count(tcp, bufs, inbox) {
        var m = 0;
        if k[10] == 2 {
            m = inet.eth_tick(tcp, bufs, c, now, k[19], net_address(), reply);
        } else {
            m = inet.tcp_tick(tcp, bufs, c, now, net_address(), reply, 0);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
            k[25] = k[25] + 1;
        }
        // and what the shell's connection has to send that it has not sent
        if k[10] == 2 {
            m = inet.eth_flush(tcp, bufs, c, now, k[19], net_address(), reply);
        } else {
            m = inet.tcp_flush(tcp, bufs, c, now, net_address(), reply, 0);
        }
        if m > 0 {
            link_send(bus, vio, dma, k, reply, m, wire);
        }
        c = c + 1;
    }
    k[24] = inet.tcp_open(tcp, bufs, inbox);
    return ready;
}

// `a.b.c.d` at `line[from..n]` as a number, or -1.
pub fn address[&r](line: &r [byte], from: int, n: int) -> [] int {
    var value = 0;
    var part = 0;
    var parts = 0;
    var digits = 0;
    var i = from;
    while i < n {
        let c = int_of(line[i]);
        if c >= '0' && c <= '9' && digits < 3 {
            part = part * 10 + c - '0';
            digits = digits + 1;
        } else if c == '.' && digits > 0 && part < 256 && parts < 3 {
            value = value * 256 + part;
            part = 0;
            digits = 0;
            parts = parts + 1;
        } else {
            return -1;
        }
        i = i + 1;
    }
    if parts != 3 || digits == 0 || part > 255 {
        return -1;
    }
    return value * 256 + part;
}

pub fn put_address[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int], a: int) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    base.put_dec(con, k, a >> 24 & 255);
    base.puts(con, k, ".");
    base.put_dec(con, k, a >> 16 & 255);
    base.puts(con, k, ".");
    base.put_dec(con, k, a >> 8 & 255);
    base.puts(con, k, ".");
    return base.put_dec(con, k, a & 255);
}

// Whose card has `target`? Asked of every card (ARP), unless it is the neighbour already
// remembered. Its card's address; 0 on the serial line, which has none; -1 if nobody answers
// within a second. Whatever else arrives meanwhile is answered as always.
pub fn resolve[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], target: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] != 2 {
        return 0;
    }
    if k[21] == target {
        return k[22];
    }
    let ours = net_address();
    let q = inet.arp_request(reply, k[19], ours, target);
    if q > 0 {
        vnet_send(vio, dma, k, reply, q);
    }
    let asked = base.now_us(cpu);
    var card = -1;
    while card < 0 && base.now_us(cpu) - asked < 1000000 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n > 0 {
            card = inet.arp_answer_from(frame, n, k[19], ours, target);
            if card < 0 {
                net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
            }
        }
    }
    if card < 0 {
        base.puts(con, k, "nobody on this network says they are ");
        put_address(con, k, target);
        base.puts(con, k, "\r\n");
        return -1;
    }
    k[21] = target;
    k[22] = card;
    return card;
}

// `<a.b.c.d> <port>` at `line[from..n]`: the address times 65536, plus the port. -1 if it is not that.
pub fn address_and_port[&r](line: &r [byte], from: int, n: int) -> [] int {
    var sp = from;
    while sp < n && int_of(line[sp]) != ' ' {
        sp = sp + 1;
    }
    let a = address(line, from, sp);
    var port = 0;
    var i = sp + 1;
    if a < 0 || i >= n {
        return -1;
    }
    while i < n {
        let c = int_of(line[i]);
        if c < '0' || c > '9' || port > 6553 {
            return -1;
        }
        port = port * 10 + c - '0';
        i = i + 1;
    }
    if port < 1 || port > 65535 {
        return -1;
    }
    return a * 65536 + port;
}

// `http <address> <port>`: the kernel opens a connection, asks for `/` in HTTP/1.0, and
// prints what comes back until the other end finishes, for at most five seconds. The
// shell waits meanwhile; the network is served as always.
pub fn net_http[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &l](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], rline: &!l [byte], dest: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 0 {
        return base.puts(con, k, "the link is down: `net up` first\r\n");
    }
    if dest < 0 {
        return base.puts(con, k, "usage: http <a.b.c.d> <port>\r\n");
    }
    let target = dest / 65536;
    let card = resolve(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, target);
    if card < 0 {
        return 0;
    }
    // a number nobody can guess to begin at, if there is one; and a port of ours not used a moment ago
    var first = cpu_read(cpu, "cntvct_el0");
    if k[37] > 0 {
        k[37] = k[37] - 1;
        first = k[4136 + k[37]];
    }
    k[23] = k[23] + 1;
    let c = inet.tcp_dial(tcp, bufs, inbox, target, dest % 65536, 49152 + k[23] % 16384, base.uptime_ms(cpu), first, card);
    if c < 0 {
        return base.puts(con, k, "no room for another connection\r\n");
    }
    let began = base.uptime_ms(cpu);
    var opened = false;
    var printed = 0;
    k[39] = 1;
    while inet.tcp_state(tcp, c) != 0 && base.uptime_ms(cpu) - began < 5000 {
        net_poll(bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, rline, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
        let state = inet.tcp_state(tcp, c);
        if state == 2 && !opened {
            opened = true;
            inet.tcp_write(tcp, bufs, c, "GET / HTTP/1.0\r\n\r\n", 0, 18);
        }
        let n = inet.tcp_read(tcp, inbox, c, wire, 256);
        var i = 0;
        while i < n {
            let ch = int_of(wire[i]);
            if ch == 10 {
                base.puts(con, k, "\r\n");
            } else if ch >= 32 && ch < 127 {
                base.putc(con, k, ch);
            } else if ch != 13 {
                base.putc(con, k, '.');
            }
            i = i + 1;
        }
        printed = printed + n;
        if state == 3 && n == 0 {
            // the other end has finished and all of it is printed: we finish too
            inet.tcp_close(tcp, c);
        }
    }
    if inet.tcp_state(tcp, c) != 0 {
        // five seconds: hang up, and let the closing happen behind the shell
        inet.tcp_close(tcp, c);
    }
    k[39] = 0;
    if !opened {
        base.puts(con, k, "no connection to ");
        put_address(con, k, target);
        base.puts(con, k, " port ");
        base.put_dec(con, k, dest % 65536);
        return base.puts(con, k, ": refused, or no answer\r\n");
    }
    base.puts(con, k, "\r\n[");
    base.put_dec(con, k, printed);
    return base.puts(con, k, " bytes]\r\n");
}

// `ping <address>`: the kernel speaks first. An echo request, and the time to its reply.
// On the card the address must first be asked for (ARP); the last answer is remembered.
// Whatever else arrives meanwhile is answered as always.
pub fn net_ping[&f, &mc, &mu, &mv, &md, &s, &n, &a, &b, &w, &t, &g, &h, &r](cpu: &!f Cpu, con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), bus: &!mu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), vio: &!mv Mmio("0xa000000..0xa004000"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], ns: &!n [int], frame: &!a [byte], reply: &!b [byte], wire: &!w [byte], tcp: &!t [int], bufs: &!g [byte], inbox: &!h [byte], line: &r [byte], from: int, len_line: int) -> [cpu("cntfrq_el0"), cpu("cntvct_el0"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000")] int {
    if k[10] == 0 {
        return base.puts(con, k, "the link is down: `net up` first\r\n");
    }
    let target = address(line, from, len_line);
    if target < 0 {
        return base.puts(con, k, "usage: ping <a.b.c.d>\r\n");
    }
    let ours = net_address();
    if resolve(cpu, con, bus, vio, dma, k, ns, frame, reply, wire, tcp, bufs, inbox, target) < 0 {
        return 0;
    }
    k[23] = k[23] + 1;
    var at = 0;
    if k[10] == 2 {
        at = 14;
    }
    var m = inet.echo_request(reply, at, ours, target, 51724, k[23], 32);
    if m > 0 && k[10] == 2 {
        m = inet.eth_frame(reply, m, k[22], k[19]);
    }
    if m <= 0 {
        return base.puts(con, k, "the request could not be built\r\n");
    }
    link_send(bus, vio, dma, k, reply, m, wire);
    let sent = base.now_us(cpu);
    while base.now_us(cpu) - sent < 1000000 {
        let n = link_recv(bus, vio, dma, k, ns, frame);
        if n > 0 {
            var hit = false;
            if k[10] == 2 {
                hit = n > 14 && inet.get16(frame, 12) == 2048 && inet.is_echo_reply(frame, 14, n - 14, ours, target, 51724, k[23]);
            } else {
                hit = inet.is_echo_reply(frame, 0, n, ours, target, 51724, k[23]);
            }
            if hit {
                let took = base.now_us(cpu) - sent;
                base.puts(con, k, "reply from ");
                put_address(con, k, target);
                base.puts(con, k, " in ");
                base.put_dec(con, k, took);
                return base.puts(con, k, " us\r\n");
            }
            net_take(bus, vio, dma, k, frame, n, reply, wire, tcp, bufs, inbox, base.uptime_ms(cpu), cpu_read(cpu, "cntvct_el0"));
        }
    }
    base.puts(con, k, "no reply from ");
    put_address(con, k, target);
    return base.puts(con, k, " within a second\r\n");
}

pub fn put_net[&mc, &s](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048"), k: &!s [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048")] int {
    if k[10] == 0 && k[9] == 0 && k[15] == 0 {
        base.puts(con, k, "no network card, and no second serial port");
    } else if k[10] == 0 {
        base.puts(con, k, "link down");
    } else if k[10] == 2 {
        base.puts(con, k, "link up: virtio-net, card ");
        var shift = 40;
        while shift >= 0 {
            base.put_hex(con, k, k[19] >> shift + 4 & 15);
            base.put_hex(con, k, k[19] >> shift & 15);
            if shift > 0 {
                base.puts(con, k, ":");
            }
            shift = shift - 8;
        }
        base.puts(con, k, ", address 10.0.0.2");
    } else {
        base.puts(con, k, "link up: SLIP on the second serial port, address 10.0.0.2");
    }
    base.puts(con, k, "\r\n");
    base.put_dec(con, k, k[11]);
    base.puts(con, k, " packets answered, ");
    base.put_dec(con, k, k[12]);
    base.puts(con, k, " dropped");
    if k[12] != 0 {
        base.puts(con, k, " (the last: ");
        if k[13] == inet.drop_short() {
            base.puts(con, k, "cut short");
        } else if k[13] == inet.drop_not_ipv4() {
            base.puts(con, k, "not IPv4");
        } else if k[13] == inet.drop_bad_header_checksum() {
            base.puts(con, k, "header checksum");
        } else if k[13] == inet.drop_not_ours() {
            base.puts(con, k, "for another address");
        } else if k[13] == inet.drop_fragment() {
            base.puts(con, k, "a fragment");
        } else if k[13] == inet.drop_bad_checksum() {
            base.puts(con, k, "checksum");
        } else if k[13] == inet.drop_not_our_frame() {
            base.puts(con, k, "a frame for another card");
        } else if k[13] == inet.drop_too_long() {
            base.puts(con, k, "too long");
        } else {
            base.puts(con, k, "nothing here answers it");
        }
        base.puts(con, k, ")");
    }
    base.puts(con, k, "\r\n");
    if k[34] != 0 && k[37] > 0 {
        base.puts(con, k, "connections begin at a random number (");
        put_rng_name(con, k);
        base.puts(con, k, ")\r\n");
    } else {
        base.puts(con, k, "connections begin at the counter's value: it can be guessed\r\n");
    }
    if k[30] != 0 {
        base.puts(con, k, "shell on port 23: ");
        if k[29] != 0 {
            base.puts(con, k, "a session is open\r\n");
        } else {
            base.puts(con, k, "nobody connected\r\n");
        }
    }
    if k[20] != 0 || k[24] != 0 || k[25] != 0 {
        base.puts(con, k, "tcp: ");
        base.put_dec(con, k, k[24]);
        base.puts(con, k, " open, ");
        base.put_dec(con, k, k[20]);
        base.puts(con, k, " segments taken without a reply, ");
        base.put_dec(con, k, k[25]);
        base.puts(con, k, " sent again\r\n");
    }
    return 0;
}

