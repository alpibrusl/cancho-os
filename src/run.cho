edition 14;

module run;

import base;
import ksys;
import ledger;
import programs;
import tool_rows;

// run.cho -- how the kernel runs a program: which word of a line names one (`program`), what it may do (`changes`,
// `takes_input`, `reading`), and `hosted`, the one block that lends it the kernel as a system (cancho
// docs/bare-system.md), after which what it connected to is in the record (docs/network-out.md). Moved out of
// kernel.cho, which was at the 2,000 lines a file may have.

fn same[&r, &s](line: &r [byte], n: int, word: &s [byte]) -> [] bool {
    if n != len(word) {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(line[i]) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Which of the programs built into the image the line asks for (`hosted` runs it), or -1: 0 `tell`, the kernel's own
// check of a lent system; 1 `fail`, which goes wrong on purpose; 2 `now`, the clock as a program sees it; 3 `random`, bytes of the board's generator;
// 4 `fetch`, a page from another machine (docs/network-out.md); and from `first_tool()` the tools of cancho-tools, in the order
// build.sh lists them. Nothing about a tool is written here: its name, whether it can change a file and whether it
// reads its input are in `tool_rows`, which build.sh makes from what the compiler says each tool performs
// (docs/tools.md).
pub fn first_tool() -> [] int {
    return 5;
}

pub fn program[&r](line: &r [byte], n: int) -> [] int {
    if same(line, n, "tell") || n > 5 && same(line, 5, "tell ") {
        return 0;
    }
    if failing(line, n) {
        return 1;
    }
    if same(line, n, "now") {
        return 2;
    }
    if same(line, n, "random") || n > 7 && same(line, 7, "random ") {
        return 3;
    }
    if same(line, n, "fetch") || n > 6 && same(line, 6, "fetch ") {
        return 4;
    }
    var i = 0;
    while i < tool_rows.count() {
        let name = tool_rows.name(i);
        let m = len(name);
        if same(line, n, name) || n > m + 1 && same(line, m, name) && int_of(line[m]) == 32 {
            return first_tool() + i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Can program `which` change a file? A tool whose row says so; and `fail`, which is not a reader's to run either.
pub fn changes(which: int) -> [] bool {
    return which == 1 || which >= first_tool() && tool_rows.writes(which - first_tool());
}

// `fail trap|spin|memory`: a program that goes wrong on purpose, as `crash` is a kernel that does (docs/tools.md).
pub fn failing[&r](line: &r [byte], n: int) -> [] bool {
    return n > 5 && same(line, 5, "fail ");
}

pub fn takes_input(which: int) -> [] bool {
    return which >= first_tool() && tool_rows.reads_input(which - first_tool());
}

// May a key that can only read run this line? The commands that change nothing and reach nowhere.
pub fn reading[&r](line: &r [byte], n: int) -> [] bool {
    if same(line, n, "time") || same(line, n, "help") || same(line, n, "about") || same(line, n, "uptime") || same(line, n, "ticks") || same(line, n, "mem") || same(line, n, "board") {
        return true;
    }
    if same(line, n, "net") || same(line, n, "disk") || same(line, n, "ls") || n > 3 && same(line, 3, "ls ") || same(line, n, "versions") || same(line, n, "record") || same(line, n, "exit") || same(line, n, "arm zero") || n == 0 {
        return true;
    }
    return n > 4 && (same(line, 4, "cat ") || same(line, 4, "sum ")) || n > 5 && same(line, 5, "echo ") || program(line, n) >= 0 && !changes(program(line, n));
}

// The one place the kernel lends itself as a system: for the length of the block, what a hosted program asks of
// its `Io`, its `Args` and its `Fs` is answered by `ksys`, with the console, the disk, the kernel's state, the line
// and what is open. `which` is what `program` answered.
pub fn hosted[&cq, &mc, &mv, &md, &mg, &mk, &s, &l, &hd, &i, &g, &f, &hp, &ck, &nu, &nn, &nf, &nr, &nw, &nt, &ng, &nh, &ni, &nb, &no](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), stage: &!mg Mmio("0x220000..0x420000,0x40220000..0x40420000"), pm: &!mk Mmio("0x3f10001c..0x3f100028,0xfe10001c..0xfe100028"), cpu: &!cq Cpu, k: &!s [int], line: &!l [byte], h: &!hd [int], io: &!i Io, args: &g Args, fs: &f Fs(""), heap: &!hp Heap, which: int, clk: &ck Clock, bus: &!nu Mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), ns: &!nn [int], frame: &!nf [byte], reply: &!nr [byte], wire: &!nw [byte], tcp: &!nt [int], bufs: &!ng [byte], inbox: &!nh [byte], si: &!ni [int], sb: &!nb [byte], up: &no Out("")) -> [heap, mmio("0x3f215004..0x3f21506c,0xfe215004..0xfe21506c"), mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0x220000..0x420000,0x40220000..0x40420000"), mmio("0x3f10001c..0x3f100028,0xfe10001c..0xfe100028"), cpu("cntfrq_el0"), cpu("cntvct_el0")] int {
    var said = 0;
    // nothing is open before a program starts: one that ended without closing left nothing behind
    var j = 0;
    while j < len(h) {
        h[j] = 0;
        j = j + 1;
    }
    // (and at the console its input has not ended)
    k[4271] = 0;
    // what the program is lent to change: files, only if its own row says it writes them (ksys.cho refuses the rest)
    k[4278] = 0;
    if which >= first_tool() && tool_rows.writes(which - first_tool()) {
        k[4278] = 1;
    }
    // a program that never ends would stop the board: the watchdog counts while one runs (ksys.cho)
    base.watchdog(pm, k, base.patience());
    system ksys(con, vio, dma, stage, pm, cpu, k, line, h, bus, ns, frame, reply, wire, tcp, bufs, inbox, si, sb) in {
        if which == 2 {
            said = programs.now(io, clk);
        } else if which == 1 {
            said = programs.fail(heap, args, io);
        } else if which == 3 {
            said = programs.random(io, args, fs);
        } else if which == 4 {
            said = programs.fetch(io, args, up);
        } else if which >= first_tool() {
            said = tool_rows.run(which - first_tool(), heap, args, fs, io);
        } else {
            said = programs.tell(io, args);
        }
    }
    base.watchdog(pm, k, 0);
    // what it left open is closed, and every connection it asked for is in the record (docs/network-out.md)
    ksys.close_connections(h, tcp);
    note_connections(con, vio, dma, k, h);
    return said;
}

// The log of connections a program asked for (ksys.cho), one line each in the record: `net` and the bytes sent and
// received where the line's version and size are, or `net-refused`, or `net-failed`.
fn note_connections[&mc, &mv, &md, &s, &hd](con: &!mc Mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), vio: &!mv Mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100"), dma: &!md Mmio("0x210000..0x220000,0x40210000..0x40220000"), k: &!s [int], h: &!hd [int]) -> [mmio("0x9000000..0x9000048,0x3f201000..0x3f201048,0xfe201000..0xfe201048,0x107d001000..0x107d001048"), mmio("0x210000..0x220000,0x40210000..0x40220000"), mmio("0xa000000..0xa004000,0x3f300000..0x3f300100,0xfd580000..0xfd590000,0xfe340000..0xfe340100")] int {
    let at = ksys.log_at();
    var who = 0;
    if k[26] != 0 {
        who = 1;
    }
    var i = 0;
    while i < h[at] && i < ksys.connections_logged() {
        let e = at + 1 + i * 68;
        region r {
            let target = alloc_slice[r](64, byte_of(0));
            var n = 0;
            while n < h[e + 3] && n < 64 {
                target[n] = byte_of(h[e + 4 + n]);
                n = n + 1;
            }
            if h[e] == 2 {
                ledger.note_counts(con, vio, dma, k, who, "net-refused", target[0..n], 0 - 1, 0 - 1);
            } else if h[e] == 1 {
                ledger.note_counts(con, vio, dma, k, who, "net", target[0..n], h[e + 1], h[e + 2]);
            } else {
                ledger.note_counts(con, vio, dma, k, who, "net-failed", target[0..n], 0 - 1, 0 - 1);
            }
        }
        i = i + 1;
    }
    return i;
}
